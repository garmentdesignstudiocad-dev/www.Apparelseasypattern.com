<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"></head><body><%- include('../partials/admin_header') %><main class="container section"><h1><%= session.title %> — Registrations</h1><p><strong>Total:</strong> <%= totals.total %> · <strong>Paid:</strong> <%= totals.paid %> · <strong>Pending/failed:</strong> <%= totals.pending %> · <strong>Revenue:</strong> ₹<%= totals.revenue.toLocaleString('en-IN') %></p><div class="card card-body table-responsive"><table><thead><tr><th>ID / Participant</th><th>Contact</th><th>Registered</th><th>Amount</th><th>Payment</th><th>Razorpay Payment ID</th><th>Status</th></tr></thead><tbody><% registrations.forEach(r=>{ %><tr><td><small><%= r._id %></small><br><strong><%= r.name %></strong></td><td><%= r.email %><br><%= r.phone %></td><td><%= new Date(r.createdAt).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'}) %></td><td>₹<%= Number(r.amount).toLocaleString('en-IN') %></td><td><%= r.payment_status %></td><td><%= r.razorpay_payment_id||'—' %></td><td><%= r.registration_status %></td></tr><% }) %></tbody></table></div></main></body></html>
