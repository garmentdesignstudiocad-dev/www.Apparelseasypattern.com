<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= seoTitle || title || product?.name || 'Garment Pattern Store' %></title>
  <meta name="description" content="<%= description || '' %>">
  <meta property="og:title" content="<%= seoTitle || title || product?.name || 'Garment Pattern Store' %>">
  <meta property="og:description" content="<%= description || '' %>">
  <meta property="og:type" content="product">
  <% if(canonicalUrl){ %><link rel="canonical" href="<%= canonicalUrl %>"><meta property="og:url" content="<%= canonicalUrl %>"><% } %>
  <% if(ogImage){ %><meta property="og:image" content="<%= ogImage %>"><meta name="twitter:card" content="summary_large_image"><% } %>
  <% if(productStructuredData){ %><script type="application/ld+json"><%- jsonLd(productStructuredData) %></script><% } %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/customer-experience.css">

  <style>
    /* =====================================================
       PRODUCT DETAIL — PREMIUM GARMENT STORE
    ===================================================== */

    :root {
      --ink: #18161a;
      --muted: #77717a;
      --cream: #f7f4ef;
      --white: #ffffff;
      --line: #e8e2db;
      --brown: #684a36;
      --brown-dark: #2a211c;
      --sand: #ead6bf;
      --gold: #b58a54;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--cream);
      color: var(--ink);
      font-family: "DM Sans", Arial, sans-serif;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font-family: inherit;
    }

    /* =====================================================
       HEADER
    ===================================================== */

    .pd-header {
      position: sticky;
      top: 0;
      z-index: 1000;

      background: rgba(255,255,255,.94);
      backdrop-filter: blur(18px);

      border-bottom: 1px solid var(--line);
    }

    .pd-nav {
      width: min(1180px, calc(100% - 40px));
      height: 76px;
      margin: auto;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
    }

    .pd-brand {
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .pd-brand-mark {
      width: 38px;
      height: 38px;

      display: grid;
      place-items: center;

      border-radius: 11px;

      color: #fff;
      background: linear-gradient(135deg, #2a211c, #77533b);

      font-family: "Playfair Display", serif;
      font-size: 13px;
      font-weight: 700;
    }

    .pd-brand-text {
      display: flex;
      flex-direction: column;
      line-height: 1.05;
    }

    .pd-brand-text strong {
      font-size: 13px;
      letter-spacing: -.2px;
    }

    .pd-brand-text small {
      margin-top: 4px;

      color: #989097;

      font-size: 7px;
      letter-spacing: 1.3px;
      text-transform: uppercase;
    }

    .pd-menu {
      display: flex;
      align-items: center;
      gap: 29px;
    }

    .pd-menu a {
      color: #625d63;

      font-size: 11px;
      font-weight: 600;

      transition: .2s ease;
    }

    .pd-menu a:hover {
      color: var(--ink);
    }

    .pd-actions {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .pd-signin {
      color: #625d63;
      font-size: 11px;
      font-weight: 600;
    }

    .pd-cart {
      padding: 11px 16px;

      border-radius: 9px;

      color: #fff;

      background: var(--ink);

      font-size: 10px;
      font-weight: 700;
    }

    /* =====================================================
       PAGE
    ===================================================== */

    .pd-page {
      width: min(1180px, calc(100% - 40px));
      margin: auto;
      padding: 30px 0 90px;
    }

    /* =====================================================
       BREADCRUMB
    ===================================================== */

    .pd-breadcrumb {
      display: flex;
      align-items: center;
      gap: 10px;

      margin-bottom: 28px;

      color: #8c858d;

      font-size: 9px;
      font-weight: 600;
    }

    .pd-breadcrumb .current {
      color: var(--brown);
    }

    /* =====================================================
       PRODUCT GRID
    ===================================================== */

    .pd-product {
      display: grid;
      grid-template-columns: 1.04fr .96fr;

      gap: 54px;

      align-items: start;
    }

    /* =====================================================
       PRODUCT VISUAL
    ===================================================== */

    .pd-visual {
      position: sticky;
      top: 105px;
    }

    .pd-image-box {
      position: relative;

      min-height: 620px;

      overflow: hidden;

      border-radius: 24px;

      background:
        radial-gradient(
          circle at 50% 25%,
          rgba(255,255,255,.75),
          transparent 30%
        ),
        linear-gradient(
          145deg,
          #eee5dc,
          #d9cec3
        );

      box-shadow:
        0 25px 65px rgba(45,31,20,.10);
    }

    .pd-image-box img {
      width: 100%;
      height: 620px;

      object-fit: cover;
    }

    .pd-image-label {
      position: absolute;
      top: 25px;
      left: 27px;

      color: #786c63;

      font-size: 8px;
      font-weight: 800;

      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .pd-number {
      position: absolute;
      top: 24px;
      right: 26px;

      color: rgba(60,45,35,.35);

      font-family: "Playfair Display", serif;
      font-size: 13px;
    }

    /* Pattern placeholder */

    .pd-placeholder {
      width: 100%;
      height: 620px;

      position: relative;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .pd-placeholder::before {
      content: "";

      position: absolute;

      width: 240px;
      height: 420px;

      border: 1px solid rgba(100,78,62,.35);

      border-radius: 125px 125px 28px 28px;

      transform: scaleX(.68);

      opacity: .65;
    }

    .pd-shirt {
      position: relative;

      width: 180px;
      height: 250px;

      border: 1px solid rgba(80,60,45,.42);

      clip-path: polygon(
        29% 0,
        44% 0,
        50% 12%,
        56% 0,
        71% 0,
        100% 18%,
        82% 38%,
        75% 27%,
        75% 100%,
        25% 100%,
        25% 27%,
        18% 38%,
        0 18%
      );

      opacity: .75;
    }

    .pd-placeholder-name {
      position: absolute;
      bottom: 65px;

      font-family: "Playfair Display", serif;
      font-size: 26px;
    }

    .pd-placeholder-sub {
      position: absolute;
      bottom: 47px;

      color: #8a7e75;

      font-size: 7px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    /* =====================================================
       PRODUCT INFO
    ===================================================== */

    .pd-info {
      padding-top: 8px;
    }

    .pd-kicker {
      display: block;

      margin-bottom: 12px;

      color: var(--brown);

      font-size: 9px;
      font-weight: 800;

      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .pd-title {
      margin: 0;

      font-family: "Playfair Display", serif;

      font-size: clamp(48px, 5vw, 68px);
      line-height: .94;

      letter-spacing: -2px;
    }

    .pd-description {
      max-width: 540px;

      margin: 18px 0 26px;

      color: var(--muted);

      font-size: 13px;
      line-height: 1.75;
    }

    /* =====================================================
       PRICE
    ===================================================== */

    .pd-price-card {
      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 20px 22px;

      margin-bottom: 25px;

      border: 1px solid var(--line);
      border-radius: 15px;

      background: rgba(255,255,255,.72);
    }

    .pd-price-label {
      display: block;

      margin-bottom: 7px;

      color: #8a8188;

      font-size: 7px;
      font-weight: 800;

      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .pd-price {
      font-family: "Playfair Display", serif;
      font-size: 25px;
    }

    .pd-price-note {
      color: #999198;
      font-size: 9px;
    }

    /* =====================================================
       SELECTION
    ===================================================== */

    .pd-section-title {
      display: flex;
      align-items: center;
      gap: 12px;

      margin-bottom: 13px;
    }

    .pd-step {
      width: 25px;
      height: 25px;

      display: grid;
      place-items: center;

      border-radius: 50%;

      color: #fff;

      background: var(--ink);

      font-size: 8px;
      font-weight: 800;
    }

    .pd-section-title strong {
      font-size: 12px;
    }

    .pd-section-title small {
      display: block;

      margin-top: 3px;

      color: #9b9399;

      font-size: 8px;
    }

    .pd-options {
      display: grid;
      gap: 9px;

      margin-bottom: 24px;
    }

    .pd-option {
      width: 100%;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 15px 15px;

      border: 1px solid #ddd4cc;
      border-radius: 13px;

      background: #fff;

      cursor: pointer;

      text-align: left;

      transition:
        border-color .2s ease,
        box-shadow .2s ease,
        transform .2s ease;
    }

    .pd-option:hover {
      transform: translateY(-1px);

      border-color: var(--gold);

      box-shadow: 0 7px 20px rgba(80,50,25,.07);
    }

    .pd-option.active {
      border-color: var(--gold);

      box-shadow:
        0 0 0 1px var(--gold),
        0 8px 24px rgba(100,70,40,.08);
    }

    .pd-option-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .pd-option-icon {
      width: 32px;
      height: 32px;

      display: grid;
      place-items: center;

      border-radius: 9px;

      color: #fff;

      background: linear-gradient(
        135deg,
        #3b2d24,
        #896246
      );

      font-size: 8px;
      font-weight: 800;
    }

    .pd-option-name {
      display: block;

      font-size: 10px;
      font-weight: 800;
    }

    .pd-option-description {
      display: block;

      margin-top: 4px;

      color: #958d92;

      font-size: 7px;
    }

    .pd-option-price {
      color: #4e4036;

      font-size: 9px;
      font-weight: 800;
    }

    /* =====================================================
       TOTAL
    ===================================================== */

    .pd-total {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;

      padding: 19px 20px;

      border-radius: 15px;

      color: #fff;

      background:
        linear-gradient(
          135deg,
          #171419,
          #2b211d
        );

      box-shadow:
        0 15px 35px rgba(20,15,15,.18);
    }

    .pd-total-label {
      display: block;

      margin-bottom: 5px;

      color: rgba(255,255,255,.5);

      font-size: 7px;
      font-weight: 800;

      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .pd-total-price {
      font-family: "Playfair Display", serif;
      font-size: 25px;
    }

    .pd-add {
      min-width: 135px;

      padding: 14px 18px;

      border: 0;
      border-radius: 10px;

      color: #2a211c;

      background: #e8c49a;

      cursor: pointer;

      font-size: 9px;
      font-weight: 800;

      transition: .2s ease;
    }

    .pd-add:hover {
      transform: translateY(-2px);

      background: #f0d0aa;
    }

    /* =====================================================
       TRUST
    ===================================================== */

    .pd-trust {
      display: grid;
      grid-template-columns: 1fr 1fr;

      gap: 9px;

      margin-top: 10px;
    }

    .pd-trust-card {
      padding: 14px;

      border: 1px solid var(--line);
      border-radius: 12px;

      background: rgba(255,255,255,.72);
    }

    .pd-trust-card strong {
      display: block;

      margin-bottom: 4px;

      font-size: 8px;
    }

    .pd-trust-card span {
      color: #958c92;

      font-size: 7px;
    }

    /* =====================================================
       DETAILS SECTION
    ===================================================== */

    .pd-details {
      margin-top: 85px;

      padding-top: 55px;

      border-top: 1px solid var(--line);
    }

    .pd-details-grid {
      display: grid;
      grid-template-columns: 1fr 2fr;

      gap: 70px;
    }

    .pd-details-title {
      margin: 0;

      font-family: "Playfair Display", serif;

      font-size: 36px;
      line-height: 1.05;
    }

    .pd-details-copy {
      color: var(--muted);

      font-size: 13px;
      line-height: 1.8;
    }

    .pd-feature-grid {
      display: grid;
      grid-template-columns: repeat(2,1fr);

      gap: 12px;

      margin-top: 24px;
    }

    .pd-feature {
      padding: 18px;

      border: 1px solid var(--line);
      border-radius: 13px;

      background: #fff;
    }

    .pd-feature strong {
      display: block;

      margin-bottom: 5px;

      font-size: 10px;
    }

    .pd-feature span {
      color: #8c858b;

      font-size: 8px;
      line-height: 1.5;
    }

    /* =====================================================
       FOOTER
    ===================================================== */

    .pd-footer {
      margin-top: 20px;

      background: #171419;
      color: #fff;
    }

    .pd-footer-inner {
      width: min(1180px, calc(100% - 40px));
      margin: auto;

      padding: 55px 0 22px;
    }

    .pd-footer-grid {
      display: grid;
      grid-template-columns: 1.7fr 1fr 1fr 1fr;

      gap: 40px;

      padding-bottom: 40px;
    }

    .pd-footer-brand strong {
      display: block;

      margin-bottom: 12px;

      font-family: "Playfair Display", serif;

      font-size: 20px;
    }

    .pd-footer-brand p {
      max-width: 310px;

      margin: 0;

      color: rgba(255,255,255,.55);

      font-size: 10px;
      line-height: 1.7;
    }

    .pd-footer-col h4 {
      margin: 0 0 14px;

      font-size: 9px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .pd-footer-col a,
    .pd-footer-col span {
      display: block;

      margin-bottom: 9px;

      color: rgba(255,255,255,.55);

      font-size: 9px;
    }

    .pd-footer-bottom {
      display: flex;
      justify-content: space-between;
      gap: 20px;

      padding-top: 18px;

      border-top: 1px solid rgba(255,255,255,.08);

      color: rgba(255,255,255,.35);

      font-size: 8px;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 900px) {

      .pd-product {
        grid-template-columns: 1fr;

        gap: 35px;
      }

      .pd-visual {
        position: relative;
        top: auto;
      }

      .pd-image-box,
      .pd-placeholder {
        min-height: 520px;
        height: 520px;
      }

      .pd-image-box img {
        height: 520px;
      }

      .pd-menu {
        display: none;
      }

      .pd-details-grid {
        grid-template-columns: 1fr;
        gap: 25px;
      }

      .pd-footer-grid {
        grid-template-columns: repeat(2,1fr);
      }
    }

    @media (max-width: 600px) {

      .pd-nav,
      .pd-page,
      .pd-footer-inner {
        width: calc(100% - 26px);
      }

      .pd-brand-text {
        display: none;
      }

      .pd-actions {
        gap: 9px;
      }

      .pd-signin {
        display: none;
      }

      .pd-title {
        font-size: 48px;
      }

      .pd-price-card {
        padding: 17px;
      }

      .pd-total {
        align-items: stretch;
        flex-direction: column;
      }

      .pd-add {
        width: 100%;
      }

      .pd-trust,
      .pd-feature-grid {
        grid-template-columns: 1fr;
      }

      .pd-footer-grid {
        grid-template-columns: 1fr;
      }

      .pd-footer-bottom {
        flex-direction: column;
      }
    }
    .fit-selector fieldset{min-width:0;margin:0;border-color:var(--primary-color,#62392d)}
    .fit-selector legend{font-weight:700;padding:0 8px}
    .fit-selector .fit-option{display:block;padding:12px 0;overflow-wrap:anywhere}
    .fit-unavailable{display:flex;flex-wrap:wrap;gap:10px}
    .fit-unavailable>span{padding:8px 12px;border:1px dashed #aaa;border-radius:6px;flex:1 1 140px}
    .fit-selector button{max-width:100%;white-space:normal}
    .fit-selector :disabled{cursor:not-allowed;opacity:.65}
    .fit-selector input:focus-visible,.fit-selector button:focus-visible{outline:3px solid var(--accent-color,#c58b62);outline-offset:3px}
    @media(max-width:600px){.fit-selector fieldset{padding:12px}.fit-unavailable>span{flex-basis:100px}}
  </style>
<%- include('partials/theme') %><link rel="stylesheet" href="/css/business.css"></head>

<body><%- include('partials/header') %>
<main class="pd-page"><nav aria-label="Breadcrumb"><a href="/products">Available Patterns</a> / <% if(product.category){ %><a href="/products?category=<%= encodeURIComponent(product.category) %>"><%= product.category.replaceAll('-',' ') %></a> / <% } %><%= product.name %></nav>
<section class="pd-product pd-grid"><div data-protected-content><div class="pd-image-box preview-watermark" data-watermark="Apparel Easy Patterns - Preview"><% if(product.images?.length){ %><img src="<%= product.images[0] %>" alt="<%= product.name %>"><% }else{ %><div class="pattern-placeholder">Product image coming soon</div><% } %></div>
<div class="pattern-gallery preview-watermark" data-watermark="Apparel Easy Patterns - Preview"><% (product.images||[]).slice(1).forEach((src,index)=>{ %><img loading="lazy" src="<%= src %>" alt="<%= product.name %> - view <%= index+2 %>"><% }) %><% if(product.sample_image_url){ %><figure><img src="<%= product.sample_image_url %>" alt="Finished garment sample for <%= product.name %>"><figcaption>Finished garment / sample</figcaption></figure><% } %></div>
<% if(product.video_url){ %><div class="preview-watermark" data-watermark="Apparel Easy Patterns - Preview"><video class="pattern-video" controls preload="metadata" aria-label="<%= product.name %> product video" src="<%= product.video_url %>"></video></div><% } %></div>
<div><span class="pd-kicker">Ready-to-use apparel pattern</span><h1 class="pd-title"><%= product.name %></h1><p data-protected-content><%= product.description || 'Choose the pattern options available for your sampling and garment-development requirements.' %></p>
<% if(product.status==='coming_soon'){ %><p class="pattern-notice">COMING SOON</p><a href="/pattern-updates">Get pattern updates</a><% }else{ %>
<%
const positivePrice=value=>value!==null && value!==undefined && String(value).trim()!=='' && Number.isFinite(Number(value)) && Number(value)>0;
const configuredSizes=(product.available_sizes || []).filter(size=>typeof size==='string' && /^[a-zA-Z0-9 ._-]{1,40}$/.test(size));
const customWork=row=>/custom|modification/i.test(String(row.name || row.file_name || ''));
const purchasableFile=file=>file.active===true && /^[a-f0-9]{24}$/i.test(String(file._id)) && positivePrice(file.file_price) && !customWork(file);
const formatName=file=>file.purpose==='dxf'?'DXF':/^(hpgl|plt)$/i.test(file.file_type || '')?'HPGL Printable':/^pdf$/i.test(file.file_type || '')?'PDF':null;
const documentFile=file=>['specs','tech_pack'].includes(file.purpose);
const fileGroup=file=>documentFile(file)?'documents':formatName(file)?'formats':'additional';
const fileMatchesLabel=(file,label,group)=>{
  if(group==='formats')return formatName(file)===label;
  if(group==='documents'){
    const name=String(file.file_name||'').trim().toLowerCase();
    const target=label.toLowerCase();
    if(target==='measurement chart')return name==='measurement chart' || (file.purpose==='specs' && /(?:measurement|measure)/i.test(name));
    if(target==='basic spec sheet / pom')return name==='basic spec sheet / pom' || name==='basic spec sheet' || name==='spec sheet' || name==='pom' || (file.purpose==='tech_pack' && /(?:spec|pom)/i.test(name));
    return name===target;
  }
  return false;
};
const baseReady=optionAvailability.printable && product.pattern_options?.printable===true && positivePrice(product.base_price);
const physicalReady=optionAvailability.physical && product.pattern_options?.physical===true && positivePrice(product.physical_price) && (product.size_prices || []).every(row=>positivePrice(row.price));
const trialReady=optionAvailability.trial && product.pattern_options?.trial===true && positivePrice(product.trial_price);
%>
<form id="pattern-purchase" class="pattern-options fit-selector" aria-labelledby="fit-selector-title">
<h2 id="fit-selector-title">SELECT YOUR FIT BLOCK</h2>
<p>Choose from the configured options for this product. Unavailable choices cannot be purchased. Category, style and fabric width are not included in your order.</p>
<fieldset><legend>1. Fit Category</legend><div class="fit-unavailable"><% ['Men','Women','Kids','Innerwear'].forEach(label=>{ %><span><%= label %> <small>Enquire for availability</small></span><% }) %></div></fieldset>
<fieldset><legend>2. Fit / Style</legend><div class="fit-unavailable"><% ['Regular','Slim','Relaxed','Oversized','Custom'].forEach(label=>{ %><span><%= label %> <small>Enquire for availability</small></span><% }) %></div></fieldset>
<% for(const group of ['formats','documents']){ %>
<fieldset><legend><%= group==='formats'?'3. File Format':'4. Digital Documents' %></legend>
<div class="fit-unavailable"><% (group==='formats'?['DXF','HPGL Printable','PDF']:['Measurement Chart','Basic Spec Sheet / POM','Construction Details','SPI Details','Fabric Guide']).forEach(label=>{const mapped=files.some(file=>fileGroup(file)===group && fileMatchesLabel(file,label,group) && purchasableFile(file)); %><% if(!mapped){ %><span><%= label %> <small>Enquire for availability</small></span><% } %><% }) %></div>
<% files.forEach((file,index)=>{if(fileGroup(file)!==group)return;const ready=purchasableFile(file); %>
<label class="fit-option"><input class="pattern-file" data-file-index="<%= index %>" type="checkbox" value="<%= file._id %>" data-price="<%= ready?Number(file.file_price):'' %>" data-per-selected-size="<%= file.price_per_selected_size?'1':'0' %>" <%= ready?'':'disabled' %>> <strong><%= group==='formats'?formatName(file):file.file_name %></strong><% if(ready){ %> &mdash; &#8377;<%= Number(file.file_price).toLocaleString('en-IN') %><%= file.price_per_selected_size?' per selected size':'' %><% }else{ %> &mdash; Not available yet<% } %><small class="pattern-file-price-detail" data-file-index="<%= index %>"><%= ready?(file.price_per_selected_size?'Select sizes to calculate this file option.':'Flat option price.'):'Enquire for availability and pricing.' %></small><small><%= file.file_name %> &middot; <%= file.file_type %></small></label>
<% }) %>
<small><%= group==='formats'?'Optional files are charged separately from the base printable option below.':'Only the named configured documents are offered; separate document contents are not implied.' %></small>
</fieldset><% } %>
<fieldset><legend>5. Fabric Width (inches)</legend><div class="fit-unavailable"><% [58,60,62,64,68,72].forEach(width=>{ %><span><%= width %> inches <small>Enquire for availability</small></span><% }) %></div><small>No width-specific file or fabric compatibility is confirmed by this list.</small></fieldset>
<fieldset><legend>6. Sizes</legend><% if(configuredSizes.length){ %><div class="pattern-sizes"><% configuredSizes.forEach(size=>{ %><label><input type="checkbox" class="pattern-size" value="<%= size %>"> <%= size %></label><% }) %></div><% }else{ %><p>No sizes are configured for purchase. Enquire for availability.</p><% } %>
<div class="fit-unavailable"><% ['XS','S','M','L','XL','XXL','3XL','4XL'].filter(size=>!configuredSizes.includes(size)).forEach(size=>{ %><span><%= size %> <small>Not available yet</small></span><% }) %></div><small>Size identifiers are shown as configured. Selected sizes do not imply separate size-specific files.</small>
<% if(baseReady){ %><small>One size is included with the base printable option.<% if(positivePrice(product.additional_size_price)){ %> Each additional printable size: &#8377;<%= Number(product.additional_size_price).toLocaleString('en-IN') %>.<% }else{ %> Additional printable sizes require a confirmed price; select one size for this option.<% } %></small><% } %></fieldset>
<fieldset><legend>7. Pattern Type</legend>
<label class="fit-option"><input id="printable-option" type="checkbox" <%= baseReady?'checked':'disabled' %>> <strong>Soft Copy &ndash; Download (base printable file)</strong><% if(baseReady){ %> &mdash; &#8377;<%= Number(product.base_price).toLocaleString('en-IN') %><% }else{ %> &mdash; Not available yet<% } %><small>Select optional digital files above independently. The base file is charged only once when checked; its format is as listed for this product.</small></label>
<label class="fit-option"><input id="physical-option" type="checkbox" <%= physicalReady?'':'disabled' %>> <strong>Hard Copy &ndash; Printed Pattern</strong><% if(physicalReady){ %> &mdash; from &#8377;<%= Number(product.physical_price).toLocaleString('en-IN') %> per size<% }else{ %> &mdash; Not available yet<% } %><small>Soft Copy and Hard Copy may be purchased together. Configured size-specific physical prices apply.</small><% if(physicalReady){ (product.size_prices || []).forEach(row=>{ %><small><%= row.size %>: &#8377;<%= Number(row.price).toLocaleString('en-IN') %> per printed pattern</small><% }); } %></label>
<% if(product.printable_dimensions){ %><p><%= product.printable_dimensions %></p><% } %>
</fieldset>
<fieldset><legend>8. Additional Options</legend><div class="fit-unavailable"><% ['Grading File','Marker File','Detailed Construction Guide'].forEach(label=>{ %><span><%= label %> <small>Enquire for availability</small></span><% }) %></div>
<% files.forEach((file,index)=>{if(fileGroup(file)!=='additional')return;const ready=purchasableFile(file); %><label class="fit-option"><input class="pattern-file" data-file-index="<%= index %>" type="checkbox" value="<%= file._id %>" data-price="<%= ready?Number(file.file_price):'' %>" data-per-selected-size="<%= file.price_per_selected_size?'1':'0' %>" <%= ready?'':'disabled' %>> <%= file.file_name %><% if(ready){ %> &mdash; &#8377;<%= Number(file.file_price).toLocaleString('en-IN') %><%= file.price_per_selected_size?' per selected size':'' %><% }else{ %> &mdash; Not available yet<% } %><small class="pattern-file-price-detail" data-file-index="<%= index %>"><%= ready?'Configured optional file.':'Enquire for availability and pricing.' %></small><small><%= file.file_type %></small></label><% }) %>
<% addons.forEach(addon=>{if(customWork(addon))return;const ready=addon.active===true && /^[a-f0-9]{24}$/i.test(String(addon._id)) && positivePrice(addon.price); %><label class="fit-option"><input class="pattern-addon" type="checkbox" value="<%= addon._id %>" data-price="<%= ready?Number(addon.price):'' %>" <%= ready?'':'disabled' %>> <%= addon.name %><% if(ready){ %> &mdash; &#8377;<%= Number(addon.price).toLocaleString('en-IN') %><% }else{ %> &mdash; Not available yet<% } %><small><%= addon.description || '' %></small></label><% }) %>
<p><strong>Custom Modification</strong> &mdash; enquiry / quotation only. Not included in your cart or total.</p><% if(canVisit('/contact')){ %><a href="/contact">Enquire About Custom Modification</a><% }else{ %><p>Contact the studio using the details below to request a quotation.</p><% } %>
<label class="fit-option"><input id="trial-option" type="checkbox" <%= trialReady?'':'disabled' %>> <strong>Order Trial Sample Based on This Pattern</strong><% if(trialReady){ %> &mdash; &#8377;<%= Number(product.trial_price).toLocaleString('en-IN') %> per size<% }else{ %> &mdash; Not available yet<% } %></label>
</fieldset>
<fieldset><legend>9. Delivery</legend><p>For Hard Copy or trial samples, delivery address, city, state and a six-digit PIN will be collected at checkout. Choose a configured delivery partner there; courier charges are calculated at checkout.</p><small>Digital-only orders do not require a delivery address.</small></fieldset>
<div class="pattern-summary"><p>Subtotal: <strong id="pattern-subtotal"></strong></p><p>GST (18%): <span id="pattern-tax"></span></p><p>Total: <strong id="pdTotal" aria-live="polite"></strong></p></div>
<button class="fashion-button" id="pdAddToCart" type="submit" <%= configuredSizes.length?'':'disabled' %>>ADD TO CART</button><button class="fashion-button" id="pdBuyNow" type="button" <%= configuredSizes.length?'':'disabled' %>>BUY NOW</button><p id="pattern-error" role="alert"></p><small>Sign in before checkout. Purchased digital files become accessible after verified payment and file preparation.</small>
</form>
<script id="pattern-config" type="application/json"><%- JSON.stringify({id:String(product._id),base:Number(product.base_price||0),extra:Number(product.additional_size_price||0),physical:Number(product.physical_price||0),trial:Number(product.trial_price||0),sizePrices:product.size_prices||[]}).replace(/</g,'\\u003c') %></script><script src="/js/pattern-product.js" defer></script><% } %>
</div></section>
<section class="pd-details" data-protected-content><h2>Measurement Chart / Basic Specifications</h2><p><%= product.size_information || 'Owner-provided measurement information will be added when available. Contact us for details before ordering.' %></p><% if(product.file_formats){ %><p>Available formats: <%= product.file_formats %></p><% } %><% if(product.download_information){ %><p><%= product.download_information %></p><% } %><% if(product.delivery_information){ %><p><%= product.delivery_information %></p><% } %><p>The pattern is intended for practical sampling and garment-development use. Stitch and evaluate your sample before production, and verify construction allowances, sewing requirements and production parameters for your own manufacturing process.</p></section>
<section><h2>Need further pattern assistance or custom requirements?</h2><p>Reach out to us.</p><%- include('partials/support-contact') %></section>
</main><%- include('partials/footer') %><script src="/js/main.js"></script><script src="/js/content-protection.js"></script></body></html>
