                <a href="<%= product.size_chart_pdf %>" target="_blank" rel="noopener noreferrer" class="btn ghost small" style="padding:5px 12px;font-size:12px;font-weight:700;color:#0284C7;border:1px solid #0284C7;border-radius:6px;background:#FFF;text-decoration:none;">
                  View PDF &nearr;
                </a>
                <a href="<%= product.size_chart_pdf %>" download="<%= product.size_chart_pdf_name || 'Size-Chart.pdf' %>" class="btn ghost small" style="padding:5px 12px;font-size:12px;font-weight:700;color:#059669;border:1px solid #059669;border-radius:6px;background:#FFF;text-decoration:none;">
                  Download PDF &darr;
                </a>
              </div>
            </div>
            <div style="position:relative;width:100%;height:380px;border-radius:6px;overflow:hidden;background:#FFF;border:1px solid #E2E8F0;">
              <iframe src="<%= product.size_chart_pdf %>#toolbar=1" width="100%" height="100%" style="border:none;" title="Size Chart PDF Document">
                <p style="padding:16px;text-align:center;font-size:13px;color:#64748B;">
                  Your browser does not display embedded PDFs inline.
                  <a href="<%= product.size_chart_pdf %>" target="_blank" style="color:#0284C7;font-weight:700;">Click here to open the Size Chart PDF</a>.
                </p>
