              <span>Add to Cart</span>
            </button>
            <button type="button" id="pdBuyNow" class="ref-btn-buy">
              <span>Place Order</span>
              <span style="font-size:18px;line-height:1;">&rarr;</span>
            </button>
          </div>
        </form>
      </div>
    </section>

    <!-- =========================================================================
