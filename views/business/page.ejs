<!DOCTYPE html><html lang="en"><head><%- include('../partials/business-head') %></head><body><%- include('../partials/header') %><main class="studio-page"><header class="studio-section"><h1><%= title %></h1><p><%= description %></p></header>
<% if(mode === 'pattern'){ %><div class="studio-actions"><% if(canVisit('#enquiry')){ %><a href="#enquiry">Book a Class</a><% } %><% if(canVisit('#enquiry')){ %><a href="#enquiry">Get Course Details</a><% } %><% if(canVisit('#enquiry')){ %><a href="#enquiry">Book 15-Minute Guidance Call</a><% } %></div><div class="studio-grid"><% Object.entries(business.modules).forEach(([heading, topics]) => { %><section class="studio-card"><h2><%= heading %></h2><ul><% topics.forEach(topic => { %><li><%= topic %></li><% }) %></ul></section><% }) %></div><p><% if(canVisit('/courses')){ %><a href="/courses">View available classes and current course fees</a><% } %>. Enquire for upcoming schedules.</p><% } %>
<% if(mode === 'technology'){ %><section class="studio-section"><h2>Training Areas</h2><ul class="studio-columns"><% business.training.forEach(topic => { %><li><%= topic %></li><% }) %></ul><div class="studio-actions"><% if(canVisit('#enquiry')){ %><a href="#enquiry">Individual Training</a><% } %><% if(canVisit('/corporate-training')){ %><a href="/corporate-training">Corporate Training</a><% } %></div></section><% } %>
<% if(mode === 'consulting'){ %><section class="studio-section"><h2>Consulting Services</h2><ul class="studio-columns"><% services.forEach(item => { const fee=consultingQuote(item); %><li><h3><%= item.name %></h3><p><%= item.description %></p><% if(canVisit('/consulting/' + String(item.slug) + '/access')){ %><a class="fashion-button" href="/consulting/<%= item.slug %>/access"><%= fee.button %> ? <%= fee.price?'?'+fee.price.toLocaleString('en-IN'):'Free' %></a><% } %></li><% }) %></ul><% if(canVisit('#enquiry')){ %><a class="fashion-button" href="#enquiry">Submit Your Requirement</a><% } %></section><% } %>
<% if(mode === 'corporate'){ %><p>Build your team's skills in garment construction, fit, pattern evaluation and technical communication. Share your training requirements to discuss a suitable programme.</p><% } %>
<% if(mode === 'contact'){ %><section><h2>Contact Details</h2><% if(siteSettings.contact_email){ %><p><a href="mailto:<%= siteSettings.contact_email %>"><%= siteSettings.contact_email %></a></p><% } %><% if(siteSettings.contact_phone){ %><p><a href="tel:<%= siteSettings.contact_phone %>"><%= siteSettings.contact_phone %></a></p><% } %><p><%= siteSettings.address %></p></section><% } %>
<% if(['courses','books','updates'].includes(mode)){ %><% if(mode === 'courses'){ %><div class="studio-actions"><% if(canVisit('/courses/pattern-making')){ %><a href="/courses/pattern-making">Pattern Making Course</a><% } %><% if(canVisit('/garment-technology')){ %><a href="/garment-technology">Garment Technology Training</a><% } %></div><h2>Available Courses & Classes</h2><% } %><%- include('../partials/business-cards', {kind:mode, items}) %><% } %>
<% if(mode === 'book'){ %><article class="studio-section"><% if(item.cover_url){ %><img class="studio-cover" src="<%= item.cover_url %>" alt="<%= item.title %> cover"><% } %><p>By <%= item.author || 'Studio editorial team' %></p><h2>About the Book</h2><p class="studio-prose"><%= item.description %></p><h2>Topics</h2><ul><% (Array.isArray(item.topics)?item.topics:[]).forEach(topic => { %><li><%= topic %></li><% }) %></ul><% if(item.pages){ %><p><%= item.pages %> pages</p><% } %><h2>Who Should Read</h2><p><%= item.who_should_read || 'Contact us to discuss whether this book suits your learning needs.' %></p><div class="studio-actions"><% const fee=accessQuote('books',item); if(fee.external && item.amazon_url){ %><a class="fashion-button" href="<%= item.amazon_url %>" target="_blank" rel="noopener noreferrer">Buy on Amazon (external purchase)</a><% }else if(!fee.external){ %><% if(canVisit('/books/' + String(item.slug) + '/access')){ %><a class="fashion-button" href="/books/<%= item.slug %>/access"><%= fee.button %> ? <%= fee.price?'?'+fee.price.toLocaleString('en-IN'):'Free' %></a><% } %><% } %></div></article><% } %>
<% if(mode === 'article'){ %><article class="studio-section"><p><%= item.category %> · <%= new Date(item.published_at).toLocaleDateString('en-IN') %></p><% if(item.image_url){ %><img class="studio-cover" src="<%= item.image_url %>" alt="<%= item.title %>"><% } %><h2><%= item.summary || 'Industry Insight' %></h2><div class="studio-prose"><%= item.content %></div></article><% } %>
<% if(mode === 'thanks'){ %><p role="status">Your enquiry has been received. Our team will contact you to discuss your requirement.</p><% } %>
<% if(['books','book'].includes(mode) && siteSettings.linkedin_show_books){ %><%- include('../partials/linkedin',{compact:false}) %><% } %>
<% if(['pattern','technology','consulting','corporate','contact'].includes(mode)){ %><%- include('../partials/lead-form') %><% } %>
<% if(['contact','consulting'].includes(mode)){ %><%- include('../partials/support-contact') %><% } %><%- include('../partials/business-cta') %></main><%- include('../partials/footer') %><script src="/js/main.js"></script></body></html>
