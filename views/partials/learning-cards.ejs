<% if(canVisit('/'+kind)){ %><div class="studio-grid"><% items.forEach(item=>{ if(!canVisit('/'+kind)) return; const course=kind==='courses'; const fee=typeof accessQuote==='function'?accessQuote(kind,item):{price:item.price}; const picture=course?item.image_url:item.banner_image; %><article class="studio-card"><% if(picture){ %><img src="<%= picture %>" alt="<%= item.name || item.title %>" loading="lazy"><% } %><h3><% if(canVisit('/' + String(kind) + '/' + String(encodeURIComponent(item.slug)))){ %><a href="/<%= kind %>/<%= encodeURIComponent(item.slug) %>"><%= item.name || item.title %></a><% } %></h3><p><%= item.short_description || (item.description || '').slice(0,180) %></p><p><%= Number(fee.price)===0?'Free':'₹'+Number(fee.price).toLocaleString('en-IN') %> · <%= item.mode %></p><% if(!course){ %><p><%= new Date(item.starts_at).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'}) %> IST</p><% } %><% if(canVisit('/' + String(kind) + '/' + String(encodeURIComponent(item.slug)))){ %><a href="/<%= kind %>/<%= encodeURIComponent(item.slug) %>"><%= course?'View Course & Book':'View Webinar' %></a><% } %></article><% }) %><% if(!items.length){ %><p>No <%= kind %> are available yet. <% if(featureEnabled('leads')){ %><a href="/contact">Contact the studio for upcoming schedules</a><% } %>.</p><% } %></div>
<% } %>