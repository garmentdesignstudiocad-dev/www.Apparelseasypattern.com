<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | Garment Pattern Store</title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/customer-experience.css"><script src="https://checkout.razorpay.com/v1/checkout.js"></script><style>.payment-page{background:#f7f4f0}.payment-wrap{width:min(1060px,calc(100% - 32px));margin:auto;padding:55px 0 80px}.payment-layout{display:grid;grid-template-columns:1.15fr .85fr;gap:28px;align-items:start}.payment-card{background:#fff;border:1px solid #e5ddd5;padding:32px;box-shadow:0 12px 35px rgba(35,25,20,.05)}.payment-card h1,.payment-card h2{font-family:"Playfair Display",serif;color:#171419}.payment-card h1{font-size:42px;margin:10px 0}.secure-mark{display:grid;place-items:center;width:60px;height:60px;border-radius:50%;background:#201614;color:#fff;font-size:24px}.summary-row{display:flex;justify-content:space-between;gap:18px;margin:15px 0;color:#6e6661}.grand-total{padding-top:20px;border-top:1px solid #e5ddd5;font-size:18px;color:#171419}.pay-button{width:100%;border:0;padding:17px;margin-top:24px;background:#201614;color:#fff;font-weight:800;cursor:pointer}.pay-button:disabled{opacity:.6;cursor:wait}.payment-message{min-height:22px;margin-top:14px;color:#8b382d;font-size:13px}@media(max-width:760px){.payment-layout{grid-template-columns:1fr}.payment-card{padding:24px}}</style><%- include('partials/theme') %></head><body class="payment-page"><%- include('partials/header') %><main class="payment-wrap"><div class="payment-layout"><section class="payment-card"><div class="secure-mark" aria-hidden="true">✓</div><span class="eyebrow" style="display:block;margin-top:24px">Razorpay checkout</span><h1>Secure Payment</h1><p class="page-intro">Complete your payment securely using Razorpay. Available payment methods are presented within Razorpay Checkout.</p><button id="pay-button" class="pay-button">Pay ₹<%= Number(summary.grand_total||0).toLocaleString('en-IN',{minimumFractionDigits:2}) %> Securely</button><p id="payment-message" class="payment-message" role="status"></p></section><aside class="payment-card"><h2>Order Summary</h2><h3>Online Payment</h3><div class="summary-row"><span>Subtotal</span><strong>₹<%= Number(summary.product_total||0).toLocaleString('en-IN',{minimumFractionDigits:2}) %></strong></div><div class="summary-row"><span>GST (<%= Number(summary.tax_rate||0) %>%)</span><strong>₹<%= Number(summary.tax_amount||0).toLocaleString('en-IN',{minimumFractionDigits:2}) %></strong></div><div class="summary-row grand-total"><span>Online Payment Total</span><strong>₹<%= Number(summary.grand_total||0).toLocaleString('en-IN',{minimumFractionDigits:2}) %></strong></div><% if(summary.delivery_required){ %><section style="border-top:1px solid #ddd;margin-top:24px;padding-top:18px"><h3>Delivery</h3><p>Destination: <%= [(summary.destination || {}).district,(summary.destination || {}).state,(summary.destination || {}).pincode].filter(Boolean).join(', ') %></p><p>Region: <%= (summary.destination || {}).region %></p><p>Dispatch From: <%= (summary.destination || {}).dispatch_location %></p><p>Customer Selected Delivery Partner: <%= summary.courier_name %></p></section><% } %></aside></div></main><%- include('partials/footer') %><script src="/js/main.js"></script><script>document.getElementById('pay-button').addEventListener('click',async function(){const button=this,message=document.getElementById('payment-message');button.disabled=true;message.textContent='Preparing secure payment…';try{const response=await fetch('/checkout/payment-method/proceed',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'});const data=await response.json();if(data.login_url){window.location.href=data.login_url;return;}if(!response.ok)throw new Error(data.error||'Unable to create payment order.');if(typeof Razorpay!=='function')throw new Error('Razorpay Checkout could not be loaded.');const checkout=new Razorpay({key:data.key_id,amount:data.amount,currency:data.currency||'INR',name:'Garment Pattern Store',description:'Garment Pattern Order',order_id:data.razorpay_order_id,prefill:{name:data.customer?.name||<%- JSON.stringify(customer?.name||'').replace(/</g,'\\u003c') %>,email:data.customer?.email||<%- JSON.stringify(customer?.email||'').replace(/</g,'\\u003c') %>,contact:data.customer?.phone||<%- JSON.stringify(customer?.phone||'') %>},handler:function(result){const form=document.createElement('form');form.method='POST';form.action='/checkout/razorpay-callback';['razorpay_order_id','razorpay_payment_id','razorpay_signature'].forEach(function(name){const input=document.createElement('input');input.type='hidden';input.name=name;input.value=result[name]||'';form.appendChild(input)});document.body.appendChild(form);form.submit()},modal:{ondismiss:function(){button.disabled=false;message.textContent='Payment cancelled. You can retry when ready.'}},theme:{color:'#62392d'}});checkout.on('payment.failed',function(){message.textContent='Payment was not completed. Your order remains unpaid.';button.disabled=false});message.textContent='';checkout.open()}catch(error){message.textContent=error.message;button.disabled=false}});</script></body></html>
