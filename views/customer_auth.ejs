<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/customer-experience.css"><%- include('partials/theme') %></head><body><%- include('partials/header') %><main class="container section"><section class="form-surface"><h1><%= title %></h1><% if(error){ %><p role="alert"><%= error %></p><% } %><form method="post" action="/account/<%= mode %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(mode==='register'){ %><label>Full Name<input name="name" autocomplete="name" maxlength="200" required></label><label>Phone Number<input name="phone" autocomplete="tel" pattern="[0-9]{10}" maxlength="10" required></label><% } %><label>Email<input name="email" type="email" autocomplete="email" maxlength="254" required></label><label>Password<input name="password" type="password" autocomplete="<%= mode==='register'?'new-password':'current-password' %>" minlength="12" maxlength="128" required></label><% if(mode==='register'){ %><label>Confirm Password<input name="confirm_password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required></label><p>Use at least 12 characters.</p><% } %><button class="fashion-button" type="submit"><%= title %></button></form><p><a href="/login">Sign In</a> ? <a href="/account/register">Create Account</a></p><p>Sign in to checkout and access your orders.</p></section></main><%- include('partials/footer') %></body></html>