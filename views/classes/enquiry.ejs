<!doctype html><html lang="en"><head><%- include('../partials/business-head') %></head><body><%- include('../partials/header') %><main class="studio-page"><h1><%= title %></h1><p><%= description %></p><% if(typeof sent==='undefined' || !sent){ %><h2>Enquire for Online Classes</h2><% if(error){ %><p role="alert"><%= error %></p><% } %><form action="/classes/enquiry" method="post" class="studio-form"><input type="hidden" name="_csrf" value="<%= learningCsrf %>"><% [['name','Full Name','text'],['whatsapp','WhatsApp Number','tel'],['email','Email','email'],['location','Location','text'],['interested_course','Interested Course','text'],['experience','Experience Level','text'],['preferred_timing','Preferred Timing','text']].forEach(([key,label,type])=>{ %><label><%= label %><input name="<%= key %>" type="<%= type %>" required maxlength="300" value="<%= typeof values[key]==='string'?values[key]:'' %>"></label><% }) %><label class="studio-wide">Message<textarea name="message" maxlength="5000" rows="4"><%= typeof values.message==='string'?values.message:'' %></textarea></label><button class="fashion-button" type="submit">Send Class Enquiry</button><p>No payment is required to submit this enquiry.</p></form><% } %><%- include('../partials/support-contact') %></main><%- include('../partials/footer') %><script src="/js/main.js"></script></body></html>
