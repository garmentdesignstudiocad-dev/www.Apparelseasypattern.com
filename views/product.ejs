              </div>
              <p style="font-size:12px;color:var(--ref-text-muted);margin:0 0 10px;">
                Enter your fabric repeat dimensions above and contact details below. Our CAD pattern engineering team will review and prepare your custom marker.
              </p>
              <div class="marker-field-row" style="margin-bottom:10px;">
                <div class="marker-field-group">
                  <label for="markerLeadName" style="font-size:11.5px;">Your Name *</label>
                  <input type="text" id="markerLeadName" placeholder="Full name" style="height:36px;font-size:13px;" value="<%= typeof user !== 'undefined' && user?.name ? user.name : '' %>">
                </div>
                <div class="marker-field-group">
                  <label for="markerLeadEmail" style="font-size:11.5px;">Email Address *</label>
                  <input type="email" id="markerLeadEmail" placeholder="name@domain.com" style="height:36px;font-size:13px;" value="<%= typeof user !== 'undefined' && user?.email ? user.email : '' %>">
                </div>
                <div class="marker-field-group">
                  <label for="markerLeadWhatsapp" style="font-size:11.5px;">WhatsApp Number *</label>
                  <input type="tel" id="markerLeadWhatsapp" placeholder="+91 98765 43210" style="height:36px;font-size:13px;">
                </div>
