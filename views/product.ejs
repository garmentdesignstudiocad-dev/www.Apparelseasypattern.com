                <div class="marker-field-group">
                  <label for="inputChecksWarp">Stripes / Warp Repeat Width (cm) *</label>
                  <input type="number" id="inputChecksWarp" name="checks_warp_repeat_cm" min="0.1" step="0.1" placeholder="e.g. 6.5">
                  <span class="marker-field-error" id="errChecksWarp">Enter a valid warp repeat in cm</span>
                </div>
                <div class="marker-field-group">
                  <label for="inputChecksWeft">Plaids / Weft Repeat Width (cm) *</label>
                  <input type="number" id="inputChecksWeft" name="checks_weft_repeat_cm" min="0.1" step="0.1" placeholder="e.g. 8.0">
                  <span class="marker-field-error" id="errChecksWeft">Enter a valid weft repeat in cm</span>
                </div>
              </div>
              <div class="marker-field-group" style="max-width:280px;">
                <label for="inputChecksCuttable">Fabric Cuttable Width (cm) *</label>
                <input type="number" id="inputChecksCuttable" name="checks_fabric_width_cm" min="1" step="0.5" placeholder="e.g. 148.0">
                <span class="marker-field-error" id="errChecksCuttable">Enter a valid cuttable width in cm</span>
