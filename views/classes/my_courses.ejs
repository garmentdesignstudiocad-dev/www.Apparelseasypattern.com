<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/customer-experience.css"><%- include('../partials/theme') %></head><body><%- include('../partials/header') %><main class="fashion-page"><span class="eyebrow">Verified enrollments</span><h1 class="page-title">My Courses</h1><p class="page-intro">Courses confirmed in this browser session after verified Razorpay payment.</p><div class="class-grid" style="margin-top:35px"><% if(registrations.length){ registrations.forEach(function(r){ const s=r.session_id; %><article class="class-card"><div class="class-card__body"><span class="eyebrow"><%= s.type %></span><h2><%= s.title %></h2><p><%= new Date(s.starts_at).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'}) %></p><p>Payment: <strong><%= r.payment_status %></strong><br>Enrollment: <strong><%= r.registration_status %></strong></p><% if(canVisit('/classes/registration/' + String(r._id))){ %><a class="fashion-button" href="/classes/registration/<%= r._id %>">View Access</a><% } %></div></article><% }) }else{ %><div class="class-empty"><h2>No verified enrollments in this session</h2><p>Successfully paid courses will appear here in the browser used for enrollment.</p><% if(canVisit('/classes')){ %><a class="fashion-button" href="/classes">Explore Courses</a><% } %></div><% } %></div></main><%- include('../partials/footer') %><script src="/js/main.js"></script></body></html>
