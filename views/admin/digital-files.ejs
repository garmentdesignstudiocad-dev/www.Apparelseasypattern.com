<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/business.css"></head><body><%- include('../partials/admin_header') %><main class="studio-admin"><h1>Private Pattern Files: <%= product.name %></h1><p>Upload files outside the public website. Base files are included with every digital purchase; option files are granted only when purchased. Existing paid download grants keep their original file versions. Maximum file size: 30 MB. Use ZIP for multiple files.</p><form id="upload-form" class="studio-form" data-csrf="<%= learningCsrf %>" data-base="/admin/products/<%= product._id %>/digital-files"><label>File destination<select id="destination"><option value="">Base pattern — <%= product.digital_file?'uploaded':'not uploaded' %></option><% files.forEach(file=>{ %><option value="/<%= file._id %>"><%= file.file_name %> — <%= file.digital_file?'uploaded':'not uploaded' %></option><% }) %></select></label><label>File<input type="file" id="file" accept=".aama,.astm,.pdf,.zip,.dxf,.dwg,.ai,.eps,.plt" required></label><button>Upload Private File</button><p id="upload-status" role="status"></p></form><a href="/admin/products/<%= product._id %>/edit">Back to product</a></main><script src="/js/admin-digital-files.js"></script></body></html>
