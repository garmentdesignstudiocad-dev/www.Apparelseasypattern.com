<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/business.css"></head><body><%- include('../partials/admin_header') %><main class="studio-admin"><h1><%= title %></h1><% if(kind==='books'){ %><p><a href="/admin/access-records?kind=books">Book Purchases & Payments</a></p><% } %>
<% if(items){ %><a href="/admin/<%= kind %>/new">Add <%= kind === 'books'?'Book':'Article' %></a><div class="studio-table"><table><thead><tr><th>Title</th><th>Visibility</th><th>Manage</th></tr></thead><tbody><% items.forEach(row => { %><tr><td><%= row.title %></td><td><%= (kind === 'books'?row.active:row.published)?'Public':'Hidden' %></td><td><a href="/admin/<%= kind %>/<%= row._id %>/edit">Edit</a></td></tr><% }) %></tbody></table></div><% if(!items.length){ %><p>No content yet. Add your first entry.</p><% } %>
<% }else{ %><p>Plain text only. HTML and JavaScript are not accepted. URLs must start with https:// or http://.</p><% if(errors.length){ %><div class="studio-errors" role="alert"><% errors.forEach(error => { %><p><%= error %></p><% }) %></div><% } %><form method="post" action="/admin/<%= kind %>/<%= item._id ? item._id+'/edit':'new' %>" class="studio-form"><input type="hidden" name="_csrf" value="<%= csrf %>">
<% const fields = kind === 'books' ? [['title',200],['slug',200],['author',200],['cover_url',2048],['topics',2000],['pages',6],['amazon_url',2048],['ebook_url',2048]] : [['title',200],['slug',200],['image_url',2048],['seo_title',200],['seo_description',320],['keywords',2000]]; fields.forEach(([key,max]) => { %><label><%= key.replaceAll('_',' ') %><%= ['topics','keywords'].includes(key)?' (comma separated)':'' %><input name="<%= key %>" maxlength="<%= max %>" type="<%= key.endsWith('_url')?'url':key === 'pages'?'number':'text' %>" <%= ['title','slug'].includes(key)?'required':'' %> value="<%= Array.isArray(item[key])?item[key].join(', '):item[key] || '' %>"></label><% }) %>
<% if(kind === 'books'){ %><label>Purchase Type<select name="purchase_type"><% [['external','External Amazon'],['direct','Direct Paid Access'],['free','Free']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= (item.purchase_type || 'external')===value?'selected':'' %>><%= label %></option><% }) %></select></label><label>Price override (INR; blank = default)<input type="number" min="0" max="1000000" step="0.01" name="price" value="<%= item.price ?? '' %>"></label><p>E-book URL is private and appears only after confirmed access.</p><% } %>
<% if(kind === 'articles'){ %><label>Category<select name="category" required><% business.categories.forEach(category => { %><option <%= item.category === category?'selected':'' %>><%= category %></option><% }) %></select></label><% } %>
<% const areas = kind === 'books' ? [['description',30000],['who_should_read',5000]] : [['summary',1000],['content',50000]]; areas.forEach(([key,max]) => { %><label class="studio-wide"><%= key.replaceAll('_',' ') %><textarea rows="<%= key === 'content'?16:5 %>" name="<%= key %>" maxlength="<%= max %>" <%= key === 'content'?'required':'' %>><%= item[key] || '' %></textarea></label><% }) %>
<label><span><input style="width:auto" type="checkbox" name="<%= kind === 'books'?'active':'published' %>" <%= (kind === 'books'?item.active:item.published)?'checked':'' %>> <%= kind === 'books'?'Active (visible to customers)':'Published (visible to customers)' %></span></label><div class="studio-wide studio-actions"><button type="submit" class="fashion-button">Save</button><a href="/admin/<%= kind %>">Back</a></div></form><% } %></main></body></html>
