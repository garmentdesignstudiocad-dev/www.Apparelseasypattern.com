<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <%- include('../partials/admin_header') %>
  <main class="container section">
    <h1>Delivery Zones and Dispatch Hubs</h1>
    <p>Customer checkout routing is fixed by delivery state: the listed South Indian states route to Bengaluru Hub, the listed Northern states route to Mumbai Hub, and other regions proceed with Pending Manual Assignment. The legacy zone and partner settings below are retained for admin reference; they do not control checkout eligibility, hub assignment, courier availability or order pricing. Manage manual courier records in <a href="/admin/settings/couriers">Delivery Partners</a>.</p>

    <% if(unassignedStates.length){ %>
      <section class="card card-body" role="status">
        <h2>States not mapped in these legacy settings</h2>
        <p>These regions are not blocked at checkout. If a state is outside the fixed routing lists, its order is accepted with hub assignment pending manual review.</p>
        <ul><% unassignedStates.forEach(state=>{ %><li><%= state %> &mdash; not mapped in legacy settings</li><% }) %></ul>
      </section>
    <% } %>

    <% regions.forEach(zone=>{ %>
      <form method="post" action="/admin/settings/delivery" class="card card-body">
        <input type="hidden" name="_csrf" value="<%= learningCsrf %>">
        <input type="hidden" name="region_id" value="<%= zone._id %>">
        <h2><%= zone.name %> &mdash; <%= zone.dispatch_location %></h2>
        <label>Legacy reference dispatch hub<input name="dispatch_location" value="<%= zone.dispatch_location %>" required></label>
        <label>States in legacy settings (one per line or comma separated)<textarea name="states"><%= (zone.states || []).join('\n') %></textarea></label>
        <fieldset>
          <legend>Legacy admin partner references</legend>
          <% partners.forEach(partner=>{ %>
            <label><input type="checkbox" name="partner_ids" value="<%= partner._id %>" <%= (zone.partner_ids || []).includes(partner._id)?'checked':'' %>><%= partner.name %><%= partner.active?'':' (disabled)' %></label>
          <% }) %>
        </fieldset>
        <label><input type="checkbox" name="active" <%= zone.active?'checked':'' %>> Active in legacy settings</label>
        <button>Save Reference Settings</button>
      </form>
    <% }) %>
  </main>
</body>
</html>
