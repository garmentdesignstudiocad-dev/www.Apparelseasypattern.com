<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/customer-experience.css"><script src="https://checkout.razorpay.com/v1/checkout.js"></script><%- include('../partials/theme') %></head><body><%- include('../partials/header') %><main class="fashion-page class-detail"><div class="class-detail__hero"><div class="class-detail__media"><% if(session.banner_image){ %><img src="<%= session.banner_image %>" alt=""><% }else{ %><span>POSTER TO BE PROVIDED</span><% } %></div><div><span class="eyebrow"><%= session.type %></span><h1 class="page-title"><%= session.title %></h1><p class="page-intro"><%= session.short_description %></p><dl class="class-facts"><div><dt>Date</dt><dd><%= new Date(session.starts_at).toLocaleDateString('en-IN',{dateStyle:'long',timeZone:'Asia/Kolkata'}) %></dd></div><div><dt>Time</dt><dd><%= new Date(session.starts_at).toLocaleTimeString('en-IN',{hour:'numeric',minute:'2-digit',timeZone:'Asia/Kolkata'}) %> IST</dd></div><div><dt>Duration</dt><dd><%= session.duration %></dd></div><div><dt>Fee</dt><dd>₹<%= Number(session.price).toLocaleString('en-IN') %></dd></div><% if(session.instructor_name){ %><div><dt>Instructor</dt><dd><%= session.instructor_name %></dd></div><% } %></dl></div></div><div class="class-detail__body"><article><h2>About this course</h2><p><%= session.description %></p><% if(session.participant_receives){ %><h2>What participants receive</h2><p><%= session.participant_receives %></p><% } %><% if(session.promotional_title && (!session.promotional_url || canVisit(session.promotional_url))){ %><h2><%= session.promotional_title %></h2><p><%= session.promotional_text %></p><% } %><% if(session.promotional_url && canVisit(session.promotional_url)){ %><a href="<%= session.promotional_url %>" rel="nofollow noopener">Promotional information</a><% } %><% if(session.linkedin_post_url){ %><a href="<%= session.linkedin_post_url %>" rel="nofollow noopener">LinkedIn post</a><% } %></article><aside class="form-surface"><h2>Enroll Now</h2><% if(session.registration_open&&available){ %><form id="class-registration"><label>Name</label><input name="name" required><label>Email</label><input name="email" type="email" required><label>Phone</label><input name="phone" required><button class="fashion-button" type="submit">Continue to Payment</button><p id="registration-message"></p></form><% }else{ %><p>Enrollment is closed or full.</p><% } %></aside></div><%- include('../partials/support-contact') %></main><%- include('../partials/footer') %><script src="/js/main.js"></script><script>const f=document.getElementById('class-registration');if(f)f.addEventListener('submit',async e=>{e.preventDefault();const m=document.getElementById('registration-message'),r=await fetch(location.pathname+'/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(f)))}),d=await r.json();if(!r.ok){m.textContent=d.error;return}new Razorpay({key:d.key,amount:d.amount,currency:d.currency,name:'Garment Pattern Store',order_id:d.razorpay_order_id,prefill:d.customer,handler:async x=>{const v=await fetch('/classes/registration/'+d.registration_id+'/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(x)}),a=await v.json();v.ok?location.href=a.redirect:m.textContent=a.error}}).open()});</script></body></html>
