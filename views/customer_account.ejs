<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %> — <%= siteSettings?.store_name || 'Apparel Easy Patterns' %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/customer-experience.css">
  <link rel="stylesheet" href="/css/storefront-theme.css">
  <%- include('partials/theme') %>

  <style>
    :root {
      --navy-900: #0B192C;
      --navy-800: #132742;
      --gold-600: #B45309;
      --gold-500: #D97706;
      --gold-400: #F59E0B;
      --gold-50: #FFFBEB;
      --slate-900: #0F172A;
      --slate-700: #334155;
      --slate-600: #475569;
      --slate-500: #64748B;
      --slate-300: #CBD5E1;
      --slate-200: #E2E8F0;
      --slate-100: #F1F5F9;
      --slate-50: #F8FAFC;
      --white: #FFFFFF;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --shadow-sm: 0 1px 3px rgba(11, 25, 44, 0.06);
      --shadow-md: 0 4px 16px -2px rgba(11, 25, 44, 0.08);
    }

    body {
      margin: 0;
      background: var(--slate-50);
      color: var(--slate-900);
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .account-page {
      max-width: 1280px;
      margin: 0 auto;
      padding: 36px 24px 80px;
    }

    /* Top Profile Overview Banner */
    .account-banner {
      background: var(--white);
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-lg);
      padding: 28px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 36px;
      box-shadow: var(--shadow-sm);
    }

    .account-user-meta {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .account-avatar {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: var(--navy-900);
      color: var(--gold-400);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Playfair Display', serif;
      font-size: 22px;
      font-weight: 700;
      border: 2px solid var(--gold-500);
      box-shadow: 0 4px 12px rgba(11, 25, 44, 0.15);
      flex-shrink: 0;
    }

    .account-info h1 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 24px;
      font-weight: 700;
      color: var(--navy-900);
      margin: 0 0 4px;
    }

    .account-contact-row {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      font-size: 13px;
      color: var(--slate-600);
    }

    .account-contact-row span {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .btn-signout {
      padding: 10px 18px;
      background: transparent;
      border: 1px solid var(--slate-300);
      border-radius: var(--radius-sm);
      color: var(--slate-700);
      font-size: 12.5px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .btn-signout:hover {
      background: #FEE2E2;
      border-color: #F87171;
      color: #991B1B;
    }

    /* Orders Section */
    .account-section-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .account-section-header h2 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 22px;
      font-weight: 700;
      color: var(--navy-900);
      margin: 0;
    }

    .orders-count {
      font-size: 13px;
      color: var(--slate-500);
      font-weight: 600;
    }

    .orders-list {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .order-card {
      background: var(--white);
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      transition: all 0.2s ease;
    }

    .order-card:hover {
      box-shadow: var(--shadow-md);
      border-color: var(--slate-300);
    }

    .order-card-header {
      background: var(--slate-100);
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      border-bottom: 1px solid var(--slate-200);
    }

    .order-id-meta strong {
      font-size: 14px;
      font-weight: 800;
      color: var(--navy-900);
      display: block;
    }

    .order-id-meta span {
      font-size: 12px;
      color: var(--slate-500);
    }

    .order-badges-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .order-badge {
      display: inline-flex;
      align-items: center;
      padding: 4px 10px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .order-badge.paid {
      background: #ECFDF5;
      color: #065F46;
      border: 1px solid #A7F3D0;
    }

    .order-badge.pending {
      background: #FFFBEB;
      color: #92400E;
      border: 1px solid #FDE68A;
    }

    .order-badge.fulfilment {
      background: var(--navy-900);
      color: var(--white);
    }

    .order-card-body {
      padding: 24px;
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr);
      gap: 28px;
    }

    .order-items-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .order-item-row {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--slate-100);
    }

    .order-item-row:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }

    .order-item-title {
      font-weight: 700;
      font-size: 14.5px;
      color: var(--navy-900);
    }

    .order-item-spec {
      font-size: 12px;
      color: var(--slate-500);
    }

    .order-summary-box {
      background: var(--slate-50);
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-sm);
      padding: 16px 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .order-amount-paid {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
      color: var(--slate-700);
    }

    .order-amount-paid strong {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 18px;
      color: var(--navy-900);
    }

    .order-courier-box {
      font-size: 12px;
      color: var(--slate-600);
      line-height: 1.5;
      padding-top: 10px;
      border-top: 1px solid var(--slate-200);
    }

    .btn-download-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-top: 6px;
      padding: 12px 18px;
      background: var(--gold-500);
      color: var(--white);
      border-radius: var(--radius-sm);
      text-decoration: none;
      font-size: 12.5px;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      transition: all 0.2s ease;
      box-shadow: 0 4px 12px rgba(217, 119, 6, 0.25);
    }

    .btn-download-action:hover {
      background: var(--gold-600);
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(217, 119, 6, 0.35);
    }

    .empty-orders-card {
      background: var(--white);
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-md);
      padding: 56px 24px;
      text-align: center;
      color: var(--slate-500);
    }

    .empty-orders-card h3 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 22px;
      color: var(--navy-900);
      margin: 0 0 8px;
    }

    @media (max-width: 800px) {
      .order-card-body { grid-template-columns: 1fr; gap: 20px; }
      .account-banner { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>

<body>
  <%- include('partials/header') %>

  <main class="account-page">
    <!-- User Overview Banner -->
    <section class="account-banner">
      <div class="account-user-meta">
        <div class="account-avatar">
          <%= (customer.name || 'C').charAt(0).toUpperCase() %>
        </div>
        <div class="account-info">
          <h1><%= customer.name %></h1>
          <div class="account-contact-row">
            <span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <%= customer.email %>
            </span>
            <span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <%= customer.phone %>
            </span>
          </div>
        </div>
      </div>

      <form method="post" action="/account/logout">
        <input type="hidden" name="_csrf" value="<%= customerCsrf %>">
        <button type="submit" class="btn-signout">Sign Out</button>
      </form>
    </section>

    <!-- Orders Section -->
    <section>
      <div class="account-section-header">
        <h2>My Pattern Orders</h2>
        <span class="orders-count"><%= orders.length %> <%= orders.length === 1 ? 'Order' : 'Orders' %></span>
      </div>

      <% if (!orders.length) { %>
        <div class="empty-orders-card">
          <h3>No orders linked to this account yet</h3>
          <p>When you purchase digital CAD blocks or physical paper patterns, they will appear here with instant secure download links.</p>
          <a href="/products" class="fashion-button" style="display:inline-block;margin-top:14px;text-decoration:none;">Explore Available Patterns</a>
        </div>
      <% } else { %>
        <div class="orders-list">
          <% orders.forEach(function (order) { %>
            <div class="order-card">
              <div class="order-card-header">
                <div class="order-id-meta">
                  <strong>Order <%= order._id %></strong>
                  <span>Placed on <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                </div>

                <div class="order-badges-wrap">
                  <span class="order-badge <%= order.payment_status === 'paid' ? 'paid' : 'pending' %>">
                    <%= order.payment_status %>
                  </span>
                  <span class="order-badge fulfilment">
                    <%= order.shipping_status || order.order_status %>
                  </span>
                </div>
              </div>

              <div class="order-card-body">
                <ul class="order-items-list">
                  <% order.items.forEach(function (item) { %>
                    <li class="order-item-row">
                      <span class="order-item-title"><%= item.product_name || 'Apparel Pattern' %></span>
                      <span class="order-item-spec">
                        Digital Soft Copy: <%= item.quantity || 0 %> |
                        Printed Hard Copy: <%= item.physical_quantity || 0 %> |
                        Trial Sample: <%= item.trial_quantity || 0 %>
                      </span>
                    </li>
                  <% }); %>
                </ul>

                <div class="order-summary-box">
                  <div class="order-amount-paid">
                    <span>Amount Paid</span>
                    <strong>INR <%= (order.payment_status === 'paid' && order.payment_verified_at ? order.grand_total : 0).toFixed(2) %></strong>
                  </div>

                  <% if (order.items.some(function(item) { return item.physical_quantity > 0 || item.trial_quantity > 0; })) { %>
                    <div class="order-courier-box">
                      <div><strong>Delivery address:</strong> <%= [order.shipping_address, order.shipping_city, order.shipping_state, order.delivery_pincode].filter(Boolean).join(', ') %></div>
                      <div><strong>Dispatch Hub:</strong> <%= order.dispatch_location || 'Pending Manual Assignment' %></div>
                      <% if (order.delivery_flow_version === 3) { %>
                        <div><strong>Courier charges:</strong> Pay separately, directly to the courier service</div>
                        <div><strong>Shipping payment status:</strong> <%= order.shipping_payment_status === 'not_collected' ? 'Not collected' : order.shipping_payment_status || 'Not applicable' %></div>
                        <div><strong>Courier booking status:</strong> <%= order.courier_booking_status === 'not_booked' ? 'Not booked' : order.courier_booking_status || 'Not required' %></div>
                      <% } else { %>
                        <div><strong>Courier:</strong> <%= order.courier_name || 'Not recorded' %></div>
                      <% } %>
                      <div><strong>Tracking / AWB:</strong> <%= order.tracking_number || 'Not assigned' %></div>
                    </div>
                  <% } %>

                  <% if (order.payment_status === 'paid' && order.payment_verified_at && order.order_status !== 'cancelled' && order.download_expires_at > new Date()) { %>
                    <a href="/account/orders/<%= order._id %>/download" class="btn-download-action">
                      Secure Downloads &rarr;
                    </a>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
