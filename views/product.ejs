            </div>
          </div>
        <% } %>
        <% if (product.size_chart_image || product.size_chart_url) { %>
          <div style="text-align:center;margin-bottom:16px;">
            <img src="<%= product.size_chart_image || product.size_chart_url %>" alt="Size Guide for <%= product.name %>" style="max-width:100%;border-radius:8px;border:1px solid #CBD5E1;">
          </div>
        <% } %>
        <p style="font-size:13.5px;color:#475569;margin:0 0 16px;">
          Select a size below to apply it directly to your order. All blocks include standard industrial seam allowances.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:20px;">
          <% configuredSizes.forEach(size => { %>
            <button type="button" class="ref-size-pill size-guide-select-chip" data-size="<%= size %>">
              <%= size %>
            </button>
          <% }) %>
        </div>
        <% if (product.size_information) { %>
          <div style="background:#F8FAFC;border:1px solid #E2E8F0;border-radius:8px;padding:14px;font-size:13px;line-height:1.6;color:#334155;white-space:pre-line;">
            <%= product.size_information %>
          </div>
        <% } %>
        <p style="font-size:12px;color:#64748B;margin:14px 0 0;">
          Need custom POM grading? <a href="/classes/enquiry" style="color:#D97706;font-weight:700;">Request Custom Block specifications &rarr;</a>
        </p>
      </div>
    </div>
    <% } %>

    <!-- Fullscreen Image Zoom Lightbox Modal -->
    <div id="imageLightboxModal" class="pd-modal" role="dialog" aria-modal="true" aria-label="Garment image preview">
      <div class="pd-modal-content">
        <button type="button" class="pd-modal-close" id="closeLightboxBtn" aria-label="Close preview">&times;</button>
        <img id="lightboxImg" class="pd-modal-img" src="" alt="Garment enlarged preview">
      </div>
    </div>

    <!-- Sticky Buy Bar -->
    <aside id="sticky-buy-bar" class="sticky-buy-bar" aria-label="Sticky Purchase Bar">
      <div class="sticky-info">
        <% if(mainImageSrc){ %><img src="<%= mainImageSrc %>" alt="" class="sticky-thumb" id="stickyThumb"><% } %>
        <div>
          <h4 class="sticky-title"><%= product.name %></h4>
          <span class="sticky-badges" id="stickySizeBadge">Size: <%= initialSelectedSize %></span>
        </div>
      </div>
      <div class="sticky-actions">
        <span class="sticky-price" id="stickyTotal">&#8377;<%= (basePrice + Math.round(basePrice * (gstRate / 100))).toLocaleString('en-IN') %></span>
        <button type="button" id="stickyAddToCart" class="ref-btn-cart" style="height:40px;padding:0 16px;font-size:13px;">Add to Cart</button>
        <button type="button" id="stickyBuyNow" class="ref-btn-buy" style="height:40px;padding:0 20px;font-size:13px;">Place Order &rarr;</button>
      </div>
    </aside>

    <!-- Configuration payload for client-side scripts -->
    <script id="pattern-config" type="application/ld+json"><%- JSON.stringify({
      id: String(product._id),
      base: basePrice,
      extra: Number(product.additional_size_price || 0),
      physical: physicalPrice,
      trial: Number(product.trial_price || 0),
      formatPricing: fp,
      bundlePrice: bundlePrice,
      isBundleActive: isBundleActive,
      priceDxf: priceDxf,
      priceHpgl: priceHpgl,
      pricePlt: pricePlt,
      pricePdf: pricePdf,
      techPackPrice: techPackPrice,
      sizePrices: product.size_prices || []
    }).replace(/</g, '\\u003c') %></script>
  </main>

  <%- include('partials/footer') %>

  <!-- Interactive Client-side Logic -->
  <script>
  (() => {
    // 1. Gallery Thumbnail Switching
    const mainImg = document.getElementById('mainProductImage');
    const thumbs = document.querySelectorAll('.ref-thumb-btn');

    thumbs.forEach(btn => {
      btn.addEventListener('click', () => {
        const newSrc = btn.dataset.src;
        if (!newSrc || !mainImg) return;
        mainImg.style.opacity = '0.35';
        thumbs.forEach(t => t.classList.remove('active'));
        btn.classList.add('active');
        const pre = new Image();
        pre.onload = () => {
          mainImg.src = newSrc;
          mainImg.style.opacity = '1';
        };
        pre.src = newSrc;
      });
    });

    // 2. Image Zoom Lightbox
    const modal = document.getElementById('imageLightboxModal');
    const lightboxImg = document.getElementById('lightboxImg');
    const zoomBtn = document.getElementById('zoomTriggerBtn');
    const closeBtn = document.getElementById('closeLightboxBtn');

    function openModal() {
      if (!modal || !lightboxImg || !mainImg) return;
      lightboxImg.src = mainImg.src;
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      if (!modal) return;
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
    }
    zoomBtn?.addEventListener('click', openModal);
    mainImg?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

    // 3. Size Guide Modal
    const btnSizeGuide = document.getElementById('btn-size-guide');
    const sizeGuideModal = document.getElementById('size-guide-modal');
    const sizeGuideBackdrop = document.getElementById('size-guide-backdrop');
    const sizeGuideClose = document.getElementById('size-guide-close');

    function openSizeGuide() {
      sizeGuideModal?.classList.add('is-visible');
      sizeGuideBackdrop?.classList.add('is-visible');
    }
    function closeSizeGuide() {
      sizeGuideModal?.classList.remove('is-visible');
      sizeGuideBackdrop?.classList.remove('is-visible');
    }
    btnSizeGuide?.addEventListener('click', openSizeGuide);
    sizeGuideClose?.addEventListener('click', closeSizeGuide);
    sizeGuideBackdrop?.addEventListener('click', closeSizeGuide);

    // Synchronize size chip from guide into main form
    document.querySelectorAll('.size-guide-select-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        const sz = btn.dataset.size;
        selectSize(sz);
        closeSizeGuide();
      });
    });

    // 4. STEP 1 — Soft Copy Sizes Selection (Multi-size checkboxes)
    const softPills = document.querySelectorAll('.ref-size-pill[data-soft-size]');
    const btnSelectAllSoft = document.getElementById('btnSelectAllSoftSizes');
    const btnClearSoft = document.getElementById('btnClearSoftSizes');
    const softSizeCountLabel = document.getElementById('softSizeCountLabel');
    const stickySizeBadge = document.getElementById('stickySizeBadge');

    function getSelectedSoftSizes() {
      const selected = [];
      softPills.forEach(pill => {
        const input = pill.querySelector('input.soft-size-check');
        if (input && input.checked) selected.push(pill.dataset.softSize);
      });
      return selected;
    }

    function updateSoftSizePillStates() {
      const selected = getSelectedSoftSizes();
      softPills.forEach(pill => {
        const input = pill.querySelector('input.soft-size-check');
        if (input && input.checked) {
          pill.classList.add('selected');
        } else {
          pill.classList.remove('selected');
        }
      });
      if (softSizeCountLabel) {
        softSizeCountLabel.textContent = '(' + selected.length + ' size' + (selected.length === 1 ? '' : 's') + ' selected)';
      }
      if (stickySizeBadge) {
        stickySizeBadge.textContent = 'Size: ' + (selected.length > 0 ? selected.join(', ') : 'None');
      }
      recalculateTotals();
    }

    softPills.forEach(pill => {
      pill.addEventListener('click', (e) => {
        e.preventDefault();
        const input = pill.querySelector('input.soft-size-check');
        if (input?.disabled) return;
        if (input) input.checked = !input.checked;
        updateSoftSizePillStates();
      });
    });

    btnSelectAllSoft?.addEventListener('click', () => {
      softPills.forEach(pill => {
        const input = pill.querySelector('input.soft-size-check');
        if (input) input.checked = true;
      });
      updateSoftSizePillStates();
    });

    btnClearSoft?.addEventListener('click', () => {
      softPills.forEach(pill => {
        const input = pill.querySelector('input.soft-size-check');
        if (input) input.checked = false;
      });
      updateSoftSizePillStates();
    });

    // 5. STEP 1 — Choose Digital File Formats
    const formatConfigs = [
      { card: 'formatCardDxf', input: 'formatInputDxf', cb: 'formatCbDxf' },
      { card: 'formatCardHpgl', input: 'formatInputHpgl', cb: 'formatCbHpgl' },
      { card: 'formatCardPlt', input: 'formatInputPlt', cb: 'formatCbPlt' },
      { card: 'formatCardPdf', input: 'formatInputPdf', cb: 'formatCbPdf' }
    ];

    // Default select DXF, HPGL, PLT if present
    ['formatCardDxf', 'formatCardHpgl', 'formatCardPlt'].forEach(id => {
      const el = document.getElementById(id);
      const inp = el ? el.querySelector('input') : null;
      const mark = el ? el.querySelector('.format-checkbox-custom span') : null;
      if (inp) inp.checked = true;
      if (el) el.classList.add('checked');
      if (mark) mark.style.display = 'inline';
    });

    formatConfigs.forEach(item => {
      const cardEl = document.getElementById(item.card);
      const inputEl = document.getElementById(item.input);
      const cbEl = document.getElementById(item.cb);
      cardEl?.addEventListener('click', (e) => {
        e.preventDefault();
        if (!inputEl) return;
        inputEl.checked = !inputEl.checked;
        const mark = cbEl?.querySelector('span');
        if (inputEl.checked) {
          cardEl.classList.add('checked');
          if (mark) mark.style.display = 'inline';
        } else {
          cardEl.classList.remove('checked');
          if (mark) mark.style.display = 'none';
        }
        syncDigitalSizeAvailability();
      });
    });

    function getSelectedDigitalFormats() {
      return formatConfigs
        .map(item => document.getElementById(item.input))
        .filter(inp => inp && inp.checked)
        .map(inp => inp.value);
    }

    function syncDigitalSizeAvailability() {
      const enabled = getSelectedDigitalFormats().length > 0;
      const selection = document.getElementById('digitalSizeSelection');
      if (selection) {
        selection.classList.toggle('is-disabled', !enabled);
        selection.setAttribute('aria-disabled', String(!enabled));
      }
      softPills.forEach(pill => {
        const input = pill.querySelector('input.soft-size-check');
        if (input) {
          input.disabled = !enabled;
          if (!enabled) input.checked = false;
        }
      });
      if (btnSelectAllSoft) btnSelectAllSoft.disabled = !enabled;
      if (btnClearSoft) btnClearSoft.disabled = !enabled;
      updateSoftSizePillStates();
    }

    // 6. STEP 2 — Tech Pack (Separate Optional Card)
    const techPackCard = document.getElementById('techPackCard');
    const techPackInput = document.getElementById('techPackInput');
    const techPackCheckMark = document.getElementById('techPackCheckMark');
    const sumTechPackRow = document.getElementById('sumTechPackRow');
    const sumTechPackPrice = document.getElementById('sumTechPackPrice');

    techPackCard?.addEventListener('click', (e) => {
      e.preventDefault();
      if (techPackInput?.disabled) return;
      techPackInput.checked = !techPackInput.checked;
      const mark = techPackCheckMark?.querySelector('span');
      if (techPackInput.checked) {
        techPackCard.classList.add('checked');
        if (mark) mark.style.display = 'inline';
        if (sumTechPackRow) sumTechPackRow.style.display = 'flex';
        const price = Number(techPackInput.dataset.price || 0);
        if (sumTechPackPrice) sumTechPackPrice.textContent = '₹' + price.toLocaleString('en-IN');
      } else {
        techPackCard.classList.remove('checked');
        if (mark) mark.style.display = 'none';
        if (sumTechPackRow) sumTechPackRow.style.display = 'none';
      }
      recalculateTotals();
    });

    // 7. STEP 3 — Physical Printout & Independent Physical Sizes
    const physicalCard = document.getElementById('physicalPrintoutCard');
    const physicalInput = document.getElementById('physical-option');
    const physicalCheckMark = document.getElementById('physicalPrintoutCheckMark');
    const physicalSizesContainer = document.getElementById('physicalSizesContainer');
    const physPills = document.querySelectorAll('.ref-size-pill[data-phys-size]');
    const btnSelectAllPhys = document.getElementById('btnSelectAllPhysSizes');
    const btnClearPhys = document.getElementById('btnClearPhysSizes');
    const physSizeCountLabel = document.getElementById('physSizeCountLabel');
    const sumPhysicalRow = document.getElementById('sumPhysicalRow');
    const sumPhysicalLabel = document.getElementById('sumPhysicalLabel');
    const sumPhysicalPrice = document.getElementById('sumPhysicalPrice');

    function getSelectedPhysSizes() {
      const selected = [];
      physPills.forEach(pill => {
        const input = pill.querySelector('input.phys-size-check');
        if (input && input.checked) selected.push(pill.dataset.physSize);
      });
      return selected;
    }

    function updatePhysSizePillStates() {
      const selected = getSelectedPhysSizes();
      physPills.forEach(pill => {
        const input = pill.querySelector('input.phys-size-check');
        if (input && input.checked) {
          pill.classList.add('selected');
        } else {
          pill.classList.remove('selected');
        }
      });
      if (physSizeCountLabel) {
        physSizeCountLabel.textContent = '(' + selected.length + ' size' + (selected.length === 1 ? '' : 's') + ' selected)';
      }
      recalculateTotals();
    }

    physicalCard?.addEventListener('click', (e) => {
      e.preventDefault();
      if (physicalInput?.disabled) return;
      physicalInput.checked = !physicalInput.checked;
      const mark = physicalCheckMark?.querySelector('span');
      if (physicalInput.checked) {
        physicalCard.classList.add('checked');
        if (mark) mark.style.display = 'inline';
        if (physicalSizesContainer) {
          physicalSizesContainer.style.opacity = '1';
          physicalSizesContainer.style.pointerEvents = 'auto';
        }
        // If no physical sizes are selected yet, auto-select the chosen soft sizes or first size
        const currentPhys = getSelectedPhysSizes();
        if (currentPhys.length === 0) {
          const softSizes = getSelectedSoftSizes();
          const targetSizes = softSizes.length > 0 ? softSizes : [physPills[0]?.dataset.physSize].filter(Boolean);
          physPills.forEach(pill => {
            const input = pill.querySelector('input.phys-size-check');
            if (input && targetSizes.includes(pill.dataset.physSize)) input.checked = true;
          });
          updatePhysSizePillStates();
        }
      } else {
        physicalCard.classList.remove('checked');
        if (mark) mark.style.display = 'none';
        if (physicalSizesContainer) {
          physicalSizesContainer.style.opacity = '0.45';
          physicalSizesContainer.style.pointerEvents = 'none';
        }
      }
      recalculateTotals();
    });

    physPills.forEach(pill => {
      pill.addEventListener('click', (e) => {
        e.preventDefault();
        const input = pill.querySelector('input.phys-size-check');
        if (input) input.checked = !input.checked;
        updatePhysSizePillStates();
      });
    });

    btnSelectAllPhys?.addEventListener('click', () => {
      physPills.forEach(pill => {
        const input = pill.querySelector('input.phys-size-check');
        if (input) input.checked = true;
      });
      updatePhysSizePillStates();
    });

    btnClearPhys?.addEventListener('click', () => {
      physPills.forEach(pill => {
        const input = pill.querySelector('input.phys-size-check');
        if (input) input.checked = false;
      });
      updatePhysSizePillStates();
    });

    // 7b. STEP 6 — Customize Markers Tabs & Numeric Validation
    const tabBtnStripes = document.getElementById('tabBtnStripes');
    const tabBtnChecks = document.getElementById('tabBtnChecks');
    const panelStripes = document.getElementById('panelStripes');
    const panelChecks = document.getElementById('panelChecks');

    tabBtnStripes?.addEventListener('click', () => {
      tabBtnStripes.classList.add('active');
      tabBtnStripes.setAttribute('aria-selected', 'true');
      tabBtnChecks?.classList.remove('active');
      tabBtnChecks?.setAttribute('aria-selected', 'false');
      panelStripes?.classList.add('active');
      panelChecks?.classList.remove('active');
    });

    tabBtnChecks?.addEventListener('click', () => {
      tabBtnChecks.classList.add('active');
      tabBtnChecks.setAttribute('aria-selected', 'true');
      tabBtnStripes?.classList.remove('active');
      tabBtnStripes?.setAttribute('aria-selected', 'false');
      panelChecks?.classList.add('active');
      panelStripes?.classList.remove('active');
    });

    function validateMarkerNumber(input, errEl, minVal) {
      if (!input) return true;
      const val = input.value.trim();
      if (!val) {
        input.classList.remove('input-invalid');
        if (errEl) errEl.style.display = 'none';
        return true;
      }
      const num = Number(val);
      if (!Number.isFinite(num) || num <= 0 || (minVal && num < minVal)) {
        input.classList.add('input-invalid');
        if (errEl) {
          errEl.textContent = 'Enter a valid positive number in cm';
          errEl.style.display = 'block';
        }
        return false;
      }
      input.classList.remove('input-invalid');
      if (errEl) errEl.style.display = 'none';
      return true;
    }

    const inpStripesRep = document.getElementById('inputStripesRepeat');
    const errStripesRep = document.getElementById('errStripesRepeat');
    const inpStripesCut = document.getElementById('inputStripesCuttable');
    const errStripesCut = document.getElementById('errStripesCuttable');

    const inpChecksWarp = document.getElementById('inputChecksWarp');
    const errChecksWarp = document.getElementById('errChecksWarp');
    const inpChecksWeft = document.getElementById('inputChecksWeft');
    const errChecksWeft = document.getElementById('errChecksWeft');
    const inpChecksCut = document.getElementById('inputChecksCuttable');
    const errChecksCut = document.getElementById('errChecksCuttable');

    [
      { inp: inpStripesRep, err: errStripesRep, min: 0.1 },
      { inp: inpStripesCut, err: errStripesCut, min: 1 },
      { inp: inpChecksWarp, err: errChecksWarp, min: 0.1 },
      { inp: inpChecksWeft, err: errChecksWeft, min: 0.1 },
      { inp: inpChecksCut, err: errChecksCut, min: 1 }
    ].forEach(({ inp, err, min }) => {
      if (!inp) return;
      inp.addEventListener('input', () => {
        validateMarkerNumber(inp, err, min);
        updateMarkerSummary();
      });
      inp.addEventListener('blur', () => {
        validateMarkerNumber(inp, err, min);
        updateMarkerSummary();
      });
    });

    function updateMarkerSummary() {
      const sumMarker = document.getElementById('sumMarkerStatus');
      if (!sumMarker) return;
      const sRep = inpStripesRep?.value.trim();
      const sCut = inpStripesCut?.value.trim();
      const cWarp = inpChecksWarp?.value.trim();
      const cWeft = inpChecksWeft?.value.trim();
      const cCut = inpChecksCut?.value.trim();

      if (sRep && sCut && Number(sRep) > 0 && Number(sCut) > 0) {
        sumMarker.textContent = `Stripes custom repeat: ${sRep}cm (${sCut}cm width) — Enquiry request`;
      } else if (cWarp && cWeft && cCut && Number(cWarp) > 0 && Number(cWeft) > 0 && Number(cCut) > 0) {
        sumMarker.textContent = `Checks custom repeat: ${cWarp}×${cWeft}cm (${cCut}cm width) — Enquiry request`;
      } else {
        sumMarker.textContent = 'Solid mini marker included';
      }
    }

    // 8. Dynamic Subtotal, Tax (18% GST), and Total Calculation
    const basePrice = <%= basePrice %>;
    const physicalPrice = <%= physicalPrice %>;
    const gstRate = <%= gstRate %>;
    const sumSubtotal = document.getElementById('sumSubtotal');
    const sumTaxAmount = document.getElementById('sumTaxAmount');
    const pdTotal = document.getElementById('pdTotal');
    const stickyTotal = document.getElementById('stickyTotal');
    const patternSubtotal = document.getElementById('pattern-subtotal');
    const patternTax = document.getElementById('pattern-tax');

    function recalculateTotals() {
      const config = JSON.parse(document.getElementById('pattern-config').textContent || '{}');
      const selectedFormats = getSelectedDigitalFormats();
      const selectedSoftSizes = getSelectedSoftSizes();
      const hasDigital = selectedFormats.length > 0 && selectedSoftSizes.length > 0;
      const isPhysical = Boolean(physicalInput && physicalInput.checked);
      const selectedPhysSizes = isPhysical ? getSelectedPhysSizes() : [];
      const hasPhysical = isPhysical && selectedPhysSizes.length > 0;
      const hasTechPack = Boolean(techPackInput && techPackInput.checked);

      // 1. Soft Copy Calculation
      let softCopyCost = 0;
      if (hasDigital) {
        const fp = config.formatPricing || {};
        let perSizeRate = 0;
        const isBundle = config.isBundleActive && (selectedFormats.length >= 3 || (selectedFormats.includes('dxf') && selectedFormats.includes('hpgl') && selectedFormats.includes('plt')));
        if (isBundle && config.bundlePrice > 0) {
          perSizeRate = config.bundlePrice;
        } else {
          for (const fmt of selectedFormats) {
            const fmtRate = fp[fmt] || config['price' + fmt.charAt(0).toUpperCase() + fmt.slice(1)] || basePrice;
            perSizeRate += fmtRate;
          }
        }
        softCopyCost = perSizeRate * selectedSoftSizes.length;
      }

      const sumSoftCopyRow = document.getElementById('sumSoftCopyRow');
      const sumSoftCopyLabel = document.getElementById('sumSoftCopyLabel');
      const sumSoftCopyPrice = document.getElementById('sumSoftCopyPrice');
      if (sumSoftCopyRow) {
        if (hasDigital) {
          sumSoftCopyRow.style.display = 'flex';
          if (sumSoftCopyLabel) sumSoftCopyLabel.textContent = 'Soft Copy (' + selectedSoftSizes.length + ' size' + (selectedSoftSizes.length === 1 ? '' : 's') + ' × ' + selectedFormats.length + ' format' + (selectedFormats.length === 1 ? '' : 's') + ')';
          if (sumSoftCopyPrice) sumSoftCopyPrice.textContent = '₹' + softCopyCost.toLocaleString('en-IN');
        } else {
          if (sumSoftCopyLabel) sumSoftCopyLabel.textContent = 'Soft Copy (0 sizes selected)';
          if (sumSoftCopyPrice) sumSoftCopyPrice.textContent = '₹0';
        }
      }

      // 2. Physical Pattern Calculation (Independent of soft copy)
      let physicalCost = 0;
      if (hasPhysical) {
        physicalCost = selectedPhysSizes.reduce((sum, size) => {
          const input = Array.from(document.querySelectorAll('.phys-size-check')).find(candidate => candidate.value === size);
          return sum + Number(input?.dataset.price ?? physicalPrice);
        }, 0);
      }
      if (sumPhysicalRow) {
        if (hasPhysical) {
          sumPhysicalRow.style.display = 'flex';
          if (sumPhysicalLabel) sumPhysicalLabel.textContent = 'Hard Copy (' + selectedPhysSizes.length + ' size' + (selectedPhysSizes.length === 1 ? '' : 's') + ')';
          if (sumPhysicalPrice) sumPhysicalPrice.textContent = '₹' + physicalCost.toLocaleString('en-IN');
        } else {
          sumPhysicalRow.style.display = 'none';
        }
      }

      // 3. Tech Pack Calculation
      let techPackCost = 0;
      if (hasTechPack) {
        techPackCost = Number(techPackInput.dataset.price || config.techPackPrice || 0);
      }

      // Subtotal calculation
      const subtotal = softCopyCost + physicalCost + techPackCost;

      // 18% GST calculation
      const tax = Math.round(subtotal * gstRate) / 100;
      const grandTotal = subtotal + tax;

      if (sumSubtotal) sumSubtotal.textContent = '₹' + subtotal.toLocaleString('en-IN');
      if (sumTaxAmount) sumTaxAmount.textContent = '₹' + tax.toLocaleString('en-IN');
      if (pdTotal) pdTotal.textContent = '₹' + grandTotal.toLocaleString('en-IN');
      if (stickyTotal) stickyTotal.textContent = '₹' + grandTotal.toLocaleString('en-IN');
      if (patternSubtotal) patternSubtotal.textContent = '₹' + subtotal.toLocaleString('en-IN');
      if (patternTax) patternTax.textContent = '₹' + tax.toLocaleString('en-IN');
    }

    syncDigitalSizeAvailability();

    // 9. Sticky Buy Bar Scroll Trigger
    const stickyBar = document.getElementById('sticky-buy-bar');
    const actionsRow = document.querySelector('.ref-actions-row');
    if (stickyBar && actionsRow) {
      window.addEventListener('scroll', () => {
        const rect = actionsRow.getBoundingClientRect();
        if (rect.bottom < 0) {
          stickyBar.classList.add('is-visible');
        } else {
          stickyBar.classList.remove('is-visible');
        }
      }, { passive: true });
    }

    document.getElementById('stickyAddToCart')?.addEventListener('click', () => {
      document.getElementById('pdAddToCart')?.click();
    });
    document.getElementById('stickyBuyNow')?.addEventListener('click', () => {
      document.getElementById('pdBuyNow')?.click();
    });

    // 10. Add to Cart & Place Order Handler
    const form = document.getElementById('pattern-purchase');
    const btnAdd = document.getElementById('pdAddToCart');
    const btnBuy = document.getElementById('pdBuyNow');
    const errBanner = document.getElementById('pattern-error');
    const config = JSON.parse(document.getElementById('pattern-config').textContent);

    async function handlePurchase(destination) {
      if (errBanner) {
        errBanner.style.display = 'none';
        errBanner.textContent = '';
      }

      // Validate custom marker fields if entered
      const sRepVal = inpStripesRep?.value.trim();
      const sCutVal = inpStripesCut?.value.trim();
      if ((sRepVal || sCutVal) && (!validateMarkerNumber(inpStripesRep, errStripesRep, 0.1) || !validateMarkerNumber(inpStripesCut, errStripesCut, 1))) {
        if (errBanner) {
          errBanner.textContent = 'Please enter valid positive centimeter values for custom stripes marker.';
          errBanner.style.display = 'block';
        }
        return;
      }

      const cWarpVal = inpChecksWarp?.value.trim();
      const cWeftVal = inpChecksWeft?.value.trim();
      const cCutVal = inpChecksCut?.value.trim();
      if ((cWarpVal || cWeftVal || cCutVal) && (!validateMarkerNumber(inpChecksWarp, errChecksWarp, 0.1) || !validateMarkerNumber(inpChecksWeft, errChecksWeft, 0.1) || !validateMarkerNumber(inpChecksCut, errChecksCut, 1))) {
        if (errBanner) {
          errBanner.textContent = 'Please enter valid positive centimeter values for custom checks marker.';
          errBanner.style.display = 'block';
        }
        return;
      }

      const selectedFormats = getSelectedDigitalFormats();
      const selectedSoftSizes = getSelectedSoftSizes();
      const hasDigital = selectedFormats.length > 0 && selectedSoftSizes.length > 0;
      const isPhysical = Boolean(physicalInput && physicalInput.checked);
      const selectedPhysSizes = isPhysical ? getSelectedPhysSizes() : [];
      const hasPhysical = isPhysical && selectedPhysSizes.length > 0;
      const hasTechPack = Boolean(techPackInput && techPackInput.checked);

      if (!hasDigital && !hasPhysical && !hasTechPack) {
        if (errBanner) {
          errBanner.textContent = 'Please select at least one format and size, or physical pattern option to proceed.';
          errBanner.style.display = 'block';
        }
        return;
      }

      if (btnAdd) btnAdd.disabled = true;
      if (btnBuy) btnBuy.disabled = true;

      const filesPayload = [];
      if (hasTechPack && techPackInput.value) {
        filesPayload.push(techPackInput.value);
      }

      const payload = {
        product_id: config.id,
        selected_sizes: selectedSoftSizes,
        physical_sizes: selectedPhysSizes,
        printable_selected: hasDigital,
        selected_formats: selectedFormats,
        quantity: hasDigital || hasTechPack ? 1 : 0,
        physical_quantity: selectedPhysSizes.length,
        trial_quantity: 0,
        files: filesPayload,
        addons: []
      };

      try {
        const res = await fetch('/cart/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (!res.ok) {
          throw new Error(result.error || 'Unable to add pattern to order.');
        }
        window.location.href = destination;
      } catch (err) {
        if (errBanner) {
          errBanner.textContent = err.message;
          errBanner.style.display = 'block';
        }
        if (btnAdd) btnAdd.disabled = false;
        if (btnBuy) btnBuy.disabled = false;
      }
    }

    // 11. Custom Marker Enquiry Submission
    const btnSubmitMarker = document.getElementById('btnSubmitMarkerEnquiry');
    const markerStatus = document.getElementById('markerSubmitStatus');
    const leadNameInp = document.getElementById('markerLeadName');
    const leadEmailInp = document.getElementById('markerLeadEmail');
    const leadWhatsappInp = document.getElementById('markerLeadWhatsapp');

    btnSubmitMarker?.addEventListener('click', async () => {
      markerStatus.style.display = 'inline-block';
      markerStatus.style.color = '#B45309';
      markerStatus.textContent = 'Submitting specifications...';

      const activeTabIsStripes = tabBtnStripes && tabBtnStripes.classList.contains('active');
      let specDetails = '';

      if (activeTabIsStripes) {
        const repVal = inpStripesRep?.value.trim();
        const cutVal = inpStripesCut?.value.trim();
        if (!validateMarkerNumber(inpStripesRep, errStripesRep, 0.1) || !validateMarkerNumber(inpStripesCut, errStripesCut, 1)) {
          markerStatus.style.color = '#DC2626';
          markerStatus.textContent = 'Please enter valid positive cm numbers for stripes repeat and cuttable width.';
          return;
        }
        specDetails = `Stripes Marker: Repeat Width = ${repVal} cm, Fabric Cuttable Width = ${cutVal} cm`;
      } else {
        const warpVal = inpChecksWarp?.value.trim();
        const weftVal = inpChecksWeft?.value.trim();
        const cutVal = inpChecksCut?.value.trim();
        if (!validateMarkerNumber(inpChecksWarp, errChecksWarp, 0.1) || !validateMarkerNumber(inpChecksWeft, errChecksWeft, 0.1) || !validateMarkerNumber(inpChecksCut, errChecksCut, 1)) {
          markerStatus.style.color = '#DC2626';
          markerStatus.textContent = 'Please enter valid positive cm numbers for checks warp, weft, and cuttable width.';
          return;
        }
        specDetails = `Checks Marker: Warp Repeat = ${warpVal} cm, Weft Repeat = ${weftVal} cm, Fabric Cuttable Width = ${cutVal} cm`;
      }

      const name = leadNameInp?.value.trim();
      const email = leadEmailInp?.value.trim();
      const whatsapp = leadWhatsappInp?.value.trim();

      if (!name || !email || !whatsapp) {
        markerStatus.style.color = '#DC2626';
        markerStatus.textContent = 'Please fill in Name, Email and WhatsApp number.';
        return;
      }

      btnSubmitMarker.disabled = true;

      try {
        const csrfToken = "<%= typeof csrf !== 'undefined' ? csrf : '' %>";
        const messageBody = `Product: <%= product.name %> (Selected Size: ${currentSelectedSize})\n${specDetails}\nRequested via Customer Product Details Page.`;

        const res = await fetch('/enquiries', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: new URLSearchParams({
            _csrf: csrfToken,
            name: name,
            email: email,
            whatsapp: whatsapp,
            interest: 'Fit Blocks',
            source: `/products/<%= product.slug %>#custom-marker`,
            message: messageBody
          })
        });

        const result = await res.json();
        if (!res.ok || !result.success) {
          throw new Error(result.error || 'Failed to submit specifications. Please try again.');
        }

        markerStatus.style.color = '#16A34A';
        markerStatus.innerHTML = '&#10003; ' + (result.message || 'Custom marker specifications saved to studio enquiries.');
      } catch (err) {
        markerStatus.style.color = '#DC2626';
        markerStatus.textContent = err.message || 'Submission error.';
      } finally {
        btnSubmitMarker.disabled = false;
      }
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      handlePurchase('/cart');
    });

    btnBuy?.addEventListener('click', (e) => {
      e.preventDefault();
      handlePurchase('/checkout');
    });
  })();
  </script>
</body>
</html>
