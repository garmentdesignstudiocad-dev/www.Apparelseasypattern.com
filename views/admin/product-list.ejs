<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/admin-products.css">
</head>
<body class="admin-products-dashboard">
  <%- include('../partials/admin_header') %>
  <main class="admin-products-main">
    <header class="admin-products-heading">
      <div>
        <p class="eyebrow">Admin Portal</p>
        <h1>Products / Patterns</h1>
        <p>Manage pattern products, pricing, files and publishing.</p>
      </div>
      <a class="btn primary" href="/admin/products/new">+ Add Product</a>
    </header>

    <% if (message) { %>
      <div class="alert <%= messageType === 'error' ? 'alert-error' : '' %>" role="status"><%= message %></div>
    <% } %>

    <section class="admin-product-stats" aria-label="Product overview">
      <article class="admin-product-stat"><span>Total Products</span><strong><%= totalProducts %></strong></article>
      <article class="admin-product-stat"><span>Active Products</span><strong><%= activeProducts %></strong></article>
      <article class="admin-product-stat"><span>Draft Products</span><strong><%= draftProducts %></strong></article>
      <article class="admin-product-stat"><span>Products Requiring Setup</span><strong><%= setupRequired %></strong></article>
    </section>

    <a class="admin-file-review-summary" href="/admin/products?review=1#product-list">
      <span><strong><%= reviewCount %> <%= reviewCount === 1 ? 'File' : 'Files' %> Need Review</strong><small>Review unconfirmed file purposes product by product. No purpose is assigned automatically.</small></span>
      <span aria-hidden="true">&rarr;</span>
    </a>

    <section class="admin-product-list" id="product-list">
      <div class="admin-product-list__heading">
        <div>
          <h2><%= reviewFilter ? 'Products with files to review' : 'Existing Products' %></h2>
          <p><%= reviewFilter ? 'Open Files on a product to confirm each imported file purpose.' : 'Choose a product to edit its details or manage its files.' %></p>
        </div>
        <% if (reviewFilter) { %><a class="btn ghost" href="/admin/products#product-list">Show all products</a><% } %>
      </div>

      <% if (products.length) { %>
        <div class="admin-product-table-wrap">
          <table class="admin-product-table">
            <thead><tr><th>Product</th><th>Category</th><th>Base Price</th><th>Files</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
              <% products.forEach(product => {
                const setup = setupByProduct.get(String(product._id));
                const files = filesByProduct.get(String(product._id)) || [];
                const live = product.active && product.status === 'active';
                const priceSet = product.base_price !== null && product.base_price !== undefined && product.base_price !== '';
              %>
                <tr>
                  <td data-label="Product">
                    <strong><%= product.name %></strong>
                    <small class="admin-product-slug"><%= product.slug %></small>
                    <span class="admin-product-badges">
                      <% if (product.import_source_key) { %><span class="admin-badge admin-badge--imported">Imported</span><% } %>
                      <% if (!setup.steps.at(-1).complete) { %><span class="admin-badge admin-badge--setup">Setup Required</span><% } %>
                    </span>
                  </td>
                  <td data-label="Category"><%= product.category ? product.category.replaceAll('-', ' ') : 'Not set' %></td>
                  <td data-label="Base Price"><%= priceSet && formatCurrency ? formatCurrency(product.base_price) : 'Price not set' %></td>
                  <td data-label="Files"><%= files.length %> <%= files.length === 1 ? 'file' : 'files' %><% const reviewFiles=files.filter(file=>file.purpose==='other'&&(product.import_source_key||file.import_source_key)); if(reviewFiles.length){ %><small class="admin-product-slug"><%= reviewFiles.length %> need review</small><% } %></td>
                  <td data-label="Status"><span class="admin-badge <%= live ? 'admin-badge--active' : 'admin-badge--draft' %>"><%= product.status === 'coming_soon' ? 'Coming Soon' : live ? 'Active' : 'Draft' %></span></td>
                  <td data-label="Actions">
                    <div class="admin-product-actions">
                      <a class="btn small primary" href="/admin/products/<%= product._id %>/edit" aria-label="Edit <%= product.name %>">Edit</a>
                      <a class="btn small ghost" href="/admin/products/<%= product._id %>/files" aria-label="Review files for <%= product.name %>">Files<% if(reviewFiles.length){ %> · Review<% } %></a>
                      <a class="btn small ghost" href="/admin/products/<%= product._id %>/addons" aria-label="Manage optional add-ons for <%= product.name %>">Add-ons</a>
                      <% if (live) { %>
                        <form method="POST" action="/admin/products/<%= product._id %>/toggle"><button class="btn small ghost" type="submit" aria-label="Deactivate <%= product.name %>">Deactivate</button></form>
                      <% } else { %>
                        <a class="btn small primary" href="/admin/products/<%= product._id %>/edit" aria-label="Review and activate <%= product.name %>">Review &amp; Activate</a>
                      <% } %>
                      <% if (!product.active) { %><form method="POST" action="/admin/products/<%= product._id %>/delete" onsubmit="return confirm('Delete this inactive product? Products linked to orders cannot be deleted.');"><button class="btn small ghost" type="submit" aria-label="Delete inactive product <%= product.name %>">Delete</button></form><% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="admin-product-empty"><%= reviewFilter ? 'No products currently have unconfirmed file purposes.' : 'No products yet. Add a product to get started.' %></p>
      <% } %>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
