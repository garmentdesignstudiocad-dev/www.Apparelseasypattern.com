<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"></head><body><%- include('../partials/admin_header') %><main class="container section"><div class="admin-hero"><div><p class="eyebrow">Training</p><h1>Webinars &amp; Classes</h1></div><a class="btn primary" href="/admin/classes/new">Create Session</a></div><% if(message){ %><div class="alert"><%= message %></div><% } %><div class="card"><div class="card-body table-responsive"><table><thead><tr><th>Session</th><th>Schedule</th><th>Status</th><th>Registrations</th><th>Actions</th></tr></thead><tbody><% sessions.forEach(function(s){ %><tr><td><strong><%= s.title %></strong><br><small><%= s.type %></small></td><td><%= new Date(s.starts_at).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'}) %></td><td><%= s.status %> / <%= s.published?'Published':'Hidden' %></td><td><%= s.registered_count %><% if(s.max_seats){ %> / <%= s.max_seats %><% } %></td><td><a class="btn small" href="/admin/classes/<%= s._id %>/edit">Edit</a> <a class="btn small" href="/admin/classes/<%= s._id %>/registrations">Attendees</a><form method="post" action="/admin/classes/<%= s._id %>/cancel" style="display:inline"><button class="btn ghost small" type="submit">Cancel</button></form></td></tr><% }) %></tbody></table></div></div></main></body></html>
