              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <button type="button" id="btnSubmitMarkerEnquiry" style="display:inline-flex;align-items:center;gap:6px;background:var(--ref-orange);color:#FFFFFF;border:none;border-radius:6px;padding:8px 16px;font-size:13px;font-weight:700;cursor:pointer;">
                  <span>Submit Marker Specifications</span> &rarr;
                </button>
                <span id="markerSubmitStatus" style="font-size:12.5px;font-weight:600;display:none;" role="status"></span>
              </div>
            </div>
          </div>

          <!-- ORDER SUMMARY with Dynamic Multi-Size & Multi-Format Breakdown -->
          <div class="ref-summary-box">
            <h4>Order Summary</h4>
