<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"></head><body><%- include('../partials/admin_header') %><main class="container section"><div class="admin-hero"><div><p class="eyebrow">Promotions</p><h1>Coupons &amp; Discounts</h1></div></div><% if(message){ %><div class="alert"><%= message %></div><% } %><section class="card"><div class="card-body"><p class="settings-note">Coupons are stored and managed here. Checkout application remains intentionally disabled until a dedicated server-side totals integration is approved.</p><form method="post" action="/admin/settings/coupons" class="admin-settings-grid"><label>Coupon Code<input name="code" required></label><label>Discount Type<select name="discount_type"><option value="percentage">Percentage</option><option value="fixed">Fixed amount</option></select></label><label>Discount Value<input type="number" min="0" step=".01" name="discount_value" required></label><label>Minimum Order Value<input type="number" min="0" step=".01" name="minimum_order_value"></label><label>Expiry Date<input type="date" name="expires_at"></label><label><span><input type="checkbox" name="active" checked> Active</span></label><button class="btn primary">Create Coupon</button></form><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Code</th><th>Type</th><th>Value</th><th>Minimum</th><th>Expiry</th><th>Status</th><th></th></tr></thead><tbody><% coupons.forEach(c=>{ %><tr><td><strong><%= c.code %></strong></td><td><%= c.discount_type %></td><td><%= c.discount_type==='percentage'?c.discount_value+'%':'₹'+c.discount_value %></td><td>₹<%= Number(c.minimum_order_value||0).toLocaleString('en-IN') %></td><td><%= c.expires_at?new Date(c.expires_at).toLocaleDateString('en-IN'):'—' %></td><td><%= c.active?'Active':'Inactive' %></td><td><form method="post" action="/admin/settings/coupons/<%= c._id %>/toggle"><button class="btn small">Toggle</button></form></td></tr><% }) %></tbody></table></div></div></section></main></body></html>
