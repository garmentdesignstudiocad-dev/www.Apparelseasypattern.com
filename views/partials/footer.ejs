<footer class="site-footer" style="background:#0B192C;color:#F1F5F9;padding:60px 0 0;font-family:'DM Sans',Arial,sans-serif"><div class="container footer-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:40px;margin-bottom:40px"><div class="footer-brand"><% if(canVisit('/')){ %><a class="fashion-logo fashion-logo--footer" href="/" style="display:flex;align-items:center;gap:12px;text-decoration:none;margin-bottom:16px"><span class="fashion-logo__mark" style="width:44px;height:38px;border-radius:9px;background:#040D1A;color:#FFFFFF;border:1px solid #D97706;display:flex;align-items:center;justify-content:center;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:800;letter-spacing:0.06em">AEP</span><span class="fashion-logo__copy"><strong style="display:block;font-size:15px;color:#FFFFFF;letter-spacing:0.06em"><%= siteSettings?.store_name || 'Apparel Easy Patterns' %></strong><small style="color:#D97706;font-size:10px;letter-spacing:0.1em;font-weight:600"><%= siteSettings?.footer_tagline || "BY GARMENT DESIGN STUDIO" %></small></span></a><% } %><p style="color:#94A3B8;font-size:13.5px;line-height:1.7;margin:0 0 16px"><%= siteSettings?.footer_text || 'Production-friendly garment blocks engineered for perfect fit, sampling speed, and industrial consistency.' %></p><p style="margin:0;font-size:12px;color:#64748B">Professional Garment Technology & CAD Services</p></div><% const orderingLinks=visibleLinks([[siteSettings?.footer_patterns_label || "Available Patterns",'/products'],[siteSettings?.footer_cart_label || "Shopping Cart",'/cart'],[siteSettings?.footer_checkout_label || "Checkout",'/checkout']]); if(orderingLinks.length){ %><div><h5 style="color:#FFFFFF;font-size:14px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;margin:0 0 16px;border-bottom:2px solid #D97706;padding-bottom:8px;display:inline-block"><%= siteSettings?.footer_ordering_label || "Ordering" %></h5><ul style="list-style:none;padding:0;margin:0"><% orderingLinks.forEach(([label,url])=>{ %><li style="margin-bottom:10px"><a href="<%= url %>" style="color:#CBD5E1;font-size:13.5px;text-decoration:none;transition:color 0.2s"><%= label %></a></li><% }) %></ul></div><% } %><div><h5 style="color:#FFFFFF;font-size:14px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;margin:0 0 16px;border-bottom:2px solid #D97706;padding-bottom:8px;display:inline-block"><%= siteSettings?.footer_support_label || "Support" %></h5><% if(siteSettings.support_cta){ %><p style="color:#94A3B8;font-size:13px;margin:0 0 12px"><%= siteSettings.support_cta %></p><% } %><ul style="list-style:none;padding:0;margin:0"><% if(siteSettings?.contact_email){ %><li style="margin-bottom:10px"><a href="mailto:<%= siteSettings.contact_email %>" style="color:#CBD5E1;font-size:13.5px;text-decoration:none"><%= siteSettings.contact_email %></a></li><% } %><% if(siteSettings?.contact_phone){ %><li style="margin-bottom:10px"><a href="tel:<%= siteSettings.contact_phone.replace(/[^+\d]/g,'') %>" style="color:#CBD5E1;font-size:13.5px;text-decoration:none"><%= siteSettings.contact_phone %></a></li><% } %><% if(siteSettings.whatsapp_number){ %><li style="margin-bottom:10px"><a href="https://wa.me/<%= siteSettings.whatsapp_number.replace(/\D/g, '') %>" target="_blank" rel="noopener noreferrer" style="color:#F59E0B;font-size:13.5px;font-weight:600;text-decoration:none"><%= siteSettings?.footer_whatsapp_label || "WhatsApp Consultation" %></a></li><% } %><% if(siteSettings?.main_website_url && canVisit(siteSettings.main_website_url)){ %><li style="margin-bottom:10px"><a href="<%= siteSettings.main_website_url %>" rel="noopener" style="color:#CBD5E1;font-size:13.5px;text-decoration:none"><%= siteSettings.back_website_label %></a></li><% } %></ul></div><div><h5 style="color:#FFFFFF;font-size:14px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;margin:0 0 16px;border-bottom:2px solid #D97706;padding-bottom:8px;display:inline-block">Technical Standards</h5><p style="color:#94A3B8;font-size:13px;line-height:1.6;margin:0 0 12px">All patterns are body-trialled, graded, and validated by NIFT garment technologists.</p><p style="margin:0;font-size:12px;color:#FBBF24;font-weight:600">DXF · PDF · HPGL · Tech Pack · POM</p></div></div><% if(featureEnabled('linkedin') && siteSettings.linkedin_show_footer){ %><div class="container" style="margin-bottom:24px"><%- include('linkedin',{compact:true}) %></div><% } %><div class="footer-bottom" style="border-top:1px solid rgba(255,255,255,0.1);padding:24px 0 16px"><div class="container" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;font-size:12.5px;color:#64748B"><span>© <%= new Date().getFullYear() %> <%= siteSettings?.store_name || 'Apparel Easy Patterns' %>. All rights reserved.</span><span><%= siteSettings?.footer_security_label || "Secure SSL 256-Bit Encrypted Ordering Portal" %></span></div></div><div class="container" style="padding:0 16px 24px;text-align:center;box-sizing:border-box"><p style="margin:0;font-size:12px;line-height:1.6;color:#64748B"><%= siteSettings?.footer_credit_label || "Created by" %> <strong style="font-weight:600;color:#94A3B8"><%= siteSettings?.footer_credit_name || "Innovix Projects" %></strong></p></div></footer>
