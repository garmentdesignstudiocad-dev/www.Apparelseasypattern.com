
<!doctype html>
<html lang="en">

<head>
  <%- include('partials/business-head') %>
  <link rel="stylesheet" href="/css/home.css">
</head>

<body class="premium-store">

  <%- include('partials/header') %>

  <main class="studio-page pattern-home">

    <!-- HERO SECTION -->
    <section class="home-hero" aria-labelledby="home-title">

      <div class="home-hero-copy">

        <span class="eyebrow">
          <%= siteSettings.home_eyebrow %>
        </span>

        <h1 id="home-title">
          <%= siteSettings.homepage_heading %>
        </h1>

        <p>
          <%= siteSettings.homepage_subheading %>
        </p>

        <% if (canVisit('/products')) { %>

          <div class="studio-actions">

            <a class="fashion-button primary" href="/products">
              <%= siteSettings.home_primary_button %>
            </a>

            <% if (canVisit('/classes/enquiry')) { %>

              <a
                class="fashion-button secondary"
                href="/classes/enquiry"
              >
                <%= siteSettings.home_secondary_button %>
              </a>

            <% } %>

          </div>

        <% } %>

        <ul
          class="home-trust-list"
          aria-label="Apparel studio capabilities"
        >

          <li><%= siteSettings.home_trust_1 %></li>
          <li><%= siteSettings.home_trust_2 %></li>
          <li><%= siteSettings.home_trust_3 %></li>

        </ul>

      </div>

      <div
        class="home-visual"
        aria-label="Apparel pattern development"
      >

        <div class="visual-panel">

          <img
            class="home-pattern-visual"
            src="<%= siteSettings.home_image_path || '/images/basic-shirt-pattern.svg' %>"
            alt="<%= siteSettings.home_image_alt %>"
            width="1000"
            height="800"
            fetchpriority="high"
          >

        </div>

        <div class="home-floating-card">

          <span>
            <%= siteSettings.home_floating_label %>
          </span>

          <strong>
            <%= siteSettings.home_floating_text %>
          </strong>

        </div>

      </div>

    </section>

    <!-- AVAILABLE PATTERNS -->
    <% if (canVisit('/products')) { %>

      <section
        class="home-available"
        aria-labelledby="available-title"
      >

        <div class="section-copy">

          <span class="eyebrow">
            <%= siteSettings.home_available_eyebrow %>
          </span>

          <h2 id="available-title">
            <%= siteSettings.home_available_heading %>
          </h2>

          <p>
            <%= siteSettings.home_available_description %>
          </p>

        </div>

        <div class="studio-actions">

          <a class="fashion-button" href="/products">
            <%= siteSettings.home_available_button %>
          </a>

        </div>

      </section>

    <% } %>

    <!-- START WITH THE RIGHT BLOCK -->
    <section
      class="home-focus"
      aria-labelledby="focus-title"
    >

      <div class="focus-header">

        <span class="eyebrow">
          <%= siteSettings.home_focus_eyebrow %>
        </span>

        <h2 id="focus-title">
          <%= siteSettings.home_focus_heading %>
        </h2>

        <p>
          <%= siteSettings.home_focus_description %>
        </p>

        <p>
          <%= siteSettings.home_focus_secondary_description %>
        </p>

      </div>

      <div class="focus-grid">

        <article>

          <span class="focus-index">01</span>

          <h3>
            <%= siteSettings.home_card_1_title %>
          </h3>

          <p>
            <%= siteSettings.home_card_1_description %>
          </p>

        </article>

        <article>

          <span class="focus-index">02</span>

          <h3>
            <%= siteSettings.home_card_2_title %>
          </h3>

          <p>
            <%= siteSettings.home_card_2_description %>
          </p>

        </article>

        <article>

          <span class="focus-index">03</span>

          <h3>
            <%= siteSettings.home_card_3_title %>
          </h3>

          <p>
            <%= siteSettings.home_card_3_description %>
          </p>

        </article>

        <article>

          <span class="focus-index">04</span>

          <h3>
            <%= siteSettings.home_card_4_title %>
          </h3>

          <p>
            <%= siteSettings.home_card_4_description %>
          </p>

        </article>

      </div>

    </section>

    <!-- INDUSTRY EXPERTISE -->
    <section
      class="home-available"
      aria-labelledby="validation-title"
    >

      <div class="section-copy">

        <span class="eyebrow">
          <%= siteSettings.home_expertise_eyebrow %>
        </span>

        <h2 id="validation-title">
          <%= siteSettings.home_expertise_heading %>
        </h2>

        <p>
          <%= siteSettings.home_expertise_description %>
        </p>

      </div>

    </section>

    <!-- BOOKS AND ONLINE CLASSES -->
    <section
      class="home-coming-soon"
      aria-label="Coming soon"
    >

      <% if (canVisit('/books')) { %>

        <article aria-labelledby="books-title">

          <span class="home-status">
            <%= siteSettings.home_books_status %>
          </span>

          <h2 id="books-title">
            <%= siteSettings.home_books_heading %>
          </h2>

          <p>
            <%= siteSettings.home_books_description %>
          </p>

        </article>

      <% } %>

      <% if (canVisit('/classes/enquiry')) { %>

        <article aria-labelledby="classes-title">

          <span class="home-status">
            <%= siteSettings.home_classes_status %>
          </span>

          <h2 id="classes-title">
            <%= siteSettings.home_classes_heading %>
          </h2>

          <p>
            <%= siteSettings.home_classes_description %>
          </p>

        </article>

      <% } %>

    </section>

  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>

</body>
</html>
