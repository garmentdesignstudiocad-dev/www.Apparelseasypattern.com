
<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Website Appearance | Admin</title>

  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/admin-appearance.css">

  <style>
    .cms-layout {
      max-width: 1200px;
      margin: 0 auto;
    }

    .cms-heading {
      margin-bottom: 25px;
    }

    .cms-heading h1 {
      margin-bottom: 8px;
    }

    .cms-heading p {
      color: #666;
      line-height: 1.6;
    }

    .cms-section {
      margin: 0 0 16px;
      border: 1px solid #dedede;
      border-radius: 14px;
      background: #fff;
      overflow: hidden;
    }

    .cms-section > summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 20px;
      cursor: pointer;
      list-style: none;
      background: #faf9f7;
    }

    .cms-section > summary::-webkit-details-marker {
      display: none;
    }

    .cms-section > summary::after {
      content: "+";
      font-size: 25px;
      line-height: 1;
      font-weight: 400;
      color: #62392d;
    }

    .cms-section[open] > summary::after {
      content: "âˆ’";
    }

    .cms-section[open] > summary {
      border-bottom: 1px solid #eee;
      background: #f6f0ea;
    }

    .cms-section-title {
      display: block;
      font-weight: 700;
      font-size: 17px;
      color: #26211e;
    }

    .cms-section-description {
      display: block;
      font-size: 13px;
      margin-top: 5px;
      color: #777;
      line-height: 1.5;
      font-weight: 400;
    }

    .cms-section-body {
      padding: 22px;
    }

    .cms-subtitle {
      font-size: 15px;
      font-weight: 700;
      margin: 20px 0 12px;
      color: #62392d;
    }

    .cms-subtitle:first-child {
      margin-top: 0;
    }

    .cms-fields {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .cms-field {
      display: flex;
      flex-direction: column;
      gap: 7px;
      min-width: 0;
    }

    .cms-field label {
      font-size: 13px;
      font-weight: 700;
      color: #292929;
    }

    .cms-field input,
    .cms-field textarea,
    .cms-field select {
      box-sizing: border-box;
      width: 100%;
      min-height: 43px;
      border: 1px solid #d8d8d8;
      border-radius: 8px;
      padding: 10px 12px;
      font: inherit;
      font-size: 14px;
      color: #222;
      background: #fff;
    }

    .cms-field textarea {
      min-height: 105px;
      resize: vertical;
      line-height: 1.6;
    }

    .cms-field input:focus,
    .cms-field textarea:focus,
    .cms-field select:focus {
      outline: 2px solid #c58b62;
      outline-offset: 1px;
      border-color: #62392d;
    }

    .cms-field small {
      color: #777;
      font-size: 12px;
      line-height: 1.5;
    }

    .cms-color-control {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .cms-color-control input[type="color"] {
      width: 52px;
      min-width: 52px;
      padding: 3px;
      cursor: pointer;
    }

    .cms-color-control input[type="text"] {
      flex: 1;
      min-width: 0;
    }

    .cms-preview {
      margin-top: 24px;
    }

    .cms-actions {
      position: sticky;
      bottom: 0;
      z-index: 20;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      padding: 15px 20px;
      background: #fff;
      border: 1px solid #ddd;
      border-radius: 12px;
      box-shadow: 0 -5px 25px rgba(0,0,0,.07);
      margin: 20px 0;
    }

    .cms-save {
      padding: 13px 25px;
      border: 0;
      border-radius: 9px;
      background: #62392d;
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
    }

    .cms-open {
      padding: 11px 17px;
      border: 1px solid #ddd;
      border-radius: 9px;
      text-decoration: none;
      color: #292929;
      font-size: 14px;
    }

    .cms-notice {
      padding: 12px 15px;
      margin: 15px 0;
      border: 1px solid #ddd;
      border-radius: 9px;
      background: #fafafa;
    }

    .cms-error {
      border-color: #c96b6b;
    }

    .cms-reset {
      margin-top: 26px;
      padding: 20px;
      border: 1px solid #ddd;
      border-radius: 12px;
      background: #fafafa;
    }

    .cms-reset label {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 14px 0;
    }

    @media (max-width: 700px) {
      .cms-fields {
        grid-template-columns: 1fr;
      }

      .cms-section-body {
        padding: 15px;
      }

      .cms-section > summary {
        padding: 16px;
      }

      .cms-actions {
        position: static;
      }
    }
  </style>
</head>

<body>

  <%- include('../partials/admin_header') %>

  <main class="container section cms-layout">

    <div class="cms-heading">
      <h1>Website Content & Appearance</h1>

      <p>
        Manage your website page by page.
        Open a section, edit its content, and save your changes.
      </p>
    </div>

    <% if (message) { %>
      <div class="cms-notice" role="status">
        <%= message %>
      </div>
    <% } %>

    <% if (errors.length) { %>
      <div class="cms-notice cms-error" role="alert">
        <strong>Please correct these settings:</strong>
        <ul>
          <% errors.forEach(error => { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <%
      const humanLabel = key =>
        key.replaceAll('_', ' ')
          .replace(/\b\w/g, c => c.toUpperCase())
          .replace(/\bUrl\b/g, 'URL')
          .replace(/\bSeo\b/g, 'SEO');

      const descriptions = {
        store_name: 'Store name shown on the website.',
        logo_url: 'Full HTTPS URL to your business logo.',
        favicon_url: 'Browser tab icon URL.',
        main_website_url: 'Main consultancy / Wix website link.',
        contact_email: 'Public contact email.',
        contact_phone: 'Public phone number.',
        whatsapp_number: 'WhatsApp number with country code.',
        support_cta: 'Short support message.',
        address: 'Business address.',

        homepage_heading: 'Main heading displayed on the homepage.',
        homepage_subheading: 'Text directly below the homepage heading.',
        home_eyebrow: 'Small label above the main title.',
        home_image_path: 'Image path such as /images/basic-shirt-pattern.svg or an HTTPS URL.',
        home_image_alt: 'Accessible description of the hero image.',
        home_primary_button: 'Text of the primary homepage button.',
        home_secondary_button: 'Text of the secondary homepage button.',

        products_heading: 'Main heading on the Products page.',
        products_description: 'Introductory paragraph on the Products page.',
        cart_heading: 'Shopping cart page heading.',
        checkout_heading: 'Checkout page heading.',
        footer_text: 'Business description in the footer.',

        main_font: 'Font used for normal text.',
        heading_font: 'Font used for headings.',
        base_font_size: 'Base text size: 14 to 20 pixels.'
      };

      const groupedSections = [
        {
          title: '01 - Homepage Settings',
          description: 'Hero section, images, buttons, trust labels and homepage content.',
          groups: [
            {
              name: 'Hero Section',
              fields: [
                'home_eyebrow',
                'homepage_heading',
                'homepage_subheading',
                'home_image_path',
                'home_image_alt',
                'home_floating_label',
                'home_floating_text'
              ]
            },
            {
              name: 'Homepage Buttons & Trust Labels',
              fields: [
                'home_primary_button',
                'home_secondary_button',
                'home_trust_1',
                'home_trust_2',
                'home_trust_3'
              ]
            },
            {
              name: 'Available Patterns Section',
              fields: [
                'home_available_eyebrow',
                'home_available_heading',
                'home_available_description',
                'home_available_button'
              ]
            },
            {
              name: 'Fit Block Section',
              fields: [
                'home_focus_eyebrow',
                'home_focus_heading',
                'home_focus_description',
                'home_focus_secondary_description'
              ]
            },
            {
              name: 'Four Homepage Cards',
              fields: [
                'home_card_1_title',
                'home_card_1_description',
                'home_card_2_title',
                'home_card_2_description',
                'home_card_3_title',
                'home_card_3_description',
                'home_card_4_title',
                'home_card_4_description'
              ]
            },
            {
              name: 'Industry Expertise Section',
              fields: [
                'home_expertise_eyebrow',
                'home_expertise_heading',
                'home_expertise_description'
              ]
            },
            {
              name: 'Books & Classes',
              fields: [
                'home_books_status',
                'home_books_heading',
                'home_books_description',
                'home_classes_status',
                'home_classes_heading',
                'home_classes_description'
              ]
            }
          ]
        },
        {
          title: '02 - Products Page',
          description: 'Headings and introductory content for your product collection.',
          groups: [
            {
              name: 'Products Page Text',
              fields: [
                'products_heading',
                'products_description',
                'view_products_label'
              ]
            }
          ]
        },
        {
          title: '03 - Cart & Checkout',
          description: 'Shopping cart and checkout page wording.',
          groups: [
            {
              name: 'Cart & Checkout Titles',
              fields: [
                'cart_heading',
                'checkout_heading'
              ]
            }
          ]
        },
        {
          title: '04 - Header, Footer & Branding',
          description: 'Logo, store identity, contact details and footer text.',
          groups: [
            {
              name: 'Brand Identity',
              fields: [
                'store_name',
                'logo_url',
                'favicon_url',
                'main_website_url'
              ]
            },
            {
              name: 'Contact Information',
              fields: [
                'contact_email',
                'contact_phone',
                'whatsapp_number',
                'support_cta',
                'address'
              ]
            },
            {
              name: 'Header Labels',
              fields: Object.keys(appearance.headerFooter).filter(key => key.startsWith('header_'))
            },
            {
              name: 'Footer Labels',
              fields: Object.keys(appearance.headerFooter).filter(key => key.startsWith('footer_'))
            },
            {
              name: 'Footer Content',
              fields: [
                'footer_text',
                'back_website_label'
              ]
            }
          ]
        },
        {
          title: '05 - Website Colors & Design',
          description: 'Website colors, typography, button shapes and layout.',
          groups: [
            {
              name: 'Brand Colors',
              fields: Object.keys(appearance.colors)
            },
            {
              name: 'Typography',
              fields: [
                'main_font',
                'heading_font',
                'base_font_size',
                'heading_style'
              ]
            },
            {
              name: 'Buttons, Cards & Layout',
              fields: [
                'button_style',
                'card_style',
                'layout_density'
              ]
            }
          ]
        },
        {
          title: '06 - SEO Settings',
          description: 'Search engine page titles and descriptions.',
          groups: [
            {
              name: 'Page SEO Fields',
              fields: Object.keys(appearance.content)
                .filter(key => key.includes('_seo_'))
            }
          ]
        }
      ];

      const usedFields = new Set(
        groupedSections.flatMap(section =>
          section.groups.flatMap(group => group.fields)
        )
      );

      const allEditableFields = Object.keys({
        ...appearance.defaults,
        ...appearance.content
      });

      const extraFields = allEditableFields.filter(
        key => !usedFields.has(key)
      );

      if (extraFields.length) {
        groupedSections.push({
          title: '07 - Additional Settings',
          description: 'Other supported website settings.',
          groups: [
            {
              name: 'Additional Fields',
              fields: extraFields
            }
          ]
        });
      }

      const longFields = new Set([
        'homepage_subheading',
        'home_available_description',
        'home_focus_description',
        'home_focus_secondary_description',
        'home_expertise_description',
        'home_books_description',
        'home_classes_description',
        'products_description',
        'address'
      ]);

      for (let i = 1; i <= 4; i++) {
        longFields.add(`home_card_${i}_description`);
      }
    %>

    <form
      method="post"
      action="/admin/settings/appearance"
      id="appearance-form"
    >

      <input type="hidden" name="_csrf" value="<%= csrf %>">

      <% groupedSections.forEach((section, index) => { %>

        <details
          class="cms-section"
          <%= index === 0 ? 'open' : '' %>
        >

          <summary>
            <span>
              <span class="cms-section-title">
                <%= section.title %>
              </span>

              <span class="cms-section-description">
                <%= section.description %>
              </span>
            </span>
          </summary>

          <div class="cms-section-body">

            <% section.groups.forEach(group => { %>

              <h3 class="cms-subtitle">
                <%= group.name %>
              </h3>

              <div class="cms-fields">

                <% group.fields.forEach(key => { %>

                  <% if (key in settings) { %>

                    <div class="cms-field">

                      <label for="<%= key %>">
                        <%= humanLabel(key) %>
                      </label>

                      <% if (key in appearance.colors) { %>

                        <div class="cms-color-control">

                          <input
                            type="color"
                            data-color-for="<%= key %>"
                            aria-label="<%= humanLabel(key) %> picker"
                            value="<%= appearance.valid(key, settings[key]) ? settings[key] : appearance.colors[key] %>"
                          >

                          <input
                            type="text"
                            id="<%= key %>"
                            name="<%= key %>"
                            value="<%= settings[key] %>"
                            pattern="#[0-9a-fA-F]{6}"
                            maxlength="7"
                            required
                            spellcheck="false"
                          >

                        </div>

                      <% } else if (key in appearance.options) { %>

                        <select
                          id="<%= key %>"
                          name="<%= key %>"
                        >

                          <% appearance.options[key].forEach(option => { %>

                            <option
                              value="<%= option %>"
                              <%= settings[key] === option ? 'selected' : '' %>
                            >
                              <%= option.replaceAll('-', ' ') %>
                            </option>

                          <% }) %>

                        </select>

                      <% } else if (longFields.has(key)) { %>

                        <textarea
                          id="<%= key %>"
                          name="<%= key %>"
                          rows="4"
                          maxlength="<%= key.startsWith('home_') || key.startsWith('homepage_') ? 3000 : 600 %>"
                        ><%= settings[key] || '' %></textarea>

                      <% } else { %>

                        <input
                          id="<%= key %>"
                          name="<%= key %>"
                          type="<%= key === 'base_font_size'
                            ? 'number'
                            : key.endsWith('_url')
                              ? 'url'
                              : key === 'contact_email'
                                ? 'email'
                                : 'text' %>"
                          value="<%= settings[key] == null ? '' : settings[key] %>"
                          maxlength="<%= key === 'home_image_path' || key.endsWith('_url')
                            ? 2048
                            : key.startsWith('home_') || key.startsWith('homepage_')
                              ? 3000
                              : 600 %>"
                          <%= key === 'base_font_size'
                            ? 'min="14" max="20" step="1" required'
                            : '' %>
                          <%= (['store_name', 'back_website_label', 'view_products_label'].includes(key) || Object.prototype.hasOwnProperty.call(appearance.headerFooter, key))
                            ? 'required'
                            : '' %>
                        >

                      <% } %>

                      <small>
                        <%= descriptions[key] ||
                          'Update this setting and save to apply the change.' %>
                      </small>

                    </div>

                  <% } %>

                <% }) %>

              </div>

            <% }) %>

          </div>

        </details>

      <% }) %>

      <!-- LIVE PREVIEW -->
      <details class="cms-section cms-preview">

        <summary>
          <span>
            <span class="cms-section-title">
              Website Preview
            </span>

            <span class="cms-section-description">
              Preview branding, colors and main heading before saving.
            </span>
          </span>
        </summary>

        <div class="cms-section-body">

          <div id="theme-preview">

            <header class="preview-header">

              <strong data-preview="store_name"></strong>

              <span>Patterns Â· Cart</span>

            </header>

            <div class="preview-main">

              <h2 data-preview="homepage_heading"></h2>

              <p data-preview="homepage_subheading"></p>

              <article class="preview-card">

                <div class="preview-image">
                  Sample Pattern
                </div>

                <h3>
                  Classic garment pattern
                </h3>

                <p>
                  Digital files and physical pattern options.
                </p>

                <strong class="preview-accent">
                  â‚¹500
                </strong>

                <p>
                  <button
                    type="button"
                    class="preview-button"
                    data-preview="view_products_label"
                  ></button>
                </p>

              </article>

            </div>

            <footer
              class="preview-footer"
              data-preview="footer_text"
            ></footer>

          </div>

        </div>

      </details>

      <!-- SAVE ACTIONS -->
      <div class="cms-actions">

        <button
          type="submit"
          class="cms-save"
        >
          Save Website Changes
        </button>

        <a
          href="/"
          target="_blank"
          rel="noopener"
          class="cms-open"
        >
          View Homepage â†—
        </a>

        <a
          href="/products"
          target="_blank"
          rel="noopener"
          class="cms-open"
        >
          View Products â†—
        </a>

      </div>

    </form>

    <!-- THEME RESET -->
    <form
      method="post"
      action="/admin/settings/appearance/reset"
      id="appearance-reset"
      class="cms-reset"
    >

      <input type="hidden" name="_csrf" value="<%= csrf %>">

      <h2>Reset Website Theme</h2>

      <p>
        Reset colors, fonts and styles only.
        Your website text, branding and business details will be kept.
      </p>

      <label>
        <input
          type="checkbox"
          name="confirm_reset"
          value="yes"
          required
        >
        I confirm that I want to reset the theme.
      </label>

      <button type="submit" class="btn">
        Reset Theme
      </button>

    </form>

  </main>

  <script src="/js/admin-appearance.js"></script>

</body>
</html>
