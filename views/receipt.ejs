<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Paid Receipt <%= receipt.receipt_number %></title><style>*{box-sizing:border-box}body{font:15px/1.6 Arial,sans-serif;background:#f2eee9;color:#222;margin:0;padding:32px}.receipt{max-width:860px;margin:auto;background:white;padding:48px;border-top:7px solid #62392d}.top{display:flex;justify-content:space-between;gap:24px}.label{font-size:12px;text-transform:uppercase;letter-spacing:1px;color:#666}h1{font-size:28px;margin:0}h2{font-size:19px;margin:0}.paid{color:#20683b;font-weight:bold}p{margin:5px 0;overflow-wrap:anywhere}.details{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin:30px 0}table{width:100%;border-collapse:collapse}th,td{padding:12px 8px;text-align:left;border-bottom:1px solid #ddd}th:last-child,td:last-child{text-align:right}.totals{margin:24px 0 24px auto;width:min(360px,100%)}.totals p{display:flex;justify-content:space-between;gap:20px}.total{font-size:20px;border-top:2px solid #333;padding-top:12px}.foot{border-top:1px solid #ddd;padding-top:20px;font-size:13px;color:#555}.print{display:block;margin:20px auto;padding:12px 20px;cursor:pointer}@media(max-width:600px){body{padding:10px}.receipt{padding:22px}.details{grid-template-columns:1fr}.top{display:block}}@media print{body{padding:0;background:white}.receipt{padding:20px;max-width:none}.print{display:none}@page{size:A4;margin:15mm}tr{break-inside:avoid}}</style></head><body><article class="receipt"><% const money=n=>'₹'+(Number(n||0)/100).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2}); %><header class="top"><div><div class="label">Payment Receipt</div><h1><%= receipt.business_name %></h1><p><%= receipt.business_address %></p><p><%= receipt.contact_email %> <%= receipt.contact_phone %></p></div><div><strong class="paid">PAID · INR</strong><p><%= receipt.receipt_number %></p><p><%= new Date(receipt.paid_at).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'}) %> IST</p></div></header><section class="details"><div><div class="label">Received From</div><h2><%= receipt.customer_name %></h2><p><%= receipt.email %></p><p><%= receipt.phone %></p></div><div><div class="label">Payment Details</div><p>Reference: <%= receipt.reference_id %></p><p>Type: <%= receipt.reference_type.replaceAll('_',' ') %></p><p>Razorpay Payment: <%= receipt.payment_id %></p><p>Status: <%= receipt.payment_status %></p></div></section><table><thead><tr><th>Item / Service</th><th>Quantity</th><th>Amount (INR)</th></tr></thead><tbody><% receipt.items.forEach(item=>{ %><tr><td><%= item.name %></td><td><%= item.quantity %></td><td><%= money(item.amount_paise) %></td></tr><% }) %></tbody></table><section class="totals"><p><span>Subtotal</span><strong><%= money(receipt.subtotal_paise) %></strong></p><p><span>Discount</span><strong>−<%= money(receipt.discount_paise) %></strong></p><p><span>GST</span><strong><%= money(receipt.gst_paise) %></strong></p><% if(receipt.delivery_flow_version!==2){ %><p><span>Historical Delivery Charge</span><strong><%= money(receipt.delivery_paise) %></strong></p><% } %><p class="total"><span>Amount Paid</span><strong><%= money(receipt.total_paise) %></strong></p></section><footer class="foot"><p>Thank you for your payment. Keep this receipt and reference for support.</p><p>This receipt records the payment received; any subsequent cancellation or refund is handled separately. This is a payment receipt, not a GST tax invoice.</p></footer></article><button class="print" id="print-receipt">Print / Save as PDF</button><script src="/js/receipt.js"></script></body></html>
