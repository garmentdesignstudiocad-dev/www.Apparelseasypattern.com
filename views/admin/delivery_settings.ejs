<!doctype html><html><head><meta charset="utf-8"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"></head><body><%- include('../partials/admin_header') %><main class="container section"><h1>Delivery Zones and Dispatch Hubs</h1><p>Map states to South or North, set each dispatch hub and select its delivery partners. All cities in a configured state use that zone. Manage <a href="/admin/settings/couriers">Delivery Partners</a>.</p>
<% if(unassignedStates.length){ %><section class="card card-body" role="alert"><h2>State/UT assignment required</h2><p>Assign each State/UT below to South or North using the zone forms. Physical checkout remains unavailable for unassigned destinations; no zone is guessed.</p><ul><% unassignedStates.forEach(state=>{ %><li><%= state %> ? assignment required</li><% }) %></ul></section><% } %>
<% regions.forEach(zone=>{ %><form method="post" action="/admin/settings/delivery" class="card card-body"><input type="hidden" name="_csrf" value="<%= learningCsrf %>"><input type="hidden" name="region_id" value="<%= zone._id %>"><h2><%= zone.name %> ? <%= zone.dispatch_location %></h2><label>Dispatch Hub<input name="dispatch_location" value="<%= zone.dispatch_location %>" required></label><label>States (one per line or comma separated)<textarea name="states"><%= (zone.states || []).join('\n') %></textarea></label><fieldset><legend>Delivery Partners for This Hub</legend><% partners.forEach(partner=>{ %><label><input type="checkbox" name="partner_ids" value="<%= partner._id %>" <%= (zone.partner_ids || []).includes(partner._id)?'checked':'' %>><%= partner.name %><%= partner.active?'':' (disabled)' %></label><% }) %></fieldset><label><input type="checkbox" name="active" <%= zone.active?'checked':'' %>> Active</label><button>Save Zone / Hub</button></form><% }) %></main></body></html>