<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/customer-experience.css"><%- include('partials/theme') %></head><body><%- include('partials/header') %><main class="container section"><h1>My Account</h1><p><%= customer.name %></p><p><%= customer.email %></p><p><%= customer.phone %></p><h2>My Orders</h2><% if(!orders.length){ %><p>No orders linked to this account yet.</p><% } %><% orders.forEach(order=>{ %><section class="card card-body"><h3>Order <%= order._id %></h3><p><%= new Date(order.createdAt).toLocaleDateString('en-IN') %></p><ul><% order.items.forEach(item=>{ %><li><%= item.product_name || 'Pattern' %> ? Digital: <%= item.quantity || 0 %>, Physical: <%= item.physical_quantity || 0 %>, Trial: <%= item.trial_quantity || 0 %></li><% }) %></ul><p>Amount Paid: INR <%= (order.payment_status==='paid' && order.payment_verified_at?order.grand_total:0).toFixed(2) %></p><p>Payment Status: <%= order.payment_status %></p><p>Fulfilment Status: <%= order.shipping_status || order.order_status %></p><% if(order.items.some(item=>item.physical_quantity>0 || item.trial_quantity>0)){ %><p>Selected Courier: <%= order.courier_name || '' %></p><p>Dispatch Hub: <%= order.dispatch_location || '' %></p><p>Tracking/AWB: <%= order.tracking_number || 'Not yet assigned' %></p><% } %><% if(order.payment_status==='paid' && order.payment_verified_at && order.order_status!=='cancelled' && order.download_expires_at>new Date()){ %><a href="/account/orders/<%= order._id %>/download">Secure Downloads</a><% } %></section><% }) %></main><%- include('partials/footer') %></body></html>