<!DOCTYPE html><html><head><meta charset="utf-8"><title>Consulting</title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/business.css"></head><body><%- include('../partials/admin_header') %><main class="studio-admin"><h1>Consulting Services</h1><a href="/admin/access-records?kind=consulting">Consultation Bookings & Payments</a><% items.forEach(row=>{ %><p><a href="/admin/consulting/<%= row._id %>/edit"><%= row.name %></a> · <%= row.active?'Active':'Inactive' %> · <%= row.price==null?'Default fee':'₹'+row.price %></p><% }) %><h2><%= item._id?'Edit':'Add' %> Service</h2><p role="alert"><%= error %></p><form method="post" action="/admin/consulting<%= item._id?'/'+item._id+'/edit':'' %>" class="studio-form"><input type="hidden" name="_csrf" value="<%= learningCsrf %>"><% ['name','slug'].forEach(key=>{ %><label><%= key %><input name="<%= key %>" required maxlength="200" value="<%= item[key] || '' %>"></label><% }) %><label>Description<textarea name="description" maxlength="5000"><%= item.description || '' %></textarea></label><label>Price override (INR; blank = default)<input type="number" name="price" min="0" max="1000000" step="0.01" value="<%= item.price ?? '' %>"></label><label><input name="active" type="checkbox" <%= item.active?'checked':'' %>> Active</label><button class="fashion-button">Save Service</button></form></main></body></html>
