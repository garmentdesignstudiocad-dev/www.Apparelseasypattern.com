<!DOCTYPE html><html lang="en"><head><%- include('../partials/business-head') %></head><body><%- include('../partials/header') %><main class="studio-page"><h1><%= title %></h1><h2><%= item.title || item.name %></h2><p><%= fee.price?'₹'+fee.price.toLocaleString('en-IN'):'Free' %> · INR</p><% if(error){ %><p role="alert" class="studio-errors"><%= error %></p><% } %><form method="post" action="/<%= kind %>/<%= encodeURIComponent(item.slug) %>/access" class="studio-form"><label hidden aria-hidden="true">Leave blank<input name="website" tabindex="-1" autocomplete="off"></label><input type="hidden" name="_csrf" value="<%= learningCsrf %>"><input type="hidden" name="submission_key" value="<%= nonce %>"><% [['full_name','Name','text'],['email','Email','email'],['whatsapp','WhatsApp','tel'],...(kind==='consulting'?[['preferred_date','Preferred Date (Asia/Kolkata)','date'],['preferred_time','Preferred Time (Asia/Kolkata)','time']]:[])].forEach(([key,label,type])=>{ %><label><%= label %><input name="<%= key %>" type="<%= type %>" required maxlength="254" value="<%= values[key] || '' %>"></label><% }) %><% if(kind==='consulting'){ %><label class="studio-wide">Requirement / Message<textarea name="notes" maxlength="5000" required><%= values.notes || '' %></textarea></label><p>This is a booking request, not a confirmed appointment. Times use Asia/Kolkata (UTC+05:30). The studio must approve availability; you must explicitly accept any proposed alternative.</p><% } %><button class="fashion-button"><%= kind==='consulting'?'Submit Booking Request':fee.button %> — <%= fee.price?'₹'+fee.price.toLocaleString('en-IN'):'Free' %></button></form></main><%- include('../partials/footer') %></body></html>
