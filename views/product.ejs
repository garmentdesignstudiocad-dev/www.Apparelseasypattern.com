              <span>Selected Product</span>
              <strong style="text-align:right;"><%= product.name %></strong>
            </div>
            <div class="ref-summary-row" id="sumSpecSheetRow" style="display:flex;">
              <span>Basic Size Guide &amp; Fit Specs</span>
