                <button type="button" class="unit-btn" data-unit="in">INCHES</button>
              </div>
            </div>

            <% if (product.size_information) { %>
              <p style="white-space:pre-line"><%= product.size_information %></p>
            <% } else { %>
              <p>Product measurements are not configured. Confirm the size against the supplied product-specific reference before ordering.</p>
            <% } %>

            <!-- Size Chart PDF Attachment Controls -->
            <% if (product.size_chart_pdf) { %>
              <div class="pd-pdf-card" style="margin-top:16px;">
                <div class="pd-pdf-info">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                  </svg>
                  <div>
                    <strong><%= product.size_chart_pdf_name || 'Size Chart Guide (PDF)' %></strong>
                    <small>Official Production Specification Sheet</small>
                  </div>
                </div>
                <div class="pd-pdf-actions">
                  <a href="<%= product.size_chart_pdf %>" target="_blank" rel="noopener noreferrer" class="btn ghost small">
                    View PDF &nearr;
                  </a>
                  <a href="<%= product.size_chart_pdf %>" download="<%= product.size_chart_pdf_name || 'Size-Chart.pdf' %>" class="btn ghost small">
                    Download PDF &darr;
                  </a>
                  <button type="button" class="btn ghost small btn-toggle-pdf-preview" data-target="sizeChartEmbedBox">
                    Preview &darr;
                  </button>
                </div>
              </div>
              <div id="sizeChartEmbedBox" class="pd-pdf-embed-box" style="display:none;margin-top:12px;">
                <iframe src="<%= product.size_chart_pdf %>#toolbar=1" width="100%" height="380" style="border:1px solid #E2E8F0;border-radius:8px;" title="Size Chart PDF Preview"></iframe>
              </div>
