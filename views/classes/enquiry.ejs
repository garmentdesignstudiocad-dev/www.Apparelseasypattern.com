<!doctype html><html lang="en"><head><%- include('../partials/business-head') %></head><body><%- include('../partials/header') %><main class="studio-page"><section class="pattern-intro"><span class="eyebrow"><%= siteSettings.classes_eyebrow || 'Online Pattern Making Class Enquiries' %></span><h1><%= siteSettings.classes_heading || title %></h1><p><%= siteSettings.classes_description || description %></p></section>
<% if(!sent){ %><details open><summary class="fashion-button">Request Class Information</summary><% if(error){ %><p role="alert"><%= error %></p><% } %><form action="/classes/enquiry" method="post" class="studio-form pattern-form" id="class-enquiry"><label hidden aria-hidden="true">Leave blank<input name="website" tabindex="-1" autocomplete="off"></label><input type="hidden" name="_csrf" value="<%= learningCsrf %>">
<% [['name','Full Name','text'],['email','Email','email'],['whatsapp','Phone','tel']].forEach(([key,label,type])=>{ %><label><%= label %><input name="<%= key %>" type="<%= type %>" required maxlength="300" value="<%= typeof values[key]==='string'?values[key]:'' %>"></label><% }) %>
<label>Profession / Current Status<select name="profession" id="profession" required><option value="">Choose your status</option><% ['Student','Working Professional','Business Owner','Other'].forEach(value=>{ %><option <%= values.profession===value?'selected':'' %>><%= value %></option><% }) %></select></label>
<label data-status="student">What are you studying?<input name="studying" maxlength="300" value="<%= typeof values.studying==='string'?values.studying:'' %>"></label>
<label data-status="experienced">Current role / area<input name="current_role" maxlength="300" value="<%= typeof values.current_role==='string'?values.current_role:'' %>"></label>
<label data-status="experienced">Years of experience<input name="experience" type="number" min="0" max="80" step="0.1" value="<%= typeof values.experience==='string'?values.experience:'' %>"></label>
<label class="studio-wide">What would you like to learn? (optional)<textarea name="message" maxlength="5000" rows="4"><%= typeof values.message==='string'?values.message:'' %></textarea></label>
<label class="studio-wide consent"><input type="checkbox" name="consent" required <%= values.consent==='on'?'checked':'' %>> Contact me about my online pattern making class enquiry.</label>
<button class="fashion-button" type="submit"><%= siteSettings.classes_cta_text || 'Request Class Information' %></button><p>This form submits an enquiry, not a confirmed class booking. No payment is required. We review enquiries and respond separately.</p></form></details><% } %><%- include('../partials/support-contact') %></main><%- include('../partials/footer') %><script src="/js/main.js"></script><script src="/js/class-enquiry.js"></script></body></html>
