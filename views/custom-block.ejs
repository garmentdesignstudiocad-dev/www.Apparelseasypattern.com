<!doctype html>
<html lang="en">
<head>
  <%- include('partials/business-head') %>
  <style>
    .cb-page-header {
      background: linear-gradient(135deg, #0B192C 0%, #1E3E62 100%);
      color: #FFFFFF;
      padding: 52px 20px 48px;
      text-align: center;
    }
    .cb-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(217, 119, 6, 0.15);
      border: 1px solid rgba(217, 119, 6, 0.4);
      color: #FBBF24;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 5px 12px;
      border-radius: 9999px;
      margin-bottom: 16px;
    }
    .cb-badge-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #F59E0B;
    }
    .cb-title {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(2rem, 3.5vw, 2.75rem);
      font-weight: 700;
      color: #FFFFFF;
      margin: 0 0 12px;
      letter-spacing: -0.01em;
    }
    .cb-subtitle {
      max-width: 660px;
      margin: 0 auto;
      font-size: 1rem;
      color: #CBD5E1;
      line-height: 1.6;
    }
    .cb-container {
      max-width: 720px;
      margin: -24px auto 60px;
      padding: 0 16px;
      position: relative;
      z-index: 2;
    }
    .cb-card {
      background: #FFFFFF;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(11, 25, 44, 0.08);
      border: 1px solid #E2E8F0;
      padding: 36px 32px;
    }
    @media (max-width: 640px) {
      .cb-card { padding: 24px 18px; }
    }
    .cb-form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
    @media (max-width: 640px) {
      .cb-form-grid { grid-template-columns: 1fr; gap: 14px; }
    }
    .cb-field-full {
      grid-column: 1 / -1;
    }
    .cb-label {
      display: block;
      font-size: 13.5px;
      font-weight: 700;
      color: #0B192C;
      margin-bottom: 6px;
    }
    .cb-label .req {
      color: #DC2626;
    }
    .cb-input, .cb-select, .cb-textarea {
      width: 100%;
      box-sizing: border-box;
      padding: 11px 14px;
      border: 1.5px solid #CBD5E1;
      border-radius: 8px;
      font-size: 14px;
      color: #0B192C;
      background: #F8FAFC;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .cb-input:focus, .cb-select:focus, .cb-textarea:focus {
      outline: none;
      border-color: #D97706;
      background: #FFFFFF;
      box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.15);
    }
    .cb-textarea {
      resize: vertical;
      min-height: 110px;
      line-height: 1.5;
    }
    .cb-actions {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 24px;
    }
    .cb-btn-submit {
      width: 100%;
      background: #0B192C;
      color: #FFFFFF;
      border: none;
      border-radius: 8px;
      padding: 14px 24px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: background 0.15s;
    }
    .cb-btn-submit:hover:not(:disabled) {
      background: #1E3E62;
    }
    .cb-btn-submit:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }
    .cb-btn-whatsapp {
      width: 100%;
      box-sizing: border-box;
      background: #25D366;
      color: #FFFFFF;
      border: none;
      border-radius: 8px;
      padding: 13px 24px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      transition: background 0.15s;
    }
    .cb-btn-whatsapp:hover {
      background: #1EBE5D;
      color: #FFFFFF;
    }
    .cb-wa-note {
      font-size: 12px;
      color: #64748B;
      text-align: center;
      margin-top: -4px;
      line-height: 1.4;
    }
    .cb-alert {
      padding: 14px 18px;
      border-radius: 8px;
      font-size: 14px;
      line-height: 1.5;
      margin-bottom: 20px;
      display: none;
    }
    .cb-alert-error {
      background: #FEF2F2;
      border: 1px solid #FCA5A5;
      color: #991B1B;
    }
    .cb-alert-success {
      background: #ECFDF5;
      border: 1px solid #A7F3D0;
      color: #065F46;
    }
    .cb-trust-bar {
      display: flex;
      justify-content: space-around;
      gap: 12px;
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid #E2E8F0;
      font-size: 12px;
      color: #64748B;
      flex-wrap: wrap;
    }
    .cb-trust-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <header class="cb-page-header">
    <div class="cb-badge">
      <span class="cb-badge-dot"></span>
      Industrial Pattern Engineering
    </div>
    <h1 class="cb-title">Request a Custom Block</h1>
    <p class="cb-subtitle">
      Need a specialized silhouette, brand-graded basic block, tech pack, or customized marker layout? Tell us your specifications and our apparel patternmaking technologists will assist you.
    </p>
  </header>

  <main class="cb-container">
    <div class="cb-card">
      <div id="cbStatusAlert" class="cb-alert" role="alert"></div>

      <% if (errors && errors.length) { %>
        <div class="cb-alert cb-alert-error" style="display:block;" role="alert">
          <% errors.forEach(err => { %>
            <div><%= err %></div>
          <% }) %>
        </div>
      <% } %>

      <form action="/enquiries" method="POST" id="customBlockForm">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="interest" value="Fit Blocks">
        <input type="hidden" name="source" value="/custom-block">
        <label hidden aria-hidden="true">Leave blank<input name="website" tabindex="-1" autocomplete="off"></label>

        <div class="cb-form-grid">
          <!-- Full Name -->
          <div>
            <label class="cb-label" for="cbName">Full Name <span class="req">*</span></label>
            <input
              type="text"
              id="cbName"
              name="name"
              class="cb-input"
              placeholder="e.g. Rajesh Kumar"
              required
              maxlength="300"
              value="<%= values && values.name ? values.name : '' %>"
            >
          </div>

          <!-- Email Address -->
          <div>
            <label class="cb-label" for="cbEmail">Email Address <span class="req">*</span></label>
            <input
              type="email"
              id="cbEmail"
              name="email"
              class="cb-input"
              placeholder="e.g. rajesh@apparel.com"
              required
              maxlength="300"
              value="<%= values && values.email ? values.email : '' %>"
            >
          </div>

          <!-- Mobile / WhatsApp Number -->
          <div>
            <label class="cb-label" for="cbWhatsapp">Mobile / WhatsApp Number <span class="req">*</span></label>
            <input
              type="tel"
              id="cbWhatsapp"
              name="whatsapp"
              class="cb-input"
              placeholder="e.g. +91 9876543210"
              required
              maxlength="30"
              value="<%= values && values.whatsapp ? values.whatsapp : '' %>"
            >
          </div>

          <!-- Garment / Pattern Category -->
          <div>
            <label class="cb-label" for="cbCategory">Garment / Pattern Category <span class="req">*</span></label>
            <select id="cbCategory" name="category" class="cb-select" required>
              <option value="">-- Select Category --</option>
              <option value="Men's Wear" <%= values && values.category === "Men's Wear" ? 'selected' : '' %>>Men's Wear</option>
              <option value="Women's Wear" <%= values && values.category === "Women's Wear" ? 'selected' : '' %>>Women's Wear</option>
              <option value="Kid's Wear" <%= values && values.category === "Kid's Wear" ? 'selected' : '' %>>Kid's Wear</option>
              <option value="Other / Unisex" <%= values && values.category === "Other / Unisex" ? 'selected' : '' %>>Other / Unisex</option>
            </select>
          </div>

          <!-- Service / Request Type -->
          <div class="cb-field-full">
            <label class="cb-label" for="cbServiceType">Service / Request Type <span class="req">*</span></label>
            <select id="cbServiceType" name="service_type" class="cb-select" required>
              <option value="">-- Select Request Type --</option>
              <option value="Custom Fit Block Development" <%= values && values.service_type === 'Custom Fit Block Development' ? 'selected' : '' %>>Custom Fit Block Development (DXF / HPGL / PDF)</option>
              <option value="Basic Construction Tech Pack" <%= values && values.service_type === 'Basic Construction Tech Pack' ? 'selected' : '' %>>Basic Construction Tech Pack &amp; Spec Sheet</option>
              <option value="Fit Correction & Pattern Audit" <%= values && values.service_type === 'Fit Correction & Pattern Audit' ? 'selected' : '' %>>Fit Correction &amp; Pattern Audit</option>
              <option value="Industrial Size Grading" <%= values && values.service_type === 'Industrial Size Grading' ? 'selected' : '' %>>Industrial Size Grading (Multi-Size Runs)</option>
              <option value="CAD Pattern Conversion" <%= values && values.service_type === 'CAD Pattern Conversion' ? 'selected' : '' %>>CAD Format Conversion (Gerber, Lectra, DXF-AAMA)</option>
              <option value="Mini Marker & Fabric Lay Plan" <%= values && values.service_type === 'Mini Marker & Fabric Lay Plan' ? 'selected' : '' %>>Mini Marker &amp; Fabric Lay Plan Optimization</option>
              <option value="Trial Fit Sample Development" <%= values && values.service_type === 'Trial Fit Sample Development' ? 'selected' : '' %>>Trial Fit Sample Development</option>
              <option value="Other Technical Service" <%= values && values.service_type === 'Other Technical Service' ? 'selected' : '' %>>Other Custom Requirement</option>
            </select>
          </div>

          <!-- Detailed Requirements -->
          <div class="cb-field-full">
            <label class="cb-label" for="cbRequirements">Detailed Requirements / Specifications <span class="req">*</span></label>
            <textarea
              id="cbRequirements"
              name="requirements"
              class="cb-textarea"
              rows="4"
              maxlength="5000"
              placeholder="Describe your garment specifications, target measurements, fabric type, desired file formats (e.g. DXF, HPGL, PDF), or specific fit adjustments needed..."
              required
            ><%= values && (values.requirements || values.message) ? (values.requirements || values.message) : '' %></textarea>
          </div>
        </div>

        <div class="cb-actions">
          <button type="submit" id="btnSubmitCustomBlock" class="cb-btn-submit">
            <span>Submit Custom Block Request</span>
            <span aria-hidden="true">&rarr;</span>
          </button>

          <% const configuredWa = (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.whatsapp_number && typeof siteSettings.whatsapp_number === 'string') ? siteSettings.whatsapp_number.trim() : ''; %>
          <% const cleanWaDigits = configuredWa ? configuredWa.replace(/\D/g, '') : ''; %>

          <% if (cleanWaDigits) { %>
          <button type="button" id="btnContactWhatsapp" class="cb-btn-whatsapp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.539 1.951.819 2.791.819 3.18 0 5.767-2.587 5.767-5.767.001-3.181-2.583-5.768-5.767-5.768zm0 10.377c-.77 0-1.636-.239-2.32-.647l-.166-.099-1.579.414.421-1.54-.109-.172c-.482-.767-.77-1.616-.77-2.567 0-2.535 2.063-4.597 4.599-4.597 2.534 0 4.597 2.062 4.597 4.598 0 2.536-2.062 4.598-4.597 4.598zm7.324-11.834c-1.947-1.949-4.536-3.02-7.325-3.02-5.706 0-10.347 4.64-10.349 10.348 0 1.823.476 3.604 1.379 5.17l-1.464 5.348 5.474-1.436c1.509.822 3.208 1.256 4.96 1.256h.004c5.705 0 10.347-4.641 10.349-10.349 0-2.763-1.07-5.352-3.028-7.317z"/>
            </svg>
            <span>Contact on WhatsApp</span>
          </button>
          <div class="cb-wa-note" id="cbWaNote">
            Opens WhatsApp with your prefilled details. You can review the message and press <strong>Send</strong> to connect directly with our technologist.
          </div>
          <% } else { %>
          <button type="button" id="btnContactWhatsapp" class="cb-btn-whatsapp" disabled style="opacity: 0.55; cursor: not-allowed; background: #94A3B8;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.539 1.951.819 2.791.819 3.18 0 5.767-2.587 5.767-5.767.001-3.181-2.583-5.768-5.767-5.768zm0 10.377c-.77 0-1.636-.239-2.32-.647l-.166-.099-1.579.414.421-1.54-.109-.172c-.482-.767-.77-1.616-.77-2.567 0-2.535 2.063-4.597 4.599-4.597 2.534 0 4.597 2.062 4.597 4.598 0 2.536-2.062 4.598-4.597 4.598zm7.324-11.834c-1.947-1.949-4.536-3.02-7.325-3.02-5.706 0-10.347 4.64-10.349 10.348 0 1.823.476 3.604 1.379 5.17l-1.464 5.348 5.474-1.436c1.509.822 3.208 1.256 4.96 1.256h.004c5.705 0 10.347-4.641 10.349-10.349 0-2.763-1.07-5.352-3.028-7.317z"/>
            </svg>
            <span>Contact on WhatsApp (Unavailable)</span>
          </button>
          <div class="cb-wa-note" id="cbWaNote" style="color: #64748B;">
            Direct WhatsApp contact is currently unconfigured in studio settings. Please submit the form above to reach our team.
          </div>
          <% } %>
        </div>

        <div class="cb-trust-bar">
          <span class="cb-trust-item">&#10003; NIFT Technologist Led</span>
          <span class="cb-trust-item">&#10003; Industrial CAD Ready</span>
          <span class="cb-trust-item">&#10003; Pre-Calibrated Grading</span>
          <span class="cb-trust-item">&#10003; Confidential &amp; Secure</span>
        </div>
      </form>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script>
  (function() {
    const form = document.getElementById('customBlockForm');
    const alertBox = document.getElementById('cbStatusAlert');
    const submitBtn = document.getElementById('btnSubmitCustomBlock');
    const whatsappBtn = document.getElementById('btnContactWhatsapp');
    const ownerNumber = '<%= (typeof siteSettings !== "undefined" && siteSettings && siteSettings.whatsapp_number && typeof siteSettings.whatsapp_number === "string") ? siteSettings.whatsapp_number.replace(/\\D/g, "") : "" %>';

    function showAlert(msg, isSuccess = false) {
      if (!alertBox) return;
      alertBox.textContent = msg;
      alertBox.className = 'cb-alert ' + (isSuccess ? 'cb-alert-success' : 'cb-alert-error');
      alertBox.style.display = 'block';
      alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // Contact on WhatsApp (enabled only when Admin configured number exists)
    if (ownerNumber) {
      whatsappBtn?.addEventListener('click', function() {
        const name = document.getElementById('cbName')?.value.trim() || '';
        const category = document.getElementById('cbCategory')?.value || '';
        const serviceType = document.getElementById('cbServiceType')?.value || '';
        const phone = document.getElementById('cbWhatsapp')?.value.trim() || '';
        const reqs = document.getElementById('cbRequirements')?.value.trim() || '';

        const lines = [
          'Hello Apparel Easy Patterns,',
          'I would like to request a Custom Block / Technical Patternmaking enquiry:',
          name ? '• Name: ' + name : null,
          phone ? '• Phone: ' + phone : null,
          category ? '• Category: ' + category : null,
          serviceType ? '• Service: ' + serviceType : null,
          reqs ? '• Requirements:\n' + reqs : null
        ].filter(Boolean);

        const messageText = lines.join('\n');
        const waUrl = 'https://wa.me/' + ownerNumber + '?text=' + encodeURIComponent(messageText);
        window.open(waUrl, '_blank', 'noopener,noreferrer');
      });
    }

    // AJAX Form Submission
    form?.addEventListener('submit', async function(e) {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (alertBox) alertBox.style.display = 'none';
      submitBtn.disabled = true;
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = '<span>Submitting Request...</span>';

      const formData = new FormData(form);
      const payload = new URLSearchParams(formData).toString();

      try {
        const res = await fetch('/enquiries', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: payload
        });

        const data = await res.json().catch(() => null);
        if (!res.ok || !data || !data.success) {
          throw new Error(data && data.error ? data.error : (res.status === 429 ? 'Please wait a moment before sending another enquiry.' : 'Could not submit your request. Please check all fields and try again.'));
        }

        showAlert(data.message || '✓ Your custom block request has been submitted successfully. Our patternmaking studio team will review your requirements and reach out promptly.', true);
        form.reset();
      } catch (err) {
        showAlert(err.message || 'An error occurred while submitting your request.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    });
  })();
  </script>
</body>
</html>
