<!DOCTYPE html><html lang="en"><head><%- include('../partials/business-head') %></head><body><%- include('../partials/header') %><main class="studio-page"><% const course=kind==='courses'; const fee=accessQuote(kind,item); const picture=course?item.image_url:item.banner_image; %><h1><%= title %></h1><% if(picture){ %><img class="studio-cover" src="<%= picture %>" alt="<%= title %>"><% } %><p><%= course?item.short_description:'' %></p><p><strong><%= Number(fee.price)===0?'Free':'₹'+Number(fee.price).toLocaleString('en-IN') %></strong> · <%= item.mode %></p><p><%= course?'Trainer: '+(item.trainer || 'Studio team'):'Speaker: '+(item.speaker || 'Studio team') %></p><p>Duration: <%= course?item.duration:item.duration_minutes+' minutes' %></p><h2>About <%= course?'the Course':'the Webinar' %></h2><div class="studio-prose"><%= item.description %></div>
<% if(course){ %><section class="studio-section"><h2>Course Modules</h2><ol><% (Array.isArray(item.modules)?item.modules:[]).forEach(module=>{ %><li class="studio-prose"><%= module %></li><% }) %></ol><h2>Schedule Information</h2><p class="studio-prose"><%= item.schedule_information || 'Submit your preferred schedule below.' %></p></section><% }else{ %><p><strong><%= new Date(item.starts_at).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'}) %> IST (UTC+05:30)</strong></p><p>Platform: <%= item.meeting_platform %>. Joining details are available only after confirmation.</p><p>Maximum seats: <%= item.max_seats || 'No fixed limit' %></p><% } %>
<% if(featureEnabled('paid_access') && (course || (item.registration_open && new Date(item.starts_at)>new Date()))){ %><section class="studio-section" id="booking"><h2><%= course?'Book This Course':'Register for This Webinar' %></h2><% if(course){ %><p>Complete registration and any required payment below. Your preferred schedule is subject to confirmation; All preferred times are in India Standard Time (UTC+05:30).</p><% }else{ %><p><%= fee.price>0?'Register, then pay securely through Razorpay to confirm your seat.':'This webinar is free. Registration confirms your seat when available.' %></p><% } %><% if(error){ %><p role="alert" class="studio-errors"><%= error %></p><% } %><form method="post" action="/<%= kind %>/<%= encodeURIComponent(item.slug) %>/<%= course?'book':'register' %>" class="studio-form"><input type="hidden" name="_csrf" value="<%= learningCsrf %>"><% if(course){ %><input type="hidden" name="submission_key" value="<%= bookingNonce %>"><label>Course<input value="<%= item.name %>" readonly></label><% } %>
<% const fields=course?[["name","Name","text",true],["email","Email","email",true],["whatsapp","WhatsApp with country code","tel",true],["preferred_date","Preferred Date (IST)","date",true],["preferred_time","Preferred Time (IST)","time",true],["experience_level","Experience Level","text",false]]:[["full_name","Full Name","text",true],["email","Email","email",true],["whatsapp","WhatsApp with country code","tel",true],["country","Country","text",false],["city","City","text",false],["profession","Profession","text",false],["experience_level","Experience Level","text",false]]; fields.forEach(([key,label,type,required])=>{ %><label><%= label %><%= required?' *':'' %><input type="<%= type %>" name="<%= key %>" maxlength="<%= key==='email'?254:key==='whatsapp'?30:200 %>" value="<%= typeof values[key]==='string'?values[key]:'' %>" <%= required?'required':'' %>></label><% }) %>
<% if(course){ %><label>Mode<select name="mode" required><% (item.mode==='Online / Offline'?['Online','Offline']:[item.mode]).forEach(mode=>{ %><option <%= values.mode===mode?'selected':'' %>><%= mode %></option><% }) %></select></label><label class="studio-wide">Notes<textarea name="notes" maxlength="5000" rows="5"><%= values.notes || '' %></textarea></label><% } %><div class="studio-wide"><button type="submit" class="fashion-button"><%= fee.button + (fee.price>0?' ? ?'+fee.price.toLocaleString('en-IN'):' ? Free') %></button></div></form></section><% }else{ %><p>Registration is currently closed.</p><% } %><%- include('../partials/business-cta') %><%- include('../partials/support-contact') %></main><%- include('../partials/footer') %><script src="/js/main.js"></script></body></html>
