<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title || product?.name || 'Garment Pattern Store' %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/customer-experience.css">

  <style>
    /* =====================================================
       PRODUCT DETAIL — PREMIUM GARMENT STORE
    ===================================================== */

    :root {
      --ink: #18161a;
      --muted: #77717a;
      --cream: #f7f4ef;
      --white: #ffffff;
      --line: #e8e2db;
      --brown: #684a36;
      --brown-dark: #2a211c;
      --sand: #ead6bf;
      --gold: #b58a54;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--cream);
      color: var(--ink);
      font-family: "DM Sans", Arial, sans-serif;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font-family: inherit;
    }

    /* =====================================================
       HEADER
    ===================================================== */

    .pd-header {
      position: sticky;
      top: 0;
      z-index: 1000;

      background: rgba(255,255,255,.94);
      backdrop-filter: blur(18px);

      border-bottom: 1px solid var(--line);
    }

    .pd-nav {
      width: min(1180px, calc(100% - 40px));
      height: 76px;
      margin: auto;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
    }

    .pd-brand {
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .pd-brand-mark {
      width: 38px;
      height: 38px;

      display: grid;
      place-items: center;

      border-radius: 11px;

      color: #fff;
      background: linear-gradient(135deg, #2a211c, #77533b);

      font-family: "Playfair Display", serif;
      font-size: 13px;
      font-weight: 700;
    }

    .pd-brand-text {
      display: flex;
      flex-direction: column;
      line-height: 1.05;
    }

    .pd-brand-text strong {
      font-size: 13px;
      letter-spacing: -.2px;
    }

    .pd-brand-text small {
      margin-top: 4px;

      color: #989097;

      font-size: 7px;
      letter-spacing: 1.3px;
      text-transform: uppercase;
    }

    .pd-menu {
      display: flex;
      align-items: center;
      gap: 29px;
    }

    .pd-menu a {
      color: #625d63;

      font-size: 11px;
      font-weight: 600;

      transition: .2s ease;
    }

    .pd-menu a:hover {
      color: var(--ink);
    }

    .pd-actions {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .pd-signin {
      color: #625d63;
      font-size: 11px;
      font-weight: 600;
    }

    .pd-cart {
      padding: 11px 16px;

      border-radius: 9px;

      color: #fff;

      background: var(--ink);

      font-size: 10px;
      font-weight: 700;
    }

    /* =====================================================
       PAGE
    ===================================================== */

    .pd-page {
      width: min(1180px, calc(100% - 40px));
      margin: auto;
      padding: 30px 0 90px;
    }

    /* =====================================================
       BREADCRUMB
    ===================================================== */

    .pd-breadcrumb {
      display: flex;
      align-items: center;
      gap: 10px;

      margin-bottom: 28px;

      color: #8c858d;

      font-size: 9px;
      font-weight: 600;
    }

    .pd-breadcrumb .current {
      color: var(--brown);
    }

    /* =====================================================
       PRODUCT GRID
    ===================================================== */

    .pd-product {
      display: grid;
      grid-template-columns: 1.04fr .96fr;

      gap: 54px;

      align-items: start;
    }

    /* =====================================================
       PRODUCT VISUAL
    ===================================================== */

    .pd-visual {
      position: sticky;
      top: 105px;
    }

    .pd-image-box {
      position: relative;

      min-height: 620px;

      overflow: hidden;

      border-radius: 24px;

      background:
        radial-gradient(
          circle at 50% 25%,
          rgba(255,255,255,.75),
          transparent 30%
        ),
        linear-gradient(
          145deg,
          #eee5dc,
          #d9cec3
        );

      box-shadow:
        0 25px 65px rgba(45,31,20,.10);
    }

    .pd-image-box img {
      width: 100%;
      height: 620px;

      object-fit: cover;
    }

    .pd-image-label {
      position: absolute;
      top: 25px;
      left: 27px;

      color: #786c63;

      font-size: 8px;
      font-weight: 800;

      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .pd-number {
      position: absolute;
      top: 24px;
      right: 26px;

      color: rgba(60,45,35,.35);

      font-family: "Playfair Display", serif;
      font-size: 13px;
    }

    /* Pattern placeholder */

    .pd-placeholder {
      width: 100%;
      height: 620px;

      position: relative;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .pd-placeholder::before {
      content: "";

      position: absolute;

      width: 240px;
      height: 420px;

      border: 1px solid rgba(100,78,62,.35);

      border-radius: 125px 125px 28px 28px;

      transform: scaleX(.68);

      opacity: .65;
    }

    .pd-shirt {
      position: relative;

      width: 180px;
      height: 250px;

      border: 1px solid rgba(80,60,45,.42);

      clip-path: polygon(
        29% 0,
        44% 0,
        50% 12%,
        56% 0,
        71% 0,
        100% 18%,
        82% 38%,
        75% 27%,
        75% 100%,
        25% 100%,
        25% 27%,
        18% 38%,
        0 18%
      );

      opacity: .75;
    }

    .pd-placeholder-name {
      position: absolute;
      bottom: 65px;

      font-family: "Playfair Display", serif;
      font-size: 26px;
    }

    .pd-placeholder-sub {
      position: absolute;
      bottom: 47px;

      color: #8a7e75;

      font-size: 7px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    /* =====================================================
       PRODUCT INFO
    ===================================================== */

    .pd-info {
      padding-top: 8px;
    }

    .pd-kicker {
      display: block;

      margin-bottom: 12px;

      color: var(--brown);

      font-size: 9px;
      font-weight: 800;

      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .pd-title {
      margin: 0;

      font-family: "Playfair Display", serif;

      font-size: clamp(48px, 5vw, 68px);
      line-height: .94;

      letter-spacing: -2px;
    }

    .pd-description {
      max-width: 540px;

      margin: 18px 0 26px;

      color: var(--muted);

      font-size: 13px;
      line-height: 1.75;
    }

    /* =====================================================
       PRICE
    ===================================================== */

    .pd-price-card {
      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 20px 22px;

      margin-bottom: 25px;

      border: 1px solid var(--line);
      border-radius: 15px;

      background: rgba(255,255,255,.72);
    }

    .pd-price-label {
      display: block;

      margin-bottom: 7px;

      color: #8a8188;

      font-size: 7px;
      font-weight: 800;

      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .pd-price {
      font-family: "Playfair Display", serif;
      font-size: 25px;
    }

    .pd-price-note {
      color: #999198;
      font-size: 9px;
    }

    /* =====================================================
       SELECTION
    ===================================================== */

    .pd-section-title {
      display: flex;
      align-items: center;
      gap: 12px;

      margin-bottom: 13px;
    }

    .pd-step {
      width: 25px;
      height: 25px;

      display: grid;
      place-items: center;

      border-radius: 50%;

      color: #fff;

      background: var(--ink);

      font-size: 8px;
      font-weight: 800;
    }

    .pd-section-title strong {
      font-size: 12px;
    }

    .pd-section-title small {
      display: block;

      margin-top: 3px;

      color: #9b9399;

      font-size: 8px;
    }

    .pd-options {
      display: grid;
      gap: 9px;

      margin-bottom: 24px;
    }

    .pd-option {
      width: 100%;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 15px 15px;

      border: 1px solid #ddd4cc;
      border-radius: 13px;

      background: #fff;

      cursor: pointer;

      text-align: left;

      transition:
        border-color .2s ease,
        box-shadow .2s ease,
        transform .2s ease;
    }

    .pd-option:hover {
      transform: translateY(-1px);

      border-color: var(--gold);

      box-shadow: 0 7px 20px rgba(80,50,25,.07);
    }

    .pd-option.active {
      border-color: var(--gold);

      box-shadow:
        0 0 0 1px var(--gold),
        0 8px 24px rgba(100,70,40,.08);
    }

    .pd-option-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .pd-option-icon {
      width: 32px;
      height: 32px;

      display: grid;
      place-items: center;

      border-radius: 9px;

      color: #fff;

      background: linear-gradient(
        135deg,
        #3b2d24,
        #896246
      );

      font-size: 8px;
      font-weight: 800;
    }

    .pd-option-name {
      display: block;

      font-size: 10px;
      font-weight: 800;
    }

    .pd-option-description {
      display: block;

      margin-top: 4px;

      color: #958d92;

      font-size: 7px;
    }

    .pd-option-price {
      color: #4e4036;

      font-size: 9px;
      font-weight: 800;
    }

    /* =====================================================
       TOTAL
    ===================================================== */

    .pd-total {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;

      padding: 19px 20px;

      border-radius: 15px;

      color: #fff;

      background:
        linear-gradient(
          135deg,
          #171419,
          #2b211d
        );

      box-shadow:
        0 15px 35px rgba(20,15,15,.18);
    }

    .pd-total-label {
      display: block;

      margin-bottom: 5px;

      color: rgba(255,255,255,.5);

      font-size: 7px;
      font-weight: 800;

      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .pd-total-price {
      font-family: "Playfair Display", serif;
      font-size: 25px;
    }

    .pd-add {
      min-width: 135px;

      padding: 14px 18px;

      border: 0;
      border-radius: 10px;

      color: #2a211c;

      background: #e8c49a;

      cursor: pointer;

      font-size: 9px;
      font-weight: 800;

      transition: .2s ease;
    }

    .pd-add:hover {
      transform: translateY(-2px);

      background: #f0d0aa;
    }

    /* =====================================================
       TRUST
    ===================================================== */

    .pd-trust {
      display: grid;
      grid-template-columns: 1fr 1fr;

      gap: 9px;

      margin-top: 10px;
    }

    .pd-trust-card {
      padding: 14px;

      border: 1px solid var(--line);
      border-radius: 12px;

      background: rgba(255,255,255,.72);
    }

    .pd-trust-card strong {
      display: block;

      margin-bottom: 4px;

      font-size: 8px;
    }

    .pd-trust-card span {
      color: #958c92;

      font-size: 7px;
    }

    /* =====================================================
       DETAILS SECTION
    ===================================================== */

    .pd-details {
      margin-top: 85px;

      padding-top: 55px;

      border-top: 1px solid var(--line);
    }

    .pd-details-grid {
      display: grid;
      grid-template-columns: 1fr 2fr;

      gap: 70px;
    }

    .pd-details-title {
      margin: 0;

      font-family: "Playfair Display", serif;

      font-size: 36px;
      line-height: 1.05;
    }

    .pd-details-copy {
      color: var(--muted);

      font-size: 13px;
      line-height: 1.8;
    }

    .pd-feature-grid {
      display: grid;
      grid-template-columns: repeat(2,1fr);

      gap: 12px;

      margin-top: 24px;
    }

    .pd-feature {
      padding: 18px;

      border: 1px solid var(--line);
      border-radius: 13px;

      background: #fff;
    }

    .pd-feature strong {
      display: block;

      margin-bottom: 5px;

      font-size: 10px;
    }

    .pd-feature span {
      color: #8c858b;

      font-size: 8px;
      line-height: 1.5;
    }

    /* =====================================================
       FOOTER
    ===================================================== */

    .pd-footer {
      margin-top: 20px;

      background: #171419;
      color: #fff;
    }

    .pd-footer-inner {
      width: min(1180px, calc(100% - 40px));
      margin: auto;

      padding: 55px 0 22px;
    }

    .pd-footer-grid {
      display: grid;
      grid-template-columns: 1.7fr 1fr 1fr 1fr;

      gap: 40px;

      padding-bottom: 40px;
    }

    .pd-footer-brand strong {
      display: block;

      margin-bottom: 12px;

      font-family: "Playfair Display", serif;

      font-size: 20px;
    }

    .pd-footer-brand p {
      max-width: 310px;

      margin: 0;

      color: rgba(255,255,255,.55);

      font-size: 10px;
      line-height: 1.7;
    }

    .pd-footer-col h4 {
      margin: 0 0 14px;

      font-size: 9px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .pd-footer-col a,
    .pd-footer-col span {
      display: block;

      margin-bottom: 9px;

      color: rgba(255,255,255,.55);

      font-size: 9px;
    }

    .pd-footer-bottom {
      display: flex;
      justify-content: space-between;
      gap: 20px;

      padding-top: 18px;

      border-top: 1px solid rgba(255,255,255,.08);

      color: rgba(255,255,255,.35);

      font-size: 8px;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 900px) {

      .pd-product {
        grid-template-columns: 1fr;

        gap: 35px;
      }

      .pd-visual {
        position: relative;
        top: auto;
      }

      .pd-image-box,
      .pd-placeholder {
        min-height: 520px;
        height: 520px;
      }

      .pd-image-box img {
        height: 520px;
      }

      .pd-menu {
        display: none;
      }

      .pd-details-grid {
        grid-template-columns: 1fr;
        gap: 25px;
      }

      .pd-footer-grid {
        grid-template-columns: repeat(2,1fr);
      }
    }

    @media (max-width: 600px) {

      .pd-nav,
      .pd-page,
      .pd-footer-inner {
        width: calc(100% - 26px);
      }

      .pd-brand-text {
        display: none;
      }

      .pd-actions {
        gap: 9px;
      }

      .pd-signin {
        display: none;
      }

      .pd-title {
        font-size: 48px;
      }

      .pd-price-card {
        padding: 17px;
      }

      .pd-total {
        align-items: stretch;
        flex-direction: column;
      }

      .pd-add {
        width: 100%;
      }

      .pd-trust,
      .pd-feature-grid {
        grid-template-columns: 1fr;
      }

      .pd-footer-grid {
        grid-template-columns: 1fr;
      }

      .pd-footer-bottom {
        flex-direction: column;
      }
    }
  </style>
<%- include('partials/theme') %><link rel="stylesheet" href="/css/business.css"></head>

<body>

  <!-- =====================================================
       HEADER
  ===================================================== -->

  <%- include('partials/header') %>


  <!-- =====================================================
       MAIN
  ===================================================== -->

  <main class="pd-page">


    <!-- Breadcrumb -->

    <div class="pd-breadcrumb">

      <% if(canVisit('/')){ %><a href="/">
        Home
      </a><% } %>

      <span>/</span>

      <% if(canVisit('/products')){ %><a href="/products">
        Patterns
      </a><% } %>

      <span>/</span>

      <span class="current">
        <%= product.name %>
      </span>

    </div>


    <!-- Product -->

    <section class="pd-product">


      <!-- =================================================
           LEFT — PRODUCT VISUAL
      ================================================= -->

      <div class="pd-visual">

        <div class="pd-image-box">

          <span class="pd-image-label">
            PROFESSIONAL PATTERN
          </span>

          <span class="pd-number">
            01
          </span>


          <% if (product.images && product.images.length > 0 && product.images[0] && product.images[0] !== '2') { %>

            <img
              src="<%= product.images[0] %>"
              alt="<%= product.name %>"
            >

          <% } else { %>

            <div class="pd-placeholder">

              <div class="pd-shirt"></div>

              <strong class="pd-placeholder-name">
                <%= product.name %>
              </strong>

              <span class="pd-placeholder-sub">
                GARMENT CONSTRUCTION PATTERN
              </span>

            </div>

          <% } %>

        </div>

      </div>


      <!-- =================================================
           RIGHT — PRODUCT INFO
      ================================================= -->

      <div class="pd-info">

        <span class="pd-kicker">
          PROFESSIONAL GARMENT PATTERN
        </span>


        <h1 class="pd-title">
          <%= product.name %>
        </h1>


        <p class="pd-description">
          <%= product.description || 'Professionally developed garment pattern designed for accurate construction, sampling and production.' %>
        </p>


<% const details=[['size_information','Available sizes'],['file_formats','File formats']].filter(([key])=>typeof product[key]==='string' && product[key].trim()); %>
<% if(details.length){ %><dl class="pattern-specifications"><% details.forEach(([key,label])=>{ %><dt><strong><%= label %></strong></dt><dd><%= product[key] %></dd><% }) %></dl><% } %>
<% if(product.amazon_listing_url){ %><a class="fashion-button" href="<%= product.amazon_listing_url %>" target="_blank" rel="noopener noreferrer">Buy on Amazon</a><% } %>
        <!-- Base Price -->

        <div class="pd-price-card">

          <div>

            <span class="pd-price-label">
              Base Pattern Price
            </span>

            <strong class="pd-price">
              ₹<%= Number(product.base_price || product.price || 0).toLocaleString('en-IN', {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
              }) %>
            </strong>

          </div>

          <span class="pd-price-note">
            Starting Price
          </span>

        </div>


        <!-- =================================================
             FORMAT SELECTION
        ================================================= -->

        <div class="pd-section-title">

          <span class="pd-step">
            01
          </span>

          <div>

            <strong>
              Select Pattern Format
            </strong>

            <small>
              Choose the files and services you require.
            </small>

          </div>

        </div>


        <div class="pd-options">


          <!-- DIGITAL -->

          <button
            type="button"
            class="pd-option active"
            data-type="digital"
            data-price="<%= Number(product.base_price || 0) %>"
          >

            <span class="pd-option-left">

              <span class="pd-option-icon">
                PDF
              </span>

              <span>

                <span class="pd-option-name">
                  Digital Pattern
                </span>

                <span class="pd-option-description">
                  Professional downloadable pattern
                </span>

              </span>

            </span>

            <span class="pd-option-price">
              ₹<%= Number(product.base_price || 0).toLocaleString('en-IN') %> / first size
            </span>

          </button>


          <!-- PHYSICAL -->

          <button
            type="button"
            class="pd-option"
            data-type="physical"
            data-price="<%= Number(product.physical_price || 0) %>"
          >

            <span class="pd-option-left">

              <span class="pd-option-icon">
                PHY
              </span>

              <span>

                <span class="pd-option-name">
                  Physical Pattern
                </span>

                <span class="pd-option-description">
                  Printed production-ready pattern
                </span>

              </span>

            </span>

            <span class="pd-option-price">

              <% if (Number(product.physical_price || 0) > 0) { %>

                +₹<%= Number(product.physical_price).toLocaleString('en-IN') %>

              <% } else { %>

                Included

              <% } %>

            </span>

          </button>


          <!-- TRIAL SAMPLE -->

          <button
            type="button"
            class="pd-option"
            data-type="trial"
            data-price="<%= Number(product.trial_price || 0) %>"
          >

            <span class="pd-option-left">

              <span class="pd-option-icon">
                TS
              </span>

              <span>

                <span class="pd-option-name">
                  Trial Sample
                </span>

                <span class="pd-option-description">
                  Sample garment for fit verification
                </span>

              </span>

            </span>

            <span class="pd-option-price">

              <% if (Number(product.trial_price || 0) > 0) { %>

                +₹<%= Number(product.trial_price).toLocaleString('en-IN') %>

              <% } else { %>

                Included

              <% } %>

            </span>

          </button>


          <!-- ADDONS FROM DATABASE -->

          <% if (addons && addons.length > 0) { %>

            <% addons.forEach((addon) => { %>

              <button
                type="button"
                class="pd-option"
                data-type="addon"
                data-id="<%= addon._id %>"
                data-price="<%= Number(addon.price || 0) %>"
              >

                <span class="pd-option-left">

                  <span class="pd-option-icon">
                    +
                  </span>

                  <span>

                    <span class="pd-option-name">
                      <%= addon.name %>
                    </span>

                    <span class="pd-option-description">
                      <%= addon.description || 'Additional pattern service' %>
                    </span>

                  </span>

                </span>

                <span class="pd-option-price">

                  +₹<%= Number(addon.price || 0).toLocaleString('en-IN') %>

                </span>

              </button>

            <% }) %>

          <% } %>


        </div>


        <div class="pd-price-card" style="display:block">
          <label for="pattern-sizes">Selected sizes (comma separated)</label>
          <input id="pattern-sizes" maxlength="500" placeholder="Enter selected sizes, separated by commas" required style="width:100%;padding:12px;margin:8px 0">
          <p>Enter the sizes required. One digital size is included in the base price; each additional size costs ₹<%= Number(product.additional_size_price || 0).toLocaleString('en-IN') %>. Physical patterns cost ₹<%= Number(product.physical_price || 0).toLocaleString('en-IN') %> per size. A selected trial sample is made for each selected size.</p>
