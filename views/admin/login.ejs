<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"><style>body{margin:0;background:#eee9e3;font-family:Arial;color:#211b19}.login-shell{min-height:100vh;display:grid;place-items:center;padding:24px}.login-card{width:min(420px,100%);padding:42px;background:#fff;border:1px solid #ddd5ce;box-shadow:0 24px 70px rgba(43,29,23,.12)}.login-brand{display:flex;align-items:center;gap:13px;margin-bottom:32px}.login-mark{display:grid;place-items:center;width:52px;height:52px;border-radius:50%;background:#211a18;color:#fff;font:700 16px Georgia}.login-brand strong,.login-brand small{display:block}.login-brand small{margin-top:5px;color:#8a807a;font-size:9px;letter-spacing:1.2px}.login-card h1{margin:0;font:500 35px Georgia}.login-card>p{color:#776d68;line-height:1.6}.login-card label{display:block;margin:18px 0 7px;font-size:11px;font-weight:700}.login-card input[type=text],.login-card input[type=password]{box-sizing:border-box;width:100%;padding:13px;border:1px solid #dcd4cd}.password-wrap{position:relative}.password-wrap button{position:absolute;right:8px;top:7px;padding:7px;border:0;background:none;color:#755244;cursor:pointer}.remember{display:flex!important;align-items:center;gap:8px;font-weight:400!important}.login-card .btn{width:100%;margin-top:12px;padding:14px}.login-alert{padding:12px;background:#f9e3df;color:#812f28;font-size:12px}</style></head><body><main class="login-shell"><section class="login-card"><div class="login-brand"><span class="login-mark">GP</span><div><strong>Garment Pattern Store</strong><small>BUSINESS CONTROL CENTER</small></div></div><h1>Admin Login</h1><p>Sign in with your authorised administrator credentials.</p><% if(message){ %><div class="login-alert" role="alert"><%= message %></div><% } %><form method="post" action="/admin/login"><label for="username">Username</label><input id="username" name="username" type="text" autocomplete="username" required autofocus><label for="password">Password</label><div class="password-wrap"><input id="password" name="password" type="password" autocomplete="current-password" required><button type="button" id="show-password">Show</button></div><label class="remember"><input type="checkbox" name="remember"> Remember me for 30 days</label><button class="btn primary" type="submit">Sign In Securely</button></form></section></main><script>document.getElementById('show-password').addEventListener('click',function(){const p=document.getElementById('password'),show=p.type==='password';p.type=show?'text':'password';this.textContent=show?'Hide':'Show'})</script></body></html>
