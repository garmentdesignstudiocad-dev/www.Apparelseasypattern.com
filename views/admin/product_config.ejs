<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    .fit-header-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px; }
    .fit-search-box { width: 100%; max-width: 380px; padding: 10px 14px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 14px; }
    .fit-badge { display: inline-block; padding: 3px 8px; border-radius: 6px; font-size: 12px; font-weight: 700; text-transform: uppercase; }
    .fit-badge--active { background: #DCFCE7; color: #166534; }
    .fit-badge--inactive { background: #F1F5F9; color: #64748B; }
    .fit-table td, .fit-table th { padding: 12px 14px; text-align: left; }
    .fit-grid-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; align-items: end; margin-bottom: 24px; background: #F8FAFC; padding: 18px; border-radius: 10px; border: 1px solid #E2E8F0; }
  </style>
</head>
<body>
  <%- include('../partials/admin_header') %>
  <main class="container section">
    <div style="margin-bottom: 20px;">
      <a href="/admin" style="font-size: 13px; color: #64748B; text-decoration: none;">&larr; Back to Dashboard</a>
    </div>

    <div class="fit-header-bar">
      <div>
        <p class="eyebrow" style="color: #D97706; font-weight: 700; margin: 0 0 4px;">Settings &rsaquo; Product Configuration</p>
        <h1 style="margin: 0; font-size: 26px; color: #0B192C;">Dynamic Garment Fits &amp; Options</h1>
      </div>
      <div style="display: flex; gap: 10px; align-items: center;">
        <form method="post" action="/admin/settings/product-config/seed-100">
          <input type="hidden" name="_csrf" value="<%= csrf || '' %>">
          <button type="submit" class="btn small" style="background: #1E3E62; color: #FFF;" title="Add 100+ standard industrial garment fits">
            + Seed 100+ Fits Library
          </button>
        </form>
      </div>
    </div>

    <% if (message) { %>
      <div class="alert" style="margin-bottom: 20px; padding: 12px 16px; background: #DCFCE7; color: #166534; border-radius: 8px;">
        <%= message %>
      </div>
    <% } %>

    <section class="card" style="margin-bottom: 30px;">
      <div class="card-body">
        <h2 style="font-size: 18px; margin-top: 0; margin-bottom: 12px;">Add New Fit Option</h2>
        <form method="post" action="/admin/settings/product-config/fit" class="fit-grid-form">
          <input type="hidden" name="_csrf" value="<%= csrf || '' %>">
          <label>
            <span style="display:block; font-size:13px; font-weight:700; margin-bottom:4px;">Fit Name *</span>
            <input name="name" required placeholder="e.g. Slim Fit, Euro Tailored" style="width:100%; padding:8px 12px; border:1px solid #CBD5E1; border-radius:6px;">
          </label>
          <label>
            <span style="display:block; font-size:13px; font-weight:700; margin-bottom:4px;">Department</span>
            <select name="department" style="width:100%; padding:8px 12px; border:1px solid #CBD5E1; border-radius:6px; background:#FFF;">
              <option value="All">All Departments</option>
              <option value="Men">Men</option>
              <option value="Women">Women</option>
              <option value="Kids">Kids</option>
            </select>
          </label>
          <label>
            <span style="display:block; font-size:13px; font-weight:700; margin-bottom:4px;">Description / Pattern Notes</span>
            <input name="description" placeholder="e.g. 2-inch chest ease, tapered waist" style="width:100%; padding:8px 12px; border:1px solid #CBD5E1; border-radius:6px;">
          </label>
          <div>
            <button type="submit" class="btn primary" style="width:100%; height:38px;">Save Fit</button>
          </div>
        </form>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
          <input type="text" id="fitFilterInput" class="fit-search-box" placeholder="Search across 100+ fits by name or department...">
          <span style="font-size: 13px; color: #64748B;">
            Total Configured Fits: <strong id="fitCount"><%= fits.length %></strong>
          </span>
        </div>

        <div class="admin-table-wrap">
          <table class="admin-table fit-table" id="fitsTable">
            <thead>
              <tr>
                <th>Fit Name</th>
                <th>Department</th>
                <th>Description</th>
                <th>Status</th>
                <th style="text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!fits || !fits.length) { %>
                <tr>
                  <td colspan="5" style="text-align:center; color:#64748B; padding:30px;">
                    No custom fits configured yet. Click "+ Seed 100+ Fits Library" above to populate industry fits.
                  </td>
                </tr>
              <% } else { %>
                <% fits.forEach(fit => { %>
                  <tr class="fit-row" data-name="<%= fit.name.toLowerCase() %>" data-dept="<%= (fit.department || '').toLowerCase() %>">
                    <td><strong><%= fit.name %></strong></td>
                    <td><span style="padding:2px 8px; background:#F1F5F9; border-radius:4px; font-size:12px;"><%= fit.department || 'All' %></span></td>
                    <td style="color:#64748B; font-size:13px;"><%= fit.description || '—' %></td>
                    <td>
                      <span class="fit-badge <%= fit.active ? 'fit-badge--active' : 'fit-badge--inactive' %>">
                        <%= fit.active ? 'Active' : 'Disabled' %>
                      </span>
                    </td>
                    <td style="text-align: right;">
                      <form method="post" action="/admin/settings/product-config/fit/<%= fit._id %>/toggle" style="display:inline;">
                        <input type="hidden" name="_csrf" value="<%= csrf || '' %>">
                        <button type="submit" class="btn small" style="padding:4px 10px; font-size:12px;">
                          <%= fit.active ? 'Disable' : 'Enable' %>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <script>
    const filterInput = document.getElementById('fitFilterInput');
    const table = document.getElementById('fitsTable');
    const rows = table.querySelectorAll('tbody tr.fit-row');
    const countEl = document.getElementById('fitCount');

    filterInput?.addEventListener('input', function() {
      const q = this.value.toLowerCase().trim();
      let visible = 0;
      rows.forEach(row => {
        const name = row.dataset.name || '';
        const dept = row.dataset.dept || '';
        if (!q || name.includes(q) || dept.includes(q)) {
          row.style.display = '';
          visible++;
        } else {
          row.style.display = 'none';
        }
      });
      if (countEl) countEl.textContent = visible;
    });
  </script>
</body>
</html>
