  <!-- =====================================================
       PRODUCT SELECTION SCRIPT
  ===================================================== -->

 <script>
document.addEventListener('DOMContentLoaded', function () {
  const options=[...document.querySelectorAll('.pd-option')], files=[...document.querySelectorAll('.pattern-file')];
  const sizes=document.getElementById('pattern-sizes'), button=document.getElementById('pdAddToCart');
  const extraPrice=Number('<%= Number(product.additional_size_price || 0) %>');
  const selectedSizes=()=>[...new Set(sizes.value.split(',').map(s=>s.trim()).filter(Boolean))];
  const active=type=>options.some(o=>o.dataset.type===type && o.classList.contains('active'));
  function update(){
    const count=Math.max(1,selectedSizes().length);let total=0;
    options.filter(o=>o.classList.contains('active')).forEach(o=>{total+=Number(o.dataset.price)*( ['physical','trial'].includes(o.dataset.type)?count:1);});
    if(active('digital'))total+=(count-1)*extraPrice+files.filter(f=>f.checked).reduce((n,f)=>n+Number(f.dataset.price),0);
    files.forEach(f=>{f.disabled=!active('digital');});
    document.getElementById('pdTotal').textContent='\u20b9'+total.toLocaleString('en-IN',{maximumFractionDigits:2});
  }
  options.forEach(o=>o.addEventListener('click',()=>{o.classList.toggle('active');o.setAttribute('aria-pressed',o.classList.contains('active'));update();}));
  sizes.addEventListener('input',update);files.forEach(f=>f.addEventListener('change',update));
  button.addEventListener('click',async()=>{
    const selected=selectedSizes();
    if(!selected.length || selected.some(s=>!/^[a-zA-Z0-9 ._-]{1,40}$/.test(s))){alert('Enter the sizes you need, separated by commas.');sizes.focus();return;}
    if(!active('digital') && !active('physical') && !active('trial')){alert('Select digital pattern, physical pattern or trial sample.');return;}
    button.disabled=true;button.textContent='Adding...';
    try{
      const response=await fetch('/cart/add',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
        product_id:'<%= product._id %>',selected_sizes:selected,quantity:active('digital')?1:0,
        physical_quantity:active('physical')?selected.length:0,trial_quantity:active('trial')?selected.length:0,
        files:active('digital')?files.filter(f=>f.checked).map(f=>f.value):[],
        addons:options.filter(o=>o.dataset.type==='addon' && o.classList.contains('active')).map(o=>o.dataset.id)
      })});const result=await response.json();if(!response.ok)throw new Error(result.error || 'Could not add product.');window.location.href='/cart';
    }catch(error){alert(error.message);button.disabled=false;button.textContent='Add to Cart';}
  });update();
});
</script>

