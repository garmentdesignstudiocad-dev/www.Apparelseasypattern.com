<link rel="stylesheet" href="/css/admin.css"><button class="admin-menu-toggle" id="admin-menu-toggle" type="button" aria-label="Toggle admin navigation" aria-controls="admin-sidebar" aria-expanded="false">&#9776;</button><aside class="admin-sidebar" id="admin-sidebar"><a class="admin-sidebar__brand" href="/admin"><span>GP</span><div><strong>Garment Pattern Store</strong><small>Business Control Center</small></div></a><nav aria-label="Owner navigation">
<% const groups={Overview:[['/admin','Dashboard']],...adminNavigation};Object.entries(groups).forEach(([label,links])=>{ %><span class="admin-nav-label"><%= label %></span><% links.forEach(([url,text])=>{ %><a href="<%= url %>"><%= text %></a><% }) %><% }) %></nav><a class="admin-logout" href="/admin/logout">Logout</a></aside><header class="admin-topbar"><div><strong>Owner Control Center</strong><small>Manage store operations</small></div><a class="admin-dashboard-back" href="/admin">Back to Dashboard</a><a href="/" target="_blank" rel="noopener">View Store &rarr;</a></header><script>document.addEventListener('DOMContentLoaded',function(){const b=document.getElementById('admin-menu-toggle'),s=document.getElementById('admin-sidebar');const current=location.pathname.replace(/\/$/,'');const path=current==='/admin/dashboard'?'/admin':current==='/admin/orders-export.csv'?'/admin/orders':current;const links=Array.from(s.querySelectorAll('nav a'));const active=links.filter(a=>path===a.pathname||(a.pathname!=='/admin' && path.startsWith(a.pathname+'/'))).sort((a,b)=>b.pathname.length-a.pathname.length)[0];if(active){active.classList.add('active');active.setAttribute('aria-current','page')}b.addEventListener('click',function(){const open=s.classList.toggle('open');b.setAttribute('aria-expanded',String(open))})});</script>