<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= typeof seoTitle !== 'undefined' && seoTitle ? seoTitle : (siteSettings?.home_title || 'Apparel Easy Patterns') %></title>

  <!-- Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600&display=swap" rel="stylesheet">

  <!-- Core Storefront & Home CSS -->
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/customer-experience.css">
  <link rel="stylesheet" href="/css/storefront-theme.css">
  <link rel="stylesheet" href="/css/home.css">
  <%- include('partials/theme') %>
</head>

<body class="home-page">

  <%- include('partials/header') %>

  <main id="main-content">

    <!-- =========================================================================
         01: HERO BANNER (Matches Approved Reference Image 1)
         ========================================================================= -->
    <section class="home-hero" aria-labelledby="hero-title">

      <% if (siteSettings?.home_video_path) { %>
      <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster="<%= siteSettings?.home_image_path || '/images/hero-fallback.jpg' %>" aria-hidden="true">
        <source src="<%= siteSettings?.home_video_path %>" type="video/mp4">
      </video>
      <% } %>

      <div class="hero-backdrop hero-overlay" aria-hidden="true"></div>

      <div class="container hero-container">

        <div class="hero-split-grid">

          <!-- Left Column: Copy & Actions -->
          <div class="hero-copy-column">

            <div class="hero-badge-group">
              <span class="hero-chip">
                <%= siteSettings?.home_hero_kicker || 'BY GARMENT DESIGN STUDIO' %>
              </span>
            </div>

            <h1 id="hero-title" class="hero-title">
              <span class="sr-only"><%= siteSettings?.homepage_heading || 'Pick a Proven Fit. Stitch Straight Away.' %></span>
              <span aria-hidden="true">Pick a <span class="highlight-gold"><%= siteSettings?.home_hero_title_highlight || 'Proven Fit.' %></span><br><%= siteSettings?.home_hero_title_suffix || 'Stitch Straight Away.' %></span>
            </h1>

            <p class="hero-lead">
              <%= siteSettings?.home_hero_subheading || 'Body-trialled patterns that shorten your timeline and effort, with no starting from scratch.' %>
            </p>

            <div class="hero-actions">
              <% if (canVisit('/products')) { %>
                <a class="fashion-btn fashion-btn--primary" href="/products">
                  <%= siteSettings?.home_hero_primary_button || 'Browse Collection' %> &rarr;
                </a>
              <% } %>
              <% if (canVisit('/classes/enquiry')) { %>
                <a class="fashion-btn fashion-btn--outline" href="/classes/enquiry">
                  <%= siteSettings?.home_hero_secondary_button || 'Request a Custom Block' %>
                </a>
              <% } %>
            </div>

            <!-- Quick Department Pills -->
            <% if (canVisit('/products')) { %>
            <div class="hero-dept-strip" aria-label="Quick collection links">
              <a href="/products?category=men" class="hero-dept-pill">
                <span class="pill-icon" aria-hidden="true">&#128084;</span>
                <span>Menswear</span>
              </a>
              <a href="/products?category=women" class="hero-dept-pill">
                <span class="pill-icon" aria-hidden="true">&#128087;</span>
                <span>Womenswear</span>
              </a>
              <a href="/products?category=kids" class="hero-dept-pill">
                <span class="pill-icon" aria-hidden="true">&#128085;</span>
                <span>Kidswear</span>
              </a>
            </div>
            <% } %>

          </div>

          <!-- Right Column: Mannequin + 3D Illuminated Basic Shirt Block Display -->
          <div class="hero-showcase-column">

            <div class="hero-3d-stage">

              <div class="hero-3d-frame" id="shirt-showcase-frame">

                <div class="frame-header">
                  <span class="frame-badge">
                    <span class="badge-dot"></span>
                    <%= siteSettings?.home_floating_label || 'Basic Shirt Block · Block Library · Digital Files' %>
                  </span>
                  <span class="frame-tag">Promotional CAD Preview</span>
                </div>

                <div class="frame-title-bar">
                  <h3 class="frame-title">
                    <%= siteSettings?.home_floating_text || 'Basic Shirt Block' %>
                  </h3>
                  <span class="frame-fit-label">Industrial Slim Fit · Men</span>
                </div>

                <!-- Showcase Media Canvas with Watermark Protection -->
                <div class="frame-canvas preview-watermark" data-protected-content data-watermark="AEP · PROMOTIONAL PREVIEW" data-vector-blueprint="/images/basic-shirt-pattern.svg">
                  <img
                    class="frame-illustration"
                    src="<%= siteSettings?.home_showcase_image_path || '/images/reference/hero-mannequin-cad.jpg' %>"
                    data-cad-vector="/images/basic-shirt-pattern.svg"
                    alt="<%= siteSettings?.home_image_alt || 'Basic Shirt Block Technical Illustration and Mannequin' %>"
                    width="470"
                    height="270"
                    fetchpriority="high"
                  >
                  <div class="canvas-3d-glow"></div>
                </div>

                <div class="frame-specs-grid">
                  <div class="spec-pill">
                    <span class="spec-label">Components</span>
                    <strong class="spec-val">10-Piece System</strong>
                  </div>
                  <div class="spec-pill">
                    <span class="spec-label">File Formats</span>
                    <strong class="spec-val">DXF · PDF · HPGL</strong>
                  </div>
                  <div class="spec-pill">
                    <span class="spec-label">Grading</span>
                    <strong class="spec-val">Pre-Calibrated</strong>
                  </div>
                </div>

                <p class="frame-caption">
                  Promotional preview only. Illustration only. Confirm sizes and file format before ordering. Full CAD master files (DXF, PDF, HPGL) delivered upon order.
                </p>

                <div class="frame-actions">
                  <% if (canVisit('/products')) { %>
                    <a class="fashion-btn fashion-btn--gold" href="/products?category=men">
                      Explore Menswear Blocks &rarr;
                    </a>
                  <% } %>
                </div>

              </div>

            </div>

          </div>

        </div>

      </div>

    </section>

    <!-- =========================================================================
         02: ONE LIBRARY, THREE WARDROBES (Section 2 in Reference Image 1)
         ========================================================================= -->
    <section class="home-categories" id="categories" aria-labelledby="categories-title">

      <div class="container wardrobes-showcase-container" data-showcase-banner="/images/categories/aep-three-wardrobes.jpg">

        <div class="section-header text-center">
          <h2 id="categories-title" class="section-title section-title--flanked">
            <span class="title-line"></span>
            <span><%= siteSettings?.home_focus_heading || 'One Library, Three Wardrobes' %></span>
            <span class="title-line"></span>
          </h2>
          <p class="section-lead">
            Explore curated pattern blocks engineered for production sampling across Men, Women, and Kids.
          </p>
        </div>

        <!-- 3 Horizontal Split Category Cards matching Reference Image 1 -->
        <div class="categories-ref-grid">

          <!-- MEN -->
          <article class="cat-ref-card cat-ref-card--men">
            <div class="cat-ref-card__photo">
              <img
                src="<%= siteSettings?.home_men_image_path || '/images/collections/men-collection.jpg' %>"
                data-collection-crop="/images/categories/men-collection.jpg"
                alt="Men's Garment Collection"
                loading="lazy"
              >
            </div>
            <div class="cat-ref-card__content">
              <h3 class="cat-ref-title">Men</h3>
              <p class="cat-ref-desc">
                Formal and casual shirts, trousers, tees and denim in slim, regular and relaxed shapes.
              </p>
              <% if (canVisit('/products')) { %>
                <a class="cat-ref-btn" href="/products?category=men" aria-label="Explore Men's Collection">
                  <span>&rarr;</span>
                </a>
              <% } %>
            </div>
          </article>

          <!-- WOMEN -->
          <article class="cat-ref-card cat-ref-card--women">
            <div class="cat-ref-card__photo">
              <img
                src="<%= siteSettings?.home_women_image_path || '/images/collections/women-collection.jpg' %>"
                data-collection-crop="/images/categories/women-collection.jpg"
                alt="Women's Garment Collection"
                loading="lazy"
              >
            </div>
            <div class="cat-ref-card__content">
              <h3 class="cat-ref-title">Women</h3>
              <p class="cat-ref-desc">
                Tops, dresses, kurtas and bottoms cut for comfort and freedom of movement.
              </p>
              <% if (canVisit('/products')) { %>
                <a class="cat-ref-btn" href="/products?category=women" aria-label="Explore Women's Collection">
                  <span>&rarr;</span>
                </a>
              <% } %>
            </div>
          </article>

          <!-- KIDS -->
          <article class="cat-ref-card cat-ref-card--kids">
            <div class="cat-ref-card__photo">
              <img
                src="<%= siteSettings?.home_kids_image_path || '/images/collections/kids-collection.jpg' %>"
                data-collection-crop="/images/categories/kids-collection.jpg"
                alt="Kids Garment Collection"
                loading="lazy"
              >
            </div>
            <div class="cat-ref-card__content">
              <h3 class="cat-ref-title">Kids</h3>
              <p class="cat-ref-desc">
                Age-graded styles with room for active play.
              </p>
              <% if (canVisit('/products')) { %>
                <a class="cat-ref-btn" href="/products?category=kids" aria-label="Explore Kids Collection">
                  <span>&rarr;</span>
                </a>
              <% } %>
            </div>
          </article>

        </div>

      </div>

    </section>

    <!-- =========================================================================
         03: HOW IT WORKS (Section 3 in Reference Image 1)
         ========================================================================= -->
    <section class="home-workflow" aria-labelledby="workflow-title">

      <div class="container">

        <div class="workflow-split-layout">

          <!-- Left Column: Title, Lead & Gold CTA Button -->
          <div class="workflow-intro-side">
            <div class="workflow-eyebrow-wrap">
              <span class="workflow-accent-bar"></span>
              <span class="workflow-eyebrow-text">HOW IT WORKS</span>
            </div>
            <h2 id="workflow-title" class="workflow-main-title">
              <%= siteSettings?.home_available_heading || 'Select, Cut, Sew. Done.' %>
            </h2>
            <p class="workflow-main-lead">
              <%= siteSettings?.home_available_description || 'Order the silhouette you need, cut it in your own fabric and check results on a form. Proportions come pre-balanced, so samples progress faster with less rework.' %>
            </p>
            <% if (canVisit('/products')) { %>
              <div class="workflow-cta-wrap">
                <a class="fashion-btn fashion-btn--primary" href="/products">
                  <%= siteSettings?.home_available_button || 'View All Styles' %> &rarr;
                </a>
              </div>
            <% } %>
          </div>

          <!-- Right Column: 4 Steps Connected by Gold Arrows -->
          <div class="workflow-steps-side">
            <div class="steps-flow-grid">

              <!-- Step 01 -->
              <div class="step-ref-card">
                <span class="step-num-pill">01</span>
                <div class="step-icon-wrap" aria-hidden="true">
                  <!-- T-Shirt Icon -->
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0B192C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.47a1 1 0 00.99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 002-2V10h2.15a1 1 0 00.99-.84l.58-3.47a2 2 0 00-1.34-2.23z"></path></svg>
                </div>
                <h4 class="step-label">Select Pattern</h4>
                <!-- Hidden compatibility markers for existing assertions -->
                <span class="sr-only">Step 1 Select Silhouette Instant Digital Download</span>
              </div>

              <div class="step-flow-arrow" aria-hidden="true">&rarr;</div>

              <!-- Step 02 -->
              <div class="step-ref-card">
                <span class="step-num-pill">02</span>
                <div class="step-icon-wrap" aria-hidden="true">
                  <!-- Scissors Icon -->
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0B192C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><line x1="20" y1="4" x2="8.12" y2="15.88"></line><line x1="14.47" y1="14.48" x2="20" y2="20"></line><line x1="8.12" y1="8.12" x2="12" y2="12"></line></svg>
                </div>
                <h4 class="step-label">Cut in Your Fabric</h4>
                <span class="sr-only">Step 2 Cut in Sample Fabric Standard Plotters & CAD</span>
              </div>

              <div class="step-flow-arrow" aria-hidden="true">&rarr;</div>

              <!-- Step 03 -->
              <div class="step-ref-card">
                <span class="step-num-pill">03</span>
                <div class="step-icon-wrap" aria-hidden="true">
                  <!-- Sewing Machine Icon -->
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0B192C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="14" width="18" height="6" rx="2"></rect><path d="M5 14V6a2 2 0 012-2h8a4 4 0 014 4v6"></path><circle cx="15" cy="9" r="2"></circle><line x1="10" y1="9" x2="10" y2="14"></line></svg>
                </div>
                <h4 class="step-label">Sew a Sample</h4>
                <span class="sr-only">Step 3 Sew &amp; Check Form Fast Sample Sign-Off</span>
              </div>

              <div class="step-flow-arrow" aria-hidden="true">&rarr;</div>

              <!-- Step 04 -->
              <div class="step-ref-card">
                <span class="step-num-pill">04</span>
                <div class="step-icon-wrap" aria-hidden="true">
                  <!-- Clipboard Check Icon -->
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0B192C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1"></rect><path d="M9 14l2 2 4-4"></path></svg>
                </div>
                <h4 class="step-label">Check &amp; Approve</h4>
              </div>

            </div>
          </div>

        </div>

      </div>

    </section>

    <!-- =========================================================================
         04: EVERY STAGE, SIMPLIFIED (Section 4 in Reference Image 1)
         ========================================================================= -->
    <section class="home-benefits" aria-labelledby="benefits-title">

      <div class="container">

        <div class="section-header text-center">
          <h2 id="benefits-title" class="section-title section-title--flanked">
            <span class="title-line"></span>
            <span>Every Stage, Simplified</span>
            <span class="title-line"></span>
          </h2>
        </div>

        <div class="benefits-ref-grid">

          <article class="benefit-ref-card">
            <div class="benefit-icon-box" aria-hidden="true">
              <!-- Foundation Layers Icon -->
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
            </div>
            <div class="benefit-ref-body">
              <span class="benefit-ref-tag">01 Balanced Foundations</span>
              <p class="benefit-ref-text">
                <%= siteSettings?.home_card_1_description || 'Accurate shape and proportion in every piece.' %>
              </p>
            </div>
          </article>

          <article class="benefit-ref-card">
            <div class="benefit-icon-box" aria-hidden="true">
              <!-- Wear-Tested Shirt Icon -->
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.47a1 1 0 00.99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 002-2V10h2.15a1 1 0 00.99-.84l.58-3.47a2 2 0 00-1.34-2.23z"></path></svg>
            </div>
            <div class="benefit-ref-body">
              <span class="benefit-ref-tag">02 Wear-Tested</span>
              <p class="benefit-ref-text">
                <%= siteSettings?.home_card_2_description || 'Sewn, tried on and corrected before release.' %>
              </p>
            </div>
          </article>

          <article class="benefit-ref-card">
            <div class="benefit-icon-box" aria-hidden="true">
              <!-- Expert Ribbon Badge Icon -->
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
            </div>
            <div class="benefit-ref-body">
              <span class="benefit-ref-tag">03 Expert Validated</span>
              <p class="benefit-ref-text">
                <%= siteSettings?.home_card_3_description || 'Signed off by a technologist with 19+ years across Indian retail and global export.' %>
              </p>
            </div>
          </article>

          <article class="benefit-ref-card">
            <div class="benefit-icon-box" aria-hidden="true">
              <!-- Speedometer Gauge Icon -->
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M4.93 4.93l2.83 2.83M2 12h4M4.93 19.07l2.83-2.83M12 22v-4M19.07 19.07l-2.83-2.83M22 12h-4M19.07 4.93l-2.83 2.83"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </div>
            <div class="benefit-ref-body">
              <span class="benefit-ref-tag">04 Quicker Approvals</span>
              <p class="benefit-ref-text">
                <%= siteSettings?.home_card_4_description || 'Fewer revision rounds and lower development costs.' %>
              </p>
            </div>
          </article>

        </div>

      </div>

    </section>

    <!-- =========================================================================
         05: MEET THE EXPERT (Section 5 in Reference Image 1 with Real Photo)
         ========================================================================= -->
    <section class="home-expert-banner" aria-labelledby="expert-title">

      <div class="container">

        <div class="expert-ref-banner">

          <div class="expert-ref-photo-col">
            <img
              src="/images/reference/expert-ss-ganesh.jpg"
              alt="S.S. Ganesh — Garment Technologist & Pattern Engineer"
              class="expert-ref-img"
              loading="lazy"
            >
          </div>

          <div class="expert-ref-content-col">
            <span class="expert-ref-eyebrow">&mdash; MEET THE EXPERT &mdash;</span>
            <span class="sr-only">NIFT Alumnus</span>
            <h2 id="expert-title" class="expert-ref-title">
              <%= siteSettings?.home_expertise_heading || 'Two Decades of Garment Technology in Every File' %>
            </h2>
            <p class="expert-ref-bio">
              <%= siteSettings?.home_expertise_description || 'Created by S.S. Ganesh, NIFT alumnus and founder of Garment Design Studio. He has built collections for leading Indian retailers and international export labels across woven, knit, denim and ethnic wear.' %>
            </p>
          </div>

          <div class="expert-ref-denim-texture" aria-hidden="true"></div>

        </div>

      </div>

    </section>

    <!-- =========================================================================
         06: COMING SOON BANNER (Section 6 in Reference Image 1)
         ========================================================================= -->
    <section class="home-coming-soon" aria-labelledby="coming-soon-title">

      <div class="container">

        <div class="coming-soon-ref-strip">

          <!-- Left Pill -->
          <div class="coming-soon-ref-badge">
            <span class="cs-horn" aria-hidden="true">&#128227;</span>
            <span class="cs-label">Coming Soon</span>
          </div>

          <!-- Middle Item: Learning Hub -->
          <div class="coming-soon-ref-item">
            <div class="cs-icon-box" aria-hidden="true">
              <!-- Book Icon -->
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"></path></svg>
            </div>
            <div>
              <h3 class="cs-heading">
                <%= siteSettings?.home_books_heading || 'Learning Hub' %>
              </h3>
              <p class="cs-desc">
                <%= siteSettings?.home_books_description || 'Practical notes on fabrics, construction and quality, drawn from real factory floors.' %>
              </p>
            </div>
          </div>

          <div class="cs-divider" aria-hidden="true"></div>

          <!-- Right Item: Pattern-Making Course -->
          <div class="coming-soon-ref-item">
            <div class="cs-icon-box" aria-hidden="true">
              <!-- Video Play Icon -->
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
            </div>
            <div>
              <h3 class="cs-heading">
                <%= siteSettings?.home_classes_heading || 'Pattern-Making Course' %>
              </h3>
              <p class="cs-desc">
                <%= siteSettings?.home_classes_description || 'Step-by-step lessons to draft, adjust and grade your own blocks.' %>
              </p>
            </div>
          </div>

        </div>

      </div>

    </section>

  </main>

  <%- include('partials/footer') %>

  <!-- Interactive Scripts -->
  <script src="/js/main.js"></script>
  <script src="/js/content-protection.js"></script>

</body>
</html>
