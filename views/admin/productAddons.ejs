<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - <%= product.name %></title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="admin-product-addons-page">
    <%- include('../partials/admin_header') %>
    <main class="container">
      <section class="section">
        <div class="admin-hero">
          <div>
            <h1>Add-ons for: <%= product.name %></h1>
            <p class="muted">Manage add-ons for this product.</p>
          </div>
          <div class="admin-quick-actions">
            <a href="/admin/products/<%= product._id %>/addons#add-form" class="btn primary">Add Add-on</a>
            <a href="/admin/products" class="btn ghost">Back to Products</a>
          </div>
        </div>

        <% if (message) { %>
          <div class="alert"><%= message %></div>
        <% } %>

        <% if (addonForm) { %>
          <section id="add-form" class="card" style="margin-bottom:1rem;padding:1rem">
            <h3><%= editingAddon ? 'Edit Add-on' : 'Add Add-on' %></h3>
            <form method="POST" action="<%= editingAddon ? ('/admin/products/' + product._id + '/addons/' + editingAddon._id + '/edit') : ('/admin/products/' + product._id + '/addons') %>">
              <label>Name<input name="name" required value="<%= addonForm.name || '' %>"></label>
              <label>Description<textarea name="description"><%= addonForm.description || '' %></textarea></label>
              <label>Price<input name="price" type="number" step="0.01" value="<%= addonForm.price || 0 %>"></label>
              <label><input type="checkbox" name="active" <%= addonForm.active ? 'checked' : '' %>> Active</label>
              <div style="margin-top:0.5rem"><button class="btn primary" type="submit">Save Add-on</button></div>
            </form>
          </section>
        <% } %>

        <table style="width:100%;border-collapse:collapse">
          <thead>
            <tr>
              <th style="text-align:left;padding:0.75rem">Name</th>
              <th style="padding:0.75rem">Price</th>
              <th style="padding:0.75rem">Status</th>
              <th style="padding:0.75rem">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% addons.forEach(function(a){ %>
              <tr style="border-top:1px solid rgba(0,0,0,0.06)">
                <td style="padding:0.75rem"><strong><%= a.name %></strong><div class="muted"><%= a.description %></div></td>
                <td style="padding:0.75rem;text-align:center"><%= formatCurrency ? formatCurrency(a.price) : a.price %></td>
                <td style="padding:0.75rem;text-align:center"><%= a.active ? 'Active' : 'Inactive' %></td>
                <td style="padding:0.75rem;text-align:center">
                  <a class="btn small" href="/admin/products/<%= product._id %>/addons/<%= a._id %>/edit">Edit</a>
                  <form method="POST" action="/admin/products/<%= product._id %>/addons/<%= a._id %>/toggle" style="display:inline">
                    <button class="btn small" type="submit"><%= a.active ? 'Deactivate' : 'Activate' %></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="admin-dashboard-page">
    <%- include('../partials/admin_header') %>
    <main class="container admin-dashboard-main">
      <section class="admin-hero">
        <div>
          <p class="eyebrow">Admin Portal</p>
          <h1>Manage Add-ons for <%= product.name %></h1>
          <p class="muted">Add and manage optional add-ons for this product.</p>
        </div>
        <div class="admin-quick-actions">
          <a href="/admin/products" class="btn ghost">Back to Products</a>
        </div>
      </section>

      <% if (message) { %>
        <div class="alert <%= messageType === 'error' ? 'alert-error' : '' %>"><%= message %></div>
      <% } %>

      <section class="card" style="margin-bottom: 1.5rem;">
        <div class="card-body">
          <h3><%= editingAddon ? 'Edit Add-on' : 'Add Add-on' %></h3>
          <form method="POST" action="<%= editingAddon ? '/admin/products/' + product._id + '/addons/' + editingAddon._id + '/edit' : '/admin/products/' + product._id + '/addons' %>" class="auth-form" style="margin-top:1rem;">
            <label>
              <span>Name</span>
              <input type="text" name="name" value="<%= addonForm.name || '' %>" required />
            </label>
            <label>
              <span>Description</span>
              <textarea name="description" rows="4"><%= addonForm.description || '' %></textarea>
            </label>
            <label>
              <span>Price</span>
              <input type="number" step="0.01" min="0" name="price" value="<%= addonForm.price || 0 %>" required />
            </label>
            <label>
              <span>Active</span>
              <input type="checkbox" name="active" <%= addonForm.active === false ? '' : 'checked' %> />
            </label>
            <div class="admin-quick-actions">
              <button class="btn primary" type="submit"><%= editingAddon ? 'Update Add-on' : 'Add Add-on' %></button>
              <% if (editingAddon) { %>
                <a href="/admin/products/<%= product._id %>/addons" class="btn ghost">Cancel</a>
              <% } %>
            </div>
          </form>
        </div>
      </section>

      <section class="card">
        <div class="card-body">
          <h3>Current Add-ons</h3>
          <% if (addons.length) { %>
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% addons.forEach(function(item) { %>
                    <tr>
                      <td><%= item.name %><br /><span class="muted"><%= item.description %></span></td>
                      <td><%= formatCurrency(item.price) %></td>
                      <td><%= item.active ? 'Active' : 'Inactive' %></td>
                      <td>
                        <div class="admin-inline-actions">
                          <a href="/admin/products/<%= product._id %>/addons/<%= item._id %>/edit" class="btn small primary">Edit</a>
                          <form method="POST" action="/admin/products/<%= product._id %>/addons/<%= item._id %>/toggle" style="display:inline;">
                            <button class="btn small ghost" type="submit"><%= item.active ? 'Deactivate' : 'Activate' %></button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p class="muted">No add-ons added for this product yet.</p>
          <% } %>
        </div>
      </section>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
