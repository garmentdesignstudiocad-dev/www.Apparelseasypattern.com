<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title || 'Shopping Cart' %> — <%= siteSettings?.store_name || 'Apparel Easy Patterns' %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/customer-experience.css">
  <link rel="stylesheet" href="/css/storefront-theme.css">
  <%- include('partials/theme') %>

  <style>
    :root {
      --navy-900: #0B192C;
      --navy-800: #132742;
      --gold-600: #B45309;
      --gold-500: #D97706;
      --gold-400: #F59E0B;
      --gold-50: #FFFBEB;
      --slate-900: #0F172A;
      --slate-700: #334155;
      --slate-600: #475569;
      --slate-500: #64748B;
      --slate-300: #CBD5E1;
      --slate-200: #E2E8F0;
      --slate-100: #F1F5F9;
      --slate-50: #F8FAFC;
      --white: #FFFFFF;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --shadow-sm: 0 1px 3px rgba(11, 25, 44, 0.06);
      --shadow-md: 0 4px 16px -2px rgba(11, 25, 44, 0.08);
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--slate-50);
      color: var(--slate-900);
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .cart-page {
      max-width: 1360px;
      margin: 0 auto;
      padding: 32px 24px 80px;
    }

    .cart-breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12.5px;
      color: var(--slate-500);
      margin-bottom: 24px;
    }
    .cart-breadcrumb a { color: var(--slate-700); text-decoration: none; font-weight: 500; }
    .cart-breadcrumb a:hover { color: var(--gold-500); }
    .cart-breadcrumb .current { color: var(--navy-900); font-weight: 700; }

    .cart-header-title {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 32px;
      border-bottom: 1px solid var(--slate-200);
      padding-bottom: 20px;
    }

    .cart-header-title h1 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(28px, 2.6vw, 38px);
      font-weight: 700;
      color: var(--navy-900);
      margin: 0;
    }

    .cart-count-badge {
      font-size: 13px;
      font-weight: 700;
      color: var(--gold-600);
      background: var(--gold-50);
      border: 1px solid #FDE68A;
      padding: 4px 12px;
      border-radius: 9999px;
    }

    .cart-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      gap: 40px;
      align-items: start;
    }

    /* Cart Items List */
    .cart-items-wrap {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .cart-item-card {
      background: var(--white);
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-md);
      padding: 20px 22px;
      display: grid;
      grid-template-columns: 88px minmax(0, 1fr) auto;
      gap: 20px;
      align-items: start;
      box-shadow: var(--shadow-sm);
      transition: all 0.2s ease;
    }

    .cart-item-card:hover {
      box-shadow: var(--shadow-md);
      border-color: var(--slate-300);
    }

    .cart-thumb-box {
      width: 88px;
      height: 110px;
      border-radius: var(--radius-sm);
      overflow: hidden;
      background: var(--slate-100);
      border: 1px solid var(--slate-200);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .cart-thumb-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .cart-thumb-placeholder {
      font-size: 28px;
      color: var(--slate-400);
    }

    .cart-item-info {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .cart-item-name {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 18px;
      font-weight: 700;
      color: var(--navy-900);
      text-decoration: none;
      line-height: 1.3;
      transition: color 0.15s ease;
    }

    .cart-item-name:hover {
      color: var(--gold-500);
    }

    .cart-options-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .cart-pill {
      font-size: 11px;
      font-weight: 600;
      color: var(--navy-900);
      background: var(--slate-100);
      border: 1px solid var(--slate-200);
      padding: 3px 8px;
      border-radius: 4px;
    }

    .cart-pill.gold {
      background: var(--gold-50);
      color: var(--gold-600);
      border-color: #FDE68A;
    }

    .cart-files-list {
      font-size: 11.5px;
      color: var(--slate-500);
      line-height: 1.4;
      margin: 2px 0;
    }

    /* Quantity Controls */
    .cart-qty-row {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      margin-top: 6px;
    }

    .qty-control-group {
      display: inline-flex;
      align-items: center;
      border: 1px solid var(--slate-300);
      border-radius: var(--radius-sm);
      overflow: hidden;
      background: var(--white);
    }

    .qty-btn {
      width: 32px;
      height: 32px;
      background: var(--slate-100);
      border: 0;
      color: var(--slate-700);
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s ease;
    }

    .qty-btn:hover {
      background: var(--slate-200);
      color: var(--navy-900);
    }

    .update-qty, .update-physical, .update-trial {
      width: 44px;
      height: 32px;
      border: 0;
      border-left: 1px solid var(--slate-300);
      border-right: 1px solid var(--slate-300);
      text-align: center;
      font-size: 13px;
      font-weight: 700;
      color: var(--navy-900);
      padding: 0;
      outline: none;
    }

    .cart-item-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      justify-content: space-between;
      min-height: 100px;
    }

    .cart-item-price {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 20px;
      font-weight: 700;
      color: var(--navy-900);
      white-space: nowrap;
    }

    .remove-item {
      background: transparent;
      border: 0;
      color: var(--slate-400);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 0;
      transition: color 0.15s ease;
    }

    .remove-item:hover {
      color: #DC2626;
    }

    /* Cart Summary Sidebar */
    .cart-summary {
      background: var(--white);
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-lg);
      padding: 28px 24px;
      box-shadow: var(--shadow-sm);
      position: sticky;
      top: 96px;
    }

    .cart-summary h2 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 22px;
      font-weight: 700;
      color: var(--navy-900);
      margin: 0 0 20px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--slate-200);
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      font-size: 13.5px;
      color: var(--slate-600);
    }

    .summary-row strong {
      color: var(--navy-900);
      font-weight: 700;
    }

    .summary-total {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px solid var(--slate-200);
      font-size: 16px;
      font-weight: 700;
      color: var(--navy-900);
    }

    .summary-total strong {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 26px;
      font-weight: 700;
      color: var(--gold-500);
    }

    .checkout-button {
      width: 100%;
      margin-top: 22px;
      padding: 16px;
      border: 0;
      border-radius: var(--radius-sm);
      background: var(--navy-900);
      color: var(--white);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
      box-shadow: 0 4px 14px rgba(11, 25, 44, 0.2);
    }

    .checkout-button:hover {
      background: var(--gold-500);
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(217, 119, 6, 0.3);
    }

    .continue-shopping {
      display: block;
      text-align: center;
      margin-top: 14px;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--slate-600);
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .continue-shopping:hover {
      color: var(--gold-500);
    }

    .secure-note {
      margin-top: 22px;
      padding-top: 18px;
      border-top: 1px solid var(--slate-200);
      font-size: 11.5px;
      color: var(--slate-500);
      line-height: 1.5;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .secure-note span {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Empty Cart State */
    .empty-cart-card {
      background: var(--white);
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-lg);
      padding: 72px 24px;
      text-align: center;
      max-width: 680px;
      margin: 20px auto;
      box-shadow: var(--shadow-sm);
    }

    .empty-cart-icon {
      font-size: 54px;
      margin-bottom: 18px;
      display: block;
      color: var(--slate-400);
    }

    .empty-cart-card h2 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 28px;
      font-weight: 700;
      color: var(--navy-900);
      margin: 0 0 10px;
    }

    .empty-cart-card p {
      font-size: 14px;
      color: var(--slate-600);
      margin: 0 0 24px;
      line-height: 1.6;
    }

    .empty-cart-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 28px;
      background: var(--navy-900);
      color: var(--white);
      border-radius: var(--radius-sm);
      text-decoration: none;
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      transition: all 0.2s ease;
    }

    .empty-cart-btn:hover {
      background: var(--gold-500);
      transform: translateY(-1px);
    }

    @media (max-width: 900px) {
      .cart-grid { grid-template-columns: 1fr; gap: 32px; }
      .cart-summary { position: relative; top: auto; }
      .cart-item-card { grid-template-columns: 76px 1fr; }
      .cart-item-right { grid-column: 1 / -1; flex-direction: row; align-items: center; min-height: auto; padding-top: 12px; border-top: 1px solid var(--slate-100); }
    }
  </style>
</head>

<body>
  <%- include('partials/header') %>

  <main class="cart-page">
    <nav aria-label="Breadcrumb" class="cart-breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span class="current">Shopping Cart</span>
    </nav>

    <% if (Array.isArray(cart) && cart.length > 0) { %>
      <div class="cart-header-title">
        <h1>Your Shopping Cart</h1>
        <span class="cart-count-badge"><%= cart.length %> <%= cart.length === 1 ? 'Pattern Block' : 'Pattern Blocks' %></span>
      </div>

      <div class="cart-grid">
        <!-- Left: Item Cards -->
        <div class="cart-items-wrap">
          <% cart.forEach(function (item) { %>
            <div class="cart-item-card">
              <div class="cart-thumb-box">
                <% if (item.images && item.images[0]) { %>
                  <img src="<%= item.images[0] %>" alt="<%= item.name %>" class="cart-thumb-img" loading="lazy">
                <% } else { %>
                  <div class="cart-thumb-placeholder">📐</div>
                <% } %>
              </div>

              <div class="cart-item-info">
                <a href="/product/<%= item.slug %>" class="cart-item-name"><%= item.name %></a>

                <div class="cart-options-pills">
                  <% if (item.selected_sizes && item.selected_sizes.length) { %>
                    <span class="cart-pill">Sizes: <%= item.selected_sizes.join(', ') %></span>
                  <% } %>
                  <% if (item.printable_selected !== false) { %>
                    <span class="cart-pill gold">Digital Soft Copy</span>
                  <% } %>
                  <% if (Number(item.physical_quantity || 0) > 0) { %>
                    <span class="cart-pill">Printed Hard Copy (×<%= item.physical_quantity %><%= item.physical_sizes && item.physical_sizes.length ? ': ' + item.physical_sizes.join(', ') : '' %>)</span>
                  <% } %>
                  <% if (Number(item.trial_quantity || 0) > 0) { %>
                    <span class="cart-pill">Trial Sample (×<%= item.trial_quantity %>)</span>
                  <% } %>
                </div>

                <% if (item.selected_files && item.selected_files.length) { %>
                  <div class="cart-files-list">
                    <strong>Included Files:</strong> <%= item.selected_files.map(function(f){ return f.file_name; }).join(', ') %>
                    <% item.selected_files.forEach(function(f) { %>
                      <% if (f.price_per_selected_size && item.selected_sizes && item.selected_sizes.length) { %>
                        <div class="cart-file-calc" style="font-size:12px;color:var(--slate-500);margin-top:2px;">
                          <%= f.file_price %> per size × <%= item.selected_sizes.length %> selected sizes × quantity <%= item.quantity || 1 %>
                          (₹<%= (Number(f.file_price || 0) * item.selected_sizes.length * Number(item.quantity || 1)).toFixed(2) %>)
                        </div>
                      <% } %>
                    <% }); %>
                  </div>
                <% } %>

                <% if (item.selected_addons && item.selected_addons.length) { %>
                  <div class="cart-files-list">
                    <strong>Addons:</strong> <%= item.selected_addons.map(function(a){ return a.name; }).join(', ') %>
                  </div>
                <% } %>

                <div class="cart-qty-row">
                  <div class="qty-control-group">
                    <button type="button" class="qty-btn quantity-minus" data-target="qty-<%= item.id %>" aria-label="Decrease quantity">&minus;</button>
                    <input type="number" id="qty-<%= item.id %>" class="update-qty" data-item-id="<%= item.id %>" value="<%= item.quantity %>" min="0" aria-label="Digital quantity">
                    <button type="button" class="qty-btn quantity-plus" data-target="qty-<%= item.id %>" aria-label="Increase quantity">&plus;</button>
                  </div>
                  <% if (Number(item.physical_quantity || 0) > 0) { %>
                    <div style="font-size:12px;color:var(--slate-600)">
                      Printed Prints: <strong><%= item.physical_quantity %></strong>
                    </div>
                  <% } %>
                </div>
              </div>

              <div class="cart-item-right">
                <div class="cart-item-price">
                  ₹<%= Number(item.total || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </div>
                <button type="button" class="remove-item" data-item-id="<%= item.id %>">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>
                  <span>Remove</span>
                </button>
              </div>
            </div>
          <% }); %>
        </div>

        <!-- Right: Summary Sidebar -->
        <aside class="cart-summary">
          <h2>Order Summary</h2>

          <div class="summary-row">
            <span>Pattern Items</span>
            <strong><%= cart.length %></strong>
          </div>

          <div class="summary-row">
            <span>Items Subtotal</span>
            <strong>
              ₹<%= cart.reduce(function(sum, item) {
                return sum + Number(item.total || 0);
              }, 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
            </strong>
          </div>

          <div class="summary-row">
            <span>Courier Shipping</span>
            <span>Calculated at checkout</span>
          </div>

          <div class="summary-row">
            <span>GST (<%= typeof gstRate === 'number' ? gstRate : 0 %>%)</span>
            <span>Calculated at checkout</span>
          </div>

          <div class="summary-total">
            <span>Estimated Total</span>
            <strong>
              ₹<%= cart.reduce(function(sum, item) {
                return sum + Number(item.total || 0);
              }, 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
            </strong>
          </div>

          <button type="button" id="proceed-checkout" class="checkout-button">
            Proceed to Checkout &rarr;
          </button>

          <% if (canVisit('/products')) { %>
            <a href="/products" class="continue-shopping">&larr; Continue Shopping</a>
          <% } %>

          <div class="secure-note">
            <span>🔒 256-Bit SSL Encrypted Checkout</span>
            <span>⚡ Instant Verified Digital Downloads</span>
            <span>📦 Pan-India Courier for Printed Patterns</span>
          </div>
        </aside>
      </div>
    <% } else { %>
      <!-- Empty Cart State -->
      <section class="empty-cart-card">
        <span class="empty-cart-icon">🛒</span>
        <h2>Your cart is empty</h2>
        <p>Explore our library of body-trialled apparel pattern blocks, tech packs, and production master files.</p>
        <% if (canVisit('/products')) { %>
          <a href="/products" class="empty-cart-btn">Explore Available Patterns &rarr;</a>
        <% } %>
      </section>
    <% } %>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>

  <!-- Cart Script -->
  <script>
    async function postJson(url, body) {
      const response = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      });
      return response.json();
    }

    async function updateCartItem(itemId) {
      const qtyInput = document.querySelector('.update-qty[data-item-id="' + itemId + '"]');
      const physicalInput = document.querySelector('.update-physical[data-item-id="' + itemId + '"]');
      const trialInput = document.querySelector('.update-trial[data-item-id="' + itemId + '"]');

      const quantity = Number(qtyInput?.value || 1);
      const physical = Number(physicalInput?.value || 0);
      const trial = Number(trialInput?.value || 0);

      await postJson("/cart/update", {
        itemId: itemId,
        quantity: quantity,
        physical_quantity: physical,
        trial_quantity: trial
      });
      window.location.reload();
    }

    document.querySelectorAll(".quantity-minus").forEach(function (button) {
      button.addEventListener("click", function () {
        const input = document.getElementById(button.dataset.target);
        if (!input) return;
        let value = Number(input.value || 0);
        const min = Number(input.min || 0);
        value--;
        if (value < min) value = min;
        input.value = value;
        updateCartItem(input.dataset.itemId);
      });
    });

    document.querySelectorAll(".quantity-plus").forEach(function (button) {
      button.addEventListener("click", function () {
        const input = document.getElementById(button.dataset.target);
        if (!input) return;
        let value = Number(input.value || 0);
        value++;
        input.value = value;
        updateCartItem(input.dataset.itemId);
      });
    });

    document.querySelectorAll(".update-qty, .update-physical, .update-trial").forEach(function (input) {
      input.addEventListener("change", function () {
        updateCartItem(input.dataset.itemId);
      });
    });

    document.querySelectorAll(".remove-item").forEach(function (button) {
      button.addEventListener("click", async function () {
        const itemId = button.dataset.itemId;
        if (!window.confirm("Remove this pattern from your cart?")) return;
        await postJson("/cart/remove", { itemId: itemId });
        window.location.reload();
      });
    });

    const checkoutButton = document.getElementById("proceed-checkout");
    if (checkoutButton) {
      checkoutButton.addEventListener("click", function () {
        window.location.href = "/checkout";
      });
    }
  </script>
</body>
</html>
