<!DOCTYPE html><html lang="en"><head><%- include('../partials/business-head') %><meta name="robots" content="noindex,nofollow"></head><body><%- include('../partials/header') %><main class="studio-page"><h1><%= confirmed?(item.payment_status==='Paid'?'Payment Successful':'Access Confirmed'):title %></h1><h2><%= itemName %></h2><p>Customer: <%= item.full_name || item.name %></p><p>Reference: <%= item._id %></p><p><%= item.payment_status==='Paid'?'Amount Paid':'Amount' %>: ₹<%= (item.amount_paise/100).toLocaleString('en-IN') %> INR</p><% if(item.payment_status==='Paid'){ %><p><% if(canVisit('/receipts/for/' + String(item.payment_purpose) + '/' + String(item._id))){ %><a class="fashion-button" href="/receipts/for/<%= item.payment_purpose %>/<%= item._id %>">View / Print Paid Receipt</a><% } %></p><% } %><p>Payment: <strong><%= item.payment_status %></strong> · Access: <strong><%= item.registration_status %></strong></p><% if(kind==='consulting' && item.scheduling_status){ %><section aria-label="Consultation scheduling"><p role="status"><%= item.registration_status==='Cancelled' && item.scheduling_status!=='Declined'?'This booking has been cancelled. Contact the studio about any payment already made.':item.scheduling_status==='Pending'?'Your booking request has been received. Availability has not yet been approved.':item.scheduling_status==='Proposed'?'The studio has proposed an alternative. Please accept explicitly to continue.':item.scheduling_status==='Declined'?'The studio declined your request. Contact the studio about any payment already made.':'Scheduling approved. Confirmation also requires verified payment if a fee applies.' %></p><p>Scheduling: <strong><%= item.scheduling_status %></strong></p><% if(item.scheduled_date){ %><p><%= item.scheduling_status==='Proposed'?'Proposed':'Approved' %> time: <%= item.scheduled_date %> <%= item.scheduled_time %> Asia/Kolkata (UTC+05:30)</p><% } %><% if(item.scheduling_status==='Proposed' && item.registration_status!=='Cancelled'){ %><form method="post" action="<%= base %>/<%= item._id %>/accept-alternative"><input type="hidden" name="_csrf" value="<%= learningCsrf %>"><input type="hidden" name="proposal" value="<%= new Date(item.scheduling_decided_at).toISOString() %>"><button class="fashion-button">Accept Proposed Date and Time</button></form><form method="post" action="<%= base %>/<%= item._id %>/reject-alternative"><input type="hidden" name="_csrf" value="<%= learningCsrf %>"><input type="hidden" name="proposal" value="<%= new Date(item.scheduling_decided_at).toISOString() %>"><button>Reject Proposed Time and Cancel Request</button></form><% } %></section><% } %><% if(item.preferred_date){ %><p>Preferred schedule: <%= item.preferred_date %> <%= item.preferred_time %> IST. Scheduling is subject to studio confirmation.</p><% } %><% if(confirmed){ %><p>Your <%= kind==='books'?'purchase':kind==='courses'?'registration':'booking' %> is confirmed.</p><% if(privateUrl){ %><a class="fashion-button" href="<%= privateUrl %>" target="_blank" rel="noopener noreferrer"><%= kind==='courses'?'Access Course Content':'Access Purchase' %></a><% }else{ %><p>The studio will provide access or scheduling details. Keep your reference.</p><% } %><% if(canVisit('/' + String(kind))){ %><a href="/<%= kind %>"><%= kind==='courses'?'View Course / Booking Details':kind==='consulting'?'View Consulting Services':'View Books' %></a><% } %><% } %><div id="webinar-payment" data-id="<%= item._id %>" data-base="<%= base %>" data-description="<%= title %>" data-csrf="<%= learningCsrf %>"><% if(featureEnabled('paid_access') && !confirmed && item.registration_status!=='Cancelled' && item.payment_status!=='Paid' && item.amount_paise){ %><button class="fashion-button" id="webinar-pay">Pay with Razorpay</button><% } %><% if(item.razorpay_order_id){ %><button id="webinar-check">Check Payment Status</button><% } %><p id="webinar-payment-message" role="status"></p></div><p>Return using the same browser. If your session expires, contact the studio with your reference.</p></main><%- include('../partials/footer') %><% if(item.amount_paise){ %><script src="https://checkout.razorpay.com/v1/checkout.js"></script><script src="/js/webinar-payment.js"></script><% } %></body></html>
