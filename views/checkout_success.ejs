<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Order Successful | <%= siteSettings?.store_name||'Garment Pattern Store' %></title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/customer-experience.css"><style>.success-page{min-height:65vh;display:grid;place-items:center;padding:45px 20px}.success-card{width:min(620px,100%);padding:45px 30px;text-align:center;background:#fff;border:1px solid #e5ddd5;box-shadow:0 20px 55px rgba(35,25,20,.08)}.success-icon{display:grid;place-items:center;width:70px;height:70px;margin:0 auto 22px;border-radius:50%;background:#e4f3e8;color:#27633b;font-size:30px}.success-details{margin:25px 0;padding:18px;background:#f8f5f1;text-align:left}.success-details p{display:flex;justify-content:space-between;gap:20px;margin:10px 0}.success-actions{display:flex;justify-content:center;flex-wrap:wrap;gap:10px}</style><%- include('partials/theme') %></head><body><%- include('partials/header') %><main class="success-page"><section class="success-card"><div class="success-icon">✓</div><span class="eyebrow"><%= order?'Payment verified':'Order confirmation' %></span><h1><%= order?'Order Successful':'Check Your Order' %></h1><p><%= order?'Your payment was verified securely and the order is being processed.':'A verified order is not available in this browser session. If you have paid, contact the store with your order reference.' %></p><% if(order){ %><p><% if(canVisit('/receipts/for/product_order/' + String(order._id))){ %><a class="fashion-button" href="/receipts/for/product_order/<%= order._id %>">View / Print Paid Receipt</a><% } %></p><% if(order.items.some(item=>Number(item.quantity ?? 1)>0)){ %><p>Purchased digital files are delivered by email after verified payment. Physical items, if ordered, remain for courier delivery.</p><% } %><% if(order.courier_name){ %><p>Courier: <%= order.courier_name %> ? <%= order.shipping_status || 'Pending' %></p><% } %><% if(order.tracking_url){ %><p><a href="<%= order.tracking_url %>" rel="noopener noreferrer">Track shipment <%= order.tracking_number %></a></p><% } %><div class="success-details"><p><span>Order ID</span><strong><%= order._id %></strong></p><p><span>Payment Status</span><strong><%= order.payment_status %></strong></p><p><span>Amount</span><strong>₹<%= Number(order.grand_total||0).toLocaleString('en-IN',{minimumFractionDigits:2}) %></strong></p></div><% }else if(orderId){ %><p>Your order reference is <strong><%= orderId %></strong>. Detailed payment information is available only in the browser session that completed payment.</p><% } %><div class="success-actions"><% if(canVisit('/products')){ %><a href="/products" class="fashion-button">Continue Shopping</a><% } %><% if(siteSettings?.main_website_url){ %><a href="<%= siteSettings.main_website_url %>" class="text-link" rel="noopener">Back to Main Website →</a><% } %></div></section></main><%- include('partials/footer') %><script src="/js/main.js"></script></body></html>
