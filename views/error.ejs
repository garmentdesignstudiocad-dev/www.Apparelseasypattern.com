<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"><% if(typeof isAdminPage==='undefined' || !isAdminPage){ %><link rel="stylesheet" href="/css/customer-experience.css"><%- include('partials/theme') %><% } %></head><body><% if(typeof isAdminPage!=='undefined' && isAdminPage){ %><%- include('partials/admin_header') %><% }else{ %><%- include('partials/header') %><% } %><main class="container section"><h1><%= title %></h1><p role="alert"><%= message %></p><a href="<%= typeof isAdminPage!=='undefined' && isAdminPage?'/admin':'/' %>">Return <%= typeof isAdminPage!=='undefined' && isAdminPage?'to admin':'home' %></a></main><% if(typeof isAdminPage==='undefined' || !isAdminPage){ %><%- include('partials/footer') %><script src="/js/main.js"></script><% } %></body></html>