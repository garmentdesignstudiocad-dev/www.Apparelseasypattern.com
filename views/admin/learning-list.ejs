<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/business.css"></head><body><%- include('../partials/admin_header') %><main class="studio-admin"><h1><%= title %></h1><div class="studio-actions"><a href="/admin/<%= kind %>/new">Add <%= kind==='courses'?'Course':'Webinar' %></a><a href="/admin/<%= kind==='courses'?'course-bookings':'webinar-registrations' %>">View <%= kind==='courses'?'Bookings':'Registrations' %></a><a href="/admin/classes">Legacy Classes & Enrollments</a></div><div class="studio-table"><table><thead><tr><th>Name</th><th>Price</th><th>Visibility</th><th>Schedule</th><th>Manage</th></tr></thead><tbody><% items.forEach(item=>{ %><tr><td><%= item.name || item.title %></td><td>₹<%= Number(item.price).toLocaleString('en-IN') %></td><td><%= item.active?'Active':'Inactive' %><%= kind==='webinars'?' / Registration '+(item.registration_open?'open':'closed'):'' %></td><td><%= kind==='courses'?item.schedule_information:new Date(item.starts_at).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'})+' IST' %></td><td><a href="/admin/<%= kind %>/<%= item._id %>/edit">Edit</a> · <a href="/<%= kind %>/<%= encodeURIComponent(item.slug) %>">Public Page</a></td></tr><% }) %></tbody></table></div><% if(!items.length){ %><p>No entries yet. Create one and activate it when ready.</p><% } %></main></body></html>
