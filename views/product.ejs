            <!-- Option A: Stripes Panel -->
            <div class="custom-marker-panel active" id="panelStripes" role="tabpanel">
              <h5 style="margin:0 0 10px;font-size:13.5px;color:var(--ref-text-dark);font-weight:700;">
                A. CUSTOMIZE MARKERS FOR STRIPES
              </h5>
              <div class="marker-field-row">
                <div class="marker-field-group">
                  <label for="inputStripesRepeat">Stripes Repeat Width (cm) *</label>
                  <input type="number" id="inputStripesRepeat" name="stripes_repeat_width_cm" min="0.1" step="0.1" placeholder="e.g. 5.0">
                  <span class="marker-field-error" id="errStripesRepeat">Enter a valid positive number in cm</span>
                </div>
                <div class="marker-field-group">
                  <label for="inputStripesCuttable">Fabric Cuttable Width (cm) *</label>
                  <input type="number" id="inputStripesCuttable" name="stripes_fabric_width_cm" min="1" step="0.5" placeholder="e.g. 148.0">
                  <span class="marker-field-error" id="errStripesCuttable">Enter a valid cuttable width in cm</span>
                </div>
              </div>
            </div>

            <!-- Option B: Checks Panel -->
