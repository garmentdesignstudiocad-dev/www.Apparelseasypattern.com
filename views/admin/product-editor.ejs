<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/admin-products.css">
<style id="aep-simple-editor-css">
.aep-simple-toggle {
  margin-left:auto;
  padding:10px 16px;
  border:1px solid #d8d4ce;
  border-radius:10px;
  background:#fff;
  color:#292524;
  font-weight:700;
  cursor:pointer;
}
.admin-product-section > header {
  display:flex;
  align-items:center;
  gap:12px;
}
.admin-product-section.aep-collapsed > :not(header) {
  display:none !important;
