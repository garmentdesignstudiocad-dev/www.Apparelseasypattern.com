<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %> — <%= siteSettings?.store_name || 'Apparel Easy Patterns' %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/customer-experience.css">
  <link rel="stylesheet" href="/css/storefront-theme.css">
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <%- include('partials/theme') %>

  <style>
    :root {
      --navy-900: #0B192C;
      --navy-800: #132742;
      --gold-600: #B45309;
      --gold-500: #D97706;
      --gold-400: #F59E0B;
      --slate-900: #0F172A;
      --slate-700: #334155;
      --slate-600: #475569;
      --slate-500: #64748B;
      --slate-300: #CBD5E1;
      --slate-200: #E2E8F0;
      --slate-100: #F1F5F9;
      --slate-50: #F8FAFC;
      --white: #FFFFFF;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --shadow-sm: 0 1px 3px rgba(11, 25, 44, 0.06);
      --shadow-md: 0 4px 16px -2px rgba(11, 25, 44, 0.08);
    }

    body {
      margin: 0;
      background: var(--slate-50);
      color: var(--slate-900);
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .payment-wrap {
      max-width: 1100px;
      margin: 0 auto;
      padding: 40px 24px 80px;
    }

    .payment-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 32px;
      align-items: start;
    }

    .payment-card {
      background: var(--white);
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-lg);
      padding: 32px;
      box-shadow: var(--shadow-sm);
    }

    .payment-card h1 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 32px;
      font-weight: 700;
      color: var(--navy-900);
      margin: 12px 0 8px;
    }

    .payment-card h2 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 22px;
      font-weight: 700;
      color: var(--navy-900);
      margin: 0 0 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--slate-200);
    }

    .payment-card h3 {
      font-size: 14px;
      font-weight: 700;
      color: var(--navy-900);
      margin: 0 0 14px;
    }

    .secure-mark {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--navy-900);
      color: var(--gold-400);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      font-weight: 800;
      border: 2px solid var(--gold-500);
    }

    .eyebrow {
      display: inline-block;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--gold-500);
      margin-top: 14px;
    }

    .page-intro {
      font-size: 14px;
      color: var(--slate-600);
      line-height: 1.6;
      margin: 0 0 24px;
    }

    .pay-button {
      width: 100%;
      padding: 16px;
      border: 0;
      border-radius: var(--radius-sm);
      background: var(--navy-900);
      color: var(--white);
      font-size: 13.5px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 4px 14px rgba(11, 25, 44, 0.2);
    }

    .pay-button:hover:not(:disabled) {
      background: var(--gold-500);
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(217, 119, 6, 0.3);
    }

    .pay-button:disabled {
      opacity: 0.6;
      cursor: wait;
    }

    .payment-message {
      min-height: 22px;
      margin-top: 14px;
      color: #DC2626;
      font-size: 13px;
      font-weight: 600;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 12px 0;
      font-size: 13.5px;
      color: var(--slate-600);
    }

    .summary-row strong {
      color: var(--navy-900);
      font-weight: 700;
    }

    .grand-total {
      margin-top: 16px;
      padding-top: 14px;
      border-top: 1px solid var(--slate-200);
      font-size: 16px;
      font-weight: 700;
      color: var(--navy-900);
    }

    .grand-total strong {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 24px;
      color: var(--gold-500);
    }

    .delivery-summary-box {
      border-top: 1px solid var(--slate-200);
      margin-top: 20px;
      padding-top: 16px;
      font-size: 12.5px;
      color: var(--slate-600);
      line-height: 1.6;
    }

    @media (max-width: 760px) {
      .payment-layout { grid-template-columns: 1fr; }
    }
  </style>
</head>

<body class="payment-page">
  <%- include('partials/header') %>

  <main class="payment-wrap">
    <div class="payment-layout">
      <section class="payment-card">
        <div class="secure-mark" aria-hidden="true">✓</div>
        <span class="eyebrow">Razorpay Checkout</span>
        <h1>Secure Payment</h1>
        <p class="page-intro">
          Complete your payment securely using Razorpay. All standard payment methods (UPI, Credit/Debit Cards, Netbanking) are presented in the checkout window.
        </p>

        <button id="pay-button" class="pay-button">
          Pay ₹<%= Number(summary.grand_total || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %> Securely
        </button>

        <p id="payment-message" class="payment-message" role="status"></p>

        <div style="margin-top:20px;font-size:12px;color:var(--slate-500);display:flex;flex-direction:column;gap:6px;">
          <span>🔒 256-bit encrypted checkout</span>
          <span>⚡ Instant digital pattern delivery upon payment confirmation</span>
        </div>
      </section>

      <aside class="payment-card">
        <h2>Order Summary</h2>
        <h3>Online Payment</h3>

        <div class="summary-row">
          <span>Product subtotal</span>
          <strong>₹<%= Number(summary.product_total || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></strong>
        </div>

        <% if (summary.delivery_required) { %>
          <div class="summary-row">
            <span>Courier charges</span>
            <strong>Pay separately</strong>
          </div>
        <% } %>

        <div class="summary-row">
          <span>GST (<%= Number(summary.tax_rate || 0) %>%)</span>
          <strong>₹<%= Number(summary.tax_amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></strong>
        </div>

        <div class="summary-row grand-total">
          <span>Final payable total</span>
          <strong>₹<%= Number(summary.grand_total || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></strong>
        </div>

        <% if (summary.delivery_required) { %>
          <div class="delivery-summary-box">
            <h3>Physical Delivery Details</h3>
            <p><strong>Delivery address:</strong> <%= [shipping?.address, shipping?.city, shipping?.state, shipping?.pincode].filter(Boolean).join(', ') %></p>
            <p><strong>Dispatch hub:</strong> <%= (summary.destination || {}).dispatch_location || 'Pending Manual Assignment' %></p>
            <p><strong>Courier charges:</strong> Pay separately and directly to the courier service; not included in the website total.</p>
            <p><strong>Shipping payment status:</strong> Not collected by this website</p>
            <p><strong>Courier booking status:</strong> Not booked</p>
          </div>
        <% } %>
      </aside>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>

  <script>
    document.getElementById('pay-button').addEventListener('click', async function () {
      const button = this;
      if (button.disabled) return;
      if (button.disabled) return;
      const message = document.getElementById('payment-message');
      button.disabled = true;
      message.textContent = 'Preparing secure payment…';

      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 20000);
      try {
        if (typeof Razorpay !== 'function') throw new Error('Razorpay Checkout could not be loaded. Reload this page and try again.');
        const response = await fetch('/checkout/payment-method/proceed', {
          method: 'POST',
          signal: controller.signal,
          signal: controller.signal,
          headers: { 'Content-Type': 'application/json' },
          body: '{}'
        });
        const data = await response.json();
        clearTimeout(timer);
        clearTimeout(timer);
        if (data.login_url) {
          window.location.href = data.login_url;
          return;
        }
        if (!response.ok) throw new Error(data.error || 'Unable to create payment order.');
        if (typeof Razorpay !== 'function') throw new Error('Razorpay Checkout could not be loaded.');

        const checkout = new Razorpay({
          key: data.key_id,
          amount: data.amount,
          currency: data.currency || 'INR',
          name: 'Apparel Easy Patterns',
          description: 'Garment Pattern Order',
          order_id: data.razorpay_order_id,
          prefill: {
            name: data.customer?.name || <%- JSON.stringify(customer?.name || '').replace(/</g, '\\u003c') %>,
            email: data.customer?.email || <%- JSON.stringify(customer?.email || '').replace(/</g, '\\u003c') %>,
            contact: data.customer?.phone || <%- JSON.stringify(customer?.phone || '') %>
          },
          handler: function (result) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/checkout/razorpay-callback';
            ['razorpay_order_id', 'razorpay_payment_id', 'razorpay_signature'].forEach(function (name) {
              const input = document.createElement('input');
              input.type = 'hidden';
              input.name = name;
              input.value = result[name] || '';
              form.appendChild(input);
            });
            document.body.appendChild(form);
            form.submit();
          },
          modal: {
            ondismiss: function () {
              button.disabled = false;
              message.textContent = 'Payment cancelled. You can retry when ready.';
            }
          },
          theme: { color: '#0B192C' }
        });

        checkout.on('payment.failed', function () {
          message.textContent = 'Payment was not completed. Your order remains unpaid.';
          button.disabled = false;
        });

        message.textContent = '';
        checkout.open();
      } catch (error) {
        message.textContent = error.name === 'AbortError' ? 'Payment setup timed out. Review your account before retrying; no payment has been confirmed here.' : error.message;
        button.disabled = false;
      } finally { clearTimeout(timer); }
    });
  </script>
</body>
</html>
