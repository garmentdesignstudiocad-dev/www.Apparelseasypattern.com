          <!-- Hidden compatibility elements for backend & calculations -->
          <span id="pattern-subtotal" style="display:none">&#8377;<%= basePrice %></span>
          <span id="pattern-tax" style="display:none">&#8377;<%= Math.round(basePrice * (gstRate / 100)) %></span>

          <!-- Two Buttons: Add to Cart (Left) & Place Order (Right) -->
