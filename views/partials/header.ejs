<style>
.site-header .nav-container{display:flex;flex-wrap:nowrap;align-items:center;gap:18px;min-height:74px}.site-header .fashion-logo{min-width:0;flex-shrink:0}.site-header .fashion-logo__copy strong{max-width:220px}.site-header .main-nav{display:block;position:static;flex:1;overflow:visible;max-height:none}.site-header .main-nav>ul{display:flex;flex-wrap:nowrap;align-items:center;gap:18px;margin:0;padding:0;list-style:none}.site-header .main-nav a,.site-header summary{font-size:12px;white-space:nowrap}.site-header summary{cursor:pointer;font-weight:700;color:inherit}.site-header .nav-group{position:relative}.site-header .nav-group>ul{position:absolute;top:100%;left:0;z-index:60;min-width:180px;display:flex;flex-direction:column;align-items:stretch;gap:0;padding:10px;background:var(--header-background,#fffdfa);border:1px solid #ddd;border-radius:8px;box-shadow:0 8px 20px #0002}.site-header .nav-group>ul li{list-style:none}.site-header .nav-group>ul a{display:block;padding:10px}.site-header .nav-auth{margin-left:auto;display:flex;gap:8px;align-items:center}.site-header .nav-auth>a{padding:9px 11px;border:1px solid currentColor;border-radius:6px}.site-header .nav-actions{display:flex;align-items:center;gap:12px;flex-shrink:0}.site-header .basket-link{position:relative;display:flex;align-items:center;padding:8px;color:inherit;text-decoration:none}.site-header .basket-link svg{width:24px;height:24px}.site-header #cart-count{position:absolute;top:0;right:-3px;min-width:17px;padding:1px 4px;text-align:center;border-radius:20px;background:#62392d;color:white;font-size:10px}.site-header .nav-toggle{display:none;margin:0;flex-direction:column;justify-content:center}.site-header .nav-toggle span{width:100%;flex-shrink:0;margin:3px 0}.site-header .nav-logout{border:0;background:transparent;color:inherit;cursor:pointer}
@media(max-width:1050px){.site-header .nav-container{gap:12px}.site-header .main-nav>ul{gap:11px}.site-header .fashion-logo__copy strong{max-width:170px;font-size:10px}.site-header .nav-auth>a{padding:8px}}
@media(max-width:900px){.site-header .nav-container{flex-wrap:wrap;justify-content:space-between;position:relative;width:calc(100% - 28px)}.site-header .fashion-logo{max-width:calc(100% - 94px)}.site-header .fashion-logo__copy strong{white-space:normal;overflow-wrap:anywhere}.site-header .nav-actions{margin-left:auto}.site-header .nav-toggle{display:flex}.site-header .main-nav{display:none;order:3;flex-basis:100%;width:100%;max-height:70vh;overflow-y:auto}.site-header .main-nav.open{display:block}.site-header .main-nav>ul{display:flex;flex-direction:column;align-items:stretch;gap:12px;padding:12px 0 20px}.site-header .nav-group>ul{position:static;box-shadow:none;min-width:0;width:auto;margin-top:8px}.site-header .nav-auth{margin:0;display:flex;flex-wrap:nowrap;gap:10px}.site-header .nav-auth>a{flex:1;text-align:center;padding:12px 6px}.site-header .nav-auth a{white-space:normal}.site-header .main-nav a::after{display:none}}
</style>
<div class="announcement-bar">Professional garment pattern ordering</div>
<header class="site-header"><div class="container nav-container">
<% if(canVisit('/')){ %><a class="fashion-logo" href="/"><% if(siteSettings?.logo_url){ %><img src="<%= siteSettings.logo_url %>" alt="" width="42" height="42" style="border-radius:50%;object-fit:contain;background:#fff;border:1px solid #e5dcd2"><% }else{ %><span class="fashion-logo__mark">GP</span><% } %><span class="fashion-logo__copy"><strong><%= siteSettings?.store_name || 'GARMENT PATTERN STORE' %></strong><small>GARMENT DESIGN STUDIO</small></span></a><% } %>
<nav class="main-nav" id="main-nav"><ul>
<% visibleLinks([['Home','/'],['Products','/products'],['Contact','/contact']]).forEach(([label,url])=>{ %><li><a href="<%= url %>"><%= label %></a></li><% }) %>
<% const groups=[['Learning',[['Online Classes','/classes'],['Courses','/courses'],['Webinars','/webinars'],['My Courses','/my-courses']]],['More',[['Garment Technology','/garment-technology'],['Books','/books'],['Updates','/updates'],['Consulting','/consulting'],...(siteSettings?.main_website_url?[['Main Website',siteSettings.main_website_url]]:[])]]];groups.forEach(([label,links])=>{const enabledLinks=visibleLinks(links);if(enabledLinks.length){ %><li><details class="nav-group"><summary><%= label %></summary><ul><% enabledLinks.forEach(([name,url])=>{ %><li><a href="<%= url %>"><%= name %></a></li><% }) %></ul></details></li><% }}); %>
<% if(canVisit('/login')){ %><li class="nav-auth"><% if(typeof customerSignedIn!=='undefined' && customerSignedIn){ %><details class="nav-group"><summary>Account</summary><ul><li><a href="/account">My Account</a></li><li><a href="/account/orders">My Orders</a></li><li><form method="post" action="/account/logout"><input type="hidden" name="_csrf" value="<%= customerCsrf %>"><button class="nav-logout" type="submit">Logout</button></form></li></ul></details><% }else{ %><a href="/login">Sign In</a><a href="/account/register">Create Account</a><% } %></li><% } %>
</ul></nav>
<div class="nav-actions"><% if(canVisit('/cart')){ %><a href="/cart" class="basket-link" aria-label="Shopping cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/></svg><span id="cart-count">0</span></a><% } %><button id="nav-toggle" class="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span></button></div>
</div></header>

