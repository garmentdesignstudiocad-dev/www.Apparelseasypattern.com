<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/business.css">
</head>
<body>
  <%- include('../partials/admin_header') %>
  <main class="studio-admin">
    <h1>Delivery Partner Settings</h1>
    <p>These records support manual admin fulfilment only. Checkout uses the fixed state-to-hub routing policy and does not require a courier partner, calculate shipping rates or book a courier. Courier charges are paid separately by customers and are not collected by this website. The legacy zone settings are available in <a href="/admin/settings/delivery">Zone / Hub Settings</a>.</p>

    <% ['south','north'].forEach(id=>{ const zone=regions.find(row=>row._id===id); if(!zone)return; %>
      <section class="studio-section">
        <h2><%= (zone.dispatch_location || id).toUpperCase() %> HUB &mdash; <%= zone.name.toUpperCase() %></h2>
        <ul>
          <% items.filter(item=>(zone.partner_ids || []).includes(item._id)).forEach(item=>{ %>
            <li><%= item.name %> &mdash; <%= item.active?'Enabled':'Disabled' %></li>
          <% }) %>
        </ul>
        <p>Hub associations here are for admin reference and do not control customer checkout routing.</p>
      </section>
    <% }) %>

    <% [...items,{name:'',priority:100,pincodes:[]}].forEach(item=>{ %>
      <section class="studio-section">
        <h2><%= item.name || 'Add Courier' %></h2>
        <form method="post" action="/admin/settings/couriers" class="studio-form">
          <input type="hidden" name="_csrf" value="<%= learningCsrf %>">
          <input type="hidden" name="courier_id" value="<%= item._id || '' %>">
          <label>Partner name<input name="name" maxlength="100" value="<%= item.name %>" required></label>
          <fieldset>
            <legend>Admin reference hubs</legend>
            <% regions.filter(zone=>['south','north'].includes(zone._id)).forEach(zone=>{ %>
              <label><input type="checkbox" name="hub_ids" value="<%= zone._id %>" <%= (zone.partner_ids || []).includes(item._id)?'checked':'' %>><%= zone.dispatch_location %> (<%= zone.name %>)</label>
            <% }) %>
          </fieldset>
          <label>Legacy reference courier rate in INR
            <input name="charge" type="number" min="0" max="1000000" step="0.01" value="<%= item.charge ?? '' %>" inputmode="decimal">
            <small>Reference only. This rate is not used in checkout, added to the order total or collected by the website.</small>
          </label>
          <label><input type="checkbox" name="charge_approved" <%= item.charge_approved?'checked':'' %>> Reference rate reviewed (does not affect checkout)</label>
          <label>Website URL<input name="website_url" value="<%= item.website_url || '' %>"></label>
          <label>Tracking URL (optional {awb} placeholder)<input name="tracking_url" value="<%= item.tracking_url || '' %>"></label>
          <label>Contact info<input name="contact" maxlength="300" value="<%= item.contact || '' %>"></label>
          <label>Reference transit minimum days<input name="delivery_min_days" type="number" min="1" max="365" value="<%= item.delivery_min_days ?? '' %>"></label>
          <label>Reference transit maximum days<input name="delivery_max_days" type="number" min="1" max="365" value="<%= item.delivery_max_days ?? '' %>"></label>
          <label>Priority<input name="priority" type="number" min="0" max="10000" value="<%= item.priority %>" required></label>
          <label><input type="checkbox" name="enabled" <%= item.active?'checked':'' %>> Enabled for manual admin fulfilment</label>
          <button>Save Partner</button>
        </form>
      </section>
    <% }) %>
  </main>
</body>
</html>
