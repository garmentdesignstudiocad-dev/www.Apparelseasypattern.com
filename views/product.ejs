          <% freeSizes.forEach(sz => { %>
            <label class="ref-size-pill free-size-pill" data-free-size="<%= sz %>" style="cursor:pointer;padding:6px 14px;border:1px solid #CBD5E1;border-radius:6px;font-size:12px;font-weight:700;">
              <input type="radio" name="free_claimed_size" value="<%= sz %>" style="display:none;">
              <span><%= sz %></span>
            </label>
          <% }) %>
        </div>
      </div>

      <div style="margin-bottom:16px"><label for="freePhoneInput">2. Mobile Number</label>
        <input type="tel" id="freePhoneInput" autocomplete="tel" placeholder="+91 98765 43210" required></div>
      <div style="margin-bottom:16px"><label for="freeEmailInput">3. Email Address</label>
        <input type="email" id="freeEmailInput" autocomplete="email" required></div>

      <!-- Error / Success Alert -->
      <div id="freePatternAlert" style="display:none;padding:10px 12px;border-radius:8px;font-size:12.5px;margin-bottom:16px;" role="alert"></div>

      <!-- Action Button -->
      <button type="button" id="btnClaimFreePattern" <%= freeSizes.length ? '' : 'disabled' %> class="fashion-btn" style="width:100%;background:#EA580C;color:#FFFFFF;border:none;padding:12px;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;">
        Claim Free Basic Pattern
      </button>

      <!-- Download Button Container (Shown on Success) -->
      <div id="freeDownloadWrap" style="display:none;text-align:center;margin-top:16px;">
        <a id="freeDownloadLink" href="#" class="fashion-btn" style="display:inline-block;width:100%;background:#10B981;color:#FFFFFF;padding:12px;border-radius:8px;font-size:14px;font-weight:700;text-decoration:none;">
          &#11015; Download Your Free Basic Pattern
        </a>
        <small style="display:block;font-size:11px;color:#64748B;margin-top:6px;">Link active for 24 hours. Keep your downloaded file safe.</small>
      </div>

      <div style="margin-top:14px;padding-top:12px;border-top:1px solid #E2E8F0;font-size:11px;color:#94A3B8;line-height:1.4;">
        * Note: Paid CAD pattern files (DXF/HPGL/PLT), Construction Tech Pack, and Measurement Charts remain independent paid options.
      </div>
    </div>
    <div id="imageLightboxModal" class="pd-modal" role="dialog" aria-modal="true" aria-label="Garment image preview">
      <div class="pd-modal-content">
        <button type="button" class="pd-modal-close" id="closeLightboxBtn" aria-label="Close preview">&times;</button>
        <div class="pd-modal-nav-bar">
          <span id="lightboxCaption" class="pd-modal-caption">Front View (1 of <%= galleryImages.length || 1 %>)</span>
        </div>
        <div class="pd-modal-img-wrap">
          <% if (galleryImages.length > 1) { %>
            <button type="button" class="pd-modal-nav-btn pd-modal-prev" id="prevLightboxBtn" aria-label="Previous image">&lang;</button>
          <% } %>
          <img id="lightboxImg" class="pd-modal-img" src="" alt="Garment enlarged preview">
          <% if (galleryImages.length > 1) { %>
            <button type="button" class="pd-modal-nav-btn pd-modal-next" id="nextLightboxBtn" aria-label="Next image">&rang;</button>
          <% } %>
        </div>
        <% if (galleryImages.length > 1) { %>
          <div class="pd-modal-thumbs" id="lightboxThumbsBar">
            <% galleryImages.forEach((src, idx) => { %>
              <button type="button" class="pd-modal-thumb-btn <%= idx === 0 ? 'active' : '' %>" data-index="<%= idx %>" data-src="<%= src %>" aria-label="Photo <%= idx + 1 %>">
                <img src="<%= src %>" alt="Thumbnail <%= idx + 1 %>">
              </button>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Sticky Buy Bar -->
    <aside id="sticky-buy-bar" class="sticky-buy-bar" aria-label="Sticky Purchase Bar">
      <div class="sticky-info">
        <% if(mainImageSrc){ %><img src="<%= mainImageSrc %>" alt="" class="sticky-thumb" id="stickyThumb"><% } %>
        <div>
          <h4 class="sticky-title"><%= product.name %></h4>
          <span class="sticky-badges" id="stickySizeBadge">Size: <%= initialSelectedSize %></span>
        </div>
      </div>
      <div class="sticky-actions">
        <span class="sticky-price" id="stickyTotal">&#8377;<%= (basePrice + Math.round(basePrice * (gstRate / 100))).toLocaleString('en-IN') %></span>
        <button type="button" id="stickyAddToCart" class="ref-btn-cart" style="height:40px;padding:0 16px;font-size:13px;">Add to Cart</button>
        <button type="button" id="stickyBuyNow" class="ref-btn-buy" style="height:40px;padding:0 20px;font-size:13px;">Place Order &rarr;</button>
      </div>
    </aside>

    <!-- Configuration payload for client-side scripts -->
    <script id="pattern-config" type="application/ld+json"><%- JSON.stringify({
      id: String(product._id),
      base: basePrice,
      digitalAvailability: mappedFormats,
      extra: Number(product.additional_size_price || 0),
      physical: physicalPrice,
      trial: Number(product.trial_price || 0),
      formatPricing: fp,
      bundlePrice: bundlePrice,
      isBundleActive: isBundleActive,
      priceDxf: priceDxf,
      priceHpgl: priceHpgl,
      pricePlt: pricePlt,
      pricePdf: pricePdf,
      techPackPrice: techPackPrice,
      sizePrices: product.size_prices || []
    }).replace(/</g, '\\u003c') %></script>
  </main>

  <%- include('partials/footer') %>

  <!-- Interactive Client-side Logic -->
  <script>
  (() => {
    // 1. Multi-Photo Gallery & Front/Back Switching
    const mainImg = document.getElementById('mainProductImage');
    const thumbs = document.querySelectorAll('.ref-thumb-btn');
    const viewBadges = document.querySelectorAll('.ref-view-badge');
    const gallerySources = Array.from(thumbs).map(t => t.dataset.src).filter(Boolean);
    let currentImageIndex = 0;

    function getPhotoLabel(idx) {
      if (idx === 0) return 'Front View';
      if (idx === 1) return 'Back View';
      return 'Detail View ' + (idx - 1);
    }

    function switchPhoto(index) {
      if (index < 0 || index >= gallerySources.length || !mainImg) return;
      currentImageIndex = index;
      const targetSrc = gallerySources[index];
      mainImg.style.opacity = '0.35';

      thumbs.forEach((t, i) => {
        if (i === index) t.classList.add('active');
        else t.classList.remove('active');
      });

      viewBadges.forEach((b, i) => {
        if (i === index) {
          b.classList.add('active');
          b.setAttribute('aria-selected', 'true');
        } else {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        }
      });

      const pre = new Image();
      pre.onload = () => {
        mainImg.src = targetSrc;
        mainImg.style.opacity = '1';
      };
      pre.src = targetSrc;
      updateLightboxDisplay();
    }

    thumbs.forEach((btn, idx) => {
      btn.addEventListener('click', () => switchPhoto(idx));
    });

    viewBadges.forEach((badge, idx) => {
      badge.addEventListener('click', () => switchPhoto(idx));
    });

    // 2. Click-to-Enlarge / Full-screen Image Lightbox
    const modal = document.getElementById('imageLightboxModal');
    const lightboxImg = document.getElementById('lightboxImg');
    const lightboxCaption = document.getElementById('lightboxCaption');
    const prevLightboxBtn = document.getElementById('prevLightboxBtn');
    const nextLightboxBtn = document.getElementById('nextLightboxBtn');
    const zoomBtn = document.getElementById('zoomTriggerBtn');
    const closeBtn = document.getElementById('closeLightboxBtn');
    const lightboxThumbs = document.querySelectorAll('.pd-modal-thumb-btn');

    function updateLightboxDisplay() {
      if (!lightboxImg || !gallerySources.length) return;
      const src = gallerySources[currentImageIndex] || mainImg?.src || '';
      lightboxImg.src = src;
      if (lightboxCaption) {
        lightboxCaption.textContent = getPhotoLabel(currentImageIndex) + ' (' + (currentImageIndex + 1) + ' of ' + gallerySources.length + ')';
      }
      lightboxThumbs.forEach((tb, i) => {
        if (i === currentImageIndex) tb.classList.add('active');
        else tb.classList.remove('active');
      });
    }

    function openModal() {
      if (!modal || !lightboxImg || !mainImg) return;
      updateLightboxDisplay();
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    function prevPhoto() {
      if (!gallerySources.length) return;
      const nextIdx = (currentImageIndex - 1 + gallerySources.length) % gallerySources.length;
      switchPhoto(nextIdx);
    }

    function nextPhoto() {
      if (!gallerySources.length) return;
      const nextIdx = (currentImageIndex + 1) % gallerySources.length;
      switchPhoto(nextIdx);
    }

    zoomBtn?.addEventListener('click', openModal);
    mainImg?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    prevLightboxBtn?.addEventListener('click', (e) => { e.stopPropagation(); prevPhoto(); });
    nextLightboxBtn?.addEventListener('click', (e) => { e.stopPropagation(); nextPhoto(); });
    modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

    lightboxThumbs.forEach((btn, idx) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        switchPhoto(idx);
      });
    });

    window.addEventListener('keydown', (e) => {
      if (!modal?.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeModal();
      else if (e.key === 'ArrowLeft') prevPhoto();
      else if (e.key === 'ArrowRight') nextPhoto();
    });

    // Touch Swipe for Mobile Lightbox
    let touchStartX = 0;
    lightboxImg?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    lightboxImg?.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].screenX;
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) prevPhoto();
        else nextPhoto();
      }
    }, { passive: true });

    // 2b. Measurement Size Chart: Unit Toggle (CM / INCHES) & Highlight
    const unitBtns = document.querySelectorAll('#unitToggle .unit-btn');
    const specCells = document.querySelectorAll('#measurementTable .sz-val');
    unitBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const unit = btn.dataset.unit;
        unitBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        specCells.forEach(td => {
          const val = td.dataset[unit];
          if (val) td.textContent = val + ' ' + unit;
        });
      });
    });

    // Toggle PDF In-page Preview
    document.querySelectorAll('.btn-toggle-pdf-preview').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.dataset.target;
        const box = document.getElementById(targetId);
        if (!box) return;
        if (box.style.display === 'none' || !box.style.display) {
          box.style.display = 'block';
          btn.textContent = 'Hide Preview ↑';
        } else {
          box.style.display = 'none';
          btn.textContent = 'Preview ↓';
        }
      });
    });

    function highlightSizeInTable(sz) {
      document.querySelectorAll('#measurementTable .sz-col').forEach(th => {
        if (th.dataset.sizeCol === sz) th.classList.add('highlighted');
        else th.classList.remove('highlighted');
      });
    }

    // 3. Size Guide Modal
    const btnSizeGuide = document.getElementById('btn-size-guide');
    const sizeGuideModal = document.getElementById('size-guide-modal');
    const sizeGuideBackdrop = document.getElementById('size-guide-backdrop');
    const sizeGuideClose = document.getElementById('size-guide-close');

    function openSizeGuide() {
      sizeGuideModal?.classList.add('is-visible');
      sizeGuideBackdrop?.classList.add('is-visible');
    }
    function closeSizeGuide() {
      sizeGuideModal?.classList.remove('is-visible');
      sizeGuideBackdrop?.classList.remove('is-visible');
    }
    btnSizeGuide?.addEventListener('click', openSizeGuide);
    sizeGuideClose?.addEventListener('click', closeSizeGuide);
    sizeGuideBackdrop?.addEventListener('click', closeSizeGuide);

    // Synchronize size chip from guide into main form
    document.querySelectorAll('.size-guide-select-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        const sz = btn.dataset.size;
        selectSize(sz);
        closeSizeGuide();
      });
    });

    // 4. STEP 1 — Soft Copy Sizes Selection (Multi-size checkboxes)
    const digitalInput = document.getElementById('digital-option');
    const softPills = document.querySelectorAll('.ref-size-pill[data-soft-size]');
    const btnSelectAllSoft = document.getElementById('btnSelectAllSoftSizes');
    const btnClearSoft = document.getElementById('btnClearSoftSizes');
    const softSizeCountLabel = document.getElementById('softSizeCountLabel');
    const stickySizeBadge = document.getElementById('stickySizeBadge');

    function getSelectedSoftSizes() {
      if (!digitalInput?.checked && !document.getElementById('trial-sample-option')?.checked && !Array.from(document.querySelectorAll('.measurement-file')).some(input=>input.checked) && !document.getElementById('techPackInput')?.checked) return [];
      const selected = [];
      softPills.forEach(pill => {
        const input = pill.querySelector('input.soft-size-check');
        if (input && input.checked && !input.disabled) selected.push(pill.dataset.softSize);
      });
      return selected;
    }

    function updateSoftSizePillStates() {
      const selected = getSelectedSoftSizes();
      softPills.forEach(pill => {
        const input = pill.querySelector('input.soft-size-check');
        if (input && input.checked) {
          pill.classList.add('selected');
        } else {
          pill.classList.remove('selected');
        }
      });
      if (softSizeCountLabel) {
        softSizeCountLabel.textContent = '(' + selected.length + ' size' + (selected.length === 1 ? '' : 's') + ' selected)';
      }
      if (stickySizeBadge) {
        stickySizeBadge.textContent = 'Size: ' + (selected.length > 0 ? selected.join(', ') : 'None');
      }
      recalculateTotals();
    }

    softPills.forEach(pill => {
      pill.addEventListener('click', (e) => {
        e.preventDefault();
        const input = pill.querySelector('input.soft-size-check');
        if (input?.disabled) return;
        if (input) input.checked = !input.checked;
        updateSoftSizePillStates();
      });
    });

    btnSelectAllSoft?.addEventListener('click', () => {
      softPills.forEach(pill => {
        const input = pill.querySelector('input.soft-size-check');
        if (input && !input.disabled) input.checked = true;
      });
      updateSoftSizePillStates();
    });

    btnClearSoft?.addEventListener('click', () => {
      softPills.forEach(pill => {
        const input = pill.querySelector('input.soft-size-check');
        if (input) input.checked = false;
      });
      updateSoftSizePillStates();
    });

    // 5. STEP 1 — Choose Digital File Formats
    const formatConfigs = [
      { card: 'formatCardDxf', input: 'formatInputDxf', cb: 'formatCbDxf' },
      { card: 'formatCardHpgl', input: 'formatInputHpgl', cb: 'formatCbHpgl' },
      { card: 'formatCardPlt', input: 'formatInputPlt', cb: 'formatCbPlt' },
      { card: 'formatCardPdf', input: 'formatInputPdf', cb: 'formatCbPdf' }
    ];

    // Auto-bundle all available, authorized formats for soft copy
    function selectBundledFormats() {
      const cfg = JSON.parse(document.getElementById('pattern-config')?.textContent || '{}');
      const formatPricing = cfg.formatPricing || {};
      const availableItems = formatConfigs.filter(item => {
        const inp = document.getElementById(item.input);
        if (!inp || inp.dataset.available === 'false') return false;
        if (Object.keys(formatPricing).length > 0 && !formatPricing[inp.value]) {
          return false;
        }
        return true;
      });
      availableItems.forEach(item => {
        const el = document.getElementById(item.card);
        const inp = document.getElementById(item.input);
        const mark = document.getElementById(item.cb)?.querySelector('span');
        if (inp) { inp.disabled = false; inp.checked = true; }
        if (el) el.classList.add('checked');
        if (mark) mark.style.display = 'inline';
      });
    }

    if (digitalInput && digitalInput.checked) {
      selectBundledFormats();
    }

    formatConfigs.forEach(item => {
      const cardEl = document.getElementById(item.card);
      const inputEl = document.getElementById(item.input);
      const cbEl = document.getElementById(item.cb);
      cardEl?.addEventListener('click', (e) => {
        e.preventDefault();
        if (!inputEl || inputEl.disabled) return;
        inputEl.checked = !inputEl.checked;
        const mark = cbEl?.querySelector('span');
        if (inputEl.checked) {
          cardEl.classList.add('checked');
          if (mark) mark.style.display = 'inline';
        } else {
          cardEl.classList.remove('checked');
          if (mark) mark.style.display = 'none';
        }
        syncDigitalSizeAvailability();
      });
    });

    function getSelectedDigitalFormats() {
      if (!digitalInput?.checked) return [];
      return formatConfigs
        .map(item => document.getElementById(item.input))
        .filter(inp => inp && inp.checked && !inp.disabled)
        .map(inp => inp.value);
    }

    function syncDigitalSizeAvailability() {
      formatConfigs.forEach(item => {
        const input = document.getElementById(item.input);
        const card = document.getElementById(item.card);
        if (input) input.disabled = !digitalInput?.checked || input.dataset.available === 'false';
        if (card) {
          card.style.opacity = digitalInput?.checked ? '1' : '0.45';
          card.setAttribute('aria-disabled', String(!digitalInput?.checked));
        }
      });
      if (techPackInput) techPackInput.disabled = !techPackAvailable;
      if (sumTechPackRow) sumTechPackRow.style.display = techPackInput?.checked ? 'flex' : 'none';
      const formats = getSelectedDigitalFormats();
      const availability = JSON.parse(document.getElementById('pattern-config').textContent || '{}').digitalAvailability || {};
      const enabled = formats.length > 0 || document.getElementById('trial-sample-option')?.checked || techPackInput?.checked || Array.from(document.querySelectorAll('.measurement-file')).some(input=>input.checked);
      const selection = document.getElementById('digitalSizeSelection');
      if (selection) {
        selection.classList.toggle('is-disabled', !enabled);
        selection.setAttribute('aria-disabled', String(!enabled));
      }
      softPills.forEach(pill => {
        const input = pill.querySelector('input.soft-size-check');
        if (input) {
          input.disabled = !enabled || (Object.keys(availability).length > 0 && formats.some(format => !(availability[format] || []).includes(input.value)));
        }
      });
      if (btnSelectAllSoft) btnSelectAllSoft.disabled = !enabled;
      if (btnClearSoft) btnClearSoft.disabled = !enabled;
      updateSoftSizePillStates();
    }
    digitalInput?.addEventListener('change', () => {
      if (digitalInput.checked) {
        selectBundledFormats();
      } else {
        formatConfigs.forEach(item => {
          const el = document.getElementById(item.card);
          const inp = document.getElementById(item.input);
          const mark = el ? el.querySelector('.format-checkbox-custom span') : null;
          if (inp) inp.checked = false;
          if (el) el.classList.remove('checked');
          if (mark) mark.style.display = 'none';
        });
      }
      syncDigitalSizeAvailability();
    });

    // 6. STEP 2 — Tech Pack (Separate Optional Card)
    const techPackCard = document.getElementById('techPackCard');
    const techPackInput = document.getElementById('techPackInput');
    const techPackAvailable = Boolean(techPackInput && !techPackInput.disabled);
    const techPackCheckMark = document.getElementById('techPackCheckMark');
    const sumTechPackRow = document.getElementById('sumTechPackRow');
    const sumTechPackPrice = document.getElementById('sumTechPackPrice');

    techPackCard?.addEventListener('click', (e) => {
      e.preventDefault();
      if (techPackInput?.disabled) return;
      techPackInput.checked = !techPackInput.checked;
      const mark = techPackCheckMark?.querySelector('span');
      if (techPackInput.checked) {
        techPackCard.classList.add('checked');
        if (mark) mark.style.display = 'inline';
        if (sumTechPackRow) sumTechPackRow.style.display = 'flex';
        const price = Number(techPackInput.dataset.price || 0);
        if (sumTechPackPrice) sumTechPackPrice.textContent = '₹' + price.toLocaleString('en-IN');
      } else {
        techPackCard.classList.remove('checked');
        if (mark) mark.style.display = 'none';
        if (sumTechPackRow) sumTechPackRow.style.display = 'none';
      }
      syncDigitalSizeAvailability();
    });

    // 7. STEP 3 — Physical Printout & Independent Physical Sizes
    const physicalCard = document.getElementById('physicalPrintoutCard');
    const physicalInput = document.getElementById('physical-option');
    const physicalCopies = document.getElementById('physical-copies');
    physicalCopies?.addEventListener('input', recalculateTotals);
    function getPhysicalCopies() {
      const copies = Number(physicalCopies?.value);
      return Number.isInteger(copies) && copies >= 1 && copies <= 1000 ? copies : 0;
    }
    const physicalCheckMark = document.getElementById('physicalPrintoutCheckMark');
    const physicalSizesContainer = document.getElementById('physicalSizesContainer');
    const physPills = document.querySelectorAll('.ref-size-pill[data-phys-size]');
    const btnSelectAllPhys = document.getElementById('btnSelectAllPhysSizes');
    const btnClearPhys = document.getElementById('btnClearPhysSizes');
    const physSizeCountLabel = document.getElementById('physSizeCountLabel');
    const sumPhysicalRow = document.getElementById('sumPhysicalRow');
    const sumPhysicalLabel = document.getElementById('sumPhysicalLabel');
    const sumPhysicalPrice = document.getElementById('sumPhysicalPrice');

    function getSelectedPhysSizes() {
      const selected = [];
      physPills.forEach(pill => {
        const input = pill.querySelector('input.phys-size-check');
        if (input && input.checked) selected.push(pill.dataset.physSize);
      });
      return selected;
    }

    function updatePhysSizePillStates() {
      const selected = getSelectedPhysSizes();
      physPills.forEach(pill => {
        const input = pill.querySelector('input.phys-size-check');
        if (input && input.checked) {
          pill.classList.add('selected');
        } else {
          pill.classList.remove('selected');
        }
      });
      if (physSizeCountLabel) {
        physSizeCountLabel.textContent = '(' + selected.length + ' size' + (selected.length === 1 ? '' : 's') + ' selected)';
      }
      recalculateTotals();
    }

    physicalCard?.addEventListener('click', (e) => {
      e.preventDefault();
      if (physicalInput?.disabled) return;
      physicalInput.checked = !physicalInput.checked;
      if (physicalCopies) physicalCopies.disabled = !physicalInput.checked;
      const mark = physicalCheckMark?.querySelector('span');
      if (physicalInput.checked) {
        physicalCard.classList.add('checked');
        if (mark) mark.style.display = 'inline';
        if (physicalSizesContainer) {
          physicalSizesContainer.style.opacity = '1';
          physicalSizesContainer.style.pointerEvents = 'auto';
        }
      } else {
        physicalCard.classList.remove('checked');
        if (mark) mark.style.display = 'none';
        if (physicalSizesContainer) {
          physicalSizesContainer.style.opacity = '0.45';
          physicalSizesContainer.style.pointerEvents = 'none';
        }
      }
      recalculateTotals();
    });

    physPills.forEach(pill => {
      pill.addEventListener('click', (e) => {
        e.preventDefault();
        const input = pill.querySelector('input.phys-size-check');
        if (!physicalInput?.checked) return;
        if (input) input.checked = !input.checked;
        updatePhysSizePillStates();
      });
    });

    btnSelectAllPhys?.addEventListener('click', () => {
      if (!physicalInput?.checked) return;
      physPills.forEach(pill => {
        const input = pill.querySelector('input.phys-size-check');
        if (input) input.checked = true;
      });
      updatePhysSizePillStates();
    });

    btnClearPhys?.addEventListener('click', () => {
      physPills.forEach(pill => {
        const input = pill.querySelector('input.phys-size-check');
        if (input) input.checked = false;
      });
      updatePhysSizePillStates();
    });

    // 7b. STEP 6 — Customize Markers Tabs & Numeric Validation
    const tabBtnStripes = document.getElementById('tabBtnStripes');
    const tabBtnChecks = document.getElementById('tabBtnChecks');
    const panelStripes = document.getElementById('panelStripes');
    const panelChecks = document.getElementById('panelChecks');

    tabBtnStripes?.addEventListener('click', () => {
      tabBtnStripes.classList.add('active');
      tabBtnStripes.setAttribute('aria-selected', 'true');
      tabBtnChecks?.classList.remove('active');
      tabBtnChecks?.setAttribute('aria-selected', 'false');
      panelStripes?.classList.add('active');
      panelChecks?.classList.remove('active');
    });

    tabBtnChecks?.addEventListener('click', () => {
      tabBtnChecks.classList.add('active');
      tabBtnChecks.setAttribute('aria-selected', 'true');
      tabBtnStripes?.classList.remove('active');
      tabBtnStripes?.setAttribute('aria-selected', 'false');
      panelChecks?.classList.add('active');
      panelStripes?.classList.remove('active');
    });

    function validateMarkerNumber(input, errEl, minVal) {
      if (!input) return true;
      const val = input.value.trim();
      if (!val) {
        input.classList.remove('input-invalid');
        if (errEl) errEl.style.display = 'none';
        return true;
      }
      const num = Number(val);
      if (!Number.isFinite(num) || num <= 0 || (minVal && num < minVal)) {
        input.classList.add('input-invalid');
        if (errEl) {
          errEl.textContent = 'Enter a valid positive number in cm';
          errEl.style.display = 'block';
        }
        return false;
      }
      input.classList.remove('input-invalid');
      if (errEl) errEl.style.display = 'none';
      return true;
    }

    const inpStripesRep = document.getElementById('inputStripesRepeat');
    const errStripesRep = document.getElementById('errStripesRepeat');
    const inpStripesCut = document.getElementById('inputStripesCuttable');
    const errStripesCut = document.getElementById('errStripesCuttable');

    const inpChecksWarp = document.getElementById('inputChecksWarp');
    const errChecksWarp = document.getElementById('errChecksWarp');
    const inpChecksWeft = document.getElementById('inputChecksWeft');
    const errChecksWeft = document.getElementById('errChecksWeft');
    const inpChecksCut = document.getElementById('inputChecksCuttable');
    const errChecksCut = document.getElementById('errChecksCuttable');

    [
      { inp: inpStripesRep, err: errStripesRep, min: 0.1 },
      { inp: inpStripesCut, err: errStripesCut, min: 1 },
      { inp: inpChecksWarp, err: errChecksWarp, min: 0.1 },
      { inp: inpChecksWeft, err: errChecksWeft, min: 0.1 },
      { inp: inpChecksCut, err: errChecksCut, min: 1 }
    ].forEach(({ inp, err, min }) => {
      if (!inp) return;
      inp.addEventListener('input', () => {
        validateMarkerNumber(inp, err, min);
        updateMarkerSummary();
      });
      inp.addEventListener('blur', () => {
        validateMarkerNumber(inp, err, min);
        updateMarkerSummary();
      });
    });

    function updateMarkerSummary() {
      const sumMarker = document.getElementById('sumMarkerStatus');
      if (!sumMarker) return;
      const mini = document.getElementById('miniMarkerOption');
      sumMarker.textContent = mini?.checked ? 'Fabric Consumption Mini Marker: INR '+Number(mini.dataset.price).toFixed(2) : 'No mini marker selected';
    }

    // 8. Dynamic Subtotal, Tax (18% GST), and Total Calculation
    const basePrice = <%= basePrice %>;
    const physicalPrice = <%= physicalPrice %>;
    const gstRate = <%= gstRate %>;
    const sumSubtotal = document.getElementById('sumSubtotal');
    const sumTaxAmount = document.getElementById('sumTaxAmount');
    const pdTotal = document.getElementById('pdTotal');
    const stickyTotal = document.getElementById('stickyTotal');
    const patternSubtotal = document.getElementById('pattern-subtotal');
    const patternTax = document.getElementById('pattern-tax');

    function recalculateTotals() {
      const config = JSON.parse(document.getElementById('pattern-config').textContent || '{}');
      const selectedFormats = getSelectedDigitalFormats();
      const selectedSoftSizes = getSelectedSoftSizes();
      const hasDigital = selectedFormats.length > 0 && selectedSoftSizes.length > 0;
      const isPhysical = Boolean(physicalInput && physicalInput.checked);
      const selectedPhysSizes = isPhysical ? getSelectedPhysSizes() : [];
      const hasPhysical = isPhysical && selectedPhysSizes.length > 0;
      const hasTechPack = Boolean(techPackInput && techPackInput.checked && !techPackInput.disabled);

      // 1. Soft Copy Calculation
      let softCopyCost = 0;
      if (hasDigital) {
        const extraPerSize = config.extra !== undefined ? Number(config.extra) : Number(config.bundlePrice ?? basePrice);
        softCopyCost = (Math.round(basePrice * 100) + Math.max(0, selectedSoftSizes.length - 1) * Math.round(extraPerSize * 100)) / 100;
      }

      const sumSoftCopyRow = document.getElementById('sumSoftCopyRow');
      const sumSoftCopyLabel = document.getElementById('sumSoftCopyLabel');
      const sumSoftCopyPrice = document.getElementById('sumSoftCopyPrice');
      if (sumSoftCopyRow) {
        if (hasDigital) {
          sumSoftCopyRow.style.display = 'flex';
          if (sumSoftCopyLabel) sumSoftCopyLabel.textContent = 'Soft Copy Bundle (' + selectedSoftSizes.length + ' size' + (selectedSoftSizes.length === 1 ? '' : 's') + ' × ' + selectedFormats.length + ' format' + (selectedFormats.length === 1 ? '' : 's') + ')';
          if (sumSoftCopyPrice) sumSoftCopyPrice.textContent = '₹' + softCopyCost.toLocaleString('en-IN');
        } else {
          if (sumSoftCopyLabel) sumSoftCopyLabel.textContent = 'Soft Copy (0 sizes selected)';
          if (sumSoftCopyPrice) sumSoftCopyPrice.textContent = '₹0';
        }
      }

      // 2. Physical Pattern Calculation (Independent of soft copy)
      let physicalCost = 0;
      if (hasPhysical) {
        physicalCost = selectedPhysSizes.reduce((sum, size) => {
          const input = Array.from(document.querySelectorAll('.phys-size-check')).find(candidate => candidate.value === size);
          return sum + Number(input?.dataset.price ?? physicalPrice);
        }, 0) * getPhysicalCopies();
      }
      if (sumPhysicalRow) {
        if (hasPhysical) {
          sumPhysicalRow.style.display = 'flex';
          if (sumPhysicalLabel) sumPhysicalLabel.textContent = 'Hard Copy (' + selectedPhysSizes.length + ' sizes × ' + getPhysicalCopies() + ' copies)';
          if (sumPhysicalPrice) sumPhysicalPrice.textContent = '₹' + physicalCost.toLocaleString('en-IN');
        } else {
          sumPhysicalRow.style.display = 'none';
        }
      }

      // 3. Tech Pack Calculation
      let techPackCost = 0;
      if (hasTechPack) {
        techPackCost = Number(techPackInput.dataset.price || 0) * (techPackInput.dataset.perSize === 'true' ? selectedSoftSizes.length : 1);
        if (sumTechPackPrice) sumTechPackPrice.textContent = '₹' + techPackCost.toLocaleString('en-IN');
      }

      const trialSizeDisplay = document.getElementById('trialSelectedSizeDisplay');
      if (trialSizeDisplay) trialSizeDisplay.textContent = selectedSoftSizes.join(', ') || 'Select a size';
      // 4. Trial Fit Sample Calculation
      const trialCheck = document.getElementById('trial-sample-option');
      const trialQtyInput = document.getElementById('trial-sample-quantity');
      const trialControls = document.getElementById('trialSampleControls');
      const sumTrialRow = document.getElementById('sumTrialRow');
      const sumTrialLabel = document.getElementById('sumTrialLabel');
      const sumTrialPrice = document.getElementById('sumTrialPrice');
      const hasTrial = Boolean(trialCheck && trialCheck.checked && !trialCheck.disabled);
      let trialQty = 0;
      let trialCost = 0;
      if (hasTrial) {
        trialQty = Number(trialQtyInput?.value || 1) * selectedSoftSizes.length;
        trialCost = trialQty * (Number(trialCheck.dataset.price) || config.trial || 0);
        if (trialControls) trialControls.style.display = 'block';
        if (sumTrialRow) {
          sumTrialRow.style.display = 'flex';
          if (sumTrialLabel) sumTrialLabel.textContent = 'Trial Fit Sample (' + trialQty + ' sample' + (trialQty > 1 ? 's' : '') + ')';
          if (sumTrialPrice) sumTrialPrice.textContent = '₹' + trialCost.toLocaleString('en-IN');
        }
      } else {
        if (trialControls) trialControls.style.display = 'none';
        if (sumTrialRow) sumTrialRow.style.display = 'none';
      }

      // Subtotal calculation
      const mini = document.getElementById('miniMarkerOption');
      const miniCost = mini?.checked ? Number(mini.dataset.price) : 0;
      const measurementCost = Array.from(document.querySelectorAll('.measurement-file')).filter(input=>input.checked).reduce((sum,input)=>sum + Number(input.dataset.price) * (input.dataset.perSize === 'true' ? selectedSoftSizes.length : 1),0);
      const measurementSummary = document.getElementById('sumMeasurementPrice');
      const measurementRow = document.getElementById('sumMeasurementRow');
      if (measurementSummary) measurementSummary.textContent = '₹' + measurementCost.toLocaleString('en-IN');
      if (measurementRow) measurementRow.style.display = measurementCost > 0 ? 'flex' : 'none';
      const subtotal = softCopyCost + physicalCost + techPackCost + miniCost + trialCost + measurementCost;
      const markerSummary = document.getElementById('sumMarkerStatus');
      if(markerSummary) markerSummary.textContent = miniCost ? 'Fabric Consumption Mini Marker: INR '+miniCost.toFixed(2) : 'No mini marker selected';

      // 18% GST calculation
      const tax = Math.round(subtotal * gstRate) / 100;
      const grandTotal = subtotal + tax;

      if (sumSubtotal) sumSubtotal.textContent = '₹' + subtotal.toLocaleString('en-IN');
      if (sumTaxAmount) sumTaxAmount.textContent = '₹' + tax.toLocaleString('en-IN');
      if (pdTotal) pdTotal.textContent = '₹' + grandTotal.toLocaleString('en-IN');
      if (stickyTotal) stickyTotal.textContent = '₹' + grandTotal.toLocaleString('en-IN');
      if (patternSubtotal) patternSubtotal.textContent = '₹' + subtotal.toLocaleString('en-IN');
      if (patternTax) patternTax.textContent = '₹' + tax.toLocaleString('en-IN');
    }

    document.querySelectorAll('.measurement-file').forEach(input=>input.addEventListener('change', syncDigitalSizeAvailability));
    document.getElementById('miniMarkerOption')?.addEventListener('change', recalculateTotals);
    const trialCard = document.getElementById('trialSampleCard');
    const trialCheck = document.getElementById('trial-sample-option');
    const trialCheckMark = document.getElementById('trialSampleCheckMark');
    trialCard?.addEventListener('click', (e) => {
      e.preventDefault();
      if (trialCheck?.disabled) return;
      trialCheck.checked = !trialCheck.checked;
      const mark = trialCheckMark?.querySelector('span');
      if (trialCheck.checked) {
        trialCard.classList.add('checked');
        if (mark) mark.style.display = 'inline';
      } else {
        trialCard.classList.remove('checked');
        if (mark) mark.style.display = 'none';
      }
      syncDigitalSizeAvailability();
    });
    document.getElementById('trial-sample-quantity')?.addEventListener('input', recalculateTotals);
    document.querySelectorAll('.marker-service-option').forEach(input=>input.addEventListener('change',()=>{
      const total=Array.from(document.querySelectorAll('.marker-service-option')).filter(i=>i.checked).reduce((sum,i)=>sum+Number(i.dataset.price),0);
      const markerTotalEl = document.getElementById('markerEnquiryTotal');
      if (markerTotalEl) markerTotalEl.textContent='Selected enquiry services: INR '+total.toFixed(2)+'. Not charged at checkout.';
    }));
    syncDigitalSizeAvailability();

    // 9. Sticky Buy Bar Scroll Trigger
    const stickyBar = document.getElementById('sticky-buy-bar');
    const actionsRow = document.querySelector('.ref-actions-row');
    if (stickyBar && actionsRow) {
      window.addEventListener('scroll', () => {
        const rect = actionsRow.getBoundingClientRect();
        if (rect.bottom < 0) {
          stickyBar.classList.add('is-visible');
        } else {
          stickyBar.classList.remove('is-visible');
        }
      }, { passive: true });
    }

    document.getElementById('stickyAddToCart')?.addEventListener('click', () => {
      document.getElementById('pdAddToCart')?.click();
    });
    document.getElementById('stickyBuyNow')?.addEventListener('click', () => {
      document.getElementById('pdBuyNow')?.click();
    });

    // 10. Add to Cart & Place Order Handler
    const form = document.getElementById('pattern-purchase');
    const btnAdd = document.getElementById('pdAddToCart');
    const btnBuy = document.getElementById('pdBuyNow');
    const errBanner = document.getElementById('pattern-error');
    const config = JSON.parse(document.getElementById('pattern-config').textContent);

    async function handlePurchase(destination) {
      if (errBanner) {
        errBanner.style.display = 'none';
        errBanner.textContent = '';
      }

      // Validate custom marker fields if entered
      const sRepVal = inpStripesRep?.value.trim();
      const sCutVal = inpStripesCut?.value.trim();
      if ((sRepVal || sCutVal) && (!validateMarkerNumber(inpStripesRep, errStripesRep, 0.1) || !validateMarkerNumber(inpStripesCut, errStripesCut, 1))) {
        if (errBanner) {
          errBanner.textContent = 'Please enter valid positive centimeter values for custom stripes marker.';
          errBanner.style.display = 'block';
        }
        return;
      }

      const cWarpVal = inpChecksWarp?.value.trim();
      const cWeftVal = inpChecksWeft?.value.trim();
      const cCutVal = inpChecksCut?.value.trim();
      if ((cWarpVal || cWeftVal || cCutVal) && (!validateMarkerNumber(inpChecksWarp, errChecksWarp, 0.1) || !validateMarkerNumber(inpChecksWeft, errChecksWeft, 0.1) || !validateMarkerNumber(inpChecksCut, errChecksCut, 1))) {
        if (errBanner) {
          errBanner.textContent = 'Please enter valid positive centimeter values for custom checks marker.';
          errBanner.style.display = 'block';
        }
        return;
      }

      const selectedFormats = getSelectedDigitalFormats();
      const selectedSoftSizes = getSelectedSoftSizes();
      const hasDigital = selectedFormats.length > 0 && selectedSoftSizes.length > 0;
      const isPhysical = Boolean(physicalInput && physicalInput.checked);
      const selectedPhysSizes = isPhysical ? getSelectedPhysSizes() : [];
      const hasPhysical = isPhysical && selectedPhysSizes.length > 0;
      const hasTechPack = Boolean(techPackInput && techPackInput.checked && !techPackInput.disabled);

      const hasMiniMarker = Boolean(document.getElementById('miniMarkerOption')?.checked);
      const trialCheckInBuy = document.getElementById('trial-sample-option');
      const hasTrial = Boolean(trialCheckInBuy && trialCheckInBuy.checked && !trialCheckInBuy.disabled);
      const trialCopies = Number(document.getElementById('trial-sample-quantity')?.value || 1);
      const trialQty = hasTrial ? trialCopies * selectedSoftSizes.length : 0;

      const measurementInputs = Array.from(document.querySelectorAll('.measurement-file')).filter(input=>input.checked);
      const selectionError = hasTrial && (!selectedSoftSizes.length || !Number.isInteger(trialCopies) || trialCopies < 1 || trialCopies > 1000) ? 'Select sizes and a whole-number trial quantity per size.' : !digitalInput?.checked && !isPhysical && !hasMiniMarker && !hasTrial && !hasTechPack && !measurementInputs.length
        ? 'Select Physical Pattern Printout, Digital Pattern / Soft Copy, mini marker, or trial fit sample to proceed.'
        : digitalInput?.checked && !hasDigital
          ? 'Select at least one digital format and size.'
          : isPhysical && (!hasPhysical || !getPhysicalCopies())
            ? 'Select at least one physical size and a whole-number print quantity from 1 to 1000.'
            : '';
      if (selectionError) {
        if (errBanner) {
          errBanner.textContent = selectionError;
          errBanner.style.display = 'block';
        }
        return;
      }

      if (btnAdd) btnAdd.disabled = true;
      if (btnBuy) btnBuy.disabled = true;

      const filesPayload = (hasMiniMarker ? JSON.parse(document.getElementById('miniMarkerOption').dataset.files) : []).concat(measurementInputs.map(input=>input.value));
      if (hasTechPack && techPackInput.value) {
        filesPayload.push(techPackInput.value);
      }

      const payload = {
        product_id: config.id,
        selected_sizes: selectedSoftSizes,
        physical_sizes: selectedPhysSizes,
        printable_selected: hasDigital,
        selected_formats: selectedFormats,
        quantity: hasDigital || hasTechPack || hasMiniMarker || measurementInputs.length ? 1 : 0,
        physical_quantity: selectedPhysSizes.length * (isPhysical ? getPhysicalCopies() : 0),
        trial_quantity: hasTrial ? trialQty : 0,
        files: filesPayload,
        addons: []
      };

      try {
        const res = await fetch('/cart/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (!res.ok) {
          throw new Error(result.error || 'Unable to add pattern to order.');
        }
        window.location.href = destination;
      } catch (err) {
        if (errBanner) {
          errBanner.textContent = err.message;
          errBanner.style.display = 'block';
        }
        if (btnAdd) btnAdd.disabled = false;
        if (btnBuy) btnBuy.disabled = false;
      }
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      handlePurchase('/cart');
    });

    btnBuy?.addEventListener('click', (e) => {
      e.preventDefault();
      handlePurchase('/checkout');
    });
  })();
  </script>
  <!-- Free Basic Pattern Modal Handler -->
  <script id="free-pattern-script">
  (function() {
// ========================================================
    // Free Basic Pattern Modal Handler
    // ========================================================
    const btnOpenFree = document.getElementById('btnOpenFreePatternModal');
    const freeBackdrop = document.getElementById('free-pattern-backdrop');
    const freeModal = document.getElementById('free-pattern-modal');
    const btnCloseFree = document.getElementById('closeFreePatternBtn');
    const btnClaimFree = document.getElementById('btnClaimFreePattern');
    const freePhoneInput = document.getElementById('freePhoneInput');
    const freeAlert = document.getElementById('freePatternAlert');
    const freeDlWrap = document.getElementById('freeDownloadWrap');
    const freeDlLink = document.getElementById('freeDownloadLink');
    let selectedFreeSize = '';

    function showFreeAlert(msg, isSuccess = false) {
      if (!freeAlert) return;
      freeAlert.style.display = 'block';
      freeAlert.style.background = isSuccess ? '#ECFDF5' : '#FEF2F2';
      freeAlert.style.color = isSuccess ? '#065F46' : '#991B1B';
      freeAlert.style.border = '1px solid ' + (isSuccess ? '#A7F3D0' : '#FECACA');
      freeAlert.textContent = msg;
    }

    function hideFreeAlert() {
      if (freeAlert) freeAlert.style.display = 'none';
    }

    function openFreeModal() {
      if (freeBackdrop) { freeBackdrop.style.display = 'block'; freeBackdrop.classList.add('is-visible'); freeBackdrop.setAttribute('aria-hidden', 'false'); }
      if (freeModal) { freeModal.style.display = 'block'; freeModal.classList.add('is-visible'); }
      hideFreeAlert();
    }

    function closeFreeModal() {
      if (freeBackdrop) { freeBackdrop.style.display = 'none'; freeBackdrop.classList.remove('is-visible'); freeBackdrop.setAttribute('aria-hidden', 'true'); }
      if (freeModal) { freeModal.style.display = 'none'; freeModal.classList.remove('is-visible'); }
    }

    btnOpenFree?.addEventListener('click', openFreeModal);
    btnCloseFree?.addEventListener('click', closeFreeModal);
    freeBackdrop?.addEventListener('click', closeFreeModal);

    document.querySelectorAll('.free-size-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.free-size-pill').forEach(p => {
          p.classList.remove('selected');
          p.style.background = '#FFFFFF';
          p.style.borderColor = '#CBD5E1';
          p.style.color = '#334155';
        });
        pill.classList.add('selected');
        pill.style.background = '#0B192C';
        pill.style.borderColor = '#0B192C';
        pill.style.color = '#FFFFFF';
        selectedFreeSize = pill.dataset.freeSize || '';
      });
    });

    // Default select first size
    const firstFreePill = document.querySelector('.free-size-pill');
    if (firstFreePill) firstFreePill.click();

    btnClaimFree?.addEventListener('click', async () => {
      hideFreeAlert();
      const phone = freePhoneInput?.value?.trim();
      const emailInput = document.getElementById('freeEmailInput');
      const email = emailInput.value.trim();
      if (!selectedFreeSize) return showFreeAlert('Please select a free size.');
      if (!phone) return showFreeAlert('Please enter your mobile number.');
      if (!email || !emailInput.checkValidity()) return showFreeAlert('Enter a valid email address.');

      btnClaimFree.disabled = true;
      btnClaimFree.textContent = 'Claiming...';
      try {
        const res = await fetch('/free-pattern/claim', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            phone,
            product_id: '<%= product._id %>',
            size: selectedFreeSize,
            email
          })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Claim failed.');
        }
        showFreeAlert(data.message || 'Free pattern unlocked!', true);
        btnClaimFree.style.display = 'none';
        if (freePhoneInput) freePhoneInput.disabled = true;
        if (freeDlWrap && freeDlLink) {
          freeDlWrap.style.display = 'block';
          freeDlLink.href = data.download_url;
        }
      } catch (err) {
        showFreeAlert(err.message);
      } finally {
        btnClaimFree.disabled = false;
        btnClaimFree.textContent = 'Claim Free Basic Pattern';
      }
    });


  })();
  </script>
