<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/business.css"></head><body><%- include('../partials/admin_header') %><main class="studio-admin"><h1>Notifications</h1><p><a href="/admin/settings/notifications">Notification Settings</a></p><p role="status"><%= notice %></p><p>Sent means accepted by the provider, not confirmed delivery. Uncertain sends need provider-log review before retrying.</p><form method="get" class="studio-form"><% [['channel',['email','whatsapp']],['status',['queued','pending','sending','sent','failed','uncertain','skipped']],['event',events]].forEach(([key,values])=>{ %><label><%= key %><select name="<%= key %>"><option value="">All</option><% values.forEach(value=>{ %><option <%= query[key]===value?'selected':'' %>><%= value %></option><% }) %></select></label><% }) %><button>Filter</button></form><p><%= total %> notifications · Page <%= page %></p><% items.forEach(item=>{ %><article class="studio-card"><h2><%= item.event.replaceAll('_',' ') %></h2><p><%= item.channel %> · <span class="status-badge"><%= item.status %></span> · Attempts: <%= item.attempts %></p><p><%= item.customer %> · <%= item.destination %></p><p>Reference: <%= item.reference_type %> / <%= item.reference_id %></p><p>Provider ID: <%= item.provider_response_id || '—' %> · Sent: <%= item.sent_at?item.sent_at.toLocaleString('en-IN'):'—' %></p><% if(item.error_message){ %><p role="alert"><%= item.error_message %></p><% } %><details><summary>Message</summary><p class="studio-prose"><%= item.message %></p></details><% if(['failed','uncertain'].includes(item.status)){ %><form method="post" action="/admin/notifications/<%= item._id %>/retry"><input type="hidden" name="_csrf" value="<%= learningCsrf %>"><% if(item.status==='uncertain'){ %><label><input type="checkbox" name="duplicate_risk_acknowledged" required> I checked provider logs and understand retrying may duplicate a message</label><% } %><button>Retry Notification</button></form><% } %></article><% }) %><% for(const target of [page-1,page+1]){if(target>0 && (target-1)*50<total){ %><a href="?<%= new URLSearchParams({channel:query.channel || '',status:query.status || '',event:query.event || '',page:String(target)}).toString() %>">Page <%= target %></a> <% }} %></main></body></html>
