<body class="admin-product-editor">
  <%- include('../partials/admin_header') %>
  <main class="admin-product-editor-main">
    <header class="admin-product-editor-heading">
      <div>
        <a class="admin-product-back" href="/admin/products">&larr; Products / Patterns</a>
        <p class="eyebrow">Admin Portal</p>
        <h1><%= editingProduct ? 'Edit Product' : 'Add Product' %></h1>
        <p><%= editingProduct ? productForm.name : 'Add a product now; complete details and pricing before making it available.' %></p>
      </div>
    </header>

    <% if (message) { %><div class="alert <%= messageType === 'error' ? 'alert-error' : '' %>" role="status"><%= message %></div><% } %>

    <% if (editingProduct) { %>
      <section class="admin-setup-panel" aria-labelledby="product-setup-heading">
        <div class="admin-setup-heading">
          <div><h2 id="product-setup-heading">Product Setup</h2><p>Complete the required sections below before activating this product.</p></div>
          <span class="admin-badge <%= productSetup.missing.length ? 'admin-badge--setup' : 'admin-badge--active' %>"><%= productSetup.missing.length ? 'Setup Required' : 'Ready for Review' %></span>
        </div>
        <ol class="admin-setup-steps">
          <% productSetup.steps.forEach(step => { %><li class="<%= step.complete ? 'is-complete' : '' %>"><span aria-hidden="true"><%= step.complete ? 'âœ“' : 'â—‹' %></span><%= step.label %></li><% }) %>
        </ol>
        <% if (productSetup.missing.length) { %>
          <div class="admin-setup-missing"><strong>Setup Required</strong><ul><% productSetup.missing.forEach(item => { %><li><%= item %></li><% }) %></ul></div>
        <% } %>
      </section>
    <% } %>

    <% const uploadCsrf = typeof productMediaCsrf === "string" ? productMediaCsrf : ""; %>
    <form class="admin-product-form" method="POST" enctype="<%= editingProduct ? 'multipart/form-data' : 'application/x-www-form-urlencoded' %>" action="<%= editingProduct ? '/admin/products/' + editingProduct._id + '/edit' : '/admin/products' %>">
      <input type="hidden" name="_csrf" value="<%= uploadCsrf %>">
      <input type="hidden" name="pattern_configuration" value="1">
      <% if (editingProduct) { %>
        <input type="hidden" name="status" value="<%= productForm.status || 'draft' %>">
        <input type="hidden" name="active" value="<%= productForm.active ? '1' : '0' %>">
      <% } else { %>
        <input type="hidden" name="status" value="draft">
      <% } %>

      <section class="admin-product-section">
        <header><span>1</span><div><h2>Product Basics</h2><p>Tell customers what this pattern is.</p></div></header>
        <div class="admin-product-fields">
          <label><span>Product Name</span><small>The name shown on product listings and product details. Example: Slim Fit Shirt.</small><input name="name" required maxlength="160" value="<%= productForm.name || '' %>"></label>
          <label><span>URL Name</span><small>Used in the product web address. Leave blank to create it from the product name.</small><input name="slug" value="<%= productForm.slug || '' %>" placeholder="slim-fit-shirt"></label>
          <label><span>Category</span><small>Groups similar products so customers can browse them. Example: shirts, pants or shorts.</small><input name="category" maxlength="80" list="product-categories" value="<%= productForm.category || '' %>" placeholder="shirts"><datalist id="product-categories"><option value="shirts"><option value="pants"><option value="shorts"></datalist></label>
          <label class="admin-product-field--wide"><span>Product Description</span><small>A customer-friendly explanation of what the pattern is and what the customer receives. Use only confirmed product details.</small><textarea name="description" rows="4" maxlength="3000"><%= productForm.description || '' %></textarea></label>
          <label><span>Measurement Chart / Basic Specifications</span><small>Confirmed measurements or specifications shown on the product page. Do not add unverified details.</small><textarea name="size_information" rows="3"><%= productForm.size_information || '' %></textarea></label>
          <label><span>File Formats</span><small>List only the actual formats customers receive. Example: PDF. Check the associated files first.</small><textarea name="file_formats" rows="3"><%= productForm.file_formats || '' %></textarea></label>
          <label><span>Delivery / Fulfilment Information</span><small>Explain confirmed digital or physical fulfilment details customers will see before ordering.</small><textarea name="delivery_information" rows="3"><%= productForm.delivery_information || '' %></textarea></label>
          <label><span>Download Information</span><small>Optional instructions shown to customers about accessing their purchased files.</small><textarea name="download_information" rows="3"><%= productForm.download_information || '' %></textarea></label>
        </div>
      </section>

      <section class="admin-product-section">
        <header><span>2</span><div><h2>Images &amp; Preview</h2><p>Show customers what the pattern or finished product represents.</p></div></header>
        <div class="admin-product-fields">

<label class="admin-product-field--wide">
  <span>Upload Main Product Photo</span>
  <% if (editingProduct) { %>
    <small>JPEG, PNG or WebP. Maximum 10 MB.</small>
    <input type="file" name="main_image"
      accept="image/jpeg,image/png,image/webp"
      data-aep-preview="main">
    <img data-aep-target="main"
      alt="Main image preview"
      <%= (productForm.images || [])[0] ? '' : 'hidden' %>
      <% if ((productForm.images || [])[0]) { %>
        src="<%= productForm.images[0] %>"
      <% } %>
      style="max-width:220px;max-height:220px;object-fit:contain">
    <label class="aep-media-removal" <%= (productForm.images || [])[0] ? "" : "hidden" %>><input type="checkbox" name="remove_main_image">
      Remove existing main image</label>
  <% } else { %>
    <input type="hidden" name="main_image_url" value="">
    <small>Create a Draft first, then upload media.</small>
  <% } %>
</label>

<label class="admin-product-field--wide">
  <span>Upload Gallery Photos</span>
  <% if (editingProduct) { %>
    <small>Choose up to 10 images, maximum 10 MB each.</small>
    <div class="aep-pdf-manage-link" style="margin:18px 0;padding:16px;border:1px solid #ddd;border-radius:10px">
  <h3>PDF Pattern Documents</h3>
  <p>Upload pattern layouts, size charts and technical PDF files securely.</p>
  <% if (editingProduct) { %>
    <a href="/admin/products/<%= editingProduct._id %>/digital-files">
      Manage PDF / DXF Files
    </a>
  <% } else { %>
    <p>Save the product first to manage PDF documents.</p>
  <% } %>
</div>
<input type="file" name="gallery_images" multiple
      accept="image/jpeg,image/png,image/webp"
      data-aep-gallery>
    <div data-aep-gallery-preview
      style="display:flex;gap:10px;flex-wrap:wrap"></div>
    <% (productForm.images || []).slice(1).forEach((src,index)=>{ %>
      <div>
        <img src="<%= src %>" alt="Gallery preview"
          style="max-width:120px;max-height:120px">
        <label><input type="checkbox"
          name="remove_gallery_image"
          value="<%= index %>"> Remove</label>
      </div>
    <% }) %>
  <% } else { %>
    <input type="hidden" name="gallery_image_urls" value="">
  <% } %>
</label>

<label>
  <span>Finished Upload Sample Photo</span>
  <% if (editingProduct) { %>
    <input type="file" name="sample_image"
      accept="image/jpeg,image/png,image/webp"
      data-aep-preview="sample">
    <img data-aep-target="sample" alt="Sample preview"
      <%= productForm.sample_image_url ? '' : 'hidden' %>
      <% if (productForm.sample_image_url) { %>
        src="<%= productForm.sample_image_url %>"
      <% } %>
      style="max-width:180px;max-height:180px">
    <label class="aep-media-removal" <%= productForm.sample_image_url ? "" : "hidden" %>><input type="checkbox" name="remove_sample_image">
      Remove sample image</label>
  <% } else { %>
    <input type="hidden" name="sample_image_url" value="">
  <% } %>
</label>

<label>
  <span>Upload Product Video</span>
  <% if (editingProduct) { %>
    <small>MP4 or WebM. Maximum 100 MB.</small>
    <input type="file" name="product_video"
      accept="video/mp4,video/webm"
      data-aep-preview="video">
    <video data-aep-target="video" controls
      preload="metadata"
      <%= productForm.video_url ? '' : 'hidden' %>
      <% if (productForm.video_url) { %>
        src="<%= productForm.video_url %>"
      <% } %>
      style="width:100%;max-width:320px"></video>
    <label class="aep-media-removal" <%= productForm.video_url ? "" : "hidden" %>><input type="checkbox" name="remove_video">
      Remove current video</label>
  <% } else { %>
    <input type="hidden" name="video_url" value="">
  <% } %>
</label>
        </div>
      </section>

      <section class="admin-product-section" id="files-section">
        <header><span>3</span><div><h2>Pattern Files</h2><p>Choose which files customers receive, either with the pattern or as a separate paid option.</p></div></header>
        <% if (editingProduct) { %>
          <p class="admin-product-guidance">Unconfirmed files stay inactive and are not sold until reviewed. Choose only a purpose you can verify from the supplied file.</p>
          <% if (productFiles.length) { %>
            <ul class="admin-product-file-list">
              <% productFiles.forEach(file => { %>
                <% const reviewRequired=file.purpose==='other'&&(editingProduct.import_source_key||file.import_source_key); %>
                <li><div><strong><%= file.file_name %></strong><small>Purpose: <%= reviewRequired ? 'Needs Review' : ({other:'Other file',dxf:'Editable DXF',tech_pack:'Basic Tech Pack',specs:'Measurement / Specifications'}[file.purpose] || 'Other file') %><% if (!file.active) { %> Â· Inactive<% } %></small><% if (reviewRequired) { %><small>This file has been imported successfully, but its purpose has not yet been confirmed. Review the file and select the correct purpose before activating the product.</small><% } %></div><a class="btn small ghost" href="/admin/products/<%= editingProduct._id %>/files/<%= file._id %>/edit"><%= reviewRequired ? 'Set Purpose' : 'Edit File' %></a></li>
              <% }) %>
            </ul>
          <% } else { %><p class="admin-product-empty">No product files have been added yet.</p><% } %>
          <div class="admin-product-actions admin-editor-file-actions">
            <a class="btn ghost" href="/admin/products/<%= editingProduct._id %>/files">Manage Product Files</a>
            <a class="btn ghost" href="/admin/products/<%= editingProduct._id %>/digital-files">Upload / Manage Private Files</a>
          </div>
          <p class="admin-product-help">Product Files describe an option and its price. Private Digital Files stores the actual customer download securely outside the public website.</p>
        <% } else { %>
          <p class="admin-product-guidance">Save the product first, then add file options and upload the private files from its product management page.</p>
        <% } %>
      </section>

      <section class="admin-product-section">
        <header><span>4</span><div><h2>Sizes</h2><p>Choose the sizes available for purchase.</p></div></header>
        <label class="admin-product-field"><span>Available Sizes</span><small>Select the pattern sizes customers can choose. Enter sizes separated by commas. Example: XS, S, M, L, XL, 2XL, 3XL, 4XL, 5XL.</small><input name="available_sizes" maxlength="500" value="<%= (productForm.available_sizes || []).join(', ') %>" placeholder="XS, S, M, L, XL, 2XL, 3XL, 4XL, 5XL"></label>
      </section>

      <section class="admin-product-section">
        <header><span>5</span><div><h2>Pricing &amp; Paid Options</h2><p>Set what customers pay for each available option.</p></div></header>
        <div class="admin-option-list">
          <label class="admin-option-row"><input type="checkbox" name="printable_enabled" <%= productForm.pattern_options?.printable !== false ? 'checked' : '' %>><span><strong>Printable Soft Copy</strong><small>The ready-to-print pattern file for customers who want to print and use it. Requires its private file and confirmed price.</small></span></label>
          <label class="admin-product-field"><span>Printable Soft Copy Price</span><small>Enter the amount the customer must pay for this option. Leave unset until the final price is confirmed. Do not use â‚¹0 as a temporary price.</small><input type="number" name="base_price" min="0" step="0.01" value="<%= productForm.base_price ?? '' %>" placeholder="Final price"></label>
          <label class="admin-product-field"><span>Additional Size Price</span><small>Extra amount charged for each additional selected size, if applicable. Leave blank until confirmed.</small><input type="number" name="additional_size_price" min="0" step="0.01" value="<%= productForm.additional_size_price ?? '' %>" placeholder="Optional"></label>
          <div class="admin-option-row admin-option-row--info"><span><strong>Editable DXF</strong><small>An editable professional pattern file. It is a separate paid option, not the normal printable pattern. Confirm its file purpose and price under Pattern Files.</small></span><a class="btn small ghost" href="<%= editingProduct ? '/admin/products/' + editingProduct._id + '/files' : '#files-section' %>">Manage Product Files</a></div>
          <div class="admin-option-row admin-option-row--info"><span><strong>Basic Tech Pack</strong><small>Additional garment construction or specification information sold as a separate paid option.</small></span><a class="btn small ghost" href="<%= editingProduct ? '/admin/products/' + editingProduct._id + '/files' : '#files-section' %>">Manage Product Files</a></div>
          <div class="admin-option-row admin-option-row--info"><span><strong>Measurement Chart / Basic Specs</strong><small>Confirmed measurement or specification file. Set it up as a separate paid file only if that is what customers will receive.</small></span><a class="btn small ghost" href="<%= editingProduct ? '/admin/products/' + editingProduct._id + '/files' : '#files-section' %>">Manage Product Files</a></div>
        </div>
      </section>

      <section class="admin-product-section">
        <header><span>6</span><div><h2>Physical Delivery</h2><p>Configure pattern options that require manual courier fulfilment.</p></div></header>
        <div class="admin-product-fields">
          <label class="admin-option-row"><input type="checkbox" name="physical_enabled" <%= productForm.pattern_options?.physical !== false ? 'checked' : '' %>><span><strong>Physical Pattern</strong><small>Select this only when customers can receive a physical printed or cut pattern.</small></span></label>
          <label><span>Physical Pattern Price</span><small>Enter the amount the customer must pay for this option, before any applicable shipping. Leave unset until the final price is confirmed. Do not use â‚¹0 as a temporary price.</small><input type="number" name="physical_price" min="0" step="0.01" value="<%= productForm.physical_price ?? '' %>" placeholder="Final price"></label>
          <label><span>Physical Price by Size</span><small>Optional confirmed amount per selected size, one per line. Example: M=500. Leave blank if one physical price applies to all sizes. Do not use â‚¹0 as a temporary price.</small><textarea name="size_prices" rows="3"><%= (productForm.size_prices || []).map(row => row.size + '=' + row.price).join('\n') %></textarea></label>
          <label class="admin-option-row"><input type="checkbox" name="trial_enabled" <%= productForm.pattern_options?.trial !== false ? 'checked' : '' %>><span><strong>Trial Sample</strong><small>Select this only when you can make an optional paid sample for customers to inspect.</small></span></label>
          <label><span>Trial Sample Price</span><small>Enter the amount the customer must pay for this sample. Leave unset until the final price is confirmed. Do not use â‚¹0 as a temporary price.</small><input type="number" name="trial_price" min="0" step="0.01" value="<%= productForm.trial_price ?? '' %>" placeholder="Final price"></label>
          <label><span>Printable Dimensions / Format Notes</span><small>Optional confirmed print dimensions or format notes shown to customers.</small><input name="printable_dimensions" maxlength="500" value="<%= productForm.printable_dimensions || '' %>"></label>
        </div>
      </section>

      <section class="admin-product-section">
        <header><span>7</span><div><h2>Product Status</h2><p>Review the product before making it available to customers.</p></div></header>
        <% if (editingProduct) { %>
          <% const isLive = productForm.active && productForm.status === 'active'; %>
          <p>Current status: <span class="admin-badge <%= isLive ? 'admin-badge--active' : 'admin-badge--draft' %>"><%= isLive ? 'Active' : productForm.status === 'coming_soon' ? 'Coming Soon' : 'Draft' %></span></p>
          <ul class="admin-status-guide">
            <li><strong>Draft:</strong> saved in Admin; customers cannot purchase it.</li>
            <li><strong>Active:</strong> available to customers after you select Activate Product.</li>
            <li><strong>Setup Required:</strong> a reminder listing the information that still needs review.</li>
          </ul>
        <% } else { %>
          <p>Current status: <span class="admin-badge admin-badge--draft">Draft</span></p>
          <ul class="admin-status-guide">
            <li><strong>Draft:</strong> saved in Admin; customers cannot purchase it.</li>
            <li><strong>Active:</strong> available to customers after you review setup and select Activate Product.</li>
            <li><strong>Setup Required:</strong> a reminder listing the information that still needs review.</li>
          </ul>
        <% } %>
      </section>

      <details class="admin-product-section admin-product-seo">
        <summary>8. SEO &amp; External Listing</summary>
        <p>Optional settings for search engines and external marketplaces.</p>
        <div class="admin-product-fields">
          <label><span>SEO Title</span><small>Optional search result title. Leave blank to use the product name.</small><input name="seo_title" maxlength="200" value="<%= productForm.seo_title || '' %>"></label>
          <label><span>SEO Description</span><small>Optional short summary that may appear in search results. Describe only confirmed product details.</small><textarea name="seo_description" maxlength="320" rows="3"><%= productForm.seo_description || '' %></textarea></label>
          <label class="admin-product-field--wide"><span>Amazon Listing URL</span><small>Optional HTTPS link to this productâ€™s own Amazon listing. Leave blank if it has no listing.</small><input type="url" name="amazon_listing_url" value="<%= productForm.amazon_listing_url || '' %>" placeholder="https://www.amazon.in/..."></label>
        </div>
      </details>

      <footer class="admin-product-form-actions">
        <% if (editingProduct) { %>
          <button class="btn primary" type="submit" name="admin_action" value="save">Save Changes</button>
          <% if (productForm.active && productForm.status === 'active') { %>
            <button class="btn ghost" type="submit" name="admin_action" value="deactivate">Deactivate Product</button>
          <% } else { %>
            <button class="btn primary" type="submit" name="admin_action" value="activate" data-activate-product data-setup-missing="<%= encodeURIComponent(JSON.stringify(productSetup.missing)) %>">Activate Product</button>
          <% } %>
        <% } else { %>
          <button class="btn primary" type="submit">Save Product</button>
        <% } %>
        <a class="btn ghost" href="/admin/products">Cancel</a>
      </footer>
    </form>
  </main>
  <%- include('../partials/footer') %>
  <script>
    document.querySelector('[data-activate-product]')?.addEventListener('click', event => {
      const missing = JSON.parse(decodeURIComponent(event.currentTarget.dataset.setupMissing || '%5B%5D'));
      if (missing.length && !window.confirm(`This product still needs setup:\n\nâ€¢ ${missing.join('\nâ€¢ ')}\n\nContinue to activation?`)) {
        event.preventDefault();
      }
    });
  </script>
<script id="aep-simple-editor-js">
(function(){
  const sections = [...document.querySelectorAll(
    '.admin-product-form > section.admin-product-section'
  )];

  sections.forEach((section,index)=>{
    const header = section.querySelector(':scope > header');
    if(!header) return;

    const title = header.querySelector('h2');
    if(!title) return;

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'aep-simple-toggle';

    const defaultOpen = index === 0 || title.textContent.includes('Status');

    function setOpen(open){
      section.classList.toggle('aep-collapsed',!open);
      button.textContent = open ? 'Hide -' : 'Open +';
      button.setAttribute('aria-expanded',String(open));
    }

    button.addEventListener('click',()=>{
      setOpen(section.classList.contains('aep-collapsed'));
    });

    header.appendChild(button);
    setOpen(defaultOpen);
  });

  const status = sections.find(section =>
    section.querySelector('h2')?.textContent.includes('Status')
  );

  if(status){
    const hint=document.createElement('div');
    hint.className='aep-simple-hint';
    hint.textContent='Save Changes = keep the current visibility. Activate Product = make available to customers after review. Deactivate Product = hide from customers.';
    status.appendChild(hint);
  }

  const footer=document.querySelector('.admin-product-form-actions');
  if(footer){
    const hint=document.createElement('p');
    hint.className='aep-simple-hint';
    hint.textContent='Tip: Open only the section you want to edit. Saving a draft does not activate it.';
    footer.parentNode.insertBefore(hint,footer);
  }
})();
</script>

<script>
// AEP_UPLOAD_FINAL
(() => {
  const urls = [];

  function previewUrl(file) {
    const url = URL.createObjectURL(file);
    urls.push(url);
    return url;
  }

  document.querySelectorAll('[data-aep-preview]')
    .forEach(input => {
      input.addEventListener('change', () => {
        const file = input.files[0];
        if (!file) return;

        const target = document.querySelector(
          '[data-aep-target="' +
          input.dataset.aepPreview + '"]'
        );

        if (!target) return;

        target.src = previewUrl(file);
        target.hidden = false;

        if (target.tagName === 'VIDEO') target.load();
      });
    });

  document.querySelector('[data-aep-gallery]')
    ?.addEventListener('change', event => {
      const box = document.querySelector(
        '[data-aep-gallery-preview]'
      );

      if (!box) return;
      box.replaceChildren();

      for (const file of event.target.files) {
        const img = document.createElement('img');
        img.src = previewUrl(file);
        img.alt = file.name;
        img.style.maxWidth = '120px';
        img.style.maxHeight = '120px';
        box.appendChild(img);
      }
    });

  window.addEventListener('pagehide', () => {
    urls.forEach(url => URL.revokeObjectURL(url));
  });
})();
</script>

<script id="aep-main-pdf-preview-support">
(function () {
  const picker = document.querySelector('input[name="main_image"]');
  if (!picker) return;

  picker.accept = ".jpg,.jpeg,.png,.webp,.pdf,image/jpeg,image/png,image/webp,application/pdf";

  const hint = document.createElement("p");
  hint.style.cssText = "font-size:13px;color:#6b564a;margin:8px 0";
  hint.textContent = "JPEG, PNG, WebP or PDF. PDF first page becomes the product picture automatically.";
  picker.insertAdjacentElement("afterend", hint);

  let busy = false;
  const form = picker.closest("form");

  function loadPdfJs() {
    if (window.pdfjsLib) return Promise.resolve(window.pdfjsLib);
    return new Promise((resolve, reject) => {
      const script = document.createElement("script");
      script.src = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js";
      script.onload = () => {
        if (!window.pdfjsLib) return reject(new Error("PDF renderer unavailable"));
        window.pdfjsLib.GlobalWorkerOptions.workerSrc =
          "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
        resolve(window.pdfjsLib);
      };
      script.onerror = () => reject(new Error("PDF renderer could not load. Check internet connection."));
      document.head.appendChild(script);
    });
  }

  picker.addEventListener("change", async function () {
    const file = picker.files && picker.files[0];
    if (!file || !(file.type === "application/pdf" || /\.pdf$/i.test(file.name))) return;

    if (busy) return;
    busy = true;
    hint.textContent = "Converting PDF first page into product picture...";
    picker.disabled = true;

    try {
      if (file.size > 20 * 1024 * 1024) {
        throw new Error("PDF must be 20 MB or smaller.");
      }

      const lib = await loadPdfJs();
      const pdf = await lib.getDocument({data: await file.arrayBuffer()}).promise;
      const page = await pdf.getPage(1);
      const base = page.getViewport({scale:1});
      const scale = Math.min(2, 1800 / Math.max(base.width, base.height));
      const viewport = page.getViewport({scale});
      const canvas = document.createElement("canvas");
      canvas.width = Math.ceil(viewport.width);
      canvas.height = Math.ceil(viewport.height);

      const context = canvas.getContext("2d", {alpha:false});
      await page.render({canvasContext:context,viewport}).promise;

      const blob = await new Promise(resolve => canvas.toBlob(resolve,"image/png"));
      if (!blob || blob.size > 10 * 1024 * 1024) {
        throw new Error("Converted picture exceeds 10 MB.");
      }

      const png = new File(
        [blob],
        file.name.replace(/\.pdf$/i,"") + "-preview.png",
        {type:"image/png"}
      );

      const transfer = new DataTransfer();
      transfer.items.add(png);
      picker.files = transfer.files;

      hint.textContent = "Ready: PDF first page converted to PNG. Click Save Changes to upload.";
    } catch (error) {
      picker.value = "";
      hint.textContent = "PDF conversion failed: " + error.message;
      alert(hint.textContent);
    } finally {
      picker.disabled = false;
      busy = false;
    }
  });

  if (form) {
    form.addEventListener("submit", function (event) {
      if (busy) {
        event.preventDefault();
        alert("Wait until PDF conversion finishes.");
      }
    }, true);
  }
})();
</script>
</body>
</html>
