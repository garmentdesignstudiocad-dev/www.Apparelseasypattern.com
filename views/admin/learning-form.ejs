<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/business.css"></head><body><%- include('../partials/admin_header') %><main class="studio-admin"><% const course=kind==='courses'; let localDate=''; if(item.starts_at && Number.isFinite(new Date(item.starts_at).valueOf())) localDate=new Date(new Date(item.starts_at).getTime()+330*60000).toISOString(); %><h1><%= item._id?'Edit':'Add' %> <%= course?'Course':'Webinar' %></h1><p>Plain text only. Prices are in INR. Webinar dates and times use India Standard Time (UTC+05:30).</p><% if(error){ %><p class="studio-errors" role="alert"><%= error %></p><% } %><form class="studio-form" method="post" action="/admin/<%= kind %>/<%= item._id?item._id+'/edit':'new' %>"><input type="hidden" name="_csrf" value="<%= learningCsrf %>">
<% const fields=course?[['name','Name','text',true],['slug','Slug','text',true],['image_url','Image URL','url',false],['access_url','Private Course Access URL (after confirmation)','url',false],['trainer','Trainer','text',false],['duration','Duration','text',false],['price','Price override (INR; blank = default, 0 = free)','number',false]]:[['title','Title','text',true],['slug','Slug','text',true],['banner_image','Banner Image URL','url',false],['speaker','Speaker','text',false],['date','Date (IST)','date',true],['start_time','Start Time (IST)','time',true],['duration_minutes','Duration (minutes)','number',true],['price','Price override (INR; blank = default, 0 = free)','number',false],['max_seats','Maximum Seats (0 = unlimited)','number',true],['meeting_link','Private Meeting Link','url',false]];fields.forEach(([key,label,type,required])=>{let value=item[key]??(key==='max_seats'?0:'');if(key==='date' && localDate)value=localDate.slice(0,10);if(key==='start_time' && localDate)value=localDate.slice(11,16); %><label><%= label %><input type="<%= type %>" name="<%= key %>" value="<%= value %>" maxlength="<%= type==='url'?2048:200 %>" <%= type==='number'?'min=0':'' %> step="<%= key==='price'?'0.01':'1' %>" <%= required?'required':'' %>></label><% }) %>
<label>Mode<select name="mode"><% (course?['Online','Offline','Online / Offline']:['Online','Offline','Hybrid']).forEach(mode=>{ %><option <%= item.mode===mode?'selected':'' %>><%= mode %></option><% }) %></select></label><% if(!course){ %><label>Meeting Platform<select name="meeting_platform"><% ['Zoom','Google Meet','Microsoft Teams','Other'].forEach(platform=>{ %><option <%= item.meeting_platform===platform?'selected':'' %>><%= platform %></option><% }) %></select></label><% } %>
<% const areas=course?[['short_description','Short Description',1000],['description','Full Description',30000],['modules','Modules (one module per line)',30000],['schedule_information','Schedule Information',5000]]:[['description','Description',30000]];areas.forEach(([key,label,max])=>{ %><label class="studio-wide"><%= label %><textarea name="<%= key %>" rows="5" maxlength="<%= max %>"><%= Array.isArray(item[key])?item[key].join('\n'):item[key] || '' %></textarea></label><% }) %><label><span><input type="checkbox" style="width:auto" name="active" <%= item.active?'checked':'' %>> Active (visible publicly)</span></label><% if(!course){ %><label><span><input type="checkbox" style="width:auto" name="registration_open" <%= item.registration_open?'checked':'' %>> Registration Open</span></label><p class="studio-wide">Reserved seats: <%= item.seat_ids?.length || 0 %>. Unpaid registrations reserve seats until cancelled by the owner. Prices apply to new registrations; existing registrations keep their original fee.</p><% } %><div class="studio-wide studio-actions"><button class="fashion-button" type="submit">Save</button><a href="/admin/<%= kind %>">Back</a></div></form></main></body></html>
