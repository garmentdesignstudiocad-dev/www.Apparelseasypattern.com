
<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Website Appearance | Admin</title>

  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/admin-appearance.css">

  <style>
    .cms-layout {
      max-width: 1200px;
      margin: 0 auto;
    }

    .cms-heading {
      margin-bottom: 25px;
    }

    .cms-heading h1 {
      margin-bottom: 8px;
    }

    .cms-heading p {
      color: #666;
      line-height: 1.6;
    }

    .cms-section {
      margin: 0 0 16px;
      border: 1px solid #dedede;
      border-radius: 14px;
      background: #fff;
      overflow: hidden;
    }

    .cms-section > summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 20px;
      cursor: pointer;
      list-style: none;
      background: #faf9f7;
    }

    .cms-section > summary::-webkit-details-marker {
      display: none;
    }

    .cms-section > summary::after {
      content: "+";
      font-size: 25px;
      line-height: 1;
      font-weight: 400;
      color: #62392d;
    }

    .cms-section[open] > summary::after {
      content: "\2212";
    }

    .cms-section[open] > summary {
      border-bottom: 1px solid #eee;
      background: #f6f0ea;
    }

    .cms-section-title {
      display: block;
      font-weight: 700;
      font-size: 17px;
      color: #26211e;
    }

    .cms-section-description {
      display: block;
      font-size: 13px;
      margin-top: 5px;
      color: #777;
      line-height: 1.5;
      font-weight: 400;
    }

    .cms-section-body {
      padding: 22px;
    }

    .cms-subtitle {
      font-size: 15px;
      font-weight: 700;
      margin: 20px 0 12px;
      color: #62392d;
    }

    .cms-subtitle:first-child {
      margin-top: 0;
    }

    .cms-fields {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .cms-field {
      display: flex;
      flex-direction: column;
      gap: 7px;
      min-width: 0;
    }

    .cms-field label {
      font-size: 13px;
      font-weight: 700;
      color: #292929;
    }

    .cms-field input,
    .cms-field textarea,
    .cms-field select {
      box-sizing: border-box;
      width: 100%;
      min-height: 43px;
      border: 1px solid #d8d8d8;
      border-radius: 8px;
      padding: 10px 12px;
      font: inherit;
      font-size: 14px;
      color: #222;
      background: #fff;
    }

    .cms-field textarea {
      min-height: 105px;
      resize: vertical;
      line-height: 1.6;
    }

    .cms-field input:focus,
    .cms-field textarea:focus,
    .cms-field select:focus {
      outline: 2px solid #c58b62;
      outline-offset: 1px;
      border-color: #62392d;
    }

    .cms-field small {
      color: #777;
      font-size: 12px;
      line-height: 1.5;
    }

    .cms-color-control {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .cms-color-control input[type="color"] {
      width: 52px;
      min-width: 52px;
      padding: 3px;
      cursor: pointer;
    }

    .cms-color-control input[type="text"] {
      flex: 1;
      min-width: 0;
    }

    .cms-preview {
      margin-top: 24px;
    }

    .cms-actions {
      position: sticky;
      bottom: 0;
      z-index: 20;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      padding: 15px 20px;
      background: #fff;
      border: 1px solid #ddd;
      border-radius: 12px;
      box-shadow: 0 -5px 25px rgba(0,0,0,.07);
      margin: 20px 0;
    }

    .cms-save {
      padding: 13px 25px;
      border: 0;
      border-radius: 9px;
      background: #62392d;
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
    }

    .cms-open {
      padding: 11px 17px;
      border: 1px solid #ddd;
      border-radius: 9px;
      text-decoration: none;
      color: #292929;
      font-size: 14px;
    }

    .cms-notice {
      padding: 12px 15px;
      margin: 15px 0;
      border: 1px solid #ddd;
      border-radius: 9px;
      background: #fafafa;
    }

    .cms-error {
      border-color: #c96b6b;
    }

    .cms-reset {
      margin-top: 26px;
      padding: 20px;
      border: 1px solid #ddd;
      border-radius: 12px;
      background: #fafafa;
    }

    .cms-reset label {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 14px 0;
    }

    @media (max-width: 700px) {
      .cms-fields {
        grid-template-columns: 1fr;
      }

      .cms-section-body {
        padding: 15px;
      }

      .cms-section > summary {
        padding: 16px;
      }

      .cms-actions {
        position: static;
      }
    }

    .cms-quick-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 24px;
      padding: 14px;
      background: #faf8f5;
      border: 1px solid #e7ded7;
      border-radius: 12px;
    }

    .cms-quick-pill {
      display: inline-block;
      padding: 7px 14px;
      border-radius: 20px;
      background: #fff;
      border: 1px solid #d4c8bf;
      color: #62392d;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.15s ease;
      cursor: pointer;
    }

    .cms-quick-pill:hover,
    .cms-quick-pill:focus {
      background: #62392d;
      color: #fff;
      border-color: #62392d;
    }

    .cms-summary-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-right: 12px;
    }

    .cms-open {
      padding: 6px 12px;
      border: 1px solid #d4c8bf;
      border-radius: 6px;
      text-decoration: none;
      color: #62392d;
      font-size: 12px;
      font-weight: 600;
      background: #fff;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .cms-open:hover {
      background: #62392d;
      color: #fff;
      border-color: #62392d;
    }

    .cms-floating-bar {
      position: sticky;
      bottom: 20px;
      z-index: 100;
      margin-top: 30px;
      padding: 14px 20px;
      background: #201b1a;
      color: #fff;
      border-radius: 14px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.25);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .cms-floating-bar span {
      font-size: 14px;
      font-weight: 500;
    }

    .cms-floating-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .cms-save-btn {
      padding: 10px 20px;
      background: #c58b62;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      transition: background 0.15s ease;
    }

    .cms-save-btn:hover {
      background: #b0754d;
    }

  </style>
</head>

<body>

  <%- include('../partials/admin_header') %>

  <main class="container section cms-layout">

    <div class="cms-heading">
      <h1>Website Content & Appearance</h1>

      <p>
        Manage your website page by page.
        Open a section, edit its content, and save your changes.
      </p>
    </div>

    <% if (message) { %>
      <div class="cms-notice" role="status">
        <%= message %>
      </div>
    <% } %>

    <% if (errors.length) { %>
      <div class="cms-notice cms-error" role="alert">
        <strong>Please correct these settings:</strong>
        <ul>
          <% errors.forEach(error => { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <!-- QUICK PAGE JUMP NAVIGATION -->
    <nav class="cms-quick-nav" aria-label="Quick page navigation">
      <strong style="align-self:center;margin-right:6px;font-size:13px;color:#201b1a;">Quick Edit:</strong>
      <a href="#sec-0" class="cms-quick-pill" onclick="expandSec(0)">Home</a>
      <a href="#sec-1" class="cms-quick-pill" onclick="expandSec(1)">About Us</a>
      <a href="#sec-2" class="cms-quick-pill" onclick="expandSec(2)">Products</a>
      <a href="#sec-3" class="cms-quick-pill" onclick="expandSec(3)">Services</a>
      <a href="#sec-4" class="cms-quick-pill" onclick="expandSec(4)">Classes</a>
      <a href="#sec-5" class="cms-quick-pill" onclick="expandSec(5)">Consulting</a>
      <a href="#sec-6" class="cms-quick-pill" onclick="expandSec(6)">Contact</a>
      <a href="#sec-7" class="cms-quick-pill" onclick="expandSec(7)">Header &amp; Footer</a>
      <a href="#sec-8" class="cms-quick-pill" onclick="expandSec(8)">SEO &amp; Social</a>
      <a href="#sec-9" class="cms-quick-pill" onclick="expandSec(9)">Colors &amp; Theme</a>
    </nav>


    <%
      const humanLabel = key =>
        key.replaceAll('_', ' ')
          .replace(/\b\w/g, c => c.toUpperCase())
          .replace(/\bUrl\b/g, 'URL')
          .replace(/\bSeo\b/g, 'SEO');

            const descriptions = {
        header_home_enabled: 'Show or hide the Home navigation link in the header.',
        header_home_label: 'Display text for the Home navigation link.',
        store_name: 'Store name shown on the website.',
        logo_url: 'Full HTTPS URL to your business logo.',
        favicon_url: 'Browser tab icon URL.',
        main_website_url: 'Main consultancy / Wix website link.',
        contact_email: 'Public contact email for customer and lead enquiries.',
        contact_phone: 'Public phone number with international country code.',
        whatsapp_number: 'WhatsApp number with country code (e.g. +91 9791753067).',
        support_cta: 'Short support response message shown in the footer and contact pages.',
        address: 'Business address shown on contact pages and receipts.',

        homepage_heading: 'Main heading displayed on the homepage.',
        homepage_subheading: 'Text directly below the homepage heading.',
        home_eyebrow: 'Small label above the main title.',
                home_image_path: 'Homepage hero fallback image (JPG, PNG, WebP up to 10 MB).',
        home_video_path: 'Homepage hero background video (MP4, WebM up to 50 MB).',
        home_showcase_image_path: 'Basic Shirt Block 3D showcase image or safe PDF reference.',
        home_men_image_path: 'Men category department finished garment photo.',
        home_women_image_path: 'Women category department finished garment photo.',
        home_kids_image_path: 'Kids category department finished garment photo.',
        home_image_alt: 'Accessible description of the hero image.',
        home_primary_button: 'Text of the primary homepage button.',
        home_secondary_button: 'Text of the secondary homepage button.',

        about_eyebrow: 'Small label above the About Us title.',
        about_heading: 'Main heading on the About Us page.',
        about_intro: 'Introductory story paragraph on the About Us page.',
        about_cta_text: 'Text on the explore button on About Us.',
        about_cta_link: 'Destination link for the About Us explore button (e.g. /products).',
        about_tile_1_title: 'First feature column heading (e.g. Digital patterns).',
        about_tile_1_text: 'First feature column explanation.',
        about_tile_2_title: 'Second feature column heading (e.g. Physical patterns).',
        about_tile_2_text: 'Second feature column explanation.',
        about_tile_3_title: 'Third feature column heading (e.g. Trial samples).',
        about_tile_3_text: 'Third feature column explanation.',

        products_heading: 'Main heading on the Products page.',
        products_description: 'Introductory paragraph on the Products page.',
        view_products_label: 'Catalog button text.',

        services_heading: 'Main heading on the Services page.',
        services_description: 'Introductory explanation of studio services.',
        services_cta_text: 'Service enquiry button label.',
        services_cta_link: 'Service button destination link.',

        classes_eyebrow: 'Small label above the Online Classes heading.',
        classes_heading: 'Main heading on the Online Classes page.',
        classes_description: 'Course overview and learning topics explanation.',
        classes_cta_text: 'Button text to submit class enquiry.',
        classes_cta_link: 'Button destination for online classes.',

        consulting_heading: 'Heading for the Consulting booking page.',
        consulting_subheading: 'Subheading question for consulting clients.',
        consulting_description: 'Explanation of what is covered in technical consulting.',
        consulting_cta_text: 'Submit button text on the consulting page.',

        contact_heading: 'Heading for the Contact page.',
        contact_description: 'Introduction text displayed above contact details.',

        cart_heading: 'Shopping cart page heading.',
        checkout_heading: 'Checkout page heading.',
        footer_text: 'Business description in the footer.',
        footer_tagline: 'Tagline shown below the logo in the footer.',
        footer_security_label: 'Security assurance notice in the footer.',
        footer_credit_label: 'Footer created-by label.',
        footer_credit_name: 'Footer creator organization name.',
        back_website_label: 'Link label pointing back to main website.',

        og_image_url: 'Image URL for WhatsApp, LinkedIn, and Facebook social share previews.',
        twitter_handle: 'Twitter / X username for social card attribution.',

        main_font: 'Font used for normal text.',
        heading_font: 'Font used for headings.',
        base_font_size: 'Base text size: 14 to 20 pixels.'
      };

      const groupedSections = [
        {
          title: '01 - Homepage Content',
          description: 'Hero section, images, buttons, trust labels and homepage content.',
          groups: [
            {
              name: 'Homepage Media Management (Direct File Uploads)',
              fields: [
                'home_image_path',
                'home_video_path',
                'home_showcase_image_path',
                'home_men_image_path',
                'home_women_image_path',
                'home_kids_image_path'
              ]
            },
            {
              name: 'Hero Section',
              fields: [
                'home_eyebrow',
                'homepage_heading',
                'homepage_subheading',
                'home_image_path',
                'home_image_alt',
                'home_floating_label',
                'home_floating_text'
              ]
            },
            {
              name: 'Homepage Buttons & Trust Labels',
              fields: [
                'home_primary_button',
                'home_secondary_button',
                'home_trust_1',
                'home_trust_2',
                'home_trust_3'
              ]
            },
            {
              name: 'Available Patterns Section',
              fields: [
                'home_available_eyebrow',
                'home_available_heading',
                'home_available_description',
                'home_available_button'
              ]
            },
            {
              name: 'Fit Block Section',
              fields: [
                'home_focus_eyebrow',
                'home_focus_heading',
                'home_focus_description',
                'home_focus_secondary_description'
              ]
            },
            {
              name: 'Four Homepage Cards',
              fields: [
                'home_card_1_title',
                'home_card_1_description',
                'home_card_2_title',
                'home_card_2_description',
                'home_card_3_title',
                'home_card_3_description',
                'home_card_4_title',
                'home_card_4_description'
              ]
            },
            {
              name: 'Industry Expertise Section',
              fields: [
                'home_expertise_eyebrow',
                'home_expertise_heading',
                'home_expertise_description'
              ]
            },
            {
              name: 'Books & Classes on Home',
              fields: [
                'home_books_status',
                'home_books_heading',
                'home_books_description',
                'home_classes_status',
                'home_classes_heading',
                'home_classes_description'
              ]
            }
          ]
        },
        {
          title: '02 - About Us Page',
          description: 'Story hero narrative, call-to-action and three feature columns.',
          groups: [
            {
              name: 'About Story & CTA',
              fields: [
                'about_eyebrow',
                'about_heading',
                'about_intro',
                'about_cta_text',
                'about_cta_link'
              ]
            },
            {
              name: 'Three Feature Columns',
              fields: [
                'about_tile_1_title',
                'about_tile_1_text',
                'about_tile_2_title',
                'about_tile_2_text',
                'about_tile_3_title',
                'about_tile_3_text'
              ]
            }
          ]
        },
        {
          title: '03 - Products & Fit Blocks',
          description: 'Headings, collection description, and cart & checkout page titles.',
          groups: [
            {
              name: 'Products Catalog Text',
              fields: [
                'products_heading',
                'products_description',
                'view_products_label'
              ]
            },
            {
              name: 'Cart & Checkout Titles',
              fields: [
                'cart_heading',
                'checkout_heading'
              ]
            }
          ]
        },
        {
          title: '04 - Services & Garment Technology',
          description: 'Technical services heading, overview and call-to-action button.',
          groups: [
            {
              name: 'Services Overview',
              fields: [
                'services_heading',
                'services_description',
                'services_cta_text',
                'services_cta_link'
              ]
            }
          ]
        },
        {
          title: '05 - Online Classes & Training',
          description: 'Course enquiry headings, curriculum overview and enquiry CTA.',
          groups: [
            {
              name: 'Class Enquiries & Content',
              fields: [
                'classes_eyebrow',
                'classes_heading',
                'classes_description',
                'classes_cta_text',
                'classes_cta_link'
              ]
            }
          ]
        },
        {
          title: '06 - Technical Consulting',
          description: 'Consultation booking headings, description and booking CTA.',
          groups: [
            {
              name: 'Consulting Narrative & CTA',
              fields: [
                'consulting_heading',
                'consulting_subheading',
                'consulting_description',
                'consulting_cta_text'
              ]
            }
          ]
        },
        {
          title: '07 - Contact & Studio Details',
          description: 'Public contact email, WhatsApp, phone number, address and prompt.',
          groups: [
            {
              name: 'Contact Page & Business Details',
              fields: [
                'contact_heading',
                'contact_description',
                'contact_email',
                'contact_phone',
                'whatsapp_number',
                'support_cta',
                'address'
              ]
            }
          ]
        },
        {
          title: '08 - Header, Footer & Branding',
          description: 'Logo, store identity, navigation labels, footer text and security notice.',
          groups: [
            {
              name: 'Brand Identity',
              fields: [
                'store_name',
                'logo_url',
                'favicon_url',
                'main_website_url'
              ]
            },
            {
              name: 'Header Navigation Labels',
              fields: Object.keys(appearance.headerFooter).filter(key => key.startsWith('header_'))
            },
            {
              name: 'Footer Navigation Labels',
              fields: Object.keys(appearance.headerFooter).filter(key => key.startsWith('footer_'))
            },
            {
              name: 'Footer Content & Credit',
              fields: [
                'footer_text',
                'back_website_label'
              ]
            }
          ]
        },
        {
          title: '09 - SEO & Social Sharing',
          description: 'Social preview image, Twitter handle and page-by-page SEO meta tags.',
          groups: [
            {
              name: 'Social Sharing Cards',
              fields: [
                'og_image_url',
                'twitter_handle'
              ]
            },
            {
              name: 'Search Engine Page SEO',
              fields: Object.keys(appearance.content).filter(key => key.includes('_seo_'))
            }
          ]
        },
        {
          title: '10 - Website Colors & Design',
          description: 'Brand color palette, typography fonts, button shapes and layout density.',
          groups: [
            {
              name: 'Brand Colors',
              fields: Object.keys(appearance.colors)
            },
            {
              name: 'Typography',
              fields: [
                'main_font',
                'heading_font',
                'base_font_size',
                'heading_style'
              ]
            },
            {
              name: 'Buttons, Cards & Layout',
              fields: [
                'button_style',
                'card_style',
                'layout_density'
              ]
            }
          ]
        }
      ];

      const usedFields = new Set(
        groupedSections.flatMap(section =>
          section.groups.flatMap(group => group.fields)
        )
      );

      const allEditableFields = Object.keys({
        ...appearance.defaults,
        ...appearance.content
      });

      const extraFields = allEditableFields.filter(
        key => !usedFields.has(key)
      );

      if (extraFields.length) {
        groupedSections.push({
          title: '07 - Additional Settings',
          description: 'Other supported website settings.',
          groups: [
            {
              name: 'Additional Fields',
              fields: extraFields
            }
          ]
        });
      }

      const longFields = new Set([
        'homepage_subheading',
        'home_available_description',
        'home_focus_description',
        'home_focus_secondary_description',
        'home_expertise_description',
        'home_books_description',
        'home_classes_description',
        'products_description', 'address', 'about_intro', 'about_tile_1_text', 'about_tile_2_text', 'about_tile_3_text', 'services_description', 'classes_description', 'consulting_description', 'contact_description'
      ]);

      for (let i = 1; i <= 4; i++) {
        longFields.add(`home_card_${i}_description`);
      }
    %>

    <form
      method="post"
      action="/admin/settings/appearance"
      id="appearance-form"
      enctype="multipart/form-data"
    >

      <input type="hidden" name="_csrf" value="<%= csrf %>">

      <% groupedSections.forEach((section, index) => { %>

        <details
          class="cms-section"
          <%= index === 0 ? 'open' : '' %>
        >

          <summary id="sec-<%= index %>">
            <span style="flex:1">
              <span class="cms-section-title"><%= section.title %></span>
              <span class="cms-section-description"><%= section.description %></span>
            </span>
            <% if (section.viewUrl) { %>
              <div class="cms-summary-actions" onclick="event.stopPropagation()">
                <a class="cms-open" href="<%= section.viewUrl %>" target="_blank" rel="noopener">View Page ↗</a>
              </div>
            <% } %>
          </summary>

          <div class="cms-section-body">

            <% section.groups.forEach(group => { %>

              <h3 class="cms-subtitle">
                <%= group.name %>
              </h3>

              <div class="cms-fields">

                <% group.fields.forEach(key => { %>

                  <% if (key in settings) { %>

                    <div class="cms-field">

                      <label for="<%= key %>">
                        <%= humanLabel(key) %>
                      </label>

                      <% if (key in appearance.colors) { %>

                        <div class="cms-color-control">

                          <input
                            type="color"
                            data-color-for="<%= key %>"
                            aria-label="<%= humanLabel(key) %> picker"
                            value="<%= appearance.valid(key, settings[key]) ? settings[key] : appearance.colors[key] %>"
                          >

                          <input
                            type="text"
                            id="<%= key %>"
                            name="<%= key %>"
                            value="<%= settings[key] %>"
                            pattern="#[0-9a-fA-F]{6}"
                            maxlength="7"
                            required
                            spellcheck="false"
                          >

                        </div>

                      <% } else if (key in appearance.options) { %>

                        <select
                          id="<%= key %>"
                          name="<%= key %>"
                        >

                          <% appearance.options[key].forEach(option => { %>

                            <option
                              value="<%= option %>"
                              <%= settings[key] === option ? 'selected' : '' %>
                            >
                              <%= option.replaceAll('-', ' ') %>
                            </option>

                          <% }) %>

                        </select>

                      <% } else if (longFields.has(key)) { %>

                        <textarea
                          id="<%= key %>"
                          name="<%= key %>"
                          rows="4"
                          maxlength="<%= key.startsWith('home_') || key.startsWith('homepage_') ? 3000 : 600 %>"
                        ><%= settings[key] || '' %></textarea>

                      <% } else { %>

                        <input
                          id="<%= key %>"
                          name="<%= key %>"
                          type="<%= key === 'base_font_size'
                            ? 'number'
                            : key.endsWith('_url')
                              ? 'url'
                              : key === 'contact_email'
                                ? 'email'
                                : 'text' %>"
                          value="<%= settings[key] == null ? '' : settings[key] %>"
                          maxlength="<%= key === 'home_image_path' || key.endsWith('_url')
                            ? 2048
                            : key.startsWith('home_') || key.startsWith('homepage_')
                              ? 3000
                              : 600 %>"
                          <%= key === 'base_font_size'
                            ? 'min="14" max="20" step="1" required'
                            : '' %>
                          <%= (['store_name', 'back_website_label', 'view_products_label'].includes(key) || Object.prototype.hasOwnProperty.call(appearance.headerFooter, key))
                            ? 'required'
                            : '' %>
                        >

                      <% } %>

                      <small>
                        <%= descriptions[key] ||
                          'Update this setting and save to apply the change.' %>
                      </small>
                      <% if (['home_image_path', 'home_video_path', 'home_showcase_image_path', 'home_men_image_path', 'home_women_image_path', 'home_kids_image_path'].includes(key)) { %>
                        <div class="cms-direct-media-card" style="margin-top:10px;padding:14px;background:#F8FAFC;border:1px solid #CBD5E1;border-radius:10px;">
                          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
                            <span style="font-size:11.5px;font-weight:700;color:#0B192C;text-transform:uppercase;letter-spacing:0.06em;">
                              Direct File Upload:
                            </span>
                            <span id="badge_<%= key %>" style="font-size:10.5px;padding:3px 8px;border-radius:999px;background:#E2E8F0;color:#475569;font-weight:600;">
                              <%= key.includes('video') ? 'MP4 / WebM < 50MB' : 'JPG / PNG / WebP < 10MB' %>
                            </span>
                          </div>

                          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;">
                            <input
                              type="file"
                              name="upload_<%= key %>"
                              id="file_<%= key %>"
                              accept="<%= key.includes('video') ? 'video/mp4,video/webm' : (key === 'home_showcase_image_path' ? 'image/jpeg,image/png,image/webp,image/svg+xml,application/pdf' : 'image/jpeg,image/png,image/webp,image/svg+xml') %>"
                              style="display:none;"
                            >
                            <button
                              type="button"
                              class="fashion-button"
                              style="padding:7px 14px;font-size:12px;background:#0B192C;color:#FFFFFF;border:1px solid #0B192C;border-radius:6px;cursor:pointer;"
                              onclick="document.getElementById('file_<%= key %>').click()"
                            >
                              Choose File from Computer
                            </button>
                            <button
                              type="button"
                              style="padding:7px 12px;font-size:12px;background:#FFFFFF;color:#DC2626;border:1px solid #CBD5E1;border-radius:6px;cursor:pointer;"
                              onclick="clearMediaField('<%= key %>', 'preview_<%= key %>', '<%= key === 'home_image_path' || key === 'home_showcase_image_path' ? '/images/basic-shirt-pattern.svg' : '' %>')"
                            >
                              Reset
                            </button>
                          </div>

                          <!-- Live Instant Preview Frame -->
                          <div id="preview_box_<%= key %>" style="padding:10px;background:#FFFFFF;border:1px solid #E2E8F0;border-radius:8px;text-align:center;">
                            <% if (key.includes('video')) { %>
                              <video
                                id="preview_<%= key %>"
                                src="<%= settings[key] || '' %>"
                                controls
                                muted
                                playsinline
                                style="max-width:100%;max-height:160px;border-radius:6px;<%= settings[key] ? 'display:block;' : 'display:none;' %>margin:0 auto;"
                              ></video>
                              <span id="preview_placeholder_<%= key %>" style="font-size:12px;color:#94A3B8;<%= settings[key] ? 'display:none;' : 'display:block;' %>padding:16px 0;">
                                No video selected. Choose an MP4 or WebM file.
                              </span>
                            <% } else { %>
                              <img
                                id="preview_<%= key %>"
                                src="<%= settings[key] || (key === 'home_image_path' || key === 'home_showcase_image_path' ? '/images/basic-shirt-pattern.svg' : '') %>"
                                alt="Preview"
                                style="max-width:100%;max-height:140px;object-fit:contain;border-radius:6px;<%= (settings[key] || key === 'home_image_path' || key === 'home_showcase_image_path') ? 'display:block;' : 'display:none;' %>margin:0 auto;"
                                onerror="this.style.display='none'"
                              >
                              <span id="preview_placeholder_<%= key %>" style="font-size:12px;color:#94A3B8;<%= (settings[key] || key === 'home_image_path' || key === 'home_showcase_image_path') ? 'display:none;' : 'display:block;' %>padding:16px 0;">
                                No image selected. Choose a photo from computer.
                              </span>
                            <% } %>
                          </div>

                          <script>
                            (function(){
                              setupDirectMediaUploader('<%= key %>', 'preview_<%= key %>', <%= key.includes('video') %>);
                            })();
                          </script>
                        </div>
                      <% } %>

                    </div>

                  <% } %>

                <% }) %>

              </div>

            <% }) %>

          </div>

        </details>

      <% }) %>

      <!-- LIVE PREVIEW -->
      <details class="cms-section cms-preview">

        <summary>
          <span>
            <span class="cms-section-title">
              Website Preview
            </span>

            <span class="cms-section-description">
              Preview branding, colors and main heading before saving.
            </span>
          </span>
        </summary>

        <div class="cms-section-body">

          <div id="theme-preview">

            <header class="preview-header">

              <strong data-preview="store_name"></strong>

              <span>Patterns &middot; Cart</span>

            </header>

            <div class="preview-main">

              <h2 data-preview="homepage_heading"></h2>

              <p data-preview="homepage_subheading"></p>

              <article class="preview-card">

                <div class="preview-image">
                  Sample Pattern
                </div>

                <h3>
                  Classic garment pattern
                </h3>

                <p>
                  Digital files and physical pattern options.
                </p>

                <strong class="preview-accent">
                  ₹500
                </strong>

                <p>
                  <button
                    type="button"
                    class="preview-button"
                    data-preview="view_products_label"
                  ></button>
                </p>

              </article>

            </div>

            <footer
              class="preview-footer"
              data-preview="footer_text"
            ></footer>

          </div>

        </div>

      </details>

      <!-- SAVE ACTIONS -->
      <div class="cms-actions">

        <button
          type="submit"
          class="cms-save"
        >
          Save Website Changes
        </button>

        <a
          href="/"
          target="_blank"
          rel="noopener"
          class="cms-open"
        >
          View Homepage &nearr;
        </a>

        <a
          href="/products"
          target="_blank"
          rel="noopener"
          class="cms-open"
        >
          View Products &nearr;
        </a>

      </div>


      <!-- STICKY BOTTOM SAVE ACTION BAR -->
      <div class="cms-floating-bar">
        <span>Ready to apply your updates?</span>
        <div class="cms-floating-actions">
          <a class="cms-open" href="/" target="_blank" rel="noopener" style="background:#332927;color:#fff;border-color:#4a3f3c">View Storefront ↗</a>
          <button type="submit" class="cms-save-btn">Save All Changes</button>
        </div>
      </div>

    </form>

    <!-- THEME RESET -->
    <form
      method="post"
      action="/admin/settings/appearance/reset"
      id="appearance-reset"
      class="cms-reset"
    >

      <input type="hidden" name="_csrf" value="<%= csrf %>">

      <h2>Reset Website Theme</h2>

      <p>
        Reset colors, fonts and styles only.
        Your website text, branding and business details will be kept.
      </p>

      <label>
        <input
          type="checkbox"
          name="confirm_reset"
          value="yes"
          required
        >
        I confirm that I want to reset the theme.
      </label>

      <button type="submit" class="btn">
        Reset Theme
      </button>

    </form>

  </main>

  <script src="/js/admin-appearance.js"></script>


  <script>
    function expandSec(index) {
      const details = document.querySelectorAll('.cms-section');
      if (details[index]) {
        details[index].open = true;
        details[index].scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  </script>


<!-- DIRECT COMPUTER MEDIA UPLOADER SCRIPT -->
<script>
function setupDirectMediaUploader(fieldId, previewImgId, isVideo) {
  var fileInput = document.getElementById('file_' + fieldId);
  var pathInput = document.getElementById(fieldId);
  var previewEl = document.getElementById(previewImgId);
  if (!fileInput || !pathInput || !previewEl) return;

  fileInput.addEventListener('change', function(e) {
    var file = e.target.files[0];
    if (!file) return;

    var maxBytes = isVideo ? 50 * 1024 * 1024 : 10 * 1024 * 1024;
    if (file.size > maxBytes) {
      alert('Selected file is too large! Maximum size allowed is ' + (isVideo ? '50 MB' : '10 MB') + '.');
      fileInput.value = '';
      return;
    }

    var reader = new FileReader();
    reader.onload = function(evt) {
      if (isVideo) {
        previewEl.src = evt.target.result;
        previewEl.style.display = 'block';
      } else {
        previewEl.src = evt.target.result;
        previewEl.style.display = 'block';
      }
      pathInput.value = '/uploads/' + file.name;
    };
    reader.readAsDataURL(file);
  });
}

function clearMediaField(fieldId, previewImgId, defaultSrc) {
  var fileInput = document.getElementById('file_' + fieldId);
  var pathInput = document.getElementById(fieldId);
  var previewEl = document.getElementById(previewImgId);
  if (fileInput) fileInput.value = '';
  if (pathInput) pathInput.value = defaultSrc || '';
  if (previewEl) {
    if (defaultSrc) {
      previewEl.src = defaultSrc;
      previewEl.style.display = 'block';
    } else {
      previewEl.style.display = 'none';
    }
  }
}
</script>

</body>
</html>
