            <div class="ref-summary-divider"></div>
            <div class="ref-summary-total-row">
              <span>Total Amount</span>
              <span class="ref-summary-total-amount" id="pdTotal">&#8377;<%= (basePrice + Math.round(basePrice * (gstRate / 100))).toLocaleString('en-IN') %></span>
