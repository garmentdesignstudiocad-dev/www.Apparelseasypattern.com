<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= seoTitle || title || product?.name || 'Basic Slim Fit Shirt | Apparel Easy Patterns' %></title>
  <meta name="description" content="<%= description || product?.description || '' %>">
  <meta property="og:title" content="<%= seoTitle || title || product?.name || 'Apparel Easy Patterns' %>">
  <meta property="og:description" content="<%= description || '' %>">
  <meta property="og:type" content="product">
  <% if(canonicalUrl){ %><link rel="canonical" href="<%= canonicalUrl %>"><meta property="og:url" content="<%= canonicalUrl %>"><% } %>
  <% if(ogImage){ %><meta property="og:image" content="<%= ogImage %>"><meta name="twitter:card" content="summary_large_image"><% } %>
  <% if(productStructuredData){ %><script type="application/ld+json"><%- jsonLd(productStructuredData) %></script><% } %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/customer-experience.css">
  <link rel="stylesheet" href="/css/storefront-theme.css">
  <%- include('partials/theme') %>

  <style>
    /* ==========================================================================
       APPAREL EASY PATTERNS — APPROVED REFERENCE DESIGN SYSTEM (LEFT PANEL)
       Executive Navy: #0B192C | Midnight Slate: #1E3E62 | Warm Gold / Orange: #EA580C & #D97706
       ========================================================================== */
    :root {
      --ref-navy: #0B192C;
      --ref-navy-hover: #132742;
      --ref-slate: #1E3E62;
      --ref-orange: #EA580C;
      --ref-orange-hover: #C2410C;
      --ref-gold: #D97706;
      --ref-bg-light: #F8FAFC;
      --ref-card-bg: #FFFFFF;
      --ref-border: #E2E8F0;
      --ref-border-strong: #CBD5E1;
      --ref-text-dark: #0B192C;
      --ref-text-muted: #64748B;
      --ref-text-sub: #475569;
      --ref-peach-bg: #FFF7ED;
      --ref-peach-border: #FFEDD5;
      --ref-peach-divider: #FED7AA;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--ref-bg-light);
      color: var(--ref-text-dark);
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .pd-container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 24px 20px 80px;
    }

    /* Breadcrumbs */
    .pd-breadcrumbs {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 13px;
      color: var(--ref-text-muted);
      margin-bottom: 24px;
    }
    .pd-breadcrumbs a {
      color: var(--ref-text-sub);
      text-decoration: none;
      font-weight: 500;
      transition: color 0.15s ease;
    }
    .pd-breadcrumbs a:hover {
      color: var(--ref-orange);
    }
    .pd-breadcrumbs .sep {
      color: #94A3B8;
      font-size: 11px;
    }
    .pd-breadcrumbs .current {
      color: var(--ref-text-dark);
      font-weight: 700;
    }

    /* Main Two-Column Grid */
    .pd-main-grid {
      display: grid;
      grid-template-columns: 460px 1fr;
      gap: 40px;
      align-items: start;
    }

    @media (max-width: 1024px) {
      .pd-main-grid {
        grid-template-columns: 1fr;
        gap: 32px;
      }
    }

    /* ==========================================================================
       LEFT COLUMN: Image Card, 5 Thumbnails & What's Included
       ========================================================================== */
    .pd-left-col {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .ref-image-card {
      background: var(--ref-card-bg);
      border: 1px solid var(--ref-border);
      border-radius: 12px;
      padding: 16px;
      box-shadow: 0 4px 16px rgba(11, 25, 44, 0.05);
    }

    .ref-main-img-box {
      position: relative;
      width: 100%;
      height: 480px;
      min-height: 480px;
      max-height: 480px;
      border-radius: 10px;
      background: #F8FAFC;
      border: 1px solid var(--ref-border);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 16px;
    }

    .ref-main-img {
      width: 100%;
      height: 100%;
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      display: block;
      transition: opacity 0.2s ease, transform 0.25s ease;
      cursor: zoom-in;
      image-rendering: -webkit-optimize-contrast;
    }
    .ref-main-img:hover {
      transform: scale(1.02);
    }

    .ref-zoom-btn {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 36px;
      height: 36px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.94);
      border: 1px solid var(--ref-border);
      color: var(--ref-text-dark);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      transition: all 0.15s ease;
      z-index: 2;
    }
    .ref-zoom-btn:hover {
      background: #FFFFFF;
      color: var(--ref-orange);
      transform: scale(1.05);
    }

    /* Five Thumbnails Row */
    .ref-thumb-row {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
      margin-top: 14px;
    }

    .ref-thumb-btn {
      width: 100%;
      aspect-ratio: 1 / 1;
      border-radius: 8px;
      border: 1.5px solid var(--ref-border);
      padding: 2px;
      background: #FFFFFF;
      cursor: pointer;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s ease;
    }
    .ref-thumb-btn:hover {
      border-color: #FDBA74;
    }
    .ref-thumb-btn.active {
      border: 2px solid var(--ref-orange);
      box-shadow: 0 0 0 1px var(--ref-orange);
    }
    .ref-thumb-btn img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: #F8FAFC;
      border-radius: 5px;
      image-rendering: -webkit-optimize-contrast;
    }

    /* What's Included Card */
    .ref-included-card {
      background: var(--ref-card-bg);
      border: 1px solid var(--ref-border);
      border-radius: 12px;
      padding: 20px 24px;
      box-shadow: 0 4px 16px rgba(11, 25, 44, 0.05);
    }
    .ref-included-title {
      margin: 0 0 14px;
      font-size: 15.5px;
      font-weight: 800;
      color: var(--ref-text-dark);
    }
    .ref-included-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .ref-included-list li {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--ref-text-sub);
    }
    .ref-included-list .check-icon {
      color: var(--ref-orange);
      font-weight: 800;
      font-size: 14px;
      width: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    /* ==========================================================================
       RIGHT COLUMN: Product Details, 4-Step Selection & Order Summary
       ========================================================================== */
    .pd-right-col {
      display: flex;
      flex-direction: column;
    }

    .ref-product-title {
      font-family: 'DM Sans', sans-serif;
      font-size: 32px;
      font-weight: 800;
      color: var(--ref-text-dark);
      margin: 0 0 6px;
      line-height: 1.2;
      letter-spacing: -0.01em;
    }

    .ref-product-sub {
      font-size: 13.5px;
      font-weight: 600;
      color: var(--ref-text-muted);
      margin-bottom: 12px;
    }

    .ref-price-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 14px;
    }
    .ref-price-main {
      font-size: 30px;
      font-weight: 800;
      color: var(--ref-orange);
      letter-spacing: -0.01em;
    }
    .ref-price-compare {
      font-size: 16px;
      color: #94A3B8;
      text-decoration: line-through;
      font-weight: 600;
    }
    .ref-discount-badge {
      font-size: 12px;
      font-weight: 800;
      color: #DC2626;
      background: #FEE2E2;
      padding: 3px 8px;
      border-radius: 4px;
    }

    .ref-short-desc {
      font-size: 14px;
      line-height: 1.6;
      color: var(--ref-text-sub);
      margin: 0 0 24px;
      max-width: 620px;
    }

    /* Purchase Steps */
    .ref-step-section {
      margin-bottom: 22px;
    }

    .ref-step-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
    }

    .ref-step-title {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 15px;
      font-weight: 800;
      color: var(--ref-text-dark);
    }

    .ref-step-num {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--ref-orange);
      color: #FFFFFF;
      font-size: 12.5px;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .ref-size-chart-btn {
      background: none;
      border: none;
      color: var(--ref-text-dark);
      font-size: 13px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      padding: 4px 8px;
      border-radius: 6px;
      transition: all 0.15s ease;
    }
    .ref-size-chart-btn:hover {
      color: var(--ref-orange);
      background: #FFF7ED;
    }

    /* Step 1: Size Selector Pills */
    .ref-size-pills-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .ref-size-pill {
      min-width: 60px;
      height: 40px;
      border-radius: 6px;
      border: 1.5px solid var(--ref-border-strong);
      background: #FFFFFF;
      color: var(--ref-text-dark);
      font-size: 14px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.15s ease;
      user-select: none;
    }
    .ref-size-pill:hover {
      border-color: var(--ref-orange);
    }
    .ref-size-pill.selected {
      background: var(--ref-navy);
      border-color: var(--ref-navy);
      color: #FFFFFF;
      box-shadow: 0 2px 6px rgba(11, 25, 44, 0.2);
    }
    #digitalSizeSelection.is-disabled .ref-size-pill {
      opacity: 0.5;
      cursor: not-allowed;
    }
    #digitalSizeSelection .size-action-link:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      text-decoration: none;
    }

    /* Step 2: Digital Format Selection (Manual format checkboxes) */
    .ref-format-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    @media (max-width: 580px) {
      .ref-main-img-box {
        height: 340px;
        min-height: 340px;
        max-height: 340px;
        padding: 10px;
      }
      .ref-format-grid {
        grid-template-columns: 1fr;
      }
    }

    .ref-format-card {
      background: #FFFFFF;
      border: 1.5px solid var(--ref-border);
      border-radius: 8px;
      padding: 12px 14px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      transition: all 0.15s ease;
      cursor: pointer;
      user-select: none;
    }
    .ref-format-card:hover {
      border-color: #FDBA74;
    }
    .ref-format-card.checked {
      background: #FFFBF7;
      border-color: var(--ref-orange);
      box-shadow: 0 2px 8px rgba(234, 88, 12, 0.08);
    }

    .format-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .format-checkbox-custom {
      width: 18px;
      height: 18px;
      border-radius: 4px;
      border: 2px solid #CBD5E1;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #FFFFFF;
      transition: all 0.15s ease;
      font-size: 12px;
      font-weight: 800;
    }
    .ref-format-card.checked .format-checkbox-custom {
      border-color: var(--ref-orange);
      background: var(--ref-orange);
      color: #FFFFFF;
    }

    .format-title {
      font-size: 13.5px;
      font-weight: 800;
      color: var(--ref-text-dark);
      margin: 2px 0 0;
    }
    .format-sub {
      font-size: 11px;
      color: var(--ref-text-muted);
      line-height: 1.35;
    }

    /* Step 3: Tech Pack & Step 4: Physical Printout Cards */
    .ref-option-card {
      background: #FFFFFF;
      border: 1.5px solid var(--ref-border);
      border-radius: 10px;
      padding: 14px 18px;
      display: flex;
      align-items: center;
      gap: 16px;
      cursor: pointer;
      transition: all 0.15s ease;
      user-select: none;
    }
    .ref-option-card:hover {
      border-color: #FDBA74;
    }
    .ref-option-card.checked {
      background: #FFFBF7;
      border-color: var(--ref-orange);
      box-shadow: 0 2px 10px rgba(234, 88, 12, 0.08);
    }

    .ref-card-cb {
      width: 20px;
      height: 20px;
      border-radius: 4px;
      border: 2px solid #CBD5E1;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #FFFFFF;
      flex-shrink: 0;
      transition: all 0.15s ease;
      font-size: 13px;
      font-weight: 800;
    }
    .ref-option-card.checked .ref-card-cb {
      border-color: var(--ref-orange);
      background: var(--ref-orange);
      color: #FFFFFF;
    }

    .ref-card-icon {
      color: var(--ref-text-dark);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .ref-card-text {
      flex: 1;
    }
    .ref-card-text strong {
      display: block;
      font-size: 14px;
      font-weight: 800;
      color: var(--ref-text-dark);
      margin-bottom: 2px;
    }
    .ref-card-text small {
      font-size: 12px;
      color: var(--ref-text-muted);
    }

    /* Step 5: Fabric Consumption Markers */
    .marker-files-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-bottom: 12px;
    }
    @media (max-width: 580px) {
      .marker-files-grid {
        grid-template-columns: 1fr;
      }
    }
    .marker-file-card {
      background: #FFFFFF;
      border: 1.5px solid var(--ref-border);
      border-radius: 8px;
      padding: 12px 14px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .marker-file-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      background: #EFF6FF;
      color: #1D4ED8;
      border: 1px solid #BFDBFE;
    }
    .marker-notice-box {
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: 6px;
      padding: 10px 14px;
      font-size: 12px;
      color: #64748B;
      line-height: 1.45;
    }

    /* Step 6: Customize Markers */
    .custom-marker-tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 14px;
    }
    .custom-marker-tab-btn {
      padding: 8px 14px;
      border-radius: 6px;
      border: 1.5px solid var(--ref-border);
      background: #FFFFFF;
      color: var(--ref-text-sub);
      font-size: 12.5px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .custom-marker-tab-btn.active {
      border-color: var(--ref-navy);
      background: var(--ref-navy);
      color: #FFFFFF;
    }
    .custom-marker-panel {
      display: none;
      background: #FFFFFF;
      border: 1.5px solid var(--ref-border);
      border-radius: 8px;
      padding: 16px;
    }
    .custom-marker-panel.active {
      display: block;
    }
    .marker-field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 12px;
    }
    @media (max-width: 580px) {
      .marker-field-row {
        grid-template-columns: 1fr;
      }
    }
    .marker-field-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .marker-field-group label {
      font-size: 12px;
      font-weight: 700;
      color: var(--ref-text-dark);
    }
    .marker-field-group input {
      padding: 8px 12px;
      border: 1.5px solid var(--ref-border);
      border-radius: 6px;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--ref-text-dark);
      outline: none;
      transition: border-color 0.15s ease;
    }
    .marker-field-group input:focus {
      border-color: var(--ref-orange);
    }
    .marker-field-group input.input-invalid {
      border-color: #EF4444;
      background: #FEF2F2;
    }
    .marker-field-error {
      font-size: 11px;
      color: #DC2626;
      display: none;
      margin-top: 2px;
    }

    /* Order Summary Card with Separate Tax Breakdown */
    .ref-summary-box {
      background: var(--ref-peach-bg);
      border: 1px solid var(--ref-peach-border);
      border-radius: 10px;
      padding: 18px 20px;
      margin-bottom: 20px;
    }
    .ref-summary-box h4 {
      margin: 0 0 14px;
      font-size: 15px;
      font-weight: 800;
      color: var(--ref-text-dark);
      letter-spacing: -0.01em;
    }
    .ref-summary-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 13.5px;
      color: var(--ref-text-sub);
      margin-bottom: 8px;
    }
    .ref-summary-row strong {
      font-weight: 700;
      color: var(--ref-text-dark);
    }
    .ref-summary-divider {
      border-top: 1px solid var(--ref-peach-divider);
      margin: 12px 0;
    }
    .ref-summary-total-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 15px;
      font-weight: 800;
      color: var(--ref-text-dark);
    }
    .ref-summary-total-amount {
      font-size: 22px;
      font-weight: 800;
      color: var(--ref-orange);
    }

    /* Action Buttons */
    .ref-actions-row {
      display: flex;
      gap: 14px;
      align-items: center;
    }

    .ref-btn-cart {
      flex: 1;
      height: 48px;
      background: #FFFFFF;
      border: 2px solid var(--ref-orange);
      color: var(--ref-orange);
      border-radius: 8px;
      font-size: 14.5px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .ref-btn-cart:hover {
      background: #FFF7ED;
      transform: translateY(-1px);
    }

    .ref-btn-buy {
      flex: 1.25;
      height: 48px;
      background: var(--ref-orange);
      border: none;
      color: #FFFFFF;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.15s ease;
      box-shadow: 0 4px 14px rgba(234, 88, 12, 0.25);
    }
    .ref-btn-buy:hover {
      background: var(--ref-orange-hover);
      transform: translateY(-1px);
    }

    /* Error Message Banner */
    .ref-error-banner {
      display: none;
      background: #FEE2E2;
      border: 1px solid #FECACA;
      color: #DC2626;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 14px;
    }

    /* ==========================================================================
       MODALS: Size Guide, Image Lightbox, Sticky Buy Bar
       ========================================================================== */
    .modal-backdrop-custom {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(11, 25, 44, 0.65);
      backdrop-filter: blur(4px);
      z-index: 99990;
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    .modal-backdrop-custom.is-visible {
      display: block;
      opacity: 1;
    }

    .size-guide-modal {
      display: none;
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -46%);
      width: min(92vw, 680px);
      max-height: 85vh;
      background: #FFFFFF;
      border-radius: 14px;
      box-shadow: 0 24px 60px rgba(11, 25, 44, 0.25);
      z-index: 99995;
      overflow-y: auto;
      padding: 28px 32px;
      opacity: 0;
      transition: all 0.22s ease;
    }
    .size-guide-modal.is-visible {
      display: block;
      opacity: 1;
      transform: translate(-50%, -50%);
    }

    .size-guide-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--ref-border);
      padding-bottom: 14px;
      margin-bottom: 18px;
    }
    .size-guide-header h3 {
      margin: 0;
      font-size: 18px;
      font-weight: 800;
      color: var(--ref-text-dark);
    }
    .size-guide-close {
      background: none;
      border: none;
      font-size: 24px;
      color: #94A3B8;
      cursor: pointer;
      line-height: 1;
    }
    .size-guide-close:hover {
      color: var(--ref-text-dark);
    }

    /* Format badges & multi-size action links */
    .format-price-badge {
      font-size: 11px;
      font-weight: 700;
      color: var(--ref-orange);
      background: var(--ref-peach-bg);
      border: 1px solid var(--ref-peach-border);
      padding: 2px 7px;
      border-radius: 4px;
      line-height: 1.2;
    }
    .size-action-link:hover {
      text-decoration: underline !important;
      opacity: 0.85;
    }

    /* Lightbox Modal */
    .pd-modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(11, 25, 44, 0.9);
      backdrop-filter: blur(6px);
      z-index: 99999;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .pd-modal.is-open {
      display: flex;
    }
    .pd-modal-content {
      position: relative;
      max-width: 90vw;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .pd-modal-img {
      max-width: 100%;
      max-height: 82vh;
      object-fit: contain;
      border-radius: 10px;
      background: #FFFFFF;
    }
    .pd-modal-close {
      position: absolute;
      top: -40px;
      right: 0;
      background: none;
      border: none;
      color: #FFFFFF;
      font-size: 32px;
      cursor: pointer;
    }

    /* Sticky Buy Bar */
    .sticky-buy-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #FFFFFF;
      border-top: 1px solid var(--ref-border);
      box-shadow: 0 -4px 20px rgba(11, 25, 44, 0.08);
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      z-index: 1000;
      transform: translateY(100%);
      transition: transform 0.25s ease;
    }
    .sticky-buy-bar.is-visible {
      transform: translateY(0);
    }
    .sticky-info {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .sticky-thumb {
      width: 44px;
      height: 44px;
      border-radius: 6px;
      object-fit: cover;
      border: 1px solid var(--ref-border);
    }
    .sticky-title {
      font-size: 14px;
      font-weight: 700;
      color: var(--ref-text-dark);
      margin: 0 0 2px;
    }
    .sticky-badges {
      font-size: 12px;
      color: var(--ref-text-muted);
      font-weight: 600;
    }
    .sticky-actions {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .sticky-price {
      font-size: 18px;
      font-weight: 800;
      color: var(--ref-orange);
    }
  </style>
</head>

<body>
  <%- include('partials/header') %>

  <%
    // Approved gallery images for Basic Slim Fit Shirt
    const galleryImages = (product.images || []).filter(Boolean);
    const mainImageSrc = galleryImages[0] || '';

    // Pricing setup
    const basePrice = Number(product.base_price || 399);
    const physicalPrice = Number(product.physical_price ?? 0);
    const configuredSizes = (product.available_sizes && product.available_sizes.length) ? product.available_sizes : ['S', 'M', 'L', 'XL', 'XXL'];
    const initialSelectedSize = configuredSizes.includes('L') ? 'L' : configuredSizes[0];

    // Format pricing
    const fp = product.format_pricing || {};
    const priceDxf = Number(fp.dxf || basePrice);
    const priceHpgl = Number(fp.hpgl || basePrice);
    const pricePlt = Number(fp.plt || basePrice);
    const pricePdf = Number(fp.pdf || basePrice);
    const bundlePrice = Number(fp.bundle_price || basePrice);
    const isBundleActive = fp.active_bundle !== false;

    // Find separate tech pack file if present
    const techPackFile = (files || []).find(f => f.purpose === 'tech_pack' || /tech\s*pack/i.test(f.file_name));
    const techPackPrice = Number(product.tech_pack_price || (techPackFile ? Number(techPackFile.file_price || 0) : 0));

    // Digital pattern formats available
    const hasPdfFile = true; // PDF is an independent format alongside DXF, HPGL and PLT.

    // Mini Marker files if present
    const miniMarkerFiles = (files || []).filter(f => /marker|fabric/i.test(f.file_name) || /marker/i.test(f.file_type));
    const hasPdfMarker = miniMarkerFiles.some(f => (f.file_type || '').toLowerCase().includes('pdf') || (f.file_name || '').toLowerCase().endsWith('.pdf'));
    const hasCadMarker = miniMarkerFiles.some(f => !(f.file_type || '').toLowerCase().includes('pdf') && !(f.file_name || '').toLowerCase().endsWith('.pdf'));

    // GST percentage
    const gstRate = typeof configuredGstRate === 'number' ? configuredGstRate : 0;
  %>

  <main class="pd-container">
    <!-- Breadcrumb Navigation matching reference: Home > Products > Basic Slim Fit Shirt -->
    <nav aria-label="Breadcrumb" class="pd-breadcrumbs">
      <a href="/">Home</a>
      <span class="sep">&gt;</span>
      <a href="/products">Products</a>
      <span class="sep">&gt;</span>
      <span class="current"><%= product.name %></span>
    </nav>

    <!-- Main Two-Column Layout -->
    <section class="pd-main-grid">
      <!-- LEFT COLUMN -->
      <div class="pd-left-col">
        <!-- Main Garment Image Card with Zoom -->
        <div class="ref-image-card">
          <div class="ref-main-img-box">
            <% if(mainImageSrc){ %><img id="mainProductImage" class="ref-main-img" src="<%= mainImageSrc %>" alt="<%= product.name %>"><% }else{ %><div class="pattern-placeholder">Finished garment photo coming soon</div><% } %>
            <button type="button" class="ref-zoom-btn" id="zoomTriggerBtn" aria-label="Zoom image" title="Enlarge image">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 3 21 3 21 9"></polyline>
                <polyline points="9 21 3 21 3 15"></polyline>
                <line x1="21" y1="3" x2="14" y2="10"></line>
                <line x1="3" y1="21" x2="10" y2="14"></line>
              </svg>
            </button>
          </div>

          <!-- 5 Thumbnail Gallery -->
          <div class="ref-thumb-row">
            <% galleryImages.slice(0, 5).forEach((src, idx) => { %>
              <button type="button" class="ref-thumb-btn <%= idx === 0 ? 'active' : '' %>" data-src="<%= src %>" aria-label="View <%= idx + 1 %>">
                <img src="<%= src %>" alt="<%= product.name %> thumbnail <%= idx + 1 %>" loading="lazy">
              </button>
            <% }) %>
          </div>
        </div>

        <!-- What's Included? Card matching Reference Image 2 -->
        <div class="ref-included-card">
          <h3 class="ref-included-title">What's Included?</h3>
          <ul class="ref-included-list">
            <li><span class="check-icon">&#10003;</span> Shirt Pattern (All Sizes)</li>
            <li><span class="check-icon">&#10003;</span> PDF Instructions &amp; Sewing Guide</li>
            <li><span class="check-icon">&#10003;</span> DXF &amp; HPGL Pattern Files</li>
            <li><span class="check-icon">&#10003;</span> Measurement Chart</li>
            <li><span class="check-icon">&#10003;</span> Tech Pack (BOM, Construction)</li>
          </ul>
        </div>
      </div>

      <!-- RIGHT COLUMN -->
      <div class="pd-right-col">
        <h1 class="ref-product-title"><%= product.name %></h1>
        <div class="ref-product-sub">
          <%= product.department ? product.department + "'s Pattern" : "Men's Pattern" %> &middot; Digital Pattern &amp; Printout
        </div>

        <!-- Price Display -->
        <div class="ref-price-row">
          <span class="ref-price-main">&#8377;<%= basePrice.toLocaleString('en-IN') %></span>
          <% if (product.compare_at_price && product.compare_at_price > basePrice) { %>
            <span class="ref-price-compare">&#8377;<%= Number(product.compare_at_price).toLocaleString('en-IN') %></span>
            <span class="ref-discount-badge"><%= Math.round((1 - basePrice / product.compare_at_price) * 100) %>% OFF</span>
          <% } %>
        </div>

        <p class="ref-short-desc">
          <%= product.description || 'Professional slim fit shirt pattern with multiple file formats, measurement chart and construction guide.' %>
        </p>

        <!-- Purchase Form -->
        <form id="pattern-purchase" class="ref-purchase-form" novalidate>
          <!-- Error banner -->
          <div id="pattern-error" class="ref-error-banner" role="alert"></div>

          <!-- STEP 1 — FIT BLOCK PATTERN — SOFT COPY (Multi-Format & Multi-Size) -->
          <div class="ref-step-section" id="section-soft-copy">
            <div class="ref-step-header">
              <div class="ref-step-title">
                <span class="ref-step-num">1</span>
                <span>FIT BLOCK PATTERN &mdash; SOFT COPY</span>
              </div>
            </div>
            <p style="font-size:12.5px;color:var(--ref-text-muted);margin:0 0 12px;">
              Ready-to-download digital CAD pattern files. Choose one, multiple, or all formats.
            </p>

            <!-- Base printable option linked to digital format selection -->
            <input type="checkbox" id="printable-option" checked style="display:none">

            <!-- Format Cards Grid: DXF, HPGL, PLT, PDF -->
            <div class="ref-format-grid" style="grid-template-columns: repeat(<%= hasPdfFile ? 4 : 3 %>, 1fr); margin-bottom: 14px;">
              <!-- DXF Card -->
              <label class="ref-format-card" id="formatCardDxf" data-format="dxf" data-price="<%= priceDxf %>">
                <div class="format-card-top">
                  <div class="format-checkbox-custom" id="formatCbDxf">
                    <span style="display:none">&#10003;</span>
                  </div>
                  <span class="format-price-badge">&#8377;<%= priceDxf.toLocaleString('en-IN') %></span>
                </div>
                <input
                  type="checkbox"
                  class="digital-format-check"
                  id="formatInputDxf"
                  value="dxf"
                  style="position:absolute;opacity:0;pointer-events:none;"
                >
                <div class="format-title">DXF</div>
                <div class="format-sub">Editable DXF Pattern</div>
              </label>

              <!-- HPGL Card -->
              <label class="ref-format-card" id="formatCardHpgl" data-format="hpgl" data-price="<%= priceHpgl %>">
                <div class="format-card-top">
                  <div class="format-checkbox-custom" id="formatCbHpgl">
                    <span style="display:none">&#10003;</span>
                  </div>
                  <span class="format-price-badge">&#8377;<%= priceHpgl.toLocaleString('en-IN') %></span>
                </div>
                <input
                  type="checkbox"
                  class="digital-format-check"
                  id="formatInputHpgl"
                  value="hpgl"
                  style="position:absolute;opacity:0;pointer-events:none;"
                >
                <div class="format-title">HPGL</div>
                <div class="format-sub">HPGL Plotter File</div>
              </label>

              <!-- PLT Card -->
              <label class="ref-format-card" id="formatCardPlt" data-format="plt" data-price="<%= pricePlt %>">
                <div class="format-card-top">
                  <div class="format-checkbox-custom" id="formatCbPlt">
                    <span style="display:none">&#10003;</span>
                  </div>
                  <span class="format-price-badge">&#8377;<%= pricePlt.toLocaleString('en-IN') %></span>
                </div>
                <input
                  type="checkbox"
                  class="digital-format-check"
                  id="formatInputPlt"
                  value="plt"
                  style="position:absolute;opacity:0;pointer-events:none;"
                >
                <div class="format-title">PLT</div>
                <div class="format-sub">Standard Plotter</div>
              </label>

              <!-- PDF Card -->
              <% if (hasPdfFile) { %>
                <label class="ref-format-card" id="formatCardPdf" data-format="pdf" data-price="<%= pricePdf %>">
                  <div class="format-card-top">
                    <div class="format-checkbox-custom" id="formatCbPdf">
                      <span style="display:none">&#10003;</span>
                    </div>
                    <span class="format-price-badge">&#8377;<%= pricePdf.toLocaleString('en-IN') %></span>
                  </div>
                  <input
                    type="checkbox"
                    class="digital-format-check"
                    id="formatInputPdf"
                    value="pdf"
                    style="position:absolute;opacity:0;pointer-events:none;"
                  >
                  <div class="format-title">PDF</div>
                  <div class="format-sub">Approved Pattern PDF</div>
                </label>
              <% } %>
            </div>

            <!-- Soft Copy Size Selection -->
            <div id="digitalSizeSelection" style="background:var(--ref-bg-light);border:1px solid var(--ref-border);border-radius:10px;padding:14px;margin-top:10px;">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;flex-wrap:wrap;gap:8px;">
                <div style="font-size:13px;font-weight:700;color:var(--ref-text-dark);display:flex;align-items:center;gap:8px;">
                  <span>Select Digital Sizes</span>
                  <span style="font-size:11.5px;font-weight:500;color:var(--ref-text-muted);" id="softSizeCountLabel">(1 size selected)</span>
                </div>
                <div style="display:flex;align-items:center;gap:8px;">
                  <button type="button" id="btnSelectAllSoftSizes" class="size-action-link" style="background:none;border:none;color:var(--ref-orange);font-size:12px;font-weight:700;cursor:pointer;padding:0;text-decoration:underline;">
                    Select All Sizes
                  </button>
                  <span style="color:var(--ref-border-strong);">&middot;</span>
                  <button type="button" id="btnClearSoftSizes" class="size-action-link" style="background:none;border:none;color:var(--ref-text-muted);font-size:12px;font-weight:600;cursor:pointer;padding:0;">
                    Clear Selection
                  </button>
                  <span style="color:var(--ref-border-strong);">&middot;</span>
                  <% if (product.size_chart_visible !== false) { %>
                  <button type="button" id="btn-size-guide" class="ref-size-chart-btn" aria-label="Open size chart" style="padding:2px 8px;font-size:12px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21.3 8.7l-2-2-1.4 1.4 2 2M16.5 13.5l-2-2-1.4 1.4 2 2M11.7 18.3l-2-2-1.4 1.4 2 2"></path>
                      <path d="M2 22l20-20"></path>
                    </svg>
                    <span>Size Chart</span>
                  </button>
                  <% } %>
                </div>
              </div>

              <div class="ref-size-pills-row" id="softSizePillsRow" role="group" aria-label="Soft Copy Size Options">
                <% configuredSizes.forEach(size => { %>
                  <label class="ref-size-pill <%= size === initialSelectedSize ? 'selected' : '' %>" data-soft-size="<%= size %>">
                    <input
                      type="checkbox"
                      name="selected_sizes"
                      class="pattern-size soft-size-check"
                      value="<%= size %>"
                      <%= size === initialSelectedSize ? 'checked' : '' %>
                      style="position:absolute;opacity:0;pointer-events:none;"
                    >
                    <span><%= size %></span>
                  </label>
                <% }) %>
              </div>
            </div>
            <small style="display:block;font-size:11.5px;color:var(--ref-text-muted);margin-top:8px;">
              Digital Pattern purchase includes 24-hour secure private download access per selected size and format.
            </small>
          </div>

          <!-- STEP 2 — BASIC CONSTRUCTION TECH PACK -->
          <div class="ref-step-section">
            <div class="ref-step-header">
              <div class="ref-step-title">
                <span class="ref-step-num">2</span>
                <span>BASIC CONSTRUCTION TECH PACK</span>
              </div>
            </div>

            <label class="ref-option-card <%= (techPackFile || techPackPrice > 0) ? '' : 'disabled-add' %>" id="techPackCard">
              <div class="ref-card-cb" id="techPackCheckMark">
                <span style="display:none">&#10003;</span>
              </div>
              <input
                type="checkbox"
                class="pattern-file"
                id="techPackInput"
                value="<%= techPackFile ? techPackFile._id : '' %>"
                data-price="<%= techPackPrice %>"
                <%= (techPackFile || techPackPrice > 0) ? '' : 'disabled' %>
                style="position:absolute;opacity:0;pointer-events:none;"
              >
              <div class="ref-card-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
              </div>
              <div class="ref-card-text">
                <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
                  <strong>Add Tech Pack &mdash; <%= techPackPrice > 0 ? '₹' + techPackPrice.toLocaleString('en-IN') : 'Included where configured' %></strong>
                  <% if (techPackPrice > 0) { %>
                    <span class="format-price-badge">&#8377;<%= techPackPrice.toLocaleString('en-IN') %></span>
                  <% } %>
                </div>
                <small>Basic Construction Details &middot; Measurement Chart &middot; POM Specifications (Points of Measure)</small>
              </div>
            </label>
          </div>

          <!-- STEP 3 — PHYSICAL PATTERN — HARD COPY (BROWN SHEET) -->
          <div class="ref-step-section" id="section-physical-pattern">
            <div class="ref-step-header">
              <div class="ref-step-title">
                <span class="ref-step-num">3</span>
                <span>PHYSICAL PATTERN &mdash; HARD COPY (BROWN SHEET)</span>
              </div>
            </div>

            <% const isPhysicalEnabled = product.pattern_options?.physical !== false; %>
            <label class="ref-option-card <%= !isPhysicalEnabled ? 'ref-option-card--disabled' : '' %>" id="physicalPrintoutCard" style="margin-bottom:12px;<%= !isPhysicalEnabled ? 'opacity:0.6;cursor:not-allowed;' : '' %>">
              <div class="ref-card-cb" id="physicalPrintoutCheckMark">
                <span style="display:none">&#10003;</span>
              </div>
              <input
                type="checkbox"
                id="physical-option"
                data-price="<%= physicalPrice %>"
                <%= !isPhysicalEnabled ? 'disabled' : '' %>
                style="position:absolute;opacity:0;pointer-events:none;"
              >
              <div class="ref-card-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 6 2 18 2 18 9"></polyline>
                  <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                  <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
              </div>
              <div class="ref-card-text">
                <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
                  <strong>Add Physical Pattern (Printed Brown Sheet)<% if (!isPhysicalEnabled) { %> <span style="font-size:11.5px;color:#ef4444;font-weight:600;">(Currently Unavailable)</span><% } %></strong>
                  <span class="format-price-badge">&#8377;<%= physicalPrice.toLocaleString('en-IN') %> / Size</span>
                </div>
                <small>Ready-to-use pattern printed on brown pattern paper/sheet. <%= product.printable_dimensions || 'A0 Plot (1:1) on 80 GSM Paper' %></small>
              </div>
            </label>

            <!-- Physical Size Selection Row (Independent of soft copy) -->
            <div id="physicalSizesContainer" style="background:var(--ref-bg-light);border:1px solid var(--ref-border);border-radius:10px;padding:14px;opacity:0.45;pointer-events:none;transition:all 0.2s ease;">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;flex-wrap:wrap;gap:8px;">
                <div style="font-size:13px;font-weight:700;color:var(--ref-text-dark);display:flex;align-items:center;gap:8px;">
                  <span>SELECT PHYSICAL PATTERN SIZES</span>
                  <span style="font-size:11.5px;font-weight:500;color:var(--ref-text-muted);" id="physSizeCountLabel">(0 selected)</span>
                </div>
                <div style="display:flex;align-items:center;gap:8px;">
                  <button type="button" id="btnSelectAllPhysSizes" class="size-action-link" style="background:none;border:none;color:var(--ref-orange);font-size:12px;font-weight:700;cursor:pointer;padding:0;text-decoration:underline;">
                    Select All Physical Sizes
                  </button>
                  <span style="color:var(--ref-border-strong);">&middot;</span>
                  <button type="button" id="btnClearPhysSizes" class="size-action-link" style="background:none;border:none;color:var(--ref-text-muted);font-size:12px;font-weight:600;cursor:pointer;padding:0;">
                    Clear Physical Selection
                  </button>
                </div>
              </div>

              <div class="ref-size-pills-row" id="physSizePillsRow" role="group" aria-label="Physical Pattern Size Options">
                <% configuredSizes.forEach(size => { %>
                  <label class="ref-size-pill" data-phys-size="<%= size %>">
                    <input
                      type="checkbox"
                      name="physical_sizes"
                      class="phys-size-check"
                      value="<%= size %>"
                      data-price="<%= product.size_prices?.find(row => row.size === size)?.price ?? physicalPrice %>"
                      style="position:absolute;opacity:0;pointer-events:none;"
                    >
                    <span><%= size %><small style="display:block;font-size:10px;font-weight:600;">&#8377;<%= Number(product.size_prices?.find(row => row.size === size)?.price ?? physicalPrice).toLocaleString('en-IN') %></small></span>
                  </label>
                <% }) %>
              </div>
            </div>
          </div>

          <!-- STEP 4 — FABRIC CONSUMPTION MARKERS -->
          <div class="ref-step-section">
            <div class="ref-step-header">
              <div class="ref-step-title">
                <span class="ref-step-num">5</span>
                <span>FABRIC CONSUMPTION MARKERS</span>
              </div>
            </div>
            <p style="font-size:12.5px;color:var(--ref-text-muted);margin:0 0 10px;">
              Basic solid-fabric consumption markers for the selected garment and size.
            </p>

            <div class="marker-files-grid">
              <div class="marker-file-card">
                <span class="marker-file-badge">PDF</span>
                <div>
                  <strong style="font-size:13px;display:block;color:var(--ref-text-dark);">PDF Mini Marker</strong>
                  <span style="font-size:11.5px;color:<%= hasPdfMarker ? '#10B981' : '#64748B' %>;">
                    <%= hasPdfMarker ? '✓ Available for download' : 'Upload pending (available on request)' %>
                  </span>
                </div>
              </div>
              <div class="marker-file-card">
                <span class="marker-file-badge">CAD</span>
                <div>
                  <strong style="font-size:13px;display:block;color:var(--ref-text-dark);">CAD Mini Marker</strong>
                  <span style="font-size:11.5px;color:<%= hasCadMarker ? '#10B981' : '#64748B' %>;">
                    <%= hasCadMarker ? '✓ Available for download' : 'Upload pending (available on request)' %>
                  </span>
                </div>
              </div>
            </div>

            <div class="marker-notice-box">
              <strong>Notice:</strong> Fabric consumption is calculated strictly from verified marker data. Mini marker files are included in release assets where uploaded.
            </div>
          </div>

          <!-- STEP 6 — CUSTOMIZE MARKERS -->
          <div class="ref-step-section">
            <div class="ref-step-header">
              <div class="ref-step-title">
                <span class="ref-step-num">6</span>
                <span>CUSTOMIZE MARKERS</span>
              </div>
            </div>
            <p style="font-size:12.5px;color:var(--ref-text-muted);margin:0 0 12px;">
              Specify fabric repeat dimensions for custom engineered marker requests.
            </p>

            <div class="custom-marker-tabs" role="tablist">
              <button type="button" class="custom-marker-tab-btn active" id="tabBtnStripes" role="tab" aria-selected="true" aria-controls="panelStripes">
                A. Markers for Stripes
              </button>
              <button type="button" class="custom-marker-tab-btn" id="tabBtnChecks" role="tab" aria-selected="false" aria-controls="panelChecks">
                B. Markers for Checks
              </button>
