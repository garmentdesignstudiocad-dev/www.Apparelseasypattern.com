<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/business.css"></head><body><%- include('../partials/admin_header') %><main class="studio-admin"><h1><%= title %></h1>
<% if(item){ %><a href="/admin/leads">Back to leads</a><dl><% ['name','email','whatsapp','country','location','profession','interest','interested_course','experience','preferred_timing','message','source','company_name','employee_count','preferred_date','createdAt'].forEach(key => { %><dt><%= key.replaceAll('_',' ') %></dt><dd><%= item[key] instanceof Date ? item[key].toISOString() : item[key] || '—' %></dd><% }) %></dl><form method="post" action="/admin/leads/<%= item._id %>/status" class="studio-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Status<select name="status"><% business.statuses.forEach(status => { %><option <%= item.status === status?'selected':'' %>><%= status %></option><% }) %></select></label><button type="submit">Save Status</button></form>
<% }else{ const params = new URLSearchParams(); for(const key of ['q','interest','interested_course','status']) if(typeof query[key] === 'string') params.set(key, query[key]); %><form method="get" class="studio-form"><label>Search name, email or phone<input name="q" maxlength="100" value="<%= typeof query.q === 'string'?query.q:'' %>"></label><label>Interest<select name="interest"><option value="">All interests</option><% business.interests.forEach(option => { %><option <%= query.interest === option?'selected':'' %>><%= option %></option><% }) %></select></label><label>Course (exact name)<input name="interested_course" maxlength="300" value="<%= typeof query.interested_course==='string'?query.interested_course:'' %>"></label><label>Status<select name="status"><option value="">All statuses</option><% business.statuses.forEach(option => { %><option <%= query.status === option?'selected':'' %>><%= option %></option><% }) %></select></label><button type="submit">Filter Leads</button></form><p><%= total %> leads · <a href="/admin/leads/export.csv?<%= params.toString() %>">Export matching leads as CSV</a></p><div class="studio-table"><table><thead><tr><th>Name</th><th>Email / Phone</th><th>Interest</th><th>Status</th><th>Received</th></tr></thead><tbody><% items.forEach(lead => { %><tr><td><a href="/admin/leads/<%= lead._id %>"><%= lead.name %></a></td><td><%= lead.email %><br><%= lead.whatsapp %></td><td><%= lead.interest %><br><%= lead.interested_course || '' %></td><td><%= lead.status %></td><td><%= new Date(lead.createdAt).toLocaleDateString('en-IN') %></td></tr><% }) %></tbody></table></div><% if(!items.length){ %><p>No matching enquiries.</p><% } %><div class="studio-actions"><% if(page > 1){ params.set('page', page-1); %><a href="?<%= params.toString() %>">Previous</a><% } %><% if(page*50 < total){ params.set('page', page+1); %><a href="?<%= params.toString() %>">Next</a><% } %></div><% } %>
</main></body></html>
