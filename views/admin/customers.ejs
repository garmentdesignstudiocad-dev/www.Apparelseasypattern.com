<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"></head><body><%- include('../partials/admin_header') %><main class="container"><section class="admin-hero"><div><p class="eyebrow">Relationships</p><h1>Customers</h1></div></section><form method="get" class="card card-body"><label>Search <input name="search" value="<%= search %>" placeholder="Name, email or phone"></label> <button class="btn primary">Search</button></form><section class="card"><div class="card-body admin-table-wrap"><table class="admin-table"><thead><tr><th>Customer</th><th>Phone</th><th>Location</th><th>Orders</th><th>Total Spend</th><th>Last Order</th><th></th></tr></thead><tbody><% if(customers.length){customers.forEach(c=>{ %><tr><td><strong><%= c.name %></strong><br><small><%= c.email %></small></td><td><%= c.phone||'—' %></td><td><%= [c.address,c.city,c.state,c.postal_code].filter(Boolean).join(', ')||'—' %></td><td><%= c.orderCount %></td><td><%= formatCurrency(c.totalPurchase) %></td><td><%= c.lastOrderDate?new Date(c.lastOrderDate).toLocaleDateString('en-IN'):'—' %></td><td><a class="btn small" href="/admin/customers/<%= c.id %>">View</a></td></tr><% })}else{ %><tr><td colspan="7">No matching customers.</td></tr><% } %></tbody></table></div></section></main></body></html>
