<% if(canVisit(kind==='courses'?'/classes':'/'+kind)){ %><div class="studio-grid"><% items.forEach(item => { const image = kind === 'products' ? item.images?.[0] : kind === 'courses' ? item.banner_image : kind === 'books' ? item.cover_url : item.image_url; const href = (kind === 'products'?'/product/':kind === 'courses'?'/classes/':kind === 'books'?'/books/':'/updates/') + encodeURIComponent(item.slug); if(!canVisit(href)) return; %>
<article class="studio-card"><% if(image){ %><img src="<%= image %>" alt="<%= item.title || item.name %>" loading="lazy"><% } %><h3><a href="<%= href %>"><%= item.title || item.name %></a></h3><p><%= item.summary || item.short_description || (item.description || '').slice(0,180) %></p><% if(kind === 'courses'){ %><p><%= new Date(item.starts_at).toLocaleDateString('en-IN') %> · <%= item.is_free ? 'Free' : '₹' + Number(item.price).toLocaleString('en-IN') %></p><% } %><a href="<%= href %>">View details</a></article><% }) %>
<% if(!items.length){ %><p>New <%= kind %> will appear here when available. <% if(featureEnabled('leads')){ %><a href="/contact">Enquire with the studio</a><% } %>.</p><% } %></div>
<% } %>