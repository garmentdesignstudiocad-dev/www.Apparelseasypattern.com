{
  "name": "garment-pattern-store",
  "version": "0.1.0",
  "description": "A modular Node.js + Express.js e-commerce storefront for garment patterns.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "test:launch": "node scripts/testLaunch.js",
    "prepare:launch": "node scripts/prepareLaunch.js",
    "test:public-visibility": "node scripts/testPublicVisibility.js",
    "test:seo": "node scripts/testSeo.js",
    "test:owner-update": "node scripts/testOwnerUpdate.js",
    "test:pattern-browser": "node scripts/testPatternBrowser.js",
    "test:features": "node scripts/testFeatures.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:consulting-forms": "node scripts/testConsultingForms.js",
    "test:notifications": "node scripts/testNotifications.js",
    "test:paid-access": "node scripts/testPaidAccess.js",
    "test:appearance": "node scripts/testAppearance.js",
    "test:business": "node scripts/testBusiness.js",
    "test:learning": "node scripts/testLearning.js",
    "test:stability": "node scripts/testStability.js",
    "test:appearance:mongo": "node scripts/testAppearanceMongo.js",
    "migrate": "npx knex migrate:latest --knexfile ./knexfile.js",
    "migrate:rollback": "npx knex migrate:rollback --knexfile ./knexfile.js",
    "test:shipping": "node scripts/testShipping.js",
    "test:notification-providers": "node scripts/testNotificationProviders.js",
    "test:commerce": "node scripts/testCommerce.js",
    "test:commerce-security": "node scripts/testCommerceSecurity.js",
    "test:commerce-local": "node scripts/testCommerceLocal.js",
    "test:courier-ui": "node scripts/testCourierUI.js",
    "test": "node scripts/testAll.js",
    "test:production-startup": "node scripts/testProductionStartup.js",
    "test:delivery-zones": "node scripts/testDeliveryZones.js",
    "test:order-confirmation": "node scripts/testOrderConfirmation.js",
    "test:customer-account": "node scripts/testCustomerAccount.js"
  },
  "dependencies": {
    "csv-parser": "^3.2.1",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.4",
    "express-session": "^1.19.0",
    "knex": "^3.3.0",
    "mongodb": "^7.5.0",
    "mongoose": "^7.5.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^10.0.13",
    "pdf-lib": "^1.17.1",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.0.1",
    "yauzl": "^3.4.0"
  },
  "knex": {
    "version": "2.x"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": true
    }
  }
}
