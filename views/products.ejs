<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> | Garment Pattern Store</title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/customer-experience.css"><%- include('partials/theme') %></head><body><%- include('partials/header') %>
<main class="fashion-page"><section class="catalog-hero"><span class="eyebrow">Pattern collection</span><h1 class="page-title"><%= siteSettings.products_heading %></h1><p class="page-intro"><%= siteSettings.products_description %></p><p>Digital / Soft Copy Patterns Available</p></section>
<section><span class="eyebrow">Browse the collection</span><h2 style="font-family:'Playfair Display',serif;font-size:30px;margin:8px 0 23px">Find your next pattern</h2><div class="product-catalog"><% if (products && products.length) { %><% products.forEach(function(p) { %><article class="fashion-product"><div class="fashion-product__media"><span class="fashion-product__badge">PATTERN</span><% if (p.images && p.images.length) { %><img loading="lazy" src="<%= p.images[0] %>" alt="<%= p.name %>"><% } else { %><div class="fashion-product__placeholder" aria-hidden="true"></div><% } %></div><div class="fashion-product__body"><span class="fashion-product__kicker">PROFESSIONAL COLLECTION</span><h2><%= p.name %></h2><p><%= p.description ? p.description.substring(0,110) : 'Customise your pattern with the options that suit your workflow.' %></p><div class="fashion-product__bottom"><strong class="fashion-price">₹<%= Number(p.base_price || 0).toLocaleString('en-IN',{minimumFractionDigits:2}) %></strong><% if(canVisit('/product/' + String(p.slug))){ %><a class="fashion-button" href="/product/<%= p.slug %>">View Details</a><% } %></div></div></article><% }) %><% } else { %><p class="page-intro">New patterns will appear here soon.</p><% } %></div></section></main><%- include('partials/footer') %><script src="/js/main.js"></script></body></html>
