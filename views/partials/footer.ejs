<footer class="site-footer"><div class="container footer-grid"><div class="footer-brand"><% if(canVisit('/')){ %><a class="fashion-logo fashion-logo--footer" href="/"><span class="fashion-logo__mark">GP</span><span class="fashion-logo__copy"><strong><%= siteSettings?.store_name || 'Garment Pattern Store' %></strong><small>ORDERING PORTAL</small></span></a><% } %><p><%= siteSettings?.footer_text || 'Professional garment pattern ordering with secure online checkout.' %></p></div><% const orderingLinks=visibleLinks([['Available Patterns','/products'],['Shopping Cart','/cart'],['Checkout','/checkout']]); if(orderingLinks.length){ %><div><h5>Ordering</h5><ul><% orderingLinks.forEach(([label,url])=>{ %><li><a href="<%= url %>"><%= label %></a></li><% }) %></ul></div><% } %><div><h5>Support</h5><% if(siteSettings.support_cta){ %><p><%= siteSettings.support_cta %></p><% } %><ul><% if(siteSettings?.contact_email){ %><li><a href="mailto:<%= siteSettings.contact_email %>"><%= siteSettings.contact_email %></a></li><% } %><% if(siteSettings?.contact_phone){ %><li><a href="tel:<%= siteSettings.contact_phone.replace(/[^+\d]/g,'') %>"><%= siteSettings.contact_phone %></a></li><% } %><% if(siteSettings.whatsapp_number){ %><li><a href="https://wa.me/<%= siteSettings.whatsapp_number.replace(/\D/g, '') %>" target="_blank" rel="noopener noreferrer">WhatsApp</a></li><% } %><% if(siteSettings?.main_website_url && canVisit(siteSettings.main_website_url)){ %><li><a href="<%= siteSettings.main_website_url %>" rel="noopener"><%= siteSettings.back_website_label %></a></li><% } %></ul></div></div><% if(featureEnabled('linkedin') && siteSettings.linkedin_show_footer){ %><div class="container"><%- include('linkedin',{compact:true}) %></div><% } %><div class="footer-bottom"><div class="container"><span>© <%= new Date().getFullYear() %> <%= siteSettings?.store_name || 'Garment Pattern Store' %></span><span>Secure ordering portal</span></div></div><div class="container" style="padding:0 16px 20px;text-align:center;box-sizing:border-box"><p style="margin:0;font-size:12px;line-height:1.6;color:inherit">Created by <strong style="font-weight:600;color:inherit">Innovix Projects</strong></p></div></footer>
