<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= typeof seoTitle!=='undefined'?seoTitle:title %> | Garment Pattern Store</title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/customer-experience.css"><%- include('../partials/theme') %></head><body><%- include('../partials/header') %><main class="fashion-page classes-page"><section class="catalog-hero"><span class="eyebrow">Learn with the studio</span><h1 class="page-title">Online Classes Available</h1><p class="page-intro">Live online learning sessions for garment pattern workflows, published and managed by Garment Pattern Store.</p><% if(canVisit('/classes/enquiry')){ %><p><a class="fashion-button" href="/classes/enquiry">Enquire for Online Classes</a></p><% } %></section><div class="class-grid"><% if(sessions.length){ sessions.forEach(function(item){ const left=item.max_seats?Math.max(0,item.max_seats-item.registered_count):null; %><article class="class-card"><div class="class-card__media"><% if(item.banner_image){ %><img src="<%= item.banner_image %>" alt=""><% }else{ %><span>GARMENT / LEARNING</span><% } %></div><div class="class-card__body"><span class="eyebrow"><%= item.type %></span><h2><% if(canVisit('/classes/' + String(item.slug))){ %><a href="/classes/<%= item.slug %>"><%= item.title %></a><% } %></h2><p><%= item.short_description || '' %></p><dl><div><dt>Date</dt><dd><%= new Date(item.starts_at).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric',timeZone:'Asia/Kolkata'}) %></dd></div><div><dt>Fee</dt><dd><%= item.is_free?'Free':'₹'+Number(item.price).toLocaleString('en-IN') %></dd></div><% if(left!==null){ %><div><dt>Seats</dt><dd><%= left %> available</dd></div><% } %></dl><% if(canVisit('/classes/' + String(item.slug))){ %><a class="fashion-button" href="/classes/<%= item.slug %>">View Details</a><% } %></div></article><% }) }else{ %><div class="class-empty"><h2>No upcoming sessions</h2><p>Published online classes and workshops will appear here when registration opens.</p></div><% } %></div></main><%- include('../partials/footer') %><script src="/js/main.js"></script></body></html>
