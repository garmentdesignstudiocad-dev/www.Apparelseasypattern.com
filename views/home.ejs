<!doctype html><html lang="en"><head><%- include('partials/business-head') %></head><body class="premium-store"><%- include('partials/header') %><main class="studio-page">
<section class="studio-section pattern-intro"><span class="eyebrow">Apparel Easy Patterns</span><h1>Ready-to-Use Apparel Patterns</h1><p>Ready-to-use garment pattern blocks for faster sampling, stitching and product development.</p><p>Browse practical pattern templates with selected printable files, measurement information, tech-pack options and physical pattern services.</p><div class="studio-actions"><% if(canVisit('/products')){ %><a class="fashion-button" href="/products">Explore Available Patterns</a><% } %><% if(canVisit('/pattern-updates')){ %><a href="/pattern-updates">Get Pattern Updates</a><% } %></div></section>
<% if(canVisit('/products')){ %><section class="studio-section"><span class="eyebrow">Ready-to-use pattern block library</span><h2>A practical starting point for your next garment.</h2><p>Explore practical pattern blocks for current and essential apparel silhouettes across Men's, Women's and Kids' categories. The library will continue to grow with new ready-to-use styles, helping you begin sampling without starting every pattern from scratch.</p><nav class="pattern-categories" aria-label="Pattern categories"><% ['shirts','pants','shorts'].forEach(category=>{ %><a href="/products?category=<%= category %>"><%= category.toUpperCase() %></a><% }) %></nav>
<% if(featureEnabled('homepage_catalogs')){ %><%- include('partials/business-cards',{kind:'products',items:products}) %><% } %><div class="studio-actions"><a href="/products">Explore Patterns</a></div></section><% } %>
<section class="pattern-teasers"><% if(canVisit('/books')){ %><article><span class="eyebrow">Books - Coming Soon</span><h2>Want to become a garment technologist?</h2><p>Learn from materials prepared with practical apparel-industry knowledge and experience.</p><a href="/books">Explore Books</a></article><% } %><% if(canVisit('/classes/enquiry')){ %><article><span class="eyebrow">Online classes - Coming Soon</span><h2>Become a professional pattern maker</h2><p>Build your skills through focused online learning and practical pattern development.</p><a href="/classes/enquiry">Request Class Information</a></article><% } %></section>
</main><%- include('partials/footer') %><script src="/js/main.js"></script></body></html>
