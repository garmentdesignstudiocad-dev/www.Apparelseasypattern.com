<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"></head><body><%- include('../partials/admin_header') %><main class="container admin-dashboard-main"><section class="admin-hero"><div><p class="eyebrow">Operations</p><h1>Orders</h1></div><a class="btn ghost" href="/admin/orders-export.csv">Export CSV</a></section><form class="card card-body admin-settings-grid" method="get"><label>Search<input name="search" value="<%= filters.search %>" placeholder="Order, customer or email"></label><label>Order Status<select name="status"><option value="">All</option><% ['pending','confirmed','processing','shipped','delivered','cancelled'].forEach(s=>{ %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= s %></option><% }) %></select></label><label>Payment Status<select name="payment"><option value="">All</option><% ['paid','pending','failed','unpaid'].forEach(s=>{ %><option value="<%= s %>" <%= filters.payment===s?'selected':'' %>><%= s %></option><% }) %></select></label><button class="btn primary">Apply Filters</button></form><section class="card"><div class="card-body admin-table-wrap"><table class="admin-table"><thead><tr><th>Order</th><th>Customer</th><th>Status</th><th>Payment</th><th>Total</th><th></th></tr></thead><tbody><% if(orders.length){orders.forEach(o=>{ %><tr><td>#<%= o.id %></td><td><%= o.customer_name %><br><a href="mailto:<%= o.customer_email %>"><%= o.customer_email %></a><br><a href="tel:<%= (o.customer_phone || '').replace(/[^+0-9]/g,'') %>"><%= o.customer_phone || '' %></a><br><%= o.customer_address || '' %><br>Courier: <%= o.courier_name || '' %><br>Dispatch Hub: <%= o.dispatch_location || '' %></td><td><span class="status-badge <%= o.order_status %>"><%= o.order_status %></span></td><td><span class="status-badge <%= o.payment_status %>"><%= o.payment_status %></span></td><td><%= formatCurrency(o.grand_total) %></td><td><a class="btn small" href="/admin/orders/<%= o.id %>">View</a></td></tr><% })}else{ %><tr><td colspan="6">No matching orders.</td></tr><% } %></tbody></table></div></section></main></body></html>
