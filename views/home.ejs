<!DOCTYPE html><html lang="en"><head><%- include('partials/business-head') %></head><body class="premium-store"><%- include('partials/header') %><main class="studio-page"><% if(typeof catalogUnavailable !== 'undefined' && catalogUnavailable){ %><p role="status">Some listings are temporarily unavailable. Please try again shortly or contact the studio.</p><% } %>
<section class="studio-section"><span class="eyebrow">Garment Design Studio</span><h1><%= siteSettings.homepage_heading %></h1><p><%= siteSettings.homepage_subheading %></p><div class="studio-actions"><% if(canVisit('/products')){ %><a href="/products">Ready-to-Use Professional Garment Patterns</a><% } %><% if(canVisit('/classes')){ %><a href="/classes">Online Classes Available</a><% } %><% if(canVisit('/classes/enquiry')){ %><a href="/classes/enquiry">Enquire for Online Classes</a><% } %><% if(canVisit('/courses')){ %><a href="/courses">Explore Courses</a><% } %><% if(canVisit('/consulting#enquiry')){ %><a href="/consulting#enquiry">Book Consultation</a><% } %></div></section>
<% const serviceLinks=visibleLinks([['Pattern Making','/courses/pattern-making'],['Garment Technology','/garment-technology'],['Digital Patterns','/products'],['Consulting','/consulting']]); if(featureEnabled('homepage_services') && serviceLinks.length){ %><section class="studio-section"><h2>Our Services</h2><div class="studio-grid"><% serviceLinks.forEach(([label,url]) => { %><% if(canVisit(String(url))){ %><a class="studio-card" href="<%= url %>"><h3><%= label %></h3><span>Explore service</span></a><% } %><% }) %></div></section>
<% } %>
<% [['New Patterns','products',products],['Featured Courses','courses',courses],['Upcoming Webinars','webinars',webinars],['Latest Fashion Updates','updates',articles],['Books','books',books]].forEach(([heading,kind,items]) => { if(featureEnabled('homepage_catalogs') && canVisit('/'+kind)){ %><section class="studio-section"><h2><%= heading %></h2><% if(kind === 'products'){ %><p>Discover the latest active patterns and product launches from the studio.</p><% } %><%- include(['courses','webinars'].includes(kind)?'partials/learning-cards':'partials/business-cards',{kind,items}) %><% if(canVisit('/' + String(kind))){ %><a href="/<%= kind %>">Explore all <%= kind %></a><% } %></section><% } }) %>
<% if(featureEnabled('consulting') && featureEnabled('homepage_services')){ %><section class="studio-section"><h2>Consulting</h2><ul class="studio-columns"><% ['Pattern Development','Tech Pack','Fit Correction','Grading','CAD','Sample Development','Technical Consultation'].forEach(service => { %><li><%= service %></li><% }) %></ul><% if(canVisit('/consulting#enquiry')){ %><a class="fashion-button" href="/consulting#enquiry">Submit Your Requirement</a><% } %></section><% } %>
</main><%- include('partials/footer') %><script src="/js/main.js"></script></body></html>