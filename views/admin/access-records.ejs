<!DOCTYPE html><html><head><meta charset="utf-8"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/business.css"></head><body><%- include('../partials/admin_header') %><main class="studio-admin"><h1><%= title %></h1><p role="status"><%= error %></p><form method="get" class="studio-form"><label>Section<select name="kind"><% ['courses','webinars','books','consulting'].forEach(k=>{ %><option <%= k===kind?'selected':'' %>><%= k %></option><% }) %></select></label><label>Search name, email, WhatsApp or item<input name="q" value="<%= query.q || '' %>"></label><label>Payment<select name="payment"><option value="">All</option><% ['Pending','Paid','Failed','Not Required'].forEach(s=>{ %><option <%= query.payment===s?'selected':'' %>><%= s %></option><% }) %></select></label><label>Access Status<select name="status"><option value="">All</option><% ['Registered','Payment Pending','Confirmed','Attended','Cancelled'].forEach(s=>{ %><option <%= query.status===s?'selected':'' %>><%= s %></option><% }) %></select></label><button>Search / Filter</button></form><p><%= total %> records · Page <%= page %></p><% items.forEach(row=>{const base='/admin/access-records/'+kind+'/'+row._id; %><article class="studio-card"><h2><%= row.item_name || row.course_name || 'Webinar registration' %></h2><p><%= row.full_name || row.name %> · <%= row.email %> · <%= row.whatsapp %></p><p>Reference: <%= row._id %> · <%= row.createdAt.toLocaleString('en-IN') %></p><p>Purpose: <%= row.payment_purpose || 'Legacy course booking' %> · Item: <%= row.item_id || row.course_id || row.webinar_id %></p><p>₹<%= ((row.amount_paise || 0)/100).toLocaleString('en-IN') %> INR · <span class="status-badge"><%= row.payment_status || 'Not Required' %></span> · Access: <%= row.registration_status || row.status %></p><p>Order: <%= row.razorpay_order_id || '—' %> · Payment: <%= row.razorpay_payment_id || '—' %></p><% if(kind==='books'){ %><p>Purchase type: <%= row.purchase_type %></p><% } %><% if(row.preferred_date){ %><p>Preferred: <%= row.preferred_date %> <%= row.preferred_time %> IST</p><p>Requirement: <%= row.notes %></p><p>Booking status: <%= row.status %></p><% } %><% if(kind==='webinars'){ %><p>Attendance: <%= row.attendance_status %></p><a href="/admin/webinar-registrations/<%= row._id %>">Meeting / Attendance Management</a><% } %><p><%= row.payment_note || '' %></p><% if(row.payment_purpose || kind==='webinars'){ %><form method="post" action="<%= base %>/check"><input type="hidden" name="_csrf" value="<%= learningCsrf %>"><button>Check Payment</button></form><form method="post" action="<%= base %>/cancel"><input type="hidden" name="_csrf" value="<%= learningCsrf %>"><label><input type="checkbox" name="refund_acknowledged"> I will arrange any paid refund separately in Razorpay</label><button>Cancel Access</button></form><% if(row.order_creating && !row.razorpay_order_id){ %><form method="post" action="<%= base %>/recover-order"><input type="hidden" name="_csrf" value="<%= learningCsrf %>"><label>Verified Razorpay Order ID<input name="order_id" required></label><button>Recover Order</button></form><form method="post" action="<%= base %>/reset-order"><input type="hidden" name="_csrf" value="<%= learningCsrf %>"><label><input type="checkbox" name="no_order_acknowledged" required> I checked Razorpay and no matching receipt exists</label><button>Reset Payment Setup (after 5 minutes)</button></form><% } %><% if(kind==='consulting'){ %><form method="post" action="<%= base %>/status"><input type="hidden" name="_csrf" value="<%= learningCsrf %>"><select name="status"><% ['New','Contacted','Confirmed','Completed'].forEach(s=>{ %><option <%= row.status===s?'selected':'' %>><%= s %></option><% }) %></select><button>Update Booking Status</button></form><% } %><% } %></article><% }) %><% for(const target of [page-1,page+1]){if(target>0 && (target-1)*50<total){const params=new URLSearchParams({kind,q:query.q || '',payment:query.payment || '',status:query.status || '',page:String(target)}); %><a href="?<%= params.toString() %>">Page <%= target %></a> <% }} %></main></body></html>
