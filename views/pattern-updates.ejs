<!doctype html><html lang="en"><head><%- include('partials/business-head') %></head><body><%- include('partials/header') %><main class="studio-page"><section class="pattern-intro"><span class="eyebrow">Apparel Easy Patterns</span><h1><%= title %></h1><p><%= description %></p></section>
<% if(sent){ %><p class="pattern-notice" role="status">Thank you. Your request has been saved.</p><a href="/products">Continue browsing patterns</a><% }else{ %><% if(error){ %><p role="alert"><%= error %></p><% } %><form method="post" action="<%= kind==='books'?'/books/notify':'/pattern-updates' %>" class="studio-form pattern-form"><input type="hidden" name="_csrf" value="<%= learningCsrf %>">
<% (kind==='books'?[['email','Email Address','email']]:[['name','Full Name','text'],['email','Email Address','email'],['whatsapp','Phone Number','tel']]).forEach(([key,label,type])=>{ %><label><%= label %><input name="<%= key %>" type="<%= type %>" required maxlength="300" autocomplete="<%= key==='whatsapp'?'tel':key %>" value="<%= typeof values[key]==='string'?values[key]:'' %>"></label><% }) %>
<label class="studio-wide consent"><input type="checkbox" name="consent" required <%= values.consent==='on'?'checked':'' %>> Send me <%= kind==='books'?'an email when books are available':'updates about new ready-to-use patterns' %>. I can ask to stop updates using the contact details below.</label><button class="fashion-button"><%= kind==='books'?'Notify Me When Books Are Available':'Get Pattern Updates' %></button><a href="/products">Continue browsing</a></form><% } %><%- include('partials/support-contact') %></main><%- include('partials/footer') %><script src="/js/main.js"></script></body></html>
