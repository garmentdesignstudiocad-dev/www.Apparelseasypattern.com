<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Your pattern downloads</title><link rel="stylesheet" href="/css/styles.css"></head><body><main class="container section"><h1>Your Pattern Downloads</h1><p>This private link expires <%= new Date(expires).toLocaleDateString('en-IN') %>. Keep it private.</p><ul><% assets.forEach((asset,index)=>{ %><li><a href="/downloads/<%= token %>/<%= index %>"><%= asset.name %></a></li><% }) %></ul></main></body></html>
