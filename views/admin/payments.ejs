<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"></head><body><%- include('../partials/admin_header') %><main class="container admin-dashboard-main"><section class="admin-hero"><div><p class="eyebrow">Finance</p><h1>Payments</h1><p><a href="/admin/access-records">Course, webinar, book and consulting payments</a></p></div></section><form method="get" class="card card-body"><label>Status <select name="status"><option value="">All</option><% ['paid','pending','failed'].forEach(s=>{ %><option value="<%= s %>" <%= selectedStatus===s?'selected':'' %>><%= s %></option><% }) %></select></label> <button class="btn primary">Filter</button></form><section class="card"><div class="card-body admin-table-wrap"><table class="admin-table"><thead><tr><th>Payment ID</th><th>Order</th><th>Customer</th><th>Provider</th><th>Amount</th><th>Status</th><th>Date</th><th></th></tr></thead><tbody><% if(payments.length){payments.forEach(p=>{ %><tr><td>#<%= p.id %></td><td><%= p.order_id||'—' %></td><td><%= p.customer_name %><br><small><%= p.customer_email %></small></td><td><%= p.payment_provider||'razorpay' %></td><td><%= formatCurrency(p.amount) %> <%= p.currency %></td><td><span class="status-badge <%= p.payment_status %>"><%= p.payment_status %></span></td><td><%= new Date(p.createdAt).toLocaleString('en-IN') %></td><td><a class="btn small" href="/admin/payments/<%= p.id %>">View</a></td></tr><% })}else{ %><tr><td colspan="8">No matching payments.</td></tr><% } %></tbody></table></div></section></main></body></html>
