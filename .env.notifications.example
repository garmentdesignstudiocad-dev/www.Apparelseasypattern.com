# Copy these names into your private environment. Do not commit real credentials.
# Public HTTPS origin for private receipt links in customer messages.
PUBLIC_BASE_URL=https://your-store.example

# SMTP: Gmail initially; use a Google App Password, never your normal password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=garmentdesignstudiocad@gmail.com
EMAIL_PASSWORD=
EMAIL_FROM=Garment Design Studio <garmentdesignstudiocad@gmail.com>
# Optional override; otherwise alerts go to MongoDB SiteSettings.contact_email.
ADMIN_NOTIFICATION_EMAIL=garmentdesignstudiocad@gmail.com

# Official Meta WhatsApp Cloud API. Use a supported version from your Meta app.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_FROM_NUMBER=+919791753067
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=studio_service_update
WHATSAPP_TEMPLATE_LANGUAGE=en

# Worker runs once per minute when the application is started with npm start.
NOTIFICATIONS_WORKER_ENABLED=true
GMAIL_USER=garmentdesignstudiocad@gmail.com
GMAIL_APP_PASSWORD=
# Automatic business lead notifications (independent of legacy channel toggles).
LEAD_NOTIFICATION_TO=garmentdesignstudiocad@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
