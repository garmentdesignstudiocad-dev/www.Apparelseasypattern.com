              </div>
              <div class="ref-card-text">
                <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
                  <strong>Trial Fit Sample - With Available Fabric<% if (!isTrialEnabled) { %> <span style="font-size:11.5px;color:#ef4444;font-weight:600;">(Currently Unavailable)</span><% } %></strong>
                  <span class="format-price-badge">&#8377;<%= trialPrice > 0 ? trialPrice.toLocaleString('en-IN') : 'N/A' %> / Sample</span>
