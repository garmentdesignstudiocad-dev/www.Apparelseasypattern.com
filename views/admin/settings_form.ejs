<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"></head><body><%- include('../partials/admin_header') %><main class="container section"><section class="admin-hero"><div><p class="eyebrow">Configuration</p><h1><%= title %></h1></div></section><% if(message){ %><div class="alert"><%= message %></div><% } %><section class="card"><div class="card-body"><% if(section==='admin'){ %><p class="settings-note">Admin authentication uses protected environment credentials. Password changes are intentionally unavailable here.</p><p><strong>Signed in as:</strong> <%= settings.display_name %></p><% }else{ %><form method="post" action="/admin/settings/<%= section %>" class="admin-settings-grid"><% if(section==='pricing'){ %><label>Default Soft Copy Price (₹)<input type="number" min="0" step=".01" name="soft_copy_price" value="<%= settings.soft_copy_price||0 %>"></label><label>Default Additional Size Price (₹)<input type="number" min="0" step=".01" name="additional_size_price" value="<%= settings.additional_size_price||0 %>"></label><label>Default Physical Pattern Price (₹)<input type="number" min="0" step=".01" name="physical_pattern_price" value="<%= settings.physical_pattern_price||0 %>"></label><label>Default Trial Sample Price (₹)<input type="number" min="0" step=".01" name="trial_sample_price" value="<%= settings.trial_sample_price||0 %>"></label><p class="settings-note full">Product-specific prices override these defaults.</p><% }else if(section==='gst'){ %><label>GST Percentage<input type="number" min="0" max="100" step=".01" name="percentage" value="18" readonly></label><label>Tax Label<input name="label" value="<%= settings.label||'GST' %>"></label><label class="full"><span><input type="checkbox" name="enabled" checked disabled> GST fixed at 18% for store orders</span></label><% }else if(section==='website'){ %><input type="hidden" name="_csrf" value="<%= learningCsrf %>"><label>Personal LinkedIn Profile URL<input type="url" name="linkedin_personal_url" value="<%= settings.linkedin_personal_url || '' %>"></label><label>Service / Business LinkedIn Profile URL<input type="url" name="linkedin_business_url" value="<%= settings.linkedin_business_url || '' %>"></label><label><input type="checkbox" name="linkedin_show_books" <%= settings.linkedin_show_books?'checked':'' %>> Show LinkedIn on Books</label><label><input type="checkbox" name="linkedin_show_footer" <%= settings.linkedin_show_footer?'checked':'' %>> Show LinkedIn in Footer</label><fieldset class="full"><legend>SEO titles and descriptions</legend><% ['products','courses','classes','contact'].forEach(section=>{ %><label><%= section %> SEO title<input name="<%= section %>_seo_title" maxlength="200" value="<%= settings[section+'_seo_title'] || '' %>"></label><label><%= section %> meta description<textarea name="<%= section %>_seo_description" maxlength="320"><%= settings[section+'_seo_description'] || '' %></textarea></label><% }) %></fieldset><label>Store Name<input name="store_name" value="<%= settings.store_name||'' %>"></label><label>Logo URL<input type="url" name="logo_url" value="<%= settings.logo_url||'' %>" placeholder="https://..."></label><label class="full">Main Website URL<input type="url" name="main_website_url" value="<%= settings.main_website_url||'' %>" placeholder="https://www.example.com/"></label><label>Contact Email<input type="email" name="contact_email" value="<%= settings.contact_email||'' %>"></label><label>Contact Phone<input name="contact_phone" value="<%= settings.contact_phone||'' %>"></label><label>WhatsApp Number<input name="whatsapp_number" value="<%= settings.whatsapp_number||'' %>"></label><label class="full">Support CTA<input name="support_cta" maxlength="600" value="<%= settings.support_cta||'' %>"></label><label class="full">Business Address<textarea name="address"><%= settings.address||'' %></textarea></label><label class="full">Footer Text<input name="footer_text" value="<%= settings.footer_text||'' %>"></label><label class="full">Homepage Heading<input name="homepage_heading" value="<%= settings.homepage_heading||'' %>"></label><label class="full">Homepage Subheading<textarea name="homepage_subheading"><%= settings.homepage_subheading||'' %></textarea></label><p class="settings-note full">The main website URL is used for customer “Back to Main Website” links. Only HTTP/HTTPS URLs are accepted.</p><% } %><button class="btn primary" type="submit">Save Settings</button></form><% } %></div></section></main></body></html>
