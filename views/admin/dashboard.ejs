<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"></head><body><%- include('../partials/admin_header') %><main class="container admin-dashboard-main"><section class="admin-hero"><div><p class="eyebrow">Business overview</p><h1>Owner Control Center</h1><p class="muted">Manage your business from one place. Choose a control below.</p></div><a class="btn primary" href="/admin/products/new">Add Product</a></section><nav class="admin-control-center" aria-label="All owner controls"><% Object.entries(adminNavigation).forEach(([heading,links])=>{ %><section class="admin-control-section"><h2><%= heading %></h2><div class="admin-control-grid"><% links.forEach(([url,label])=>{ %><a class="admin-control-card" href="<%= url %>"><span><%= label %></span><span aria-hidden="true">&rarr;</span></a><% }) %></div></section><% }) %><p><a class="btn" href="/admin/logout">Logout</a></p></nav><h2>Business Overview</h2><section class="grid admin-stats-grid"><% [{l:'Total Products',v:counts.products},{l:'Total Orders',v:counts.orders},{l:'Paid Orders',v:orderStats.paid},{l:'Pending Orders',v:orderStats.pending},{l:'Processing Orders',v:orderStats.processing},{l:'Total Customers',v:counts.customers},{l:'Total Revenue',v:typeof totalRevenue==='number'?formatCurrency(totalRevenue):'—'},{l:'Today Revenue',v:formatCurrency(todayRevenue)}].forEach(x=>{ %><article class="card admin-card"><div class="card-body"><h3><%= x.l %></h3><p class="huge"><%= x.v %></p></div></article><% }) %></section><section class="grid admin-stats-grid"><% (typeof paidAccessStats!=='undefined'?paidAccessStats:[]).forEach(stat=>{ %><article class="card admin-card"><div class="card-body"><h3><%= stat.label %></h3><p class="huge"><%= stat.value %></p><a href="/admin/access-records">View registrations & payments</a></div></article><% }) %></section><section class="grid"><div class="card"><div class="card-body"><h2>Recent Orders</h2><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Payment</th><th>Status</th><th></th></tr></thead><tbody><% if(recentOrders.length){recentOrders.forEach(o=>{ %><tr><td>#<%= o.id %></td><td><%= o.customer_name %></td><td><%= formatCurrency(o.grand_total) %></td><td><span class="status-badge <%= o.payment_status %>"><%= o.payment_status %></span></td><td><span class="status-badge <%= o.order_status %>"><%= o.order_status %></span></td><td><a href="/admin/orders/<%= o.id %>">View</a></td></tr><% })}else{ %><tr><td colspan="6">No recent orders.</td></tr><% } %></tbody></table></div></div></div><div class="card"><div class="card-body"><h2>Recent Payments</h2><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Payment</th><th>Order</th><th>Amount</th><th>Status</th></tr></thead><tbody><% if(recentPayments.length){recentPayments.forEach(p=>{ %><tr><td>#<%= p.id %></td><td><%= p.order_id||'—' %></td><td><%= formatCurrency(p.amount) %></td><td><span class="status-badge <%= p.payment_status %>"><%= p.payment_status %></span></td></tr><% })}else{ %><tr><td colspan="4">No recent payments.</td></tr><% } %></tbody></table></div></div></div></section><section class="card"><div class="card-body"><h2>Inactive Products</h2><% if(inactiveProducts.length){ %><ul><% inactiveProducts.forEach(p=>{ %><li><a href="/admin/products/<%= p._id %>/edit"><%= p.name %></a></li><% }) %></ul><% }else{ %><p class="muted">No inactive products.</p><% } %></div></section></main></body></html>
