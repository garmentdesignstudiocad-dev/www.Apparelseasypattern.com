<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= seoTitle || title %></title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/customer-experience.css"><%- include('partials/theme') %></head><body><%- include('partials/header') %>
<main class="fashion-page"><section class="catalog-hero"><span class="eyebrow">Ready-to-use pattern block library</span><h1 class="page-title">READY-TO-USE AVAILABLE PATTERN TEMPLATES</h1><p class="page-intro">Practical pattern blocks for sampling, stitching and garment development. Choose the printable pattern and optional files or physical services available for each style.</p></section>
<nav class="pattern-categories" aria-label="Pattern categories"><a href="/products" <%= !category?'aria-current=page':'' %>>All patterns</a><% categories.forEach(c=>{ %><a href="/products?category=<%= encodeURIComponent(c) %>" <%= category===c?'aria-current=page':'' %>><%= c.replaceAll('-',' ').toUpperCase() %></a><% }) %></nav>
<section><span class="eyebrow">Browse the collection</span><h2 style="font-family:'Playfair Display',serif;font-size:30px;margin:8px 0 23px"><%= category ? category.replaceAll('-',' ').toUpperCase() : 'Find your next pattern' %></h2><div class="product-catalog"><% if (products && products.length) { %><% products.forEach(function(p) { %><article class="fashion-product"><div class="fashion-product__media preview-watermark" data-protected-content data-watermark="Apparel Easy Patterns - Preview"><span class="fashion-product__badge">PATTERN</span><% if (p.images && p.images.length) { %><img loading="lazy" src="<%= p.images[0] %>" alt="<%= p.name %>"><% } else { %><div class="fashion-product__placeholder" aria-hidden="true"></div><% } %></div><div class="fashion-product__body"><span class="fashion-product__kicker">READY-TO-USE PATTERN</span><h2><%= p.name %></h2><p><%= p.description ? p.description.substring(0,110) : 'Customise your pattern with the options that suit your workflow.' %></p><div class="fashion-product__bottom"><strong class="fashion-price"><%= p.status==='coming_soon'?'Coming soon':'From ' %>₹<%= p.status==='coming_soon'?'':Number(p.base_price || 0).toLocaleString('en-IN',{minimumFractionDigits:2}) %></strong><% if(canVisit('/product/' + String(p.slug))){ %><a class="fashion-button" href="/product/<%= p.slug %>">View Details</a><% } %></div></div></article><% }) %><% } else { %><p class="page-intro">No patterns are available in this category yet. Explore another category or get pattern updates.</p><% } %></div></section><% if(canVisit('/pattern-updates')){ %><p><a href="/pattern-updates">Get pattern updates</a></p><% } %></main><%- include('partials/footer') %><script src="/js/main.js"></script><script src="/js/content-protection.js"></script></body></html>
