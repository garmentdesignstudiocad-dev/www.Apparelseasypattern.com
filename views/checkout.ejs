<!DOCTYPE html>
<html lang="en">
<head>
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title || ('Checkout | ' + (siteSettings?.store_name || 'Apparel Easy Patterns')) %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/customer-experience.css">
  <link rel="stylesheet" href="/css/storefront-theme.css">
  <%- include('partials/theme') %>

  <style>
    :root {
      --navy-900: #0B192C;
      --navy-800: #132742;
      --gold-600: #B45309;
      --gold-500: #D97706;
      --gold-400: #F59E0B;
      --gold-50: #FFFBEB;
      --slate-900: #0F172A;
      --slate-700: #334155;
      --slate-600: #475569;
      --slate-500: #64748B;
      --slate-300: #CBD5E1;
      --slate-200: #E2E8F0;
      --slate-100: #F1F5F9;
      --slate-50: #F8FAFC;
      --white: #FFFFFF;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --shadow-sm: 0 1px 3px rgba(11, 25, 44, 0.06);
      --shadow-md: 0 4px 16px -2px rgba(11, 25, 44, 0.08);
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--slate-50);
      color: var(--slate-900);
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .checkout-page {
      background: var(--slate-50);
      min-height: 100vh;
    }

    .checkout-container {
      max-width: 1360px;
      margin: 0 auto;
      padding: 32px 24px 80px;
    }

    .checkout-breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12.5px;
      color: var(--slate-500);
      margin-bottom: 24px;
    }
    .checkout-breadcrumb a { color: var(--slate-700); text-decoration: none; font-weight: 500; }
    .checkout-breadcrumb a:hover { color: var(--gold-500); }
    .checkout-breadcrumb .current { color: var(--navy-900); font-weight: 700; }

    .checkout-heading {
      margin-bottom: 32px;
      border-bottom: 1px solid var(--slate-200);
      padding-bottom: 20px;
    }

    .checkout-kicker {
      display: inline-block;
      margin-bottom: 6px;
      color: var(--gold-500);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .checkout-heading h1 {
      margin: 0 0 8px;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(28px, 2.6vw, 38px);
      line-height: 1.15;
      color: var(--navy-900);
    }

    .checkout-heading p {
      margin: 0;
      color: var(--slate-600);
      font-size: 14px;
    }

    .checkout-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      gap: 40px;
      align-items: start;
    }

    .checkout-card {
      background: var(--white);
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-lg);
      padding: 32px;
      box-shadow: var(--shadow-sm);
    }

    .checkout-card h2 {
      margin: 0 0 20px;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 22px;
      color: var(--navy-900);
      padding-bottom: 12px;
      border-bottom: 1px solid var(--slate-200);
    }

    .checkout-card h3 {
      margin: 24px 0 14px;
      color: var(--navy-900);
      font-size: 15px;
      font-weight: 700;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .form-group.full {
      grid-column: 1 / -1;
    }

    .form-group label {
      margin-bottom: 6px;
      color: var(--navy-900);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .required {
      color: var(--gold-600);
    }

    .form-group input, .form-group select {
      width: 100%;
      box-sizing: border-box;
      padding: 12px 14px;
      border: 1.5px solid var(--slate-300);
      border-radius: var(--radius-sm);
      background: var(--white);
      color: var(--slate-900);
      font-family: inherit;
      font-size: 13.5px;
      outline: none;
      transition: all 0.15s ease;
    }

    .form-group input:focus, .form-group select:focus {
      border-color: var(--gold-500);
      box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.12);
    }

    .field-error {
      min-height: 16px;
      margin-top: 4px;
      color: #DC2626;
      font-size: 11px;
      font-weight: 600;
    }

    .delivery-box {
      margin-top: 24px;
      padding: 20px;
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-md);
      background: var(--slate-50);
    }

    .delivery-box h3 {
      margin: 0 0 6px;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 18px;
      color: var(--navy-900);
    }

    .delivery-box p {
      margin: 0 0 10px;
      color: var(--slate-600);
      font-size: 12.5px;
      line-height: 1.5;
    }

    .delivery-status {
      margin: 10px 0 14px;
      font-size: 12.5px;
      font-weight: 700;
    }

    .delivery-status.digital {
      color: #059669;
    }

    .delivery-status.physical {
      color: var(--gold-600);
    }

    .payment-note {
      margin-top: 22px;
      padding: 14px 16px;
      border-radius: var(--radius-sm);
      background: var(--gold-50);
      border: 1px solid #FDE68A;
      color: var(--gold-600);
      font-size: 12px;
      line-height: 1.5;
    }

    .checkout-button {
      width: 100%;
      margin-top: 22px;
      padding: 16px 20px;
      border: 0;
      border-radius: var(--radius-sm);
      background: var(--navy-900);
      color: var(--white);
      font-family: inherit;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 4px 14px rgba(11, 25, 44, 0.2);
    }

    .checkout-button:hover:not(:disabled) {
      background: var(--gold-500);
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(217, 119, 6, 0.3);
    }

    .checkout-button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    /* Right: Order Summary Items */
    .order-item {
      padding: 14px 0;
      border-bottom: 1px solid var(--slate-200);
    }

    .order-item:first-child {
      padding-top: 0;
    }

    .order-item:last-child {
      border-bottom: 0;
    }

    .order-item-top {
      display: flex;
      justify-content: space-between;
      gap: 15px;
    }

    .order-product-name {
      color: var(--navy-900);
      font-size: 14px;
      font-weight: 700;
    }

    .order-product-price {
      color: var(--navy-900);
      font-size: 14px;
      font-weight: 700;
      white-space: nowrap;
    }

    .order-meta {
      margin-top: 6px;
      color: var(--slate-500);
      font-size: 11.5px;
      line-height: 1.6;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      margin-top: 12px;
      color: var(--slate-600);
      font-size: 13.5px;
    }

    .summary-row strong {
      color: var(--navy-900);
      font-weight: 700;
    }

    .summary-row.delivery strong {
      color: var(--gold-600);
    }

    .summary-note {
      margin-top: 12px;
      color: var(--slate-400);
      font-size: 11px;
      line-height: 1.5;
    }

    .order-total {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid var(--slate-200);
    }

    .order-total span {
      color: var(--navy-900);
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .order-total strong {
      color: var(--gold-500);
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 26px;
      font-weight: 700;
    }

    .hidden {
      display: none !important;
    }

    .empty-checkout {
      background: var(--white);
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-lg);
      padding: 60px 24px;
      text-align: center;
      max-width: 600px;
      margin: 20px auto;
    }

    .empty-checkout h2 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 26px;
      color: var(--navy-900);
      margin: 0 0 10px;
    }

    @media (max-width: 900px) {
      .checkout-layout { grid-template-columns: 1fr; gap: 32px; }
      .form-grid { grid-template-columns: 1fr; }
      .form-group.full { grid-column: auto; }
    }
  </style>
</head>

<body class="checkout-page">
  <%- include('partials/header') %>

  <main class="checkout-container">
    <nav aria-label="Breadcrumb" class="checkout-breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/cart">Cart</a>
      <span>/</span>
      <span class="current">Checkout</span>
    </nav>

    <div class="checkout-heading">
      <span class="checkout-kicker">SECURE CHECKOUT</span>
      <h1><%= siteSettings.checkout_heading || 'Checkout & Payment' %></h1>
      <p>Enter your contact details and continue to secure payment.</p>
    </div>

    <% if (cart && cart.length) { %>
      <div class="checkout-layout">
        <!-- CUSTOMER INFORMATION -->
        <section class="checkout-card">
          <h2>Customer Information</h2>

          <form id="checkout-form">
            <div class="form-grid">
              <!-- NAME -->
              <div class="form-group full">
                <label for="fullName">Full Name <span class="required">*</span></label>
                <input
                  type="text"
                  id="fullName"
                  name="name"
                  value="<%= typeof accountCustomer!=='undefined' && accountCustomer ? accountCustomer.name : '' %>"
                  autocomplete="name"
                  required
                  placeholder="Enter your full name"
                >
                <div class="field-error" id="err-name"></div>
              </div>

              <!-- EMAIL -->
              <div class="form-group">
                <label for="email">Email Address <span class="required">*</span></label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  value="<%= typeof accountCustomer!=='undefined' && accountCustomer ? accountCustomer.email : '' %>"
                  autocomplete="email"
                  required
                  placeholder="you@example.com"
                >
                <div class="field-error" id="err-email"></div>
              </div>

              <!-- PHONE -->
              <div class="form-group">
                <label for="phone">Phone Number <span class="required">*</span></label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  value="<%= typeof accountCustomer!=='undefined' && accountCustomer ? accountCustomer.phone : '' %>"
                  autocomplete="tel"
                  required
                  maxlength="10"
                  placeholder="10 digit mobile number"
                >
                <div class="field-error" id="err-phone"></div>
              </div>
            </div>

            <!-- DELIVERY INFORMATION -->
            <div id="delivery-section">
              <h3>Delivery Information</h3>

              <div class="form-grid">
                <div class="form-group full">
                  <label for="address">Delivery Address <span class="required">*</span></label>
                  <input
                    type="text"
                    id="address"
                    name="address"
                    autocomplete="street-address"
                    placeholder="House / Flat / Street / Area"
                  >
                </div>

                <div class="form-group">
                  <label for="city">City <span class="required">*</span></label>
                  <input
                    type="text"
                    id="city"
                    name="city"
                    autocomplete="address-level2"
                    placeholder="City"
                  >
                </div>

                <div class="form-group">
                  <label for="state">State <span class="required">*</span></label>
                  <input
                    type="text"
                    id="state"
                    name="state"
                    autocomplete="address-level1"
                    placeholder="State"
                  >
                </div>

                <div class="form-group">
                  <label for="pincode">Pincode <span class="required">*</span></label>
                  <input
                    type="text"
                    id="pincode"
                    name="pincode"
                    inputmode="numeric"
                    maxlength="6"
                    autocomplete="postal-code"
                    placeholder="6 digit pincode"
                  >
                </div>
              </div>

              <div class="delivery-box">
                <h3>Dispatch Hub</h3>
                <p>Dispatch routing is based on your delivery state. Courier booking is not handled by this website.</p>

                <div id="delivery-status" class="delivery-status physical">
                  Enter your state to see the dispatch hub. Other regions can proceed with manual hub assignment.
                </div>
                <p style="margin-top:12px;font-size:12px;color:var(--slate-600)">
                  Courier charges payable separately directly to the courier company. They are not included in your order total.
                </p>
              </div>
            </div>

            <!-- DIGITAL ONLY MESSAGE -->
            <div id="digital-message" class="delivery-box hidden">
              <h3>Digital Delivery</h3>
              <p>Your order contains only digital products. No physical delivery is required.</p>
              <div class="delivery-status digital">
                ✓ Instant online access after verified payment
              </div>
            </div>

            <div class="payment-note">
              Live payments are securely encrypted through Razorpay. You can pay via UPI, Cards, or Netbanking in the secure modal.
            </div>

            <button type="submit" id="proceed" class="checkout-button">
              Continue to Payment &rarr;
            </button>
          </form>
        </section>

        <!-- ORDER SUMMARY -->
        <section class="checkout-card">
          <h2>Order Summary</h2>

          <div id="cart-items">
            <% cart.forEach(function(item) { %>
              <div class="order-item">
                <div class="order-item-top">
                  <span class="order-product-name"><%= item.name %></span>
                  <span class="order-product-price">
                    ₹<%= Number(item.total || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                  </span>
                </div>

                <div class="order-meta">
                  Sizes: <%= (item.selected_sizes || []).join(', ') || 'As ordered' %> &middot; Digital qty: <%= item.quantity ?? 1 %>
                  <% if (item.selected_files && item.selected_files.length) { %>
                    <br>Digital / Files:
                    <%= item.selected_files.map(function(f) {
                      const unit = Number(f.file_price || 0), sizes = (item.selected_sizes || []).length, quantity = Number(item.quantity || 0);
                      return f.file_name + (f.price_per_selected_size ? (" — ₹" + unit.toLocaleString('en-IN') + " per size × " + sizes + " sizes = ₹" + (unit*sizes*quantity).toLocaleString('en-IN')) : (" — ₹" + unit.toLocaleString('en-IN')));
                    }).join(', ') %>
                  <% } %>

                  <% if (item.physical_quantity) { %>
                    <br>Physical Patterns: <%= item.physical_quantity %>
                  <% } %>

                  <% if (item.trial_quantity) { %>
                    <br>Trial Samples: <%= item.trial_quantity %>
                  <% } %>

                  <% if (item.selected_addons && item.selected_addons.length) { %>
                    <br>Add-ons: <%= item.selected_addons.map(function(a) { return a.name; }).join(', ') %>
                  <% } %>
                </div>
              </div>
            <% }); %>
          </div>

          <h3>Online Payment</h3>

          <div class="summary-row">
            <span>Product subtotal</span>
            <strong id="product-total">₹0.00</strong>
          </div>

          <div id="courier-payment-summary-row" class="summary-row delivery hidden">
            <span>Courier charges</span>
            <strong>Pay separately</strong>
          </div>

          <div class="summary-row tax">
            <span>GST (<%= typeof gstRate !== 'undefined' ? gstRate : 18 %>%)</span>
            <strong id="gst-total">₹0.00</strong>
          </div>

          <div class="summary-note">
            Final price is calculated securely by the server.
          </div>

          <div class="order-total">
            <span>Final payable total</span>
            <strong id="grand-total">₹0.00</strong>
          </div>

          <section id="courier-summary" class="hidden" style="border-top:1px solid var(--slate-200);margin-top:24px;padding-top:18px">
            <h3>Physical Delivery Details</h3>
            <p style="font-size:12.5px;color:var(--slate-600);margin:4px 0;">Destination: <span id="destination-summary"></span></p>
            <p style="font-size:12.5px;color:var(--slate-600);margin:4px 0;">Dispatch Hub: <strong id="dispatch-summary">Pending Manual Assignment</strong></p>
            <p style="font-size:12.5px;color:var(--slate-600);margin:4px 0;">Courier charges: Pay separately &middot; Not collected by this website</p>
            <p style="font-size:12.5px;color:var(--slate-600);margin:4px 0;">Courier booking: Not booked</p>
          </section>
        </section>
      </div>
    <% } else { %>
      <div class="empty-checkout">
        <h2>Your cart is empty</h2>
        <p>Add a garment pattern to your cart before continuing to checkout.</p>
        <% if (canVisit('/products')) { %>
          <a href="/products" class="fashion-button" style="text-decoration:none;display:inline-block;margin-top:12px;">Browse Available Patterns</a>
        <% } %>
      </div>
    <% } %>
  </main>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const checkoutForm = document.getElementById("checkout-form");
      const proceedButton = document.getElementById("proceed");
      const deliverySection = document.getElementById("delivery-section");
      const digitalMessage = document.getElementById("digital-message");
      const courierSummary = document.getElementById("courier-summary");
      const deliveryStatus = document.getElementById("delivery-status");
      const courierPaymentRow = document.getElementById("courier-payment-summary-row");
      const cityInput = document.getElementById("city"), stateInput = document.getElementById("state");
      let deliveryRequestId = 0;

      const productTotalElement = document.getElementById("product-total");
      const gstTotalElement = document.getElementById("gst-total");
      const grandTotalElement = document.getElementById("grand-total");

      function showDestination(data = {}) {
        document.getElementById("destination-summary").textContent = [data.city, data.state].filter(Boolean).join(", ");
        document.getElementById("dispatch-summary").textContent = data.dispatch_location || "Pending Manual Assignment";
      }

      const cart = <%- JSON.stringify(typeof cart !== 'undefined' ? cart : []) %>;
      const gstRate = Number(<%- JSON.stringify(typeof gstRate !== 'undefined' ? gstRate : 0) %>);

      function isDeliveryRequired() {
        return cart.some(function (item) {
          return Number(item.physical_quantity || 0) > 0 || Number(item.trial_quantity || 0) > 0;
        });
      }

      const deliveryRequired = isDeliveryRequired();

      function formatCurrency(amount) {
        return "₹" + Number(amount || 0).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }

      function calculateProductTotal() {
        return cart.reduce(function (total, item) {
          return total + Number(item.total || 0);
        }, 0);
      }

      const productTotal = calculateProductTotal();

      async function loadDeliveryRoute() {
        const requestId = ++deliveryRequestId;
        if (!deliveryRequired) return null;
        const city = cityInput.value.trim(), state = stateInput.value.trim(), cityKey = state + "|" + city;
        if (!state) {
          showDestination();
          deliveryStatus.textContent = "Enter your state to determine the dispatch hub.";
          return null;
        }
        deliveryStatus.textContent = "Determining dispatch hub...";
        try {
          const response = await fetch("/checkout/delivery-info?state=" + encodeURIComponent(state) + "&city=" + encodeURIComponent(city));
          const data = await response.json();
          if (requestId !== deliveryRequestId || stateInput.value.trim() + "|" + cityInput.value.trim() !== cityKey) return { stale: true };
          if (!response.ok || !data.ok) throw new Error(data.error || "Unable to determine dispatch hub.");
          showDestination(data);
          deliveryStatus.textContent = data.hub_assignment_status === "pending_manual"
            ? "Dispatch hub assignment is pending manual review. You can continue checkout."
            : "Dispatch hub assigned from your delivery state. Courier is not booked.";
          return data;
        } catch {
          if (requestId !== deliveryRequestId) return { stale: true };
          showDestination({ city: city, state: state, dispatch_location: "Pending Manual Assignment" });
          deliveryStatus.textContent = "Dispatch hub will be assigned from your delivery state. You can continue checkout.";
          return { hub_assignment_status: "pending_manual" };
        }
      }

      function updateCheckoutTotals() {
        productTotalElement.textContent = formatCurrency(productTotal);
        const tax = Math.round(productTotal * 100 * gstRate / 100) / 100;
        gstTotalElement.textContent = formatCurrency(tax);
        const grandTotal = productTotal + tax;
        grandTotalElement.textContent = formatCurrency(grandTotal);
      }

      if (deliveryRequired) {
        deliverySection.classList.remove("hidden");
        digitalMessage.classList.add("hidden");
        courierSummary.classList.remove("hidden");
        courierPaymentRow.classList.remove("hidden");
      } else {
        deliverySection.classList.add("hidden");
        digitalMessage.classList.remove("hidden");
        courierSummary.classList.add("hidden");
        courierPaymentRow.classList.add("hidden");
      }

      updateCheckoutTotals();

      if (deliveryRequired) {
        [cityInput, stateInput].forEach(function (input) {
          input.addEventListener("change", loadDeliveryRoute);
          input.addEventListener("blur", loadDeliveryRoute);
        });
      }

      if (checkoutForm) {
        checkoutForm.addEventListener("submit", async function (event) {
          event.preventDefault();
          const name = document.getElementById("fullName").value.trim();
          const email = document.getElementById("email").value.trim();
          const phone = document.getElementById("phone").value.trim();
          const address = document.getElementById("address")?.value.trim() || "";
          const city = document.getElementById("city")?.value.trim() || "";
          const state = document.getElementById("state")?.value.trim() || "";
          const pincode = document.getElementById("pincode")?.value.trim() || "";

          let valid = true;
          document.querySelectorAll(".field-error").forEach(function (el) { el.textContent = ""; });

          if (!name) { document.getElementById("err-name").textContent = "Full name is required."; valid = false; }
          if (!email || !email.includes("@")) { document.getElementById("err-email").textContent = "Enter a valid email."; valid = false; }
          if (!phone || !/^[0-9]{10}$/.test(phone)) { document.getElementById("err-phone").textContent = "Enter a 10 digit phone number."; valid = false; }

          if (deliveryRequired) {
            if (!address) { alert("Delivery address is required."); return; }
            if (!city) { alert("City is required."); return; }
            if (!state) { alert("State is required."); return; }
            if (!/^[0-9]{6}$/.test(pincode)) { alert("Please enter a valid 6-digit pincode."); return; }
            await loadDeliveryRoute();
          }

          if (!valid) return;

          const items = cart.map(function (item) {
            return {
              product_id: item.product_id || item.productId,
              name: item.name,
              unit_price: item.itemUnitTotal || item.unit_price || item.total || 0,
              selected_formats: item.selected_formats || [],
              physical_sizes: item.physical_sizes || [],
              selected_sizes: item.selected_sizes || [],
              printable_selected: item.printable_selected !== false,
              quantity: item.quantity ?? 1,
              selected_files: item.selected_files || [],
              selected_addons: item.selected_addons || [],
              physical_quantity: item.physical_quantity || 0,
              trial_quantity: item.trial_quantity || 0
            };
          });

          const customer = {
            name: name,
            email: email,
            phone: phone,
            address: deliveryRequired ? address : "",
            city: deliveryRequired ? city : "",
            state: deliveryRequired ? state : "",
            pincode: deliveryRequired ? pincode : ""
          };

          const shipping = deliveryRequired ? {
            address: address,
            city: city,
            state: state,
            pincode: pincode
          } : {};

          proceedButton.disabled = true;
          proceedButton.textContent = "Preparing Payment...";

          try {
            const response = await fetch("/checkout", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ customer: customer, items: items, shipping: shipping })
            });

            const json = await response.json();
            if (json.login_url) { window.location.href = json.login_url; return; }
            if (!response.ok) { alert(json.error || "Unable to start payment."); proceedButton.disabled = false; proceedButton.textContent = "Continue to Payment →"; return; }
            if (json.payment_method_url) { window.location.href = json.payment_method_url; return; }
            if (!json.razorpay_order_id) { alert(json.message || json.error || "Payment gateway is not available."); proceedButton.disabled = false; proceedButton.textContent = "Continue to Payment →"; return; }

            const options = {
              key: json.key,
              amount: json.amount,
              currency: json.currency || "INR",
              name: "Apparel Easy Patterns",
              description: "Garment Pattern Order",
              order_id: json.razorpay_order_id,
              prefill: {
                name: json.customer?.name || name,
                email: json.customer?.email || email,
                contact: phone ? ("+91" + phone) : ""
              },
              notes: {
                order_id: json.order_id,
                tax_amount: json.tax_amount,
                grand_total: json.grand_total
              },
              theme: { color: "#0B192C" },
              callback_url: window.location.origin + "/checkout/razorpay-callback"
            };

            const razorpay = new Razorpay(options);
            razorpay.on("payment.failed", function (resp) {
              alert(resp.error?.description || "Payment failed. Please try again.");
              proceedButton.disabled = false;
              proceedButton.textContent = "Continue to Payment →";
            });
            razorpay.open();
          } catch (err) {
            alert("Unable to start payment. Please try again.");
            proceedButton.disabled = false;
            proceedButton.textContent = "Continue to Payment →";
          } finally {
            setTimeout(function () {
              proceedButton.disabled = false;
              proceedButton.textContent = "Continue to Payment →";
            }, 3000);
          }
        });
      }
    });
  </script>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
