<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Order Successful — <%= siteSettings?.store_name || 'Apparel Easy Patterns' %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/customer-experience.css">
  <link rel="stylesheet" href="/css/storefront-theme.css">
  <%- include('partials/theme') %>

  <style>
    :root {
      --navy-900: #0B192C;
      --navy-800: #132742;
      --gold-600: #B45309;
      --gold-500: #D97706;
      --gold-400: #F59E0B;
      --gold-50: #FFFBEB;
      --slate-900: #0F172A;
      --slate-700: #334155;
      --slate-600: #475569;
      --slate-500: #64748B;
      --slate-300: #CBD5E1;
      --slate-200: #E2E8F0;
      --slate-100: #F1F5F9;
      --slate-50: #F8FAFC;
      --white: #FFFFFF;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --shadow-md: 0 8px 30px -4px rgba(11, 25, 44, 0.1);
    }

    body {
      margin: 0;
      background: var(--slate-50);
      color: var(--slate-900);
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .success-page {
      min-height: 75vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 50px 20px 80px;
    }

    .success-card {
      width: 100%;
      max-width: 640px;
      background: var(--white);
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-lg);
      padding: 44px 36px;
      text-align: center;
      box-shadow: var(--shadow-md);
    }

    .success-icon-badge {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: #ECFDF5;
      color: #059669;
      border: 2px solid #A7F3D0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      margin: 0 auto 18px;
    }

    .success-eyebrow {
      display: inline-block;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--gold-500);
      margin-bottom: 8px;
    }

    .success-card h1 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 30px;
      font-weight: 700;
      color: var(--navy-900);
      margin: 0 0 12px;
    }

    .success-msg {
      font-size: 14px;
      color: var(--slate-600);
      line-height: 1.6;
      margin: 0 0 24px;
    }

    .success-details-box {
      background: var(--slate-50);
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-md);
      padding: 20px;
      margin: 24px 0;
      text-align: left;
    }

    .success-details-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      font-size: 13.5px;
      color: var(--slate-600);
    }

    .success-details-row:last-child {
      margin-bottom: 0;
      padding-top: 10px;
      border-top: 1px solid var(--slate-200);
    }

    .success-details-row strong {
      color: var(--navy-900);
    }

    .success-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 28px;
    }

    .btn-receipt {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 14px 22px;
      background: var(--navy-900);
      color: var(--white);
      border-radius: var(--radius-sm);
      text-decoration: none;
      font-size: 12.5px;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      transition: all 0.2s ease;
    }

    .btn-receipt:hover {
      background: var(--gold-500);
      transform: translateY(-1px);
    }

    .btn-secondary-link {
      display: inline-flex;
      align-items: center;
      padding: 14px 22px;
      border: 1.5px solid var(--slate-300);
      border-radius: var(--radius-sm);
      color: var(--navy-900);
      text-decoration: none;
      font-size: 12.5px;
      font-weight: 700;
      transition: all 0.15s ease;
    }

    .btn-secondary-link:hover {
      background: var(--slate-100);
      border-color: var(--navy-900);
    }
  </style>
</head>

<body>
  <%- include('partials/header') %>

  <main class="success-page">
    <section class="success-card">
      <div class="success-icon-badge">✓</div>
      <span class="success-eyebrow"><%= order ? 'Payment verified' : 'Order confirmation' %></span>
      <h1><%= order ? 'Order Successful' : 'Check Your Order' %></h1>
      <p class="success-msg">
        <%= order ? 'Your payment was verified securely. Review your order details and any eligible digital access below.' : 'A verified order is not available in this browser session. If you have paid, contact the studio with your order reference.' %>
      </p>

      <% if (order) { %>
        <div class="success-details-box">
          <div class="success-details-row">
            <span>Order ID</span>
            <strong><%= order._id %></strong>
          </div>
          <div class="success-details-row">
            <span>Payment Status</span>
            <strong style="color:#059669"><%= order.payment_status %></strong>
          </div>
          <div class="success-details-row">
            <span>Total Paid (incl. 18% GST)</span>
            <strong style="font-size:16px;">₹<%= Number(order.grand_total || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></strong>
          </div>
        </div>

        <% if (canVisit('/receipts/for/product_order/' + String(order._id))) { %>
          <p style="margin: 16px 0;">
            <a class="fashion-button btn-receipt" href="/receipts/for/product_order/<%= order._id %>">
              View / Print Paid Receipt &rarr;
            </a>
          </p>
        <% } %>

        <% if (order.items && order.items.some(function(item){ return Number(item.quantity ?? 1) > 0; })) { %>
          <p style="font-size:13px;color:var(--slate-600);margin:14px 0;">
            Digital master CAD and PDF pattern files are linked directly in your <a href="/account/orders" style="color:var(--gold-500);font-weight:700">Account Orders</a>.
          </p>
        <% } %>

        <% if (order.items && order.items.some(function(item){ return Number(item.physical_quantity || 0) > 0 || Number(item.trial_quantity || 0) > 0; })) { %>
          <div class="success-details-box" style="text-align:left">
            <h2 style="margin:0 0 12px;color:var(--navy-900);font-size:17px">Physical Delivery</h2>
            <p><strong>Delivery address:</strong> <%= [order.shipping_address, order.shipping_city, order.shipping_state, order.delivery_pincode].filter(Boolean).join(', ') %></p>
            <p><strong>Dispatch hub:</strong> <%= order.dispatch_location || 'Pending Manual Assignment' %></p>
            <p>Courier charges are not included in your order total. Shipping charges are payable separately and directly to the courier service.</p>
            <p><strong>Shipping payment status:</strong> <%= order.shipping_payment_status === 'not_collected' ? 'Not collected' : order.shipping_payment_status || 'Not applicable' %></p>
            <p><strong>Courier booking status:</strong> <%= order.courier_booking_status === 'not_booked' ? 'Not booked' : order.courier_booking_status || 'Not required' %></p>
          </div>
        <% } %>

        <% if (order.tracking_url) { %>
          <p style="margin:10px 0;">
            <a href="<%= order.tracking_url %>" rel="noopener noreferrer" style="color:var(--gold-500);font-weight:700;font-size:13px;">Track Shipment (<%= order.tracking_number %>) &rarr;</a>
          </p>
        <% } %>
      <% } else if (orderId) { %>
        <p style="font-size:13px;color:var(--slate-600);">
          Your order reference is <strong><%= orderId %></strong>. Detailed payment information is available only in the browser session that completed payment.
        </p>
      <% } %>

      <div class="success-actions">
        <% if (canVisit('/products')) { %>
          <a href="/products" class="btn-secondary-link">Continue Shopping</a>
        <% } %>
        <a href="/account/orders" class="btn-secondary-link">View My Orders</a>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
