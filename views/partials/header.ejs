<div class="announcement-bar">Professional garment pattern ordering</div><header class="site-header"><div class="container nav-container"><% if(canVisit('/')){ %><a class="fashion-logo" href="/"><% if(siteSettings?.logo_url){ %><img src="<%= siteSettings.logo_url %>" alt="" width="42" height="42" style="border-radius:50%;object-fit:contain;background:#fff;border:1px solid #e5dcd2"><% }else{ %><span class="fashion-logo__mark">GP</span><% } %><span class="fashion-logo__copy"><strong><%= siteSettings?.store_name || 'GARMENT PATTERN STORE' %></strong><small>GARMENT DESIGN STUDIO</small></span></a><% } %><button id="nav-toggle" class="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span></button><nav class="main-nav" id="main-nav"><ul><% visibleLinks([['Home','/'],['Online Classes','/classes'],['Courses','/courses'],['Webinars','/webinars'],['Garment Technology','/garment-technology'],['Products','/products'],['Books','/books'],['Updates','/updates'],['Consulting','/consulting'],['Contact','/contact'],['My Courses','/my-courses']]).forEach(([label,url])=>{ %><li><a href="<%= url %>"><%= label %></a></li><% }) %><% if(siteSettings?.main_website_url && canVisit(siteSettings.main_website_url)){ %><li><a href="<%= siteSettings.main_website_url %>" rel="noopener">Main Website ↗</a></li><% } %><% if(canVisit('/login')){ %><% if(typeof customerSignedIn!=='undefined' && customerSignedIn){ %><li><a href="/account">My Account</a></li><li><a href="/account/orders">My Orders</a></li><li><form method="post" action="/account/logout"><input type="hidden" name="_csrf" value="<%= customerCsrf %>"><button type="submit">Logout</button></form></li><% }else{ %><li><a href="/login">Sign In</a></li><li><a href="/account/register">Create Account</a></li><% } %><% } %><li class="spacer"></li><% if(canVisit('/cart')){ %><li><a href="/cart" class="cart-link">Cart <span id="cart-count">0</span></a></li><% } %></ul></nav></div></header>
