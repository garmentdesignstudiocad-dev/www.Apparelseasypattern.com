<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/customer-experience.css"><%- include('../partials/theme') %></head><body><%- include('../partials/header') %><main class="fashion-page"><section class="confirmation-card"><span class="eyebrow">Enrollment confirmed</span><h1><%= session.title %></h1><p><strong>Registration ID:</strong> <%= registration._id %></p><p><strong>Participant:</strong> <%= registration.name %></p><p><strong>Date:</strong> <%= new Date(session.starts_at).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'}) %></p><p><strong>Amount paid:</strong> ₹<%= Number(registration.amount).toLocaleString('en-IN') %></p><p><strong>Payment:</strong> <%= registration.payment_status %></p><p><strong>Razorpay reference:</strong> <%= registration.razorpay_payment_id %></p><% if(registration.payment_verified_at){ %><p><% if(canVisit('/receipts/for/class_registration/' + String(registration._id))){ %><a class="fashion-button" href="/receipts/for/class_registration/<%= registration._id %>">View / Print Paid Receipt</a><% } %></p><% } %><% if(session.meeting_link){ %><a class="fashion-button" href="<%= session.meeting_link %>" rel="nofollow noopener">Open Course Access</a><% }else{ %><p>Meeting access will appear here when configured.</p><% } %></section></main><%- include('../partials/footer') %></body></html>
