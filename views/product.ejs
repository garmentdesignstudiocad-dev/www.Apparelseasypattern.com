            <% if (product.size_chart_image || product.size_chart_url) { %>
              <div style="margin-top:14px;border-radius:8px;overflow:hidden;border:1px solid #E2E8F0;">
                <img src="<%= product.size_chart_image || product.size_chart_url %>" alt="Size Chart Visual" style="width:100%;height:auto;display:block;">
              </div>
            <% } %>
          </div>

          <!-- Right Sub-card: "How to Measure" PDF Viewing Option -->
          <div class="pd-measurement-subcard">
            <div class="pd-subcard-header">
              <h3 class="pd-subcard-title">How to Measure</h3>
              <span class="pd-guide-badge">Fit Guide</span>
            </div>
            <p style="font-size:13px;color:#64748B;margin:0 0 16px;line-height:1.5;">
              Follow these simple steps with a flexible tape measure to find your accurate garment size:
            </p>

            <div class="pd-measure-steps">
              <div class="pd-measure-step-item">
                <div class="pd-measure-step-num">1</div>
                <div>
                  <strong>Chest / Bust:</strong>
                  <span>Measure horizontally around the fullest part of your chest, keeping the tape snug under your armpits.</span>
                </div>
              </div>
              <div class="pd-measure-step-item">
                <div class="pd-measure-step-num">2</div>
                <div>
                  <strong>Waist:</strong>
                  <span>Measure around your natural waistline, where your trousers typically rest, keeping one finger between tape and body.</span>
                </div>
              </div>
              <div class="pd-measure-step-item">
                <div class="pd-measure-step-num">3</div>
                <div>
                  <strong>Across Shoulder:</strong>
                  <span>Measure from the tip of one shoulder bone across the back curve to the other shoulder tip.</span>
                </div>
              </div>
              <div class="pd-measure-step-item">
                <div class="pd-measure-step-num">4</div>
                <div>
                  <strong>Collar / Neck:</strong>
                  <span>Measure around the base of the neck where the collar sits comfortably with one finger allowance.</span>
                </div>
              </div>
              <div class="pd-measure-step-item">
                <div class="pd-measure-step-num">5</div>
                <div>
                  <strong>Sleeve Length:</strong>
                  <span>Measure from the top shoulder point down along the outer arm to the wrist bone.</span>
                </div>
              </div>
            </div>

            <!-- "How to Measure" PDF Viewing Option -->
            <div class="pd-pdf-card" style="margin-top:18px;">
              <div class="pd-pdf-info">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#EA580C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <div>
                  <strong><%= product.how_to_measure_pdf_name || 'How to Measure Guide (PDF)' %></strong>
                  <small>Illustrated Body Measurement Tutorial</small>
                </div>
              </div>
              <div class="pd-pdf-actions">
                <% if (product.how_to_measure_pdf) { %>
                  <a href="<%= product.how_to_measure_pdf %>" target="_blank" rel="noopener noreferrer" class="btn ghost small">
                    View PDF &nearr;
                  </a>
                  <a href="<%= product.how_to_measure_pdf %>" download="<%= product.how_to_measure_pdf_name || 'How-To-Measure.pdf' %>" class="btn ghost small">
                    Download PDF &darr;
                  </a>
                  <button type="button" class="btn ghost small btn-toggle-pdf-preview" data-target="howToMeasureEmbedBox">
                    Preview &darr;
                  </button>
                <% } else { %>
                  <a href="<%= product.size_chart_pdf || '#measurement-size-chart-section' %>" target="_blank" rel="noopener noreferrer" class="btn ghost small">
                    View Illustrated Guide &nearr;
                  </a>
                <% } %>
              </div>
            </div>
            <% if (product.how_to_measure_pdf) { %>
              <div id="howToMeasureEmbedBox" class="pd-pdf-embed-box" style="display:none;margin-top:12px;">
                <iframe src="<%= product.how_to_measure_pdf %>#toolbar=1" width="100%" height="380" style="border:1px solid #E2E8F0;border-radius:8px;" title="How to Measure PDF Preview"></iframe>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </section>

    <% if (product.size_chart_visible !== false) { %>
