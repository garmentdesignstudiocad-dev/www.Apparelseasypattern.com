            <div class="ref-summary-row" id="sumPhysicalRow" style="display:none">
              <span id="sumPhysicalLabel">Hard Copy (0 sizes)</span>
              <strong id="sumPhysicalPrice">&#8377;0</strong>
            </div>
            <div class="ref-summary-row" id="sumTechPackRow" style="display:none">
              <span>Tech Pack (Optional)</span>
              <strong id="sumTechPackPrice">&#8377;0</strong>
            </div>
            <div class="ref-summary-row" id="sumMarkerRow">
              <span>Marker Service</span>
              <span id="sumMarkerStatus" style="font-size:12px;color:var(--ref-text-muted);">No mini marker selected</span>
            </div>
            <div class="ref-summary-row" id="sumTrialRow" style="display:none">
              <span id="sumTrialLabel">Trial Fit Sample (0 samples)</span>
              <strong id="sumTrialPrice">&#8377;0</strong>
            </div>
            <div class="ref-summary-divider"></div>
            <div class="ref-summary-row">
              <span>Subtotal</span>
              <strong id="sumSubtotal">&#8377;<%= basePrice.toLocaleString('en-IN') %></strong>
            </div>
            <div class="ref-summary-row">
              <span>Tax (GST <%= gstRate %>%)</span>
              <strong id="sumTaxAmount">&#8377;<%= Math.round(basePrice * (gstRate / 100)).toLocaleString('en-IN') %></strong>
