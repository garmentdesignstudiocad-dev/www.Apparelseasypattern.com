<!DOCTYPE html><html lang="en"><head><%- include('../partials/business-head') %><meta name="robots" content="noindex,nofollow"></head><body><%- include('../partials/header') %><main class="studio-page"><h1><%= confirmed && item.payment_status==='Paid'?'Payment Successful':'Webinar Registration' %></h1><p>Customer: <%= item.full_name %></p><h2><%= webinar?.title || 'Webinar' %></h2><p>Reference: <%= item._id %></p><p>Registration: <strong><%= item.registration_status %></strong> · Payment: <strong><%= item.payment_status %></strong></p><p>Fee: <%= item.amount_paise?'₹'+(item.amount_paise/100).toLocaleString('en-IN'):'Free' %></p><% if(item.payment_status==='Paid'){ %><p><% if(canVisit('/receipts/for/webinar_registration/' + String(item._id))){ %><a class="fashion-button" href="/receipts/for/webinar_registration/<%= item._id %>">View / Print Paid Receipt</a><% } %></p><% } %><p>Attendance: <%= item.attendance_status %></p><% if(webinar){ %><p><%= new Date(webinar.starts_at).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'}) %> IST</p><% } %><% if(confirmed){ %><p>Your seat is confirmed.</p><% if(webinar?.meeting_link){ %><a class="fashion-button" href="<%= webinar.meeting_link %>" target="_blank" rel="noopener noreferrer">Join Webinar</a><% }else{ %><p>Joining details will appear here when the studio adds them.</p><% } %><% }else if(item.registration_status==='Cancelled'){ %><p>This registration is cancelled. Contact the studio if you have made a payment.</p><% }else if(item.amount_paise){ %><p>Your seat is reserved while payment is pending. Complete payment to confirm it. The studio may cancel abandoned unpaid reservations.</p><% } %>
<% if(item.payment_note){ %><p>If payment cannot proceed, contact the studio with your registration reference. If you have already paid, check payment status before trying again.</p><% } %><div id="webinar-payment" data-id="<%= item._id %>" data-csrf="<%= learningCsrf %>"><div class="studio-actions"><% if(featureEnabled('paid_access') && !confirmed && item.amount_paise && item.registration_status!=='Cancelled' && item.payment_status!=='Paid'){ %><button type="button" class="fashion-button" id="webinar-pay">Pay with Razorpay</button><% } %><% if(item.razorpay_order_id && item.amount_paise){ %><button type="button" id="webinar-check">Check Payment Status</button><% } %></div><p id="webinar-payment-message" role="status" aria-live="polite"></p></div><p>Keep this reference and return using the same browser. If your session expires, contact the studio for support.</p><% if(canVisit('/webinars')){ %><a href="/webinars">All Webinars</a><% } %></main><%- include('../partials/footer') %><script src="/js/main.js"></script><% if(item.amount_paise){ %><script src="https://checkout.razorpay.com/v1/checkout.js"></script><script src="/js/webinar-payment.js"></script><% } %></body></html>
